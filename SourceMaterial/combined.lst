 6636 T:f289  20 52 17                           jsr GETADR             ; AS 16-BIT INTEGER
 6637 T:f28c  a5 50                              lda LINNUM                ; MUST BE ABOVE VARIABLES AND ARRAYS
 6638 T:f28e  c5 6d                              cmp STREND                ; 
 6639 T:f290  a5 51                              lda LINNUM+1          ; 
 6640 T:f292  e5 6e                              sbc STREND+1          ; 
 6641 T:f294  b0 03                              bcs SETHI                ; IT IS ABOVE THEM
 6642 T:f296  4c 10 04                 JMM       jmp MEMERR          ; NOT ENOUGH MEMORY
 6643 T:f299  a5 50                    SETHI     lda LINNUM             ; STORE NEW HIMEM: VALUE
 6644 T:f29b  85 73                              sta MEMSIZ                ; 
 6645 T:f29d  85 6f                              sta FRETOP                ; <<<NOTE THAT "HIMEM:" DOES NOT>>>
 6646 T:f29f  a5 51                              lda LINNUM+1          ; <<<CLEAR STRING VARIABLES.    >>>
 6647 T:f2a1  85 74                              sta MEMSIZ+1          ; <<<THIS COULD BE DISASTROUS.  >>>
 6648 T:f2a3  85 70                              sta FRETOP+1          ; 
 6649 T:f2a5  60                                 rts                    ; 
