 7516 T:f769                                    ; "DRAW" STATEMENT
 7517 T:f769                                    ; --------------------------------
 7518 T:f769  20 2d 27                 DRAW      jsr DRWPNT
 7519 T:f76c  4c 05 26                           jmp DRAW1
 7520 T:f76f                                    ; --------------------------------
 7521 T:f76f                                    ; "XDRAW" STATEMENT
 7522 T:f76f                                    ; --------------------------------
 7523 T:f76f  20 2d 27                 XDRAW     jsr DRWPNT
 7524 T:f772  4c 61 26                           jmp XDRAW1
 7525 T:f775                                    ; --------------------------------
 7526 T:f775                                    ; "SHLOAD" STATEMENT
 7527 T:f775                                    ; 
 7528 T:f775                                    ; READS A SHAPE TABLE FROM CASSETTE TAPE
 7529 T:f775                                    ; TO A POSITION JUST BELOW HIMEM.
 7530 T:f775                                    ; HIMEM IS THEN MOVED TO JUST BELOW THE TABLE
 7531 T:f775                                    ; --------------------------------
 7532 T:f775  a9 00                    SHLOAD    lda #>LINNUM           ; SET UP TO READ TWO BYTES
 7533 T:f777  85 3d                              sta MON_A1H                ; INTO LINNUM,LINNUM+1
 7534 T:f779  85 3f                              sta MON_A2H                ; 
 7535 T:f77b  a0 50                              ldy #LINNUM               ; 
 7536 T:f77d  84 3c                              sty MON_A1L                ; 
 7537 T:f77f  c8                                 iny                    ; LINNUM+1
 7538 T:f780  84 3e                              sty MON_A2L                ; 
 7539 T:f782  20 fd fe                           jsr MON_READ                ; READ TAPE
 7540 T:f785  18                                 clc                    ; SETUP TO READ (LINNUM) BYTES
 7541 T:f786  a5 73                              lda MEMSIZ                ; ENDING AT HIMEM-1
 7542 T:f788  aa                                 tax                    ; 
 7543 T:f789  ca                                 dex                    ; FORMING HIMEM-1
 7544 T:f78a  86 3e                              stx MON_A2L                ; 
 7545 T:f78c  e5 50                              sbc LINNUM                ; FORMING HIMEM-(LINNUM)
 7546 T:f78e  48                                 pha                    ; 
 7547 T:f78f  a5 74                              lda MEMSIZ+1          ; 
 7548 T:f791  a8                                 tay                    ; 
 7549 T:f792  e8                                 inx                    ; SEE IF HIMEM LOW-BYTE WAS ZERO
 7550 T:f793  d0 01                              bne L_SHLOAD_1                ; NO
 7551 T:f795  88                                 dey                    ; YES, HAVE TO DECREMENT HIGH BYTE
 7552 T:f796  84 3f                    L_SHLOAD_1 sty MON_A2H             ; 
 7553 T:f798  e5 51                              sbc LINNUM+1          ; 
 7554 T:f79a  c5 6e                              cmp STREND+1          ; RUNNING INTO VARIABLES?
 7555 T:f79c  90 02                              bcc L_SHLOAD_2                ; YES, OUT OF MEMORY
 7556 T:f79e  d0 03                              bne L_SHLOAD_3                ; NO, STILL ROOM
 7557 T:f7a0  4c 10 04                 L_SHLOAD_2 jmp MEMERR          ; MEM FULL ERR
 7558 T:f7a3  85 74                    L_SHLOAD_3 sta MEMSIZ+1       ; 
 7559 T:f7a5  85 70                              sta FRETOP+1          ; CLEAR STRING SPACE
 7560 T:f7a7  85 3d                              sta MON_A1H                ; (BUT NAMES ARE STILL IN VARTBL!)
 7561 T:f7a9  85 e9                              sta HGR_SHAPE_PNTR+1
 7562 T:f7ab  68                                 pla 
 7563 T:f7ac  85 e8                              sta HGR_SHAPE_PNTR
 7564 T:f7ae  85 73                              sta MEMSIZ
 7565 T:f7b0  85 6f                              sta FRETOP
 7566 T:f7b2  85 3c                              sta MON_A1L
 7567 T:f7b4  20 fa fc                           jsr MON_RD2BIT                ; READ TO TAPE TRANSITIONS
 7568 T:f7b7  a9 03                              lda #3             ; SHORT DELAY FOR INTERMEDIATE HEADER
 7569 T:f7b9  4c 02 ff                           jmp MON_READ2                ; READ SHAPES
 7570 T:f7bc                                    ; --------------------------------
 7571 T:f7bc                                    ; CALLED FROM STORE AND RECALL
 7572 T:f7bc                                    ; --------------------------------
 7573 T:f7bc                           TAPEPNT   
 7574 T:f7bc  18                                 clc 
 7575 T:f7bd  a5 9b                              lda LOWTR
 7576 T:f7bf  65 50                              adc LINNUM
 7577 T:f7c1  85 3e                              sta MON_A2L
 7578 T:f7c3  a5 9c                              lda LOWTR+1
 7579 T:f7c5  65 51                              adc LINNUM+1
 7580 T:f7c7  85 3f                              sta MON_A2H
 7581 T:f7c9  a0 04                              ldy #4
 7582 T:f7cb  b1 9b                              lda (LOWTR),Y
 7583 T:f7cd  20 ef 10                           jsr GETARY2
 7584 T:f7d0  a5 94                              lda HIGHDS
 7585 T:f7d2  85 3c                              sta MON_A1L
 7586 T:f7d4  a5 95                              lda HIGHDS+1
 7587 T:f7d6  85 3d                              sta MON_A1H
 7588 T:f7d8  60                                 rts 
 7589 T:f7d9                                    ; --------------------------------
 7590 T:f7d9                                    ; CALLED FROM STORE AND RECALL
 7591 T:f7d9                                    ; --------------------------------
 7592 T:f7d9                           GETARYPT  
 7593 T:f7d9  a9 40                              lda #$40
 7594 T:f7db  85 14                              sta SUBFLG
 7595 T:f7dd  20 e3 0f                           jsr PTRGET
 7596 T:f7e0  a9 00                              lda #0
 7597 T:f7e2  85 14                              sta SUBFLG
 7598 T:f7e4  4c f0 08                           jmp VARTIO
 7599 T:f7e7                                    ; --------------------------------
 7600 T:f7e7                                    ; "HTAB" STATEMENT
 7601 T:f7e7                                    ; 
 7602 T:f7e7                                    ; NOTE THAT IF WNDLEFT IS NOT 0, HTAB CAN PRINT
 7603 T:f7e7                                    ; OUTSIDE THE SCREEN (EG., IN THE PROGRAM)
 7604 T:f7e7                                    ; --------------------------------
 7605 T:f7e7  20 f8 16                 HTAB      jsr GETBYT
 7606 T:f7ea  ca                                 dex 
 7607 T:f7eb  8a                                 txa 
 7608 T:f7ec  c9 28                    L_HTAB_1  cmp #40
 7609 T:f7ee  90 0a                              bcc L_HTAB_2
 7610 T:f7f0  e9 28                              sbc #40
 7611 T:f7f2  48                                 pha 
 7612 T:f7f3  20 fb 0a                           jsr CRDO
 7613 T:f7f6  68                                 pla 
 7614 T:f7f7  4c ec 27                           jmp L_HTAB_1
 7615 T:f7fa  85 24                    L_HTAB_2  sta MON_CH
 7616 T:f7fc  60                                 rts 
 7617 T:f7fd                                    ; --------------------------------
 7618 T:f7fd  cb                                 .byt ("K"|%10000000)
 7619 T:f7fe  d2                                 .byt ("R"|%10000000)
 7620 T:f7ff  d7                                 .byt ("W"|%10000000)
 7621 T:f800                                    ; UNKNOWN

