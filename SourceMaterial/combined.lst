 1198 T:d365                                    ; --------------------------------
 1199 T:d365                                    ; CALLED BY "NEXT" AND "FOR" TO SCAN THROUGH
 1200 T:d365                                    ; THE STACK FOR A FRAME WITH THE SAME VARIABLE.
 1201 T:d365                                    ; 
 1202 T:d365                                    ; (FORPNT) = ADDRESS OF VARIABLE IF "FOR" OR "NEXT"
 1203 T:d365                                    ; = $XXFF IF CALLED FROM "RETURN"
 1204 T:d365                                    ; <<< BUG: SHOULD BE $FFXX >>>
 1205 T:d365                                    ; 
 1206 T:d365                                    ; RETURNS .NE. IF VARIABLE NOT FOUND,
 1207 T:d365                                    ; (X) = STACK PNTR AFTER SKIPPING ALL FRAMES
 1208 T:d365                                    ; 
 1209 T:d365                                    ; EQU. IF FOUND
 1210 T:d365                                    ; (X) = STACK PNTR OF FRAME FOUND
 1211 T:d365                                    ; --------------------------------
 1212 T:d365                           GTFORPNT  
 1213 T:d365  ba                                 tsx 
 1214 T:d366  e8                                 inx 
 1215 T:d367  e8                                 inx 
 1216 T:d368  e8                                 inx 
 1217 T:d369  e8                                 inx 
 1218 T:d36a  bd 01 01                 L_GTFORPNT_1 lda STACK+1,X                   ; "FOR" FRAME HERE?
 1219 T:d36d  c9 81                              cmp #TOKEN_FOR               ; 
 1220 T:d36f  d0 21                              bne L_GTFORPNT_4                ; NO
 1221 T:d371  a5 86                              lda FORPNT+1          ; YES -- "NEXT" WITH NO VARIABLE?
 1222 T:d373  d0 0a                              bne L_GTFORPNT_2                ; NO, VARIABLE SPECIFIED
 1223 T:d375  bd 02 01                           lda STACK+2,X                   ; YES, SO USE THIS FRAME
 1224 T:d378  85 85                              sta FORPNT                ; 
 1225 T:d37a  bd 03 01                           lda STACK+3,X                   ; 
 1226 T:d37d  85 86                              sta FORPNT+1          ; 
 1227 T:d37f  dd 03 01                 L_GTFORPNT_2 cmp STACK+3,X                   ; IS VARIABLE IN THIS FRAME?
 1228 T:d382  d0 07                              bne L_GTFORPNT_3                ; NO
 1229 T:d384  a5 85                              lda FORPNT                ; LOOK AT 2ND BYTE TOO
 1230 T:d386  dd 02 01                           cmp STACK+2,X                   ; SAME VARIABLE?
 1231 T:d389  f0 07                              beq L_GTFORPNT_4                ; YES
 1232 T:d38b  8a                       L_GTFORPNT_3 txa                 ; NO, SO TRY NEXT FRAME (IF ANY)
 1233 T:d38c  18                                 clc                    ; 18 BYTES PER FRAME
 1234 T:d38d  69 12                              adc #18             ; 
 1235 T:d38f  aa                                 tax 
 1236 T:d390  d0 d8                              bne L_GTFORPNT_1             ; ...ALWAYS?
 1237 T:d392  60                       L_GTFORPNT_4 rts 
 1238 T:d393                                    ; --------------------------------
 1239 T:d393                                    ; MOVE BLOCK OF MEMORY UP
 1240 T:d393                                    ; 
 1241 T:d393                                    ; ON ENTRY:
 1242 T:d393                                    ; (Y,A) = (HIGHDS) = DESTINATION END+1
 1243 T:d393                                    ; (LOWTR) = LOWEST ADDRESS OF SOURCE
 1244 T:d393                                    ; (HIGHTR) = HIGHEST SOURCE ADDRESS+1
 1245 T:d393                                    ; --------------------------------
 1246 T:d393  20 e3 03                 BLTU      jsr REASON             ; BE SURE (Y,A) < FRETOP
 1247 T:d396  85 6d                              sta STREND                ; NEW TOP OF ARRAY STORAGE
 1248 T:d398  84 6e                              sty STREND+1          ; 
 1249 T:d39a  38                       BLTU2     sec                 ; 
 1250 T:d39b  a5 96                              lda HIGHTR                ; COMPUTE # OF BYTES TO BE MOVED
 1251 T:d39d  e5 9b                              sbc LOWTR                ; (FROM LOWTR THRU HIGHTR-1)
 1252 T:d39f  85 5e                              sta INDEX                ; PARTIAL PAGE AMOUNT
 1253 T:d3a1  a8                                 tay                    ; 
 1254 T:d3a2  a5 97                              lda HIGHTR+1          ; 
 1255 T:d3a4  e5 9c                              sbc LOWTR+1          ; 
 1256 T:d3a6  aa                                 tax                    ; # OF WHOLE PAGES IN X-REG
 1257 T:d3a7  e8                                 inx                    ; 
 1258 T:d3a8  98                                 tya                    ; # BYTES IN PARTIAL PAGE
 1259 T:d3a9  f0 23                              beq L_BLTU2_4                ; NO PARTIAL PAGE
 1260 T:d3ab  a5 96                              lda HIGHTR                ; BACK UP HIGHTR # BYTES IN PARTIAL PAGE
 1261 T:d3ad  38                                 sec                    ; 
 1262 T:d3ae  e5 5e                              sbc INDEX                ; 
 1263 T:d3b0  85 96                              sta HIGHTR                ; 
 1264 T:d3b2  b0 03                              bcs L_BLTU2_1                ; 
 1265 T:d3b4  c6 97                              dec HIGHTR+1          ; 
 1266 T:d3b6  38                                 sec                    ; 
 1267 T:d3b7  a5 94                    L_BLTU2_1 lda HIGHDS             ; BACK UP HIGHDS # BYTES IN PARTIAL PAGE
 1268 T:d3b9  e5 5e                              sbc INDEX                ; 
 1269 T:d3bb  85 94                              sta HIGHDS                ; 
 1270 T:d3bd  b0 08                              bcs L_BLTU2_3                ; 
 1271 T:d3bf  c6 95                              dec HIGHDS+1          ; 
 1272 T:d3c1  90 04                              bcc L_BLTU2_3                ; ...ALWAYS
 1273 T:d3c3  b1 96                    L_BLTU2_2 lda (HIGHTR),Y                  ; MOVE THE BYTES
 1274 T:d3c5  91 94                              sta (HIGHDS),Y
 1275 T:d3c7  88                       L_BLTU2_3 dey 
 1276 T:d3c8  d0 f9                              bne L_BLTU2_2             ; LOOP TO END OF THIS 256 BYTES
 1277 T:d3ca  b1 96                              lda (HIGHTR),Y                  ; MOVE ONE MORE BYTE
 1278 T:d3cc  91 94                              sta (HIGHDS),Y
 1279 T:d3ce  c6 97                    L_BLTU2_4 dec HIGHTR+1       ; DOWN TO NEXT BLOCK OF 256
 1280 T:d3d0  c6 95                              dec HIGHDS+1
 1281 T:d3d2  ca                                 dex                    ; ANOTHER BLOCK OF 256 TO MOVE?
 1282 T:d3d3  d0 f2                              bne L_BLTU2_3             ; YES
 1283 T:d3d5  60                                 rts                    ; NO, FINISHED
 1284 T:d3d6                                    ; --------------------------------
 1285 T:d3d6                                    ; CHECK IF ENOUGH ROOM LEFT ON STACK
 1286 T:d3d6                                    ; FOR "FOR", "GOSUB", OR EXPRESSION EVALUATION
 1287 T:d3d6                                    ; --------------------------------
 1288 T:d3d6  0a                       CHKMEM    asl 
 1289 T:d3d7  69 36                              adc #54
 1290 T:d3d9  b0 35                              bcs MEMERR                ; ...MEM FULL ERR
 1291 T:d3db  85 5e                              sta INDEX
 1292 T:d3dd  ba                                 tsx 
 1293 T:d3de  e4 5e                              cpx INDEX
 1294 T:d3e0  90 2e                              bcc MEMERR                ; ...MEM FULL ERR
 1295 T:d3e2  60                                 rts 
 1296 T:d3e3                                    ; --------------------------------
 1297 T:d3e3                                    ; CHECK IF ENOUGH ROOM BETWEEN ARRAYS AND STRINGS
 1298 T:d3e3                                    ; (Y,A) = ADDR ARRAYS NEED TO GROW TO
 1299 T:d3e3                                    ; --------------------------------
 1300 T:d3e3  c4 70                    REASON    cpy FRETOP+1       ; HIGH BYTE
 1301 T:d3e5  90 28                              bcc L_REASON_4                ; PLENTY OF ROOM
 1302 T:d3e7  d0 04                              bne L_REASON_1                ; NOT ENOUGH, TRY GARBAGE COLLECTION
 1303 T:d3e9  c5 6f                              cmp FRETOP                ; LOW BYTE
 1304 T:d3eb  90 22                              bcc L_REASON_4                ; ENOUGH ROOM
 1305 T:d3ed                                    ; --------------------------------
 1306 T:d3ed  48                       L_REASON_1 pha                 ; SAVE (Y,A), TEMP1, AND TEMP2
 1307 T:d3ee  a2 09                              ldx #FAC-TEMP1-1
 1308 T:d3f0  98                                 tya 
 1309 T:d3f1  48                       L_REASON_2 pha 
 1310 T:d3f2  b5 93                              lda TEMP1,X
 1311 T:d3f4  ca                                 dex 
 1312 T:d3f5  10 fa                              bpl L_REASON_2
 1313 T:d3f7  20 84 14                           jsr GARBAG                ; MAKE AS MUCH ROOM AS POSSIBLE
 1314 T:d3fa  a2 f7                              ldx #TEMP1+256-FAC+1; RESTORE TEMP1 AND TEMP2
 1315 T:d3fc  68                       L_REASON_3 pla                 ; AND (Y,A)
 1316 T:d3fd  95 9d                              sta FAC,X
 1317 T:d3ff  e8                                 inx 
 1318 T:d400  30 fa                              bmi L_REASON_3
 1319 T:d402  68                                 pla 
 1320 T:d403  a8                                 tay 
 1321 T:d404  68                                 pla                    ; DID WE FIND ENOUGH ROOM?
 1322 T:d405  c4 70                              cpy FRETOP+1          ; HIGH BYTE
 1323 T:d407  90 06                              bcc L_REASON_4                ; YES, AT LEAST A PAGE
 1324 T:d409  d0 05                              bne MEMERR                ; NO, MEM FULL ERR
 1325 T:d40b  c5 6f                              cmp FRETOP                ; LOW BYTE
 1326 T:d40d  b0 01                              bcs MEMERR                ; NO, MEM FULL ERR
 1327 T:d40f  60                       L_REASON_4 rts                 ; YES, RETURN
 1328 T:d410                                    ; --------------------------------
 1329 T:d410  a2 4d                    MEMERR    ldx #ERR_MEMFULL
 1330 T:d412                                    ; --------------------------------
 1331 T:d412                                    ; HANDLE AN ERROR
 1332 T:d412                                    ; 
 1333 T:d412                                    ; (X)=OFFSET IN ERROR MESSAGE TABLE
 1334 T:d412                                    ; (ERRFLG) > 128 IF "ON ERR" TURNED ON
 1335 T:d412                                    ; (CURLIN+1) = $FF IF IN DIRECT MODE
 1336 T:d412                                    ; --------------------------------
 1337 T:d412  24 d8                    ERROR     bit ERRFLG             ; "ON ERR" TURNED ON?
 1338 T:d414  10 03                              bpl L_ERROR_1                ; NO
 1339 T:d416  4c e9 22                           jmp HANDLERR                ; YES
 1340 T:d419  20 fb 0a                 L_ERROR_1 jsr CRDO             ; PRINT <RETURN>
 1341 T:d41c  20 5a 0b                           jsr OUTQUES                ; PRINT "?"
 1342 T:d41f  bd 60 02                 L_ERROR_2 lda ERROR_MESSAGES,X
 1343 T:d422  48                                 pha                    ; PRINT MESSAGE
 1344 T:d423  20 5c 0b                           jsr OUTDO
 1345 T:d426  e8                                 inx 
 1346 T:d427  68                                 pla 
 1347 T:d428  10 f5                              bpl L_ERROR_2
 1348 T:d42a  20 83 06                           jsr STKINI                ; FIX STACK, ET AL
 1349 T:d42d  a9 50                              lda #<QT_ERROR           ; PRINT " ERROR" AND BELL
 1350 T:d42f  a0 03                              ldy #>QT_ERROR
 1351 T:d431                                    ; --------------------------------
 1352 T:d431                                    ; PRINT STRING AT (Y,A)
 1353 T:d431                                    ; PRINT CURRENT LINE # UNLESS IN DIRECT MODE
 1354 T:d431                                    ; FALL INTO WARM RESTART
 1355 T:d431                                    ; --------------------------------
 1356 T:d431                           PRINT_ERROR_LINNUM 
 1357 T:d431  20 3a 0b                           jsr STROUT                ; PRINT STRING AT (Y,A)
 1358 T:d434  a4 76                              ldy CURLIN+1          ; RUNNING, OR DIRECT?
 1359 T:d436  c8                                 iny 
 1360 T:d437  f0 03                              beq RESTART                ; WAS $FF, SO DIRECT MODE
 1361 T:d439  20 19 1d                           jsr INPRT                ; RUNNING, SO PRINT LINE NUMBER
 1362 T:d43c                                    ; --------------------------------
 1363 T:d43c                                    ; WARM RESTART ENTRY
 1364 T:d43c                                    ; 
 1365 T:d43c                                    ; COME HERE FROM MONITOR BY CTL-C, 0G, 3D0G, OR E003G
 1366 T:d43c                                    ; --------------------------------
 1367 T:d43c                           RESTART   
 1368 T:d43c  20 fb 0a                           jsr CRDO                ; PRINT <RETURN>
 1369 T:d43f  a2 dd                              ldx #("]"|%10000000)     ; PROMPT CHARACTER
 1370 T:d441  20 2e 05                           jsr INLIN2                ; READ A LINE
 1371 T:d444  86 b8                              stx TXTPTR                ; SET UP CHRGET TO SCAN THE LINE
 1372 T:d446  84 b9                              sty TXTPTR+1          ; 
 1373 T:d448  46 d8                              lsr ERRFLG                ; CLEAR FLAG
 1374 T:d44a  20 b1 00                           jsr CHRGET                ; 
 1375 T:d44d  aa                                 tax                    ; 
 1376 T:d44e  f0 ec                              beq RESTART             ; EMPTY LINE
 1377 T:d450  a2 ff                              ldx #$ff             ; $FF IN HI-BYTE OF CURLIN MEANS
 1378 T:d452  86 76                              stx CURLIN+1          ; WE ARE IN DIRECT MODE
 1379 T:d454  90 06                              bcc NUMBERED_LINE                ; CHRGET SAW DIGIT, NUMBERED LINE
 1380 T:d456  20 59 05                           jsr PARSE_INPUT_LINE                ; NO NUMBER, SO PARSE IT
 1381 T:d459  4c 05 08                           jmp TRACE_                ; AND TRY EXECUTING IT
 1382 T:d45c                                    ; --------------------------------
 1383 T:d45c                                    ; HANDLE NUMBERED LINE
 1384 T:d45c                                    ; --------------------------------
 1385 T:d45c                           NUMBERED_LINE 
 1386 T:d45c  a6 af                              ldx PRGEND                ; SQUASH VARIABLE TABLE
 1387 T:d45e  86 69                              stx VARTAB
 1388 T:d460  a6 b0                              ldx PRGEND+1
 1389 T:d462  86 6a                              stx VARTAB+1
 1390 T:d464  20 0c 0a                           jsr LINGET                ; GET LINE #
 1391 T:d467  20 59 05                           jsr PARSE_INPUT_LINE                ; AND PARSE THE INPUT LINE
 1392 T:d46a  84 0f                              sty EOL_PNTR                ; SAVE INDEX TO INPUT BUFFER
 1393 T:d46c  20 1a 06                           jsr FNDLIN                ; IS THIS LINE # ALREADY IN PROGRAM?
 1394 T:d46f  90 44                              bcc PUT_NEW_LINE                ; NO
 1395 T:d471  a0 01                              ldy #1             ; YES, SO DELETE IT
 1396 T:d473  b1 9b                              lda (LOWTR),Y                   ; LOWTR POINTS AT LINE
 1397 T:d475  85 5f                              sta INDEX+1          ; GET HIGH BYTE OF FORWARD PNTR
 1398 T:d477  a5 69                              lda VARTAB
 1399 T:d479  85 5e                              sta INDEX
 1400 T:d47b  a5 9c                              lda LOWTR+1
 1401 T:d47d  85 61                              sta DEST+1
 1402 T:d47f  a5 9b                              lda LOWTR
 1403 T:d481  88                                 dey 
 1404 T:d482  f1 9b                              sbc (LOWTR),Y
 1405 T:d484  18                                 clc 
 1406 T:d485  65 69                              adc VARTAB
 1407 T:d487  85 69                              sta VARTAB
 1408 T:d489  85 60                              sta DEST
 1409 T:d48b  a5 6a                              lda VARTAB+1
 1410 T:d48d  69 ff                              adc #$ff
 1411 T:d48f  85 6a                              sta VARTAB+1
 1412 T:d491  e5 9c                              sbc LOWTR+1
 1413 T:d493  aa                                 tax 
 1414 T:d494  38                                 sec 
 1415 T:d495  a5 9b                              lda LOWTR
 1416 T:d497  e5 69                              sbc VARTAB
 1417 T:d499  a8                                 tay 
 1418 T:d49a  b0 03                              bcs L_NUMBERED_LINE_1
 1419 T:d49c  e8                                 inx 
 1420 T:d49d  c6 61                              dec DEST+1
 1421 T:d49f  18                       L_NUMBERED_LINE_1 clc 
 1422 T:d4a0  65 5e                              adc INDEX
 1423 T:d4a2  90 03                              bcc L_NUMBERED_LINE_2
 1424 T:d4a4  c6 5f                              dec INDEX+1
 1425 T:d4a6  18                                 clc 
 1426 T:d4a7                                    ; --------------------------------
 1427 T:d4a7  b1 5e                    L_NUMBERED_LINE_2 lda (INDEX),Y                   ; MOVE HIGHER LINES OF PROGRAM
 1428 T:d4a9  91 60                              sta (DEST),Y                    ; DOWN OVER THE DELETED LINE.
 1429 T:d4ab  c8                                 iny 
 1430 T:d4ac  d0 f9                              bne L_NUMBERED_LINE_2
 1431 T:d4ae  e6 5f                              inc INDEX+1
 1432 T:d4b0  e6 61                              inc DEST+1
 1433 T:d4b2  ca                                 dex 
 1434 T:d4b3  d0 f2                              bne L_NUMBERED_LINE_2
 1435 T:d4b5                                    ; --------------------------------
 1436 T:d4b5                           PUT_NEW_LINE 
 1437 T:d4b5  ad 00 02                           lda INPUT_BUFFER                ; ANY CHARACTERS AFTER LINE #?
 1438 T:d4b8  f0 38                              beq FIX_LINKS                ; NO, SO NOTHING TO INSERT.
 1439 T:d4ba  a5 73                              lda MEMSIZ                ; YES, SO MAKE ROOM AND INSERT LINE
 1440 T:d4bc  a4 74                              ldy MEMSIZ+1          ; WIPE STRING AREA CLEAN
 1441 T:d4be  85 6f                              sta FRETOP                ; 
 1442 T:d4c0  84 70                              sty FRETOP+1          ; 
 1443 T:d4c2  a5 69                              lda VARTAB                ; SET UP BLTU SUBROUTINE
 1444 T:d4c4  85 96                              sta HIGHTR                ; INSERT NEW LINE.
 1445 T:d4c6  65 0f                              adc EOL_PNTR
 1446 T:d4c8  85 94                              sta HIGHDS
 1447 T:d4ca  a4 6a                              ldy VARTAB+1
 1448 T:d4cc  84 97                              sty HIGHTR+1
 1449 T:d4ce  90 01                              bcc L_PUT_NEW_LINE_1
 1450 T:d4d0  c8                                 iny 
 1451 T:d4d1  84 95                    L_PUT_NEW_LINE_1 sty HIGHDS+1
 1452 T:d4d3  20 93 03                           jsr BLTU             ; MAKE ROOM FOR THE LINE
 1453 T:d4d6  a5 50                              lda LINNUM                ; PUT LINE NUMBER IN LINE IMAGE
 1454 T:d4d8  a4 51                              ldy LINNUM+1
 1455 T:d4da  8d fe 01                           sta INPUT_BUFFER-2
 1456 T:d4dd  8c ff 01                           sty INPUT_BUFFER-1
 1457 T:d4e0  a5 6d                              lda STREND
 1458 T:d4e2  a4 6e                              ldy STREND+1
 1459 T:d4e4  85 69                              sta VARTAB
 1460 T:d4e6  84 6a                              sty VARTAB+1
 1461 T:d4e8  a4 0f                              ldy EOL_PNTR
 1462 T:d4ea                                    ; ---COPY LINE INTO PROGRAM-------
 1463 T:d4ea  b9 fb 01                 L_PUT_NEW_LINE_2 lda INPUT_BUFFER-5,Y
 1464 T:d4ed  88                                 dey 
 1465 T:d4ee  91 9b                              sta (LOWTR),Y
 1466 T:d4f0  d0 f8                              bne L_PUT_NEW_LINE_2
 1467 T:d4f2                                    ; --------------------------------
 1468 T:d4f2                                    ; CLEAR ALL VARIABLES
 1469 T:d4f2                                    ; RE-ESTABLISH ALL FORWARD LINKS
 1470 T:d4f2                                    ; --------------------------------
 1471 T:d4f2                           FIX_LINKS 
 1472 T:d4f2  20 65 06                           jsr SETPTRS                ; CLEAR ALL VARIABLES
 1473 T:d4f5  a5 67                              lda TXTTAB                ; POINT INDEX AT START OF PROGRAM
 1474 T:d4f7  a4 68                              ldy TXTTAB+1
 1475 T:d4f9  85 5e                              sta INDEX
 1476 T:d4fb  84 5f                              sty INDEX+1
 1477 T:d4fd  18                                 clc 
 1478 T:d4fe  a0 01                    L_FIX_LINKS_1 ldy #1          ; HI-BYTE OF NEXT FORWARD PNTR
 1479 T:d500  b1 5e                              lda (INDEX),Y                   ; END OF PROGRAM YET?
 1480 T:d502  d0 0b                              bne L_FIX_LINKS_2                ; NO, KEEP GOING
 1481 T:d504  a5 69                              lda VARTAB                ; YES
 1482 T:d506  85 af                              sta PRGEND
 1483 T:d508  a5 6a                              lda VARTAB+1
 1484 T:d50a  85 b0                              sta PRGEND+1
 1485 T:d50c  4c 3c 04                           jmp RESTART
 1486 T:d50f  a0 04                    L_FIX_LINKS_2 ldy #4          ; FIND END OF THIS LINE
 1487 T:d511  c8                       L_FIX_LINKS_3 iny                 ; (NOTE MAXIMUM LENGTH < 256)
 1488 T:d512  b1 5e                              lda (INDEX),Y                   ; 
 1489 T:d514  d0 fb                              bne L_FIX_LINKS_3             ; 
 1490 T:d516  c8                                 iny                    ; COMPUTE ADDRESS OF NEXT LINE
 1491 T:d517  98                                 tya                    ; 
 1492 T:d518  65 5e                              adc INDEX                ; 
 1493 T:d51a  aa                                 tax                    ; 
 1494 T:d51b  a0 00                              ldy #0             ; STORE FORWARD PNTR IN THIS LINE
 1495 T:d51d  91 5e                              sta (INDEX),Y                   ; 
 1496 T:d51f  a5 5f                              lda INDEX+1          ; 
 1497 T:d521  69 00                              adc #0             ; (NOTE: THIS CLEARS CARRY)
 1498 T:d523  c8                                 iny                    ; 
 1499 T:d524  91 5e                              sta (INDEX),Y                   ; 
 1500 T:d526  86 5e                              stx INDEX                ; 
 1501 T:d528  85 5f                              sta INDEX+1          ; 
 1502 T:d52a  90 d2                              bcc L_FIX_LINKS_1             ; ...ALWAYS
 1503 T:d52c                                    ; --------------------------------
 1504 T:d52c                                    ; --------------------------------
 1505 T:d52c                                    ; READ A LINE, AND STRIP OFF SIGN BITS
 1506 T:d52c                                    ; --------------------------------
 1507 T:d52c  a2 80                    INLIN     ldx #$80          ; NULL PROMPT
 1508 T:d52e  86 33                    INLIN2    stx MON_PROMPT
 1509 T:d530  20 6a fd                           jsr MON_GETLN
 1510 T:d533  e0 ef                              cpx #239             ; MAXIMUM LINE LENGTH
 1511 T:d535  90 02                              bcc L_INLIN2_1
 1512 T:d537  a2 ef                              ldx #239             ; TRUNCATE AT 239 CHARS
 1513 T:d539  a9 00                    L_INLIN2_1 lda #0          ; MARK END OF LINE WITH $00 BYTE
 1514 T:d53b  9d 00 02                           sta INPUT_BUFFER,X
 1515 T:d53e  8a                                 txa 
 1516 T:d53f  f0 0b                              beq L_INLIN2_3                ; NULL INPUT LINE
 1517 T:d541  bd ff 01                 L_INLIN2_2 lda INPUT_BUFFER-1,X            ; DROP SIGN BITS
 1518 T:d544  29 7f                              and #$7f
 1519 T:d546  9d ff 01                           sta INPUT_BUFFER-1,X
 1520 T:d549  ca                                 dex 
 1521 T:d54a  d0 f5                              bne L_INLIN2_2
 1522 T:d54c  a9 00                    L_INLIN2_3 lda #0          ; (Y,X) POINTS AT BUFFER-1
 1523 T:d54e  a2 ff                              ldx #<(INPUT_BUFFER-1)
 1524 T:d550  a0 01                              ldy #>(INPUT_BUFFER-1)
 1525 T:d552  60                                 rts 
 1526 T:d553                                    ; --------------------------------
 1527 T:d553  20 0c fd                 INCHR     jsr MON_RDKEY             ; *** OUGHT TO BE "BIT $C010" ***
 1528 T:d556  29 7f                              and #$7f
 1529 T:d558  60                                 rts 
 1530 T:d559                                    ; --------------------------------
 1531 T:d559                                    ; TOKENIZE THE INPUT LINE
 1532 T:d559                                    ; --------------------------------
 1533 T:d559                           PARSE_INPUT_LINE 
 1534 T:d559  a6 b8                              ldx TXTPTR                ; INDEX INTO UNPARSED LINE
 1535 T:d55b  ca                                 dex                    ; PREPARE FOR INX AT "PARSE"
 1536 T:d55c  a0 04                              ldy #4             ; INDEX TO PARSED OUTPUT LINE
 1537 T:d55e  84 13                              sty DATAFLG                ; CLEAR SIGN-BIT OF DATAFLG
 1538 T:d560  24 d6                              bit LOCK                ; IS THIS PROGRAM LOCKED?
 1539 T:d562  10 08                              bpl PARSE                ; NO, GO AHEAD AND PARSE THE LINE
 1540 T:d564  68                                 pla                    ; YES, IGNORE INPUT AND "RUN"
 1541 T:d565  68                                 pla                    ; THE PROGRAM
 1542 T:d566  20 65 06                           jsr SETPTRS                ; CLEAR ALL VARIABLES
 1543 T:d569  4c d2 07                           jmp NEWSTT                ; START RUNNING
 1544 T:d56c                                    ; --------------------------------
 1545 T:d56c  e8                       PARSE     inx                 ; NEXT INPUT CHARACTER
 1546 T:d56d  bd 00 02                 L_PARSE_1 lda INPUT_BUFFER,X
 1547 T:d570  24 13                              bit DATAFLG                ; IN A "DATA" STATEMENT?
 1548 T:d572  70 04                              bvs L_PARSE_2                ; YES (DATAFLG = $49)
 1549 T:d574  c9 20                              cmp #(" "&%01111111)     ; IGNORE BLANKS
 1550 T:d576  f0 f4                              beq PARSE             ; 
 1551 T:d578  85 0e                    L_PARSE_2 sta ENDCHR             ; 
 1552 T:d57a  c9 22                              cmp #$22             ; START OF QUOTATION?
 1553 T:d57c  f0 74                              beq L_PARSE_13                ; 
 1554 T:d57e  70 4d                              bvs L_PARSE_9                ; BRANCH IF IN "DATA" STATEMENT
 1555 T:d580  c9 3f                              cmp #("?"&%01111111)     ; SHORTHAND FOR "PRINT"?
 1556 T:d582  d0 04                              bne L_PARSE_3                ; NO
 1557 T:d584  a9 ba                              lda #TOKEN_PRINT               ; YES, REPLACE WITH "PRINT" TOKEN
 1558 T:d586  d0 45                              bne L_PARSE_9                ; ...ALWAYS
 1559 T:d588  c9 30                    L_PARSE_3 cmp #("0"&%01111111)  ; IS IT A DIGIT, COLON, OR SEMI-COLON?
 1560 T:d58a  90 04                              bcc L_PARSE_4                ; NO, PUNCTUATION !"#$%&'()*+,-./
 1561 T:d58c  c9 3c                              cmp #(";"&%01111111)+1
 1562 T:d58e  90 3d                              bcc L_PARSE_9                ; YES, NOT A TOKEN
 1563 T:d590                                    ; --------------------------------
 1564 T:d590                                    ; SEARCH TOKEN NAME TABLE FOR MATCH STARTING
 1565 T:d590                                    ; WITH CURRENT CHAR FROM INPUT LINE
 1566 T:d590                                    ; --------------------------------
 1567 T:d590  84 ad                    L_PARSE_4 sty STRNG2             ; SAVE INDEX TO OUTPUT LINE
 1568 T:d592  a9 d0                              lda #<(TOKEN_NAME_TABLE-$0100)
 1569 T:d594  85 9d                              sta FAC                ; MAKE PNTR FOR SEARCH
 1570 T:d596  a9 ff                              lda #>(TOKEN_NAME_TABLE-$0100)
 1571 T:d598  85 9e                              sta FAC+1
 1572 T:d59a  a0 00                              ldy #0             ; USE Y-REG WITH (FAC) TO ADDRESS TABLE
 1573 T:d59c  84 0f                              sty TKN_CNTR                ; HOLDS CURRENT TOKEN-$80
 1574 T:d59e  88                                 dey                    ; PREPARE FOR "INY" A FEW LINES DOWN
 1575 T:d59f  86 b8                              stx TXTPTR                ; SAVE POSITION IN INPUT LINE
 1576 T:d5a1  ca                                 dex                    ; PREPARE FOR "INX" A FEW LINES DOWN
 1577 T:d5a2  c8                       L_PARSE_5 iny                 ; ADVANCE POINTER TO TOKEN TABLE
 1578 T:d5a3  d0 02                              bne L_PARSE_6                ; Y=Y+1 IS ENOUGH
 1579 T:d5a5  e6 9e                              inc FAC+1          ; ALSO NEED TO BUMP THE PAGE
 1580 T:d5a7  e8                       L_PARSE_6 inx                 ; ADVANCE POINTER TO INPUT LINE
 1581 T:d5a8  bd 00 02                 L_PARSE_7 lda INPUT_BUFFER,X              ; NEXT CHAR FROM INPUT LINE
 1582 T:d5ab  c9 20                              cmp #(" "&%01111111)     ; THIS CHAR A BLANK?
 1583 T:d5ad  f0 f8                              beq L_PARSE_6             ; YES, IGNORE ALL BLANKS
 1584 T:d5af  38                                 sec                    ; NO, COMPARE TO CHAR IN TABLE
 1585 T:d5b0  f1 9d                              sbc (FAC),Y                     ; SAME AS NEXT CHAR OF TOKEN NAME?
 1586 T:d5b2  f0 ee                              beq L_PARSE_5             ; YES, CONTINUE MATCHING
 1587 T:d5b4  c9 80                              cmp #$80             ; MAYBE; WAS IT SAME EXCEPT FOR BIT 7?
 1588 T:d5b6  d0 41                              bne L_PARSE_14                ; NO, SKIP TO NEXT TOKEN
 1589 T:d5b8  05 0f                              ora TKN_CNTR                ; YES, END OF TOKEN; GET TOKEN #
 1590 T:d5ba  c9 c5                              cmp #TOKENDB               ; DID WE MATCH "AT"?
 1591 T:d5bc  d0 0d                              bne L_PARSE_8                ; NO, SO NO AMBIGUITY
 1592 T:d5be  bd 01 02                           lda INPUT_BUFFER+1,X            ; "AT" COULD BE "ATN" OR "A TO"
 1593 T:d5c1  c9 4e                              cmp #("N"&%01111111)     ; "ATN" HAS PRECEDENCE OVER "AT"
 1594 T:d5c3  f0 34                              beq L_PARSE_14                ; IT IS "ATN", FIND IT THE HARD WAY
 1595 T:d5c5  c9 4f                              cmp #("O"&%01111111)     ; "TO" HAS PRECEDENCE OVER "AT"
 1596 T:d5c7  f0 30                              beq L_PARSE_14                ; IT IS "A TO", FIN IT THE HARD WAY
 1597 T:d5c9  a9 c5                              lda #TOKENDB               ; NOT "ATN" OR "A TO", SO USE "AT"
 1598 T:d5cb                                    ; --------------------------------
 1599 T:d5cb                                    ; STORE CHARACTER OR TOKEN IN OUTPUT LINE
 1600 T:d5cb                                    ; --------------------------------
 1601 T:d5cb  a4 ad                    L_PARSE_8 ldy STRNG2             ; GET INDEX TO OUTPUT LINE IN Y-REG
 1602 T:d5cd  e8                       L_PARSE_9 inx                 ; ADVANCE INPUT INDEX
 1603 T:d5ce  c8                                 iny                    ; ADVANCE OUTPUT INDEX
 1604 T:d5cf  99 fb 01                           sta INPUT_BUFFER-5,Y            ; STORE CHAR OR TOKEN
 1605 T:d5d2  b9 fb 01                           lda INPUT_BUFFER-5,Y            ; TEST FOR EOL OR EOS
 1606 T:d5d5  f0 39                              beq L_PARSE_17                ; END OF LINE
 1607 T:d5d7  38                                 sec                    ; 
 1608 T:d5d8  e9 3a                              sbc #(":"&%01111111)     ; END OF STATEMENT?
 1609 T:d5da  f0 04                              beq L_PARSE_10                ; YES, CLEAR DATAFLG
 1610 T:d5dc  c9 49                              cmp #TOKENDWTA+128-$ba   ; "DATA" TOKEN?
 1611 T:d5de  d0 02                              bne L_PARSE_11                ; NO, LEAVE DATAFLG ALONE
 1612 T:d5e0  85 13                    L_PARSE_10 sta DATAFLG             ; DATAFLG = 0 OR $83-$3A = $49
 1613 T:d5e2  38                       L_PARSE_11 sec                 ; IS IT A "REM" TOKEN?
 1614 T:d5e3  e9 78                              sbc #TOKEN_REM+128-$ba
 1615 T:d5e5  d0 86                              bne L_PARSE_1             ; NO, CONTINUE PARSING LINE
 1616 T:d5e7  85 0e                              sta ENDCHR                ; YES, CLEAR LITERAL FLAG
 1617 T:d5e9                                    ; --------------------------------
 1618 T:d5e9                                    ; HANDLE LITERAL (BETWEEN QUOTES) OR REMARK,
 1619 T:d5e9                                    ; BY COPYING CHARS UP TO ENDCHR.
 1620 T:d5e9                                    ; --------------------------------
 1621 T:d5e9  bd 00 02                 L_PARSE_12 lda INPUT_BUFFER,X
 1622 T:d5ec  f0 df                              beq L_PARSE_9             ; END OF LINE
 1623 T:d5ee  c5 0e                              cmp ENDCHR
 1624 T:d5f0  f0 db                              beq L_PARSE_9             ; FOUND ENDCHR
 1625 T:d5f2  c8                       L_PARSE_13 iny                 ; NEXT OUTPUT CHAR
 1626 T:d5f3  99 fb 01                           sta INPUT_BUFFER-5,Y
 1627 T:d5f6  e8                                 inx                    ; NEXT INPUT CHAR
 1628 T:d5f7  d0 f0                              bne L_PARSE_12             ; ...ALWAYS
 1629 T:d5f9                                    ; --------------------------------
 1630 T:d5f9                                    ; ADVANCE POINTER TO NEXT TOKEN NAME
 1631 T:d5f9                                    ; --------------------------------
 1632 T:d5f9  a6 b8                    L_PARSE_14 ldx TXTPTR             ; GET POINTER TO INPUT LINE IN X-REG
 1633 T:d5fb  e6 0f                              inc TKN_CNTR                ; BUMP (TOKEN # - $80)
 1634 T:d5fd  b1 9d                    L_PARSE_15 lda (FAC),Y                     ; SCAN THROUGH TABLE FOR BIT7 = 1
 1635 T:d5ff  c8                                 iny                    ; NEXT TOKEN ONE BEYOND THAT
 1636 T:d600  d0 02                              bne L_PARSE_16                ; ...USUALLY ENOUGH TO BUMP Y-REG
 1637 T:d602  e6 9e                              inc FAC+1          ; NEXT SET OF 256 TOKEN CHARS
 1638 T:d604  0a                       L_PARSE_16 asl                 ; SEE IF SIGN BIT SET ON CHAR
 1639 T:d605  90 f6                              bcc L_PARSE_15             ; NO, MORE IN THIS NAME
 1640 T:d607  b1 9d                              lda (FAC),Y                     ; YES, AT NEXT NAME.  END OF TABLE?
 1641 T:d609  d0 9d                              bne L_PARSE_7             ; NO, NOT END OF TABLE
 1642 T:d60b  bd 00 02                           lda INPUT_BUFFER,X              ; YES, SO NOT A KEYWORD
 1643 T:d60e  10 bb                              bpl L_PARSE_8             ; ...ALWAYS, COPY CHAR AS IS
 1644 T:d610                                    ; ---END OF LINE------------------
 1645 T:d610  99 fd 01                 L_PARSE_17 sta INPUT_BUFFER-3,Y            ; STORE ANOTHER 00 ON END
 1646 T:d613  c6 b9                              dec TXTPTR+1          ; SET TXTPTR = INPUT.BUFFER-1
 1647 T:d615  a9 ff                              lda #<(INPUT_BUFFER-1)
 1648 T:d617  85 b8                              sta TXTPTR
 1649 T:d619  60                                 rts 
 1650 T:d61a                                    ; --------------------------------
 1651 T:d61a                                    ; SEARCH FOR LINE
 1652 T:d61a                                    ; 
 1653 T:d61a                                    ; (LINNUM) = LINE # TO FIND
 1654 T:d61a                                    ; IF NOT FOUND:  CARRY = 0
 1655 T:d61a                                    ; LOWTR POINTS AT NEXT LINE
 1656 T:d61a                                    ; IF FOUND:      CARRY = 1
 1657 T:d61a                                    ; LOWTR POINTS AT LINE
 1658 T:d61a                                    ; --------------------------------
 1659 T:d61a  a5 67                    FNDLIN    lda TXTTAB             ; SEARCH FROM BEGINNING OF PROGRAM
 1660 T:d61c  a6 68                              ldx TXTTAB+1          ; 
 1661 T:d61e  a0 01                    FL1       ldy #1          ; SEARCH FROM (X,A)
 1662 T:d620  85 9b                              sta LOWTR                ; 
 1663 T:d622  86 9c                              stx LOWTR+1          ; 
 1664 T:d624  b1 9b                              lda (LOWTR),Y                   ; 
 1665 T:d626  f0 1f                              beq L_FL1_3                ; END OF PROGRAM, AND NOT FOUND
 1666 T:d628  c8                                 iny                    ; 
 1667 T:d629  c8                                 iny                    ; 
 1668 T:d62a  a5 51                              lda LINNUM+1          ; 
 1669 T:d62c  d1 9b                              cmp (LOWTR),Y                   ; 
 1670 T:d62e  90 18                              bcc RTS_1                ; IF NOT FOUND
 1671 T:d630  f0 03                              beq L_FL1_1                ; 
 1672 T:d632  88                                 dey                    ; 
 1673 T:d633  d0 09                              bne L_FL1_2                ; 
 1674 T:d635  a5 50                    L_FL1_1   lda LINNUM             ; 
 1675 T:d637  88                                 dey                    ; 
 1676 T:d638  d1 9b                              cmp (LOWTR),Y                   ; 
 1677 T:d63a  90 0c                              bcc RTS_1                ; PAST LINE, NOT FOUND
 1678 T:d63c  f0 0a                              beq RTS_1                ; IF FOUND
 1679 T:d63e  88                       L_FL1_2   dey                 ; 
 1680 T:d63f  b1 9b                              lda (LOWTR),Y                   ; 
 1681 T:d641  aa                                 tax                    ; 
 1682 T:d642  88                                 dey                    ; 
 1683 T:d643  b1 9b                              lda (LOWTR),Y                   ; 
 1684 T:d645  b0 d7                              bcs FL1             ; ALWAYS
 1685 T:d647  18                       L_FL1_3   clc                 ; RETURN CARRY = 0
 1686 T:d648  60                       RTS_1     rts 
 1687 T:d649                                    ; --------------------------------
 1688 T:d649                                    ; "NEW" STATEMENT
 1689 T:d649                                    ; --------------------------------
 1690 T:d649  d0 fd                    NEW       bne RTS_1          ; IGNORE IF MORE TO THE STATEMENT
 1691 T:d64b  a9 00                    SCRTCH    lda #0
 1692 T:d64d  85 d6                              sta LOCK
 1693 T:d64f  a8                                 tay 
 1694 T:d650  91 67                              sta (TXTTAB),Y
 1695 T:d652  c8                                 iny 
 1696 T:d653  91 67                              sta (TXTTAB),Y
 1697 T:d655  a5 67                              lda TXTTAB
 1698 T:d657  69 02                              adc #2             ; (CARRY WASN'T CLEARED, SO "NEW" USUALLY
 1699 T:d659  85 69                              sta VARTAB                ; ADDS 3, WHEREAS "FP" ADDS 2.)
 1700 T:d65b  85 af                              sta PRGEND
 1701 T:d65d  a5 68                              lda TXTTAB+1
 1702 T:d65f  69 00                              adc #0
 1703 T:d661  85 6a                              sta VARTAB+1
 1704 T:d663  85 b0                              sta PRGEND+1
 1705 T:d665                                    ; --------------------------------
 1706 T:d665                           SETPTRS   
 1707 T:d665  20 97 06                           jsr STXTPT                ; SET TXTPTR TO TXTTAB - 1
 1708 T:d668  a9 00                              lda #0             ; (THIS COULD HAVE BEEN ".HS 2C")
 1709 T:d66a                                    ; --------------------------------
 1710 T:d66a                                    ; "CLEAR" STATEMENT
 1711 T:d66a                                    ; --------------------------------
 1712 T:d66a  d0 2a                    CLEAR     bne RTS_2             ; IGNORE IF NOT AT END OF STATEMENT
 1713 T:d66c  a5 73                    CLEARC    lda MEMSIZ             ; CLEAR STRING AREA
 1714 T:d66e  a4 74                              ldy MEMSIZ+1          ; 
 1715 T:d670  85 6f                              sta FRETOP                ; 
 1716 T:d672  84 70                              sty FRETOP+1          ; 
 1717 T:d674  a5 69                              lda VARTAB                ; CLEAR ARRAY AREA
 1718 T:d676  a4 6a                              ldy VARTAB+1          ; 
 1719 T:d678  85 6b                              sta ARYTAB                ; 
 1720 T:d67a  84 6c                              sty ARYTAB+1          ; 
 1721 T:d67c  85 6d                              sta STREND                ; LOW END OF FREE SPACE
 1722 T:d67e  84 6e                              sty STREND+1          ; 
 1723 T:d680  20 49 08                           jsr RESTORE                ; SET "DATA" POINTER TO BEGINNING
 1724 T:d683                                    ; --------------------------------
 1725 T:d683  a2 55                    STKINI    ldx #TEMPST
 1726 T:d685  86 52                              stx TEMPPT
 1727 T:d687  68                                 pla                    ; SAVE RETURN ADDRESS
 1728 T:d688  a8                                 tay                    ; 
 1729 T:d689  68                                 pla                    ; 
 1730 T:d68a  a2 f8                              ldx #$f8             ; START STACK AT $F8,
 1731 T:d68c  9a                                 txs                    ; LEAVING ROOM FOR PARSING LINES
 1732 T:d68d  48                                 pha                    ; RESTORE RETURN ADDRESS
 1733 T:d68e  98                                 tya 
 1734 T:d68f  48                                 pha 
 1735 T:d690  a9 00                              lda #0
 1736 T:d692  85 7a                              sta OLDTEXT+1
 1737 T:d694  85 14                              sta SUBFLG
 1738 T:d696  60                       RTS_2     rts 
 1739 T:d697                                    ; --------------------------------
 1740 T:d697                                    ; SET TXTPTR TO BEGINNING OF PROGRAM
 1741 T:d697                                    ; --------------------------------
 1742 T:d697  18                       STXTPT    clc                 ; TXTPTR = TXTTAB - 1
 1743 T:d698  a5 67                              lda TXTTAB
 1744 T:d69a  69 ff                              adc #$ff
 1745 T:d69c  85 b8                              sta TXTPTR
 1746 T:d69e  a5 68                              lda TXTTAB+1
 1747 T:d6a0  69 ff                              adc #$ff
 1748 T:d6a2  85 b9                              sta TXTPTR+1
 1749 T:d6a4  60                                 rts 
 1750 T:d6a5                                    ; --------------------------------
 1751 T:d6a5                                    ; "LIST" STATEMENT
 1752 T:d6a5                                    ; --------------------------------
 1753 T:d6a5  90 0a                    LIST      bcc L_LIST_1             ; NO  LINE # SPECIFIED
 1754 T:d6a7  f0 08                              beq L_LIST_1                ; ---DITTO---
 1755 T:d6a9  c9 c9                              cmp #TOKEN_MINUS               ; IF DASH OR COMMA, START AT LINE 0
 1756 T:d6ab  f0 04                              beq L_LIST_1                ; IS IS A DASH
 1757 T:d6ad  c9 2c                              cmp #(","&%01111111)     ; COMMA?
 1758 T:d6af  d0 e5                              bne RTS_2             ; NO, ERROR
 1759 T:d6b1  20 0c 0a                 L_LIST_1  jsr LINGET             ; CONVERT LINE NUMBER IF ANY
 1760 T:d6b4  20 1a 06                           jsr FNDLIN             ; POINT LOWTR TO 1ST LINE
 1761 T:d6b7  20 b7 00                           jsr CHRGOT                ; RANGE SPECIFIED?
 1762 T:d6ba  f0 10                              beq L_LIST_3                ; NO
 1763 T:d6bc  c9 c9                              cmp #TOKEN_MINUS
 1764 T:d6be  f0 04                              beq L_LIST_2
 1765 T:d6c0  c9 2c                              cmp #(","&%01111111)
 1766 T:d6c2  d0 84                              bne RTS_1
 1767 T:d6c4  20 b1 00                 L_LIST_2  jsr CHRGET             ; GET NEXT CHAR
 1768 T:d6c7  20 0c 0a                           jsr LINGET                ; CONVERT SECOND LINE #
 1769 T:d6ca  d0 ca                              bne RTS_2             ; BRANCH IF SYNTAX ERR
 1770 T:d6cc  68                       L_LIST_3  pla                 ; POP RETURN ADRESS
 1771 T:d6cd  68                                 pla                    ; (GET BACK BY "JMP NEWSTT")
 1772 T:d6ce  a5 50                              lda LINNUM                ; IF NO SECOND NUMBER, USE $FFFF
 1773 T:d6d0  05 51                              ora LINNUM+1          ; 
 1774 T:d6d2  d0 06                              bne LIST_0                ; THERE WAS A SECOND NUMBER
 1775 T:d6d4  a9 ff                              lda #$ff             ; MAX END RANGE
 1776 T:d6d6  85 50                              sta LINNUM                ; 
 1777 T:d6d8  85 51                              sta LINNUM+1          ; 
 1778 T:d6da  a0 01                    LIST_0    ldy #1          ; 
 1779 T:d6dc  b1 9b                              lda (LOWTR),Y                   ; HIGH BYTE OF LINK
 1780 T:d6de  f0 44                              beq LIST_3                ; END OF PROGRAM
 1781 T:d6e0  20 58 08                           jsr ISCNTC                ; CHECK IF CONTROL-C HAS BEEN TYPED
 1782 T:d6e3  20 fb 0a                           jsr CRDO                ; NO, PRINT <RETURN>
 1783 T:d6e6  c8                                 iny                    ; 
