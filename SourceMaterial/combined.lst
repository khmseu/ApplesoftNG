 6445 T:f1b0  91 67                              sta (TXTTAB),Y                  ; FIRST BYTE IN PROGRAM SPACE = 0
 6446 T:f1b2  e6 67                              inc TXTTAB                ; ADVANCE PAST THE $00
 6447 T:f1b4  d0 02                              bne L_COLD_START_4                ; 
