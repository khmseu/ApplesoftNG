 4687 T:e752                                    ; CONVERT (FAC) TO A 16-BIT VALUE IN LINNUM
 4688 T:e752                                    ; --------------------------------
 4689 T:e752  a5 9d                    GETADR    lda FAC             ; FAC < 2^16?
 4690 T:e754  c9 91                              cmp #$91             ; 
 4691 T:e756  b0 9a                              bcs GOIQ             ; NO, ILLEGAL QUANTITY
 4692 T:e758  20 f2 1b                           jsr QINT                ; CONVERT TO INTEGER
 4693 T:e75b  a5 a0                              lda FAC+3          ; COPY IT INTO LINNUM
 4694 T:e75d  a4 a1                              ldy FAC+4          ; 
 4695 T:e75f  84 50                              sty LINNUM                ; TO LINNUM
 4696 T:e761  85 51                              sta LINNUM+1          ; 
