 6401 T:f15e  8a                                 txa                    ; A=0
 6402 T:f15f  85 a4                              sta SHIFT_SIGN_EXT
 6403 T:f161  85 54                              sta LASTPT+1
 6404 T:f163  48                                 pha                    ; PUT $00 ON STACK (WHAT FOR?)
 6405 T:f164  a9 03                              lda #3             ; SET LENGTH OF TEMP. STRING DESCRIPTORS
 6406 T:f166  85 8f                              sta DSCLEN                ; FOR GARBAGE COLLECTION SUBROUTINE
 6407 T:f168  20 fb 0a                           jsr CRDO             ; PRINT <RETURN>
 6408 T:f16b  a9 01                              lda #1             ; SET UP FAKE FORWARD LINK
 6409 T:f16d  8d fd 01                           sta INPUT_BUFFER-3
 6410 T:f170  8d fc 01                           sta INPUT_BUFFER-4
 6411 T:f173  a2 55                              ldx #TEMPST               ; INIT INDEX TO TEMP STRING DESCRIPTORS
 6412 T:f175  86 52                              stx TEMPPT
 6413 T:f177                                    ; --------------------------------
 6414 T:f177                                    ; FIND HIGH END OF RAM
 6415 T:f177                                    ; --------------------------------
 6416 T:f177  a9 00                              lda #<$0800            ; SET UP POINTER TO LOW END OF RAM
 6417 T:f179  a0 08                              ldy #>$0800
 6418 T:f17b  85 50                              sta LINNUM
 6419 T:f17d  84 51                              sty LINNUM+1
 6420 T:f17f  a0 00                              ldy #0
 6421 T:f181  e6 51                    L_COLD_START_2 inc LINNUM+1       ; TEST FIRST BYTE OF EACH PAGE
 6422 T:f183  b1 50                              lda (LINNUM),Y                  ; BY COMPLEMENTING IT AND WATCHING
 6423 T:f185  49 ff                              eor #$ff             ; IT CHANGE THE SAME WAY
 6424 T:f187  91 50                              sta (LINNUM),Y                  ; 
 6425 T:f189  d1 50                              cmp (LINNUM),Y                  ; ROM OR EMPTY SOCKETS WON'T TRACK
 6426 T:f18b  d0 08                              bne L_COLD_START_3                ; NOT RAM HERE
 6427 T:f18d  49 ff                              eor #$ff             ; RESTORE ORIGINAL VALUE
 6428 T:f18f  91 50                              sta (LINNUM),Y                  ; 
 6429 T:f191  d1 50                              cmp (LINNUM),Y                  ; DID IT TRACK AGAIN?
 6430 T:f193  f0 ec                              beq L_COLD_START_2             ; YES, STILL IN RAM
 6431 T:f195  a4 50                    L_COLD_START_3 ldy LINNUM             ; NO, END OF RAM
 6432 T:f197  a5 51                              lda LINNUM+1          ; 
 6433 T:f199  29 f0                              and #$f0             ; FORCE A MULTIPLE OF 4096 BYTES
 6434 T:f19b  84 73                              sty MEMSIZ                ; (BAD RAM MAY HAVE YIELDED NON-MULTIPLE)
 6435 T:f19d  85 74                              sta MEMSIZ+1          ; 
 6436 T:f19f  84 6f                              sty FRETOP                ; SET HIMEM AND BOTTOM OF STRINGS
 6437 T:f1a1  85 70                              sta FRETOP+1          ; 
 6438 T:f1a3  a2 00                              ldx #<$0800            ; SET PROGRAM POINTER TO $0800
 6439 T:f1a5  a0 08                              ldy #>$0800            ; 
 6440 T:f1a7  86 67                              stx TXTTAB                ; 
 6441 T:f1a9  84 68                              sty TXTTAB+1          ; 
 6442 T:f1ab  a0 00                              ldy #0             ; TURN OFF SEMI-SECRET LOCK FLAG
 6443 T:f1ad  84 d6                              sty LOCK                ; 
