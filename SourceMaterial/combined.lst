 3420 T:e07d                                    ; CHECK IF (A) IS ASCII LETTER A-Z
 3421 T:e07d                                    ; 
 3422 T:e07d                                    ; RETURN CARRY = 1 IF A-Z
 3423 T:e07d                                    ; = 0 IF NOT
 3424 T:e07d                                    ; 
 3425 T:e07d                                    ; <<<NOTE FASTER AND SHORTER CODE:    >>>
 3426 T:e07d                                    ; <<<    CMP #LOCHAR(`Z')+1  COMPARE HI END
 3427 T:e07d                                    ; <<<    BCS L_PTRGET4_1      ABOVE A-Z
 3428 T:e07d                                    ; <<<    CMP #LOCHAR(`A')    COMPARE LO END
 3429 T:e07d                                    ; <<<    RTS         C=0 IF LO, C=1 IF A-Z
 3430 T:e07d                                    ; <<<L_PTRGET4_1  CLC         C=0 IF HI
 3431 T:e07d                                    ; <<<    RTS
 3432 T:e07d                                    ; --------------------------------
 3433 T:e07d  c9 41                    ISLETC    cmp #("A"&%01111111)  ; COMPARE LO END
 3434 T:e07f  90 05                              bcc L_ISLETC_1                ; C=0 IF LOW
 3435 T:e081  e9 5b                              sbc #("Z"&%01111111)+1; PREPARE HI END TEST
 3436 T:e083  38                                 sec                    ; TEST HI END, RESTORING (A)
 3437 T:e084  e9 a5                              sbc #255-'Z'       ; C=0 IF LO, C=1 IF A-Z
 3438 T:e086  60                       L_ISLETC_1 rts 
