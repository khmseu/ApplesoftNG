 4290 T:e532  d0 1e                              bne CHECK_BUMP                ; YES, ABOVE FRETOP
 4291 T:e534  e4 6f                              cpx FRETOP                ; MAYBE, CHECK LO-BYTE
 4292 T:e536  b0 1a                              bcs CHECK_BUMP                ; YES, ABOVE FRETOP
 4293 T:e538  c5 9c                    L_CHECK_VARIABLE_1 cmp LOWTR+1       ; ABOVE HIGHEST STRING FOUND?
 4294 T:e53a  90 16                              bcc CHECK_BUMP                ; NO, IGNORE FOR NOW
 4295 T:e53c  d0 04                              bne L_CHECK_VARIABLE_2                ; YES, THIS IS THE NEW HIGHEST
 4296 T:e53e  e4 9b                              cpx LOWTR                ; MAYBE, TRY LO-BYTE
 4297 T:e540  90 10                              bcc CHECK_BUMP                ; NO, IGNORE FOR NOW
 4298 T:e542  86 9b                    L_CHECK_VARIABLE_2 stx LOWTR             ; MAKE THIS THE HIGHEST STRING
