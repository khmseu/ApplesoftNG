 5486 T:ebb8  b1 60                              lda (DEST),Y                    ; 
 5487 T:ebba  c8                                 iny                    ; POINT AT NEXT BYTE
 5488 T:ebbb  aa                                 tax                    ; EXPONENT TO X-REG
 5489 T:ebbc  f0 c4                              beq SIGN             ; IF COMPARAND=0, "SIGN" COMPARES FAC
 5490 T:ebbe  b1 60                              lda (DEST),Y                    ; GET HI-BYTE OF MANTISSA
 5491 T:ebc0  45 a2                              eor FAC_SIGN                ; COMPARE WITH FAC SIGN
 5492 T:ebc2  30 c2                              bmi SIGN1             ; DIFFERENT SIGNS, "SIGN" GIVES ANSWER
 5493 T:ebc4  e4 9d                              cpx FAC                ; SAME SIGN, SO COMPARE EXPONENTS
