 5521 T:ebf2                                    ; QUICK INTEGER FUNCTION
 5522 T:ebf2                                    ; 
 5523 T:ebf2                                    ; CONVERTS FP VALUE IN FAC TO INTEGER VALUE
 5524 T:ebf2                                    ; IN FAC+1...FAC+4, BY SHIFTING RIGHT WITH SIGN
 5525 T:ebf2                                    ; EXTENSION UNTIL FRACTIONAL BITS ARE OUT.
 5526 T:ebf2                                    ; 
 5527 T:ebf2                                    ; THIS SUBROUTINE ASSUMES THE EXPONENT < 32.
 5528 T:ebf2                                    ; --------------------------------
 5529 T:ebf2  a5 9d                    QINT      lda FAC             ; LOOK AT FAC EXPONENT
 5530 T:ebf4  f0 4a                              beq QINT_3                ; FAC=0, SO FINISHED
 5531 T:ebf6  38                                 sec                    ; GET -(NUMBER OF FRACTIONAL BITS)
 5532 T:ebf7  e9 a0                              sbc #$a0             ; IN A-REG FOR SHIFT COUNT
 5533 T:ebf9  24 a2                              bit FAC_SIGN                ; CHECK SIGN OF FAC
 5534 T:ebfb  10 09                              bpl L_QINT_1                ; POSITIVE, CONTINUE
 5535 T:ebfd  aa                                 tax                    ; NEGATIVE, SO COMPLEMENT MANTISSA
 5536 T:ebfe  a9 ff                              lda #$ff             ; AND SET SIGN EXTENSION FOR SHIFT
 5537 T:ec00  85 a4                              sta SHIFT_SIGN_EXT
 5538 T:ec02  20 a4 18                           jsr COMPLEMENT_FAC_MANTISSA
 5539 T:ec05  8a                                 txa                    ; RESTORE BIT COUNT TO A-REG
 5540 T:ec06  a2 9d                    L_QINT_1  ldx #FAC            ; POINT SHIFT SUBROUTINE AT FAC
 5541 T:ec08  c9 f9                              cmp #$f9             ; MORE THAN 7 BITS TO SHIFT?
 5542 T:ec0a  10 06                              bpl QINT_2                ; NO, SHORT SHIFT
 5543 T:ec0c  20 f0 18                           jsr SHIFT_RIGHT             ; YES, USE GENERAL ROUTINE
 5544 T:ec0f  84 a4                              sty SHIFT_SIGN_EXT                ; Y=0, CLEAR SIGN EXTENSION
 5545 T:ec11  60                       RTS_16    rts 
 5546 T:ec12                                    ; --------------------------------
 5547 T:ec12  a8                       QINT_2    tay                 ; SAVE SHIFT COUNT
 5548 T:ec13  a5 a2                              lda FAC_SIGN                ; GET SIGN BIT
 5549 T:ec15  29 80                              and #$80             ; 
 5550 T:ec17  46 9e                              lsr FAC+1          ; START RIGHT SHIFT
 5551 T:ec19  05 9e                              ora FAC+1          ; AND MERGE WITH SIGN
 5552 T:ec1b  85 9e                              sta FAC+1
 5553 T:ec1d  20 07 19                           jsr SHIFT_RIGHT_4             ; JUMP INTO MIDDLE OF SHIFTER
 5554 T:ec20  84 a4                              sty SHIFT_SIGN_EXT                ; Y=0, CLEAR SIGN EXTENSION
 5555 T:ec22  60                                 rts 
