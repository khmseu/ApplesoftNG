 6462 T:f1d5                                    ; --------------------------------
 6463 T:f1d5                                    ; --------------------------------
 6464 T:f1d5                                    ; "CALL" STATEMENT
 6465 T:f1d5                                    ; 
 6466 T:f1d5                                    ; EFFECTIVELY PERFORMS A "JSR" TO THE SPECIFIED
 6467 T:f1d5                                    ; ADDRESS, WITH THE FOLLOWING REGISTER CONTENTS:
 6468 T:f1d5                                    ; (A,Y) = CALL ADDRESS
 6469 T:f1d5                                    ; (X)   = $9D
 6470 T:f1d5                                    ; 
 6471 T:f1d5                                    ; THE CALLED ROUTINE CAN RETURN WITH "RTS",
 6472 T:f1d5                                    ; AND APPLESOFT WILL CONTINUE WITH THE NEXT
 6473 T:f1d5                                    ; STATEMENT.
 6474 T:f1d5                                    ; --------------------------------
 6475 T:f1d5  20 67 0d                 CALL      jsr FRMNUM          ; EVALUATE EXPRESSION FOR CALL ADDRESS
 6476 T:f1d8  20 52 17                           jsr GETADR             ; CONVERT EXPRESSION TO 16-BIT INTEGER
 6477 T:f1db  6c 50 00                           jmp (LINNUM)              ; IN LINNUM, AND JUMP THERE.
 6478 T:f1de                                    ; --------------------------------
 6479 T:f1de                                    ; "IN#" STATEMENT
 6480 T:f1de                                    ; 
 6481 T:f1de                                    ; NOTE:  NO CHECK FOR VALID SLOT #, AS LONG
 6482 T:f1de                                    ; AS VALUE IS < 256 IT IS ACCEPTED.
 6483 T:f1de                                    ; MONITOR MASKS VALUE TO 4 BITS (0-15).
 6484 T:f1de                                    ; --------------------------------
 6485 T:f1de                           IN_NUMBER 
 6486 T:f1de  20 f8 16                           jsr GETBYT             ; GET SLOT NUMBER IN X-REG
 6487 T:f1e1  8a                                 txa                    ; MONITOR WILL INSTALL IN VECTOR
 6488 T:f1e2  4c 8b fe                           jmp MON_INPORT                ; AT $38,39.
 6489 T:f1e5                                    ; --------------------------------
 6490 T:f1e5                                    ; "PR#" STATEMENT
 6491 T:f1e5                                    ; 
 6492 T:f1e5                                    ; NOTE:  NO CHECK FOR VALID SLOT #, AS LONG
 6493 T:f1e5                                    ; AS VALUE IS < 256 IT IS ACCEPTED.
 6494 T:f1e5                                    ; MONITOR MASKS VALUE TO 4 BITS (0-15).
 6495 T:f1e5                                    ; --------------------------------
 6496 T:f1e5                           PR_NUMBER 
 6497 T:f1e5  20 f8 16                           jsr GETBYT             ; GET SLOT NUMBER IN X-REG
 6498 T:f1e8  8a                                 txa                    ; MONITOR WILL INSTALL IN VECTOR
 6499 T:f1e9  4c 95 fe                           jmp MON_OUTPORT                ; AT $36,37
 6500 T:f1ec                                    ; --------------------------------
 6501 T:f1ec                                    ; GET TWO VALUES < 48, WITH COMMA SEPARATOR
 6502 T:f1ec                                    ; 
 6503 T:f1ec                                    ; CALLED FOR "PLOT X,Y"
 6504 T:f1ec                                    ; AND "HLIN A,B AT Y"
 6505 T:f1ec                                    ; AND "VLIN A,B AT X"
 6506 T:f1ec                                    ; 
 6507 T:f1ec                                    ; --------------------------------
 6508 T:f1ec                           PLOTFNS   
 6509 T:f1ec  20 f8 16                           jsr GETBYT             ; GET FIRST VALUE IN X-REG
 6510 T:f1ef  e0 30                              cpx #48             ; MUST BE < 48
 6511 T:f1f1  b0 13                              bcs GOERR                ; TOO LARGE
 6512 T:f1f3  86 f0                              stx FIRST                ; SAVE FIRST VALUE
 6513 T:f1f5  a9 2c                              lda #(","&%01111111)     ; MUST HAVE A COMMA
 6514 T:f1f7  20 c0 0e                           jsr SYNCHR             ; 
 6515 T:f1fa  20 f8 16                           jsr GETBYT             ; GET SECOND VALUE IN X-REG
 6516 T:f1fd  e0 30                              cpx #48             ; MUST BE < 48
 6517 T:f1ff  b0 05                              bcs GOERR                ; TOO LARGE
 6518 T:f201  86 2c                              stx MON_H2                ; SAVE SECOND VALUE
 6519 T:f203  86 2d                              stx MON_V2                ; 
 6520 T:f205  60                                 rts                    ; SECOND VALUE STILL IN X-REG
 6521 T:f206                                    ; --------------------------------
 6522 T:f206  4c 99 11                 GOERR     jmp IQERR          ; ILLEGAL QUANTITY ERROR
 6523 T:f209                                    ; --------------------------------
 6524 T:f209                                    ; GET "A,B AT C" VALUES FOR "HLIN" AND "VLIN"
 6525 T:f209                                    ; 
 6526 T:f209                                    ; PUT SMALLER OF (A,B) IN FIRST,
 6527 T:f209                                    ; AND LARGER  OF (A,B) IN H2 AND V2.
 6528 T:f209                                    ; RETURN WITH (X) = C-VALUE.
 6529 T:f209                                    ; --------------------------------
 6530 T:f209                           LINCOOR   
 6531 T:f209  20 ec 21                           jsr PLOTFNS             ; GET A,B VALUES
 6532 T:f20c  e4 f0                              cpx FIRST                ; IS A < B?
 6533 T:f20e  b0 08                              bcs L_LINCOOR_1                ; YES, IN RIGHT ORDER
 6534 T:f210  a5 f0                              lda FIRST                ; NO, INTERCHANGE THEM
 6535 T:f212  85 2c                              sta MON_H2                ; 
 6536 T:f214  85 2d                              sta MON_V2                ; 
 6537 T:f216  86 f0                              stx FIRST                ; 
 6538 T:f218  a9 c5                    L_LINCOOR_1 lda #TOKENDB            ; MUST HAVE "AT" NEXT
 6539 T:f21a  20 c0 0e                           jsr SYNCHR             ; 
 6540 T:f21d  20 f8 16                           jsr GETBYT             ; GET C-VALUE IN X-REG
 6541 T:f220  e0 30                              cpx #48             ; MUST BE < 48
 6542 T:f222  b0 e2                              bcs GOERR             ; TOO LARGE
 6543 T:f224  60                                 rts                    ; C-VALUE IN X-REG
 6544 T:f225                                    ; --------------------------------
 6545 T:f225                                    ; "PLOT" STATEMENT
 6546 T:f225                                    ; --------------------------------
 6547 T:f225  20 ec 21                 PLOT      jsr PLOTFNS          ; GET X,Y VALUES
 6548 T:f228  8a                                 txa                    ; Y-COORD TO A-REG FOR MONITOR
 6549 T:f229  a4 f0                              ldy FIRST                ; X-COORD TO Y-YEG FOR MONITOR
 6550 T:f22b  c0 28                              cpy #40             ; X-COORD MUST BE < 40
 6551 T:f22d  b0 d7                              bcs GOERR             ; X-COORD IS TOO LARGE
 6552 T:f22f  4c 00 f8                           jmp MON_PLOT                ; PLOT!
 6553 T:f232                                    ; --------------------------------
 6554 T:f232                                    ; "HLIN" STATEMENT
 6555 T:f232                                    ; --------------------------------
 6556 T:f232  20 09 22                 HLIN      jsr LINCOOR          ; GET "A,B AT C"
 6557 T:f235  8a                                 txa                    ; Y-COORD IN A-REG
 6558 T:f236  a4 2c                              ldy MON_H2                ; RIGHT END OF LINE
 6559 T:f238  c0 28                              cpy #40             ; MUST BE < 40
 6560 T:f23a  b0 ca                              bcs GOERR             ; TOO LARGE
 6561 T:f23c  a4 f0                              ldy FIRST                ; LEFT END OF LINE IN Y-REG
 6562 T:f23e  4c 19 f8                           jmp MON_HLINE                ; LET MONITOR DRAW LINE
 6563 T:f241                                    ; --------------------------------
 6564 T:f241                                    ; "VLIN" STATEMENT
 6565 T:f241                                    ; --------------------------------
 6566 T:f241  20 09 22                 VLIN      jsr LINCOOR          ; GET "A,B AT C"
 6567 T:f244  8a                                 txa                    ; X-COORD IN Y-REG
 6568 T:f245  a8                                 tay                    ; 
 6569 T:f246  c0 28                              cpy #40             ; X-COORD MUST BE < 40
 6570 T:f248  b0 bc                              bcs GOERR             ; TOO LARGE
 6571 T:f24a  a5 f0                              lda FIRST                ; TOP END OF LINE IN A-REG
 6572 T:f24c  4c 28 f8                           jmp MON_VLINE                ; LET MONITOR DRAW LINE
 6573 T:f24f                                    ; --------------------------------
 6574 T:f24f                                    ; "COLOR=" STATEMENT
