 6387 T:f150                                    ; MOVE GENERIC CHRGET AND RANDOM SEED INTO PLACE
 6388 T:f150                                    ; 
 6389 T:f150                                    ; <<< NOTE THAT LOOP VALUE IS WRONG!          >>>
 6390 T:f150                                    ; <<< THE LAST BYTE OF THE RANDOM SEED IS NOT >>>
 6391 T:f150                                    ; <<< COPIED INTO PAGE ZERO!                  >>>
 6392 T:f150                                    ; --------------------------------
 6393 T:f150  a2 1c                              ldx #GENERIC_END-GENERIC_CHRGET-1
 6394 T:f152  bd 0a 21                 L_COLD_START_1 lda GENERIC_CHRGET-1,X
 6395 T:f155  95 b0                              sta CHRGET-1,X
