 3834 T:e2ad                                    ; USED ONLY BY ARRAY SUBSCRIPT ROUTINES
 3835 T:e2ad                                    ; --------------------------------
 3836 T:e2ad                           MULTIPLY_SUBSCRIPT 
 3837 T:e2ad  84 5e                              sty INDEX                ; SAVE Y-REG
 3838 T:e2af  b1 9b                              lda (LOWTR),Y                   ; GET MULTIPLIER
 3839 T:e2b1  85 64                              sta RESULT+2          ; SAVE IN RESULT+2,3
 3840 T:e2b3  88                                 dey                    ; 
 3841 T:e2b4  b1 9b                              lda (LOWTR),Y                   ; 
