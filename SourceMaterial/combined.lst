 2959 T:ddf6  d9 b2 00                 PREFNC    cmp MATHTBL,Y
 2960 T:ddf9  b0 48                              bcs FRM_PERFORM_2                ; DO NOW IF HIGHER PRECEDENCE
 2961 T:ddfb  90 d9                              bcc NXOP             ; ...ALWAYS
