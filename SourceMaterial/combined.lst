 7393 T:f6b9                                    ; GET HI-RES PLOTTING COORDINATES (0-279,0-191) FROM
 7394 T:f6b9                                    ; TXTPTR.  LEAVE REGISTERS SET UP FOR HPOSN:
 7395 T:f6b9                                    ; (Y,X)=X-COORD
 7396 T:f6b9                                    ; (A)  =Y-COORD
 7397 T:f6b9                                    ; --------------------------------
 7398 T:f6b9  20 67 0d                 HFNS      jsr FRMNUM          ; EVALUATE EXPRESSION, MUST BE NUMERIC
 7399 T:f6bc  20 52 17                           jsr GETADR             ; CONVERT TO 2-BYTE INTEGER IN LINNUM
 7400 T:f6bf  a4 51                              ldy LINNUM+1          ; GET HORIZ COOR IN X,Y
 7401 T:f6c1  a6 50                              ldx LINNUM                ; 
 7402 T:f6c3  c0 01                              cpy #>280            ; MAKE SURE IT IS < 280
 7403 T:f6c5  90 06                              bcc L_HFNS_1                ; IN RANGE
 7404 T:f6c7  d0 1d                              bne GGERR                ; 
 7405 T:f6c9  e0 18                              cpx #<280            ; 
 7406 T:f6cb  b0 19                              bcs GGERR                ; 
 7407 T:f6cd  8a                       L_HFNS_1  txa                 ; SAVE HORIZ COOR ON STACK
 7408 T:f6ce  48                                 pha                    ; 
 7409 T:f6cf  98                                 tya                    ; 
 7410 T:f6d0  48                                 pha                    ; 
 7411 T:f6d1  a9 2c                              lda #(","&%01111111)     ; REQUIRE A COMMA
 7412 T:f6d3  20 c0 0e                           jsr SYNCHR             ; 
 7413 T:f6d6  20 f8 16                           jsr GETBYT             ; EVAL EXP TO SINGLE BYTE IN X-REG
 7414 T:f6d9  e0 c0                              cpx #192             ; CHECK FOR RANGE
 7415 T:f6db  b0 09                              bcs GGERR                ; TOO BIG
 7416 T:f6dd  86 9d                              stx FAC                ; SAVE Y-COORD
 7417 T:f6df  68                                 pla                    ; RETRIEVE HORIZONTAL COORDINATE
 7418 T:f6e0  a8                                 tay                    ; 
 7419 T:f6e1  68                                 pla                    ; 
 7420 T:f6e2  aa                                 tax                    ; 
 7421 T:f6e3  a5 9d                              lda FAC                ; AND VERTICAL COORDINATE
 7422 T:f6e5  60                                 rts                    ; 
 7423 T:f6e6                                    ; --------------------------------
 7424 T:f6e6  4c 06 22                 GGERR     jmp GOERR          ; ILLEGAL QUANTITY ERROR
