 2977 T:de10                                    ; STACK (FAC)
 2978 T:de10                                    ; 
 2979 T:de10                                    ; THREE ENTRY POINTS:
 2980 T:de10                                    ; L_SNTXERR_1, FROM FRMEVL
 2981 T:de10                                    ; L_SNTXERR_2, FROM "STEP"
