 4826 T:e829  b0 03                              bcs NORMALIZE_FAC_2
 4827 T:e82b  20 9e 18                           jsr COMPLEMENT_FAC
 4828 T:e82e                                    ; --------------------------------
 4829 T:e82e                           NORMALIZE_FAC_2 
 4830 T:e82e  a0 00                              ldy #0             ; SHIFT UP SIGNIF DIGIT
 4831 T:e830  98                                 tya                    ; START A=0, COUNT SHIFTS IN A-REG
 4832 T:e831  18                                 clc 
 4833 T:e832  a6 9e                    L_NORMALIZE_FAC_2_1 ldx FAC+1       ; LOOK AT MOST SIGNIFICANT BYTE
 4834 T:e834  d0 4a                              bne NORMALIZE_FAC_4                ; SOME 1-BITS HERE
 4835 T:e836  a6 9f                              ldx FAC+2          ; HI-BYTE OF MANTISSA STILL ZERO,
 4836 T:e838  86 9e                              stx FAC+1          ; SO DO A FAST 8-BIT SHUFFLE
 4837 T:e83a  a6 a0                              ldx FAC+3
 4838 T:e83c  86 9f                              stx FAC+2
 4839 T:e83e  a6 a1                              ldx FAC+4
 4840 T:e840  86 a0                              stx FAC+3
 4841 T:e842  a6 ac                              ldx FAC_EXTENSION
 4842 T:e844  86 a1                              stx FAC+4
