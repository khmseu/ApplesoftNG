 7217 T:f5ba                                    ; TABLE OF COS(90*X/16 DEGREES)*$100 - 1
 7218 T:f5ba                                    ; WITH ONE BYTE PRECISION, X=0 TO 16:
 7219 T:f5ba                                    ; --------------------------------
 7220 T:f5ba  ff fe fa f4 ec e1 d4 c5  COSINE_TABLE .byt $ff,$fe,$fa,$f4,$ec,$e1,$d4,$c5
 7221 T:f5c2  b4 a1 8d 78 61 49 31 18            .byt $b4,$a1,$8d,$78,$61,$49,$31,$18
 7222 T:f5ca  ff                                 .byt $ff
 7223 T:f5cb                                    ; --------------------------------
 7224 T:f5cb                                    ; HFIND -- CALCULATES CURRENT POSITION OF HI-RES CURSOR
 7225 T:f5cb                                    ; (NOT CALLED BY ANY APPLESOFT ROUTINE)
 7226 T:f5cb                                    ; 
 7227 T:f5cb                                    ; CALCULATE Y-COORD FROM GBASL,H
 7228 T:f5cb                                    ; AND X-COORD FROM HORIZ AND HMASK
 7229 T:f5cb                                    ; --------------------------------
 7230 T:f5cb  a5 26                    HFIND     lda MON_GBASL             ; GBASL = EABAB000
 7231 T:f5cd  0a                                 asl                    ; E INTO CARRY
 7232 T:f5ce  a5 27                              lda MON_GBASH                ; GBASH = PPPFGHCD
 7233 T:f5d0  29 03                              and #3             ; 000000CD
 7234 T:f5d2  2a                                 rol                    ; 00000CDE
 7235 T:f5d3  05 26                              ora MON_GBASL                ; EABABCDE
 7236 T:f5d5  0a                                 asl                    ; ABABCDE0
 7237 T:f5d6  0a                                 asl                    ; BABCDE00
 7238 T:f5d7  0a                                 asl                    ; ABCDE000
 7239 T:f5d8  85 e2                              sta HGR_Y                ; ALL BUT FGH
 7240 T:f5da  a5 27                              lda MON_GBASH                ; PPPFGHCD
 7241 T:f5dc  4a                                 lsr                    ; 0PPPFGHC
 7242 T:f5dd  4a                                 lsr                    ; 00PPPFGH
 7243 T:f5de  29 07                              and #7             ; 00000FGH
 7244 T:f5e0  05 e2                              ora HGR_Y                ; ABCDEFGH
 7245 T:f5e2  85 e2                              sta HGR_Y                ; THAT TAKES CARE OF Y-COORDINATE!
 7246 T:f5e4  a5 e5                              lda HGR_HORIZ                ; X = 7*HORIZ + BIT POS. IN HMASK
 7247 T:f5e6  0a                                 asl                    ; MULTIPLY BY 7
 7248 T:f5e7  65 e5                              adc HGR_HORIZ                ; 3* SO FAR
 7249 T:f5e9  0a                                 asl                    ; 6*
 7250 T:f5ea  aa                                 tax                    ; SINCE 7* MIGHT NOT FIT IN 1 BYTE,
 7251 T:f5eb                                    ; WAIT TILL LATER FOR LAST ADD
 7252 T:f5eb  ca                                 dex                    ; 
 7253 T:f5ec  a5 30                              lda MON_HMASK                ; NOW FIND BIT POSITION IN HMASK
 7254 T:f5ee  29 7f                              and #$7f             ; ONLY LOOK AT LOW SEVEN
 7255 T:f5f0  e8                       L_HFIND_1 inx                 ; COUNT A SHIFT
 7256 T:f5f1  4a                                 lsr                    ; 
 7257 T:f5f2  d0 fc                              bne L_HFIND_1             ; STILL IN THERE
 7258 T:f5f4  85 e1                              sta HGR_X+1          ; ZERO TO HI-BYTE
 7259 T:f5f6  8a                                 txa                    ; 6*HORIZ+LOG2(HMASK)
 7260 T:f5f7  18                                 clc                    ; ADD HORIZ ONE MORE TIME
 7261 T:f5f8  65 e5                              adc HGR_HORIZ                ; 7*HORIZ+LOG2(HMASK)
 7262 T:f5fa  90 02                              bcc L_HFIND_2                ; UPPER BYTE = 0
 7263 T:f5fc  e6 e1                              inc HGR_X+1          ; UPPER BYTE = 1
 7264 T:f5fe  85 e0                    L_HFIND_2 sta HGR_X             ; STORE LOWER BYTE
 7265 T:f600  60                       RTS_22    rts 
 7266 T:f601                                    ; --------------------------------
 7267 T:f601                                    ; DRAW A SHAPE
 7268 T:f601                                    ; 
 7269 T:f601                                    ; (Y,X) = SHAPE STARTING ADDRESS
 7270 T:f601                                    ; (A)   = ROTATION (0-3F)
 7271 T:f601                                    ; --------------------------------
 7272 T:f601                                    ; APPLESOFT DOES NOT CALL DRAW0
 7273 T:f601                                    ; --------------------------------
 7274 T:f601  86 1a                    DRAW0     stx HGR_SHAPE             ; SAVE SHAPE ADDRESS
 7275 T:f603  84 1b                              sty HGR_SHAPE+1
 7276 T:f605                                    ; --------------------------------
 7277 T:f605                                    ; APPLESOFT ENTERS HERE
 7278 T:f605                                    ; --------------------------------
 7279 T:f605  aa                       DRAW1     tax                 ; SAVE ROTATION (0-$3F)
 7280 T:f606  4a                                 lsr                    ; DIVIDE ROTATION BY 16 TO GET
 7281 T:f607  4a                                 lsr                    ; QUADRANT (0=UP, 1=RT, 2=DWN, 3=LFT)
 7282 T:f608  4a                                 lsr 
 7283 T:f609  4a                                 lsr 
 7284 T:f60a  85 d3                              sta HGR_QUADRANT
 7285 T:f60c  8a                                 txa                    ; USE LOW 4 BITS OF ROTATION TO INDEX
 7286 T:f60d  29 0f                              and #$0f             ; THE TRIG TABLE
 7287 T:f60f  aa                                 tax 
 7288 T:f610  bc ba 25                           ldy COSINE_TABLE,X              ; SAVE COSINE IN HGR.DX
 7289 T:f613  84 d0                              sty HGR_DX                ; 
 7290 T:f615  49 0f                              eor #$0f             ; AND SINE IN DY
 7291 T:f617  aa                                 tax 
 7292 T:f618  bc bb 25                           ldy COSINE_TABLE+1,X
 7293 T:f61b  c8                                 iny 
 7294 T:f61c  84 d2                              sty HGR_DY
 7295 T:f61e  a4 e5                              ldy HGR_HORIZ                ; INDEX FROM GBASL,H TO BYTE WE'RE IN
 7296 T:f620  a2 00                              ldx #0
 7297 T:f622  86 ea                              stx HGR_COLLISIONS                ; CLEAR COLLISION COUNTER
 7298 T:f624  a1 1a                              lda (HGR_SHAPE,X)               ; GET FIRST BYTE OF SHAPE DEFN
 7299 T:f626  85 d1                    L_DRAW1_1 sta HGR_DX+1       ; KEEP SHAPE BYTE IN HGR.DX+1
 7300 T:f628  a2 80                              ldx #$80             ; INITIAL VALUES FOR FRACTIONAL VECTORS
 7301 T:f62a  86 d4                              stx HGR_E                ; L_DRAW1_5 IN COSINE COMPONENT
 7302 T:f62c  86 d5                              stx HGR_E+1          ; L_DRAW1_5 IN SINE COMPONENT
 7303 T:f62e  a6 e7                              ldx HGR_SCALE                ; SCALE FACTOR
 7304 T:f630  a5 d4                    L_DRAW1_2 lda HGR_E             ; ADD COSINE VALUE TO X-VALUE
 7305 T:f632  38                                 sec                    ; IF >= 1, THEN DRAW
 7306 T:f633  65 d0                              adc HGR_DX                ; 
 7307 T:f635  85 d4                              sta HGR_E                ; ONLY SAVE FRACTIONAL PART
 7308 T:f637  90 04                              bcc L_DRAW1_3                ; NO INTEGRAL PART
 7309 T:f639  20 b3 24                           jsr LRUD1             ; TIME TO PLOT COSINE COMPONENT
 7310 T:f63c  18                                 clc                    ; 
 7311 T:f63d  a5 d5                    L_DRAW1_3 lda HGR_E+1       ; ADD SINE VALUE TO Y-VALUE
 7312 T:f63f  65 d2                              adc HGR_DY                ; IF >= 1, THEN DRAW
 7313 T:f641  85 d5                              sta HGR_E+1          ; ONLY SAVE FRACTIONAL PART
 7314 T:f643  90 03                              bcc L_DRAW1_4                ; NO INTEGRAL PART
 7315 T:f645  20 b4 24                           jsr LRUD2             ; TIME TO PLOT SINE COMPONENT
 7316 T:f648  ca                       L_DRAW1_4 dex                 ; LOOP ON SCALE FACTOR.
 7317 T:f649  d0 e5                              bne L_DRAW1_2             ; STILL ON SAME SHAPE ITEM
 7318 T:f64b  a5 d1                              lda HGR_DX+1          ; GET NEXT SHAPE ITEM
 7319 T:f64d  4a                                 lsr                    ; NEXT 3 BIT VECTOR
 7320 T:f64e  4a                                 lsr                    ; 
 7321 T:f64f  4a                                 lsr                    ; 
 7322 T:f650  d0 d4                              bne L_DRAW1_1             ; MORE IN THIS SHAPE BYTE
 7323 T:f652  e6 1a                              inc HGR_SHAPE                ; GO TO NEXT SHAPE BYTE
 7324 T:f654  d0 02                              bne L_DRAW1_5
 7325 T:f656  e6 1b                              inc HGR_SHAPE+1
 7326 T:f658  a1 1a                    L_DRAW1_5 lda (HGR_SHAPE,X)               ; NEXT BYTE OF SHAPE DEFINITION
 7327 T:f65a  d0 ca                              bne L_DRAW1_1             ; PROCESS IF NOT ZERO
 7328 T:f65c  60                                 rts                    ; FINISHED
 7329 T:f65d                                    ; --------------------------------
 7330 T:f65d                                    ; XDRAW A SHAPE (SAME AS DRAW, EXCEPT TOGGLES SCREEN)
 7331 T:f65d                                    ; 
 7332 T:f65d                                    ; (Y,X) = SHAPE STARTING ADDRESS
 7333 T:f65d                                    ; (A)   = ROTATION (0-3F)
 7334 T:f65d                                    ; --------------------------------
 7335 T:f65d                                    ; APPLESOFT DOES NOT CALL XDRAW0
 7336 T:f65d                                    ; --------------------------------
 7337 T:f65d  86 1a                    XDRAW0    stx HGR_SHAPE             ; SAVE SHAPE ADDRESS
 7338 T:f65f  84 1b                              sty HGR_SHAPE+1
 7339 T:f661                                    ; --------------------------------
 7340 T:f661                                    ; APPLESOFT ENTERS HERE
 7341 T:f661                                    ; --------------------------------
 7342 T:f661  aa                       XDRAW1    tax                 ; SAVE ROTATION (0-$3F)
 7343 T:f662  4a                                 lsr                    ; DIVIDE ROTATION BY 16 TO GET
 7344 T:f663  4a                                 lsr                    ; QUADRANT (0=UP, 1=RT, 2=DWN, 3=LFT)
 7345 T:f664  4a                                 lsr 
 7346 T:f665  4a                                 lsr 
 7347 T:f666  85 d3                              sta HGR_QUADRANT
 7348 T:f668  8a                                 txa                    ; USE LOW 4 BITS OF ROTATION TO INDEX
 7349 T:f669  29 0f                              and #$0f             ; THE TRIG TABLE
 7350 T:f66b  aa                                 tax 
 7351 T:f66c  bc ba 25                           ldy COSINE_TABLE,X              ; SAVE COSINE IN HGR.DX
 7352 T:f66f  84 d0                              sty HGR_DX                ; 
 7353 T:f671  49 0f                              eor #$0f             ; AND SINE IN DY
 7354 T:f673  aa                                 tax 
 7355 T:f674  bc bb 25                           ldy COSINE_TABLE+1,X
 7356 T:f677  c8                                 iny 
 7357 T:f678  84 d2                              sty HGR_DY
 7358 T:f67a  a4 e5                              ldy HGR_HORIZ                ; INDEX FROM GBASL,H TO BYTE WE'RE IN
 7359 T:f67c  a2 00                              ldx #0
 7360 T:f67e  86 ea                              stx HGR_COLLISIONS                ; CLEAR COLLISION COUNTER
 7361 T:f680  a1 1a                              lda (HGR_SHAPE,X)               ; GET FIRST BYTE OF SHAPE DEFN
 7362 T:f682  85 d1                    L_XDRAW1_1 sta HGR_DX+1       ; KEEP SHAPE BYTE IN HGR.DX+1
 7363 T:f684  a2 80                              ldx #$80             ; INITIAL VALUES FOR FRACTIONAL VECTORS
 7364 T:f686  86 d4                              stx HGR_E                ; L_XDRAW1_5 IN COSINE COMPONENT
 7365 T:f688  86 d5                              stx HGR_E+1          ; L_XDRAW1_5 IN SINE COMPONENT
 7366 T:f68a  a6 e7                              ldx HGR_SCALE                ; SCALE FACTOR
 7367 T:f68c  a5 d4                    L_XDRAW1_2 lda HGR_E             ; ADD COSINE VALUE TO X-VALUE
 7368 T:f68e  38                                 sec                    ; IF >= 1, THEN DRAW
 7369 T:f68f  65 d0                              adc HGR_DX                ; 
 7370 T:f691  85 d4                              sta HGR_E                ; ONLY SAVE FRACTIONAL PART
 7371 T:f693  90 04                              bcc L_XDRAW1_3                ; NO INTEGRAL PART
 7372 T:f695  20 9c 24                           jsr LRUDX1             ; TIME TO PLOT COSINE COMPONENT
 7373 T:f698  18                                 clc                    ; 
 7374 T:f699  a5 d5                    L_XDRAW1_3 lda HGR_E+1       ; ADD SINE VALUE TO Y-VALUE
 7375 T:f69b  65 d2                              adc HGR_DY                ; IF >= 1, THEN DRAW
 7376 T:f69d  85 d5                              sta HGR_E+1          ; ONLY SAVE FRACTIONAL PART
 7377 T:f69f  90 03                              bcc L_XDRAW1_4                ; NO INTEGRAL PART
 7378 T:f6a1  20 9d 24                           jsr LRUDX2             ; TIME TO PLOT SINE COMPONENT
 7379 T:f6a4  ca                       L_XDRAW1_4 dex                 ; LOOP ON SCALE FACTOR.
 7380 T:f6a5  d0 e5                              bne L_XDRAW1_2             ; STILL ON SAME SHAPE ITEM
 7381 T:f6a7  a5 d1                              lda HGR_DX+1          ; GET NEXT SHAPE ITEM
 7382 T:f6a9  4a                                 lsr                    ; NEXT 3 BIT VECTOR
 7383 T:f6aa  4a                                 lsr                    ; 
 7384 T:f6ab  4a                                 lsr                    ; 
 7385 T:f6ac  d0 d4                              bne L_XDRAW1_1             ; MORE IN THIS SHAPE BYTE
 7386 T:f6ae  e6 1a                              inc HGR_SHAPE                ; GO TO NEXT SHAPE BYTE
 7387 T:f6b0  d0 02                              bne L_XDRAW1_5
 7388 T:f6b2  e6 1b                              inc HGR_SHAPE+1
 7389 T:f6b4  a1 1a                    L_XDRAW1_5 lda (HGR_SHAPE,X)               ; NEXT BYTE OF SHAPE DEFINITION
 7390 T:f6b6  d0 ca                              bne L_XDRAW1_1             ; PROCESS IF NOT ZERO
