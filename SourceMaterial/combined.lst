 6211 T:f026                                    ; IF FALL THRU, RANGE IS -1/2...0
 6212 T:f026                                    ; IF BRANCH HERE, RANGE IS -1/4...0
 6213 T:f026                                    ; --------------------------------
 6214 T:f026  a9 70                    SIN_2     lda #<QUARTER           ; ADD 1/4 TO SHIFT RANGE
 6215 T:f028  a0 20                              ldy #>QUARTER              ; TO -1/4...1/4
 6216 T:f02a  20 be 17                           jsr FADD             ; 
 6217 T:f02d  68                                 pla                    ; GET SAVED SIGN FROM ABOVE
 6218 T:f02e  10 03                              bpl L_SIN_2_1                ; 
