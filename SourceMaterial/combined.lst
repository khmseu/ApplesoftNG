 4844 T:e848  69 08                              adc #8             ; BUMP SHIFT COUNT
 4845 T:e84a  c9 20                              cmp #32             ; DONE 4 TIMES YET?
 4846 T:e84c  d0 e4                              bne L_NORMALIZE_FAC_2_1             ; NO, STILL MIGHT BE SOME 1'S
 4847 T:e84e                                    ; YES, VALUE OF FAC IS ZERO
