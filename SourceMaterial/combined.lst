 2898 T:dd95                                    ; --------------------------------
 2899 T:dd95                           FRMEVL_2  
 2900 T:dd95  20 b7 00                           jsr CHRGOT                ; CHECK FOR RELATIONAL OPERATORS
 2901 T:dd98  38                       L_FRMEVL_2_1 sec                 ; > IS $CF, = IS $D0, < IS $D1
 2902 T:dd99  e9 cf                              sbc #TOKEN_GREATER               ; > IS 0, = IS 1, < IS 2
 2903 T:dd9b  90 17                              bcc L_FRMEVL_2_2                ; NOT RELATIONAL OPERATOR
 2904 T:dd9d  c9 03                              cmp #3             ; 
 2905 T:dd9f  b0 13                              bcs L_FRMEVL_2_2                ; NOT RELATIONAL OPERATOR
 2906 T:dda1  c9 01                              cmp #1             ; SET CARRY IF "=" OR "<"
 2907 T:dda3  2a                                 rol                    ; NOW > IS 0, = IS 3, < IS 5
 2908 T:dda4  49 01                              eor #1             ; NOW > IS 1, = IS 2, < IS 4
 2909 T:dda6  45 89                              eor CPRTYP                ; SET BITS OF CPRTYP:  00000<=>
 2910 T:dda8  c5 89                              cmp CPRTYP                ; CHECK FOR ILLEGAL COMBINATIONS
 2911 T:ddaa  90 61                              bcc SNTXERR                ; IF LESS THAN, A RELOP WAS REPEATED
 2912 T:ddac  85 89                              sta CPRTYP                ; 
 2913 T:ddae  20 b1 00                           jsr CHRGET                ; ANOTHER OPERATOR?
 2914 T:ddb1  4c 98 0d                           jmp L_FRMEVL_2_1             ; CHECK FOR <,=,> AGAIN
 2915 T:ddb4                                    ; --------------------------------
 2916 T:ddb4  a6 89                    L_FRMEVL_2_2 ldx CPRTYP             ; DID WE FIND A RELATIONAL OPERATOR?
 2917 T:ddb6  d0 2c                              bne FRM_RELATIONAL                ; YES
 2918 T:ddb8  b0 7b                              bcs NOTMATH                ; NO, AND NEXT TOKEN IS > $D1
 2919 T:ddba  69 07                              adc #$cf-TOKEN_PLUS         ; NO, AND NEXT TOKEN < $CF
 2920 T:ddbc  90 77                              bcc NOTMATH                ; IF NEXT TOKEN < "+"
 2921 T:ddbe  65 11                              adc VALTYP                ; + AND LAST RESULT A STRING?
 2922 T:ddc0  d0 03                              bne L_FRMEVL_2_3                ; BRANCH IF NOT
 2923 T:ddc2  4c 97 15                           jmp CAT                ; CONCATENATE IF SO.
