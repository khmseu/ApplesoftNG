 4214 T:e4bd  20 19 15                 L_FIND_HIGHEST_STRING_4 jsr CHECK_SIMPLE_VARIABLE
 4215 T:e4c0  f0 f3                              beq L_FIND_HIGHEST_STRING_3             ; ...ALWAYS
