 2935 T:ddd3  20 6a 0d                           jsr CHKNUM             ; WAS LAST RESULT A #?
 2936 T:ddd6  48                       NXOP      pha                 ; YES, SAVE PRECEDENCE ON STACK
 2937 T:ddd7  20 fd 0d                 SAVOP     jsr FRM_RECURSE             ; SAVE REST, CALL FRMEVL RECURSIVELY
 2938 T:ddda  68                                 pla 
