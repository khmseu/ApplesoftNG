 6591 T:f262  20 f8 16                 SPEED     jsr GETBYT          ; GET SPEED SETTING IN X-REG
 6592 T:f265  8a                                 txa                    ; SPEEDZ = $100-SPEED
 6593 T:f266  49 ff                              eor #$ff             ; SO "SPEED=255" IS FASTEST
 6594 T:f268  aa                                 tax                    ; 
 6595 T:f269  e8                                 inx                    ; 
 6596 T:f26a  86 f1                              stx SPEEDZ                ; 
 6597 T:f26c  60                                 rts                    ; 
