 6581 T:f256                                    ; --------------------------------
 6582 T:f256  20 f8 16                 VTAB      jsr GETBYT          ; GET LINE # IN X-REG
 6583 T:f259  ca                                 dex                    ; CONVERT TO ZERO BASE
 6584 T:f25a  8a                                 txa                    ; 
 6585 T:f25b  c9 18                              cmp #24             ; MUST BE 0-23
 6586 T:f25d  b0 a7                              bcs GOERR             ; TOO LARGE, OR WAS "VTAB 0"
 6587 T:f25f  4c 5b fb                           jmp MON_TABV                ; LET MONITOR COMPUTE BASE
