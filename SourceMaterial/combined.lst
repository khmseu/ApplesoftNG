 7453 T:f6fe  c9 c1                    HPLOT     cmp #TOKEN_TO            ; "PLOT TO" FORM?
 7454 T:f700  f0 0d                              beq L_HPLOT_2                ; YES, START FROM CURRENT LOCATION
 7455 T:f702  20 b9 26                           jsr HFNS             ; NO, GET STARTING POINT OF LINE
 7456 T:f705  20 57 24                           jsr HPLOT0             ; PLOT THE POINT, AND SET UP FOR
 7457 T:f708                                    ; DRAWING A LINE FROM THAT POINT
 7458 T:f708  20 b7 00                 L_HPLOT_1 jsr CHRGOT             ; CHARACTER AT END OF EXPRESSION
 7459 T:f70b  c9 c1                              cmp #TOKEN_TO               ; IS A LINE SPECIFIED?
 7460 T:f70d  d0 e6                              bne RTS_23             ; NO, EXIT
 7461 T:f70f  20 c0 0e                 L_HPLOT_2 jsr SYNCHR          ; YES. ADV. TXTPTR (WHY NOT CHRGET)
 7462 T:f712  20 b9 26                           jsr HFNS             ; GET COORDINATES OF LINE END
 7463 T:f715  84 9d                              sty DSCTMP                ; SET UP FOR LINE
 7464 T:f717  a8                                 tay                    ; 
 7465 T:f718  8a                                 txa                    ; 
 7466 T:f719  a6 9d                              ldx DSCTMP                ; 
 7467 T:f71b  20 3a 25                           jsr HGLIN             ; PLOT LINE
