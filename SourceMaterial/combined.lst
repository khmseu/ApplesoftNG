 3845 T:e2b8  a9 10                              lda #16             ; MULTIPLY 16 BITS
 3846 T:e2ba  85 99                              sta INDX                ; 
 3847 T:e2bc  a2 00                              ldx #0             ; PRODUCT = 0 INITIALLY
 3848 T:e2be  a0 00                              ldy #0             ; 
