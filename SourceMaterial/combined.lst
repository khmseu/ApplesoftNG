 6452 T:f1bf  20 4b 06                           jsr SCRTCH             ; MORE POINTERS
 6453 T:f1c2  a9 3a                              lda #<STROUT           ; PUT CORRECT ADDRESSES IN TWO
 6454 T:f1c4  a0 0b                              ldy #>STROUT           ; USER VECTORS
 6455 T:f1c6  85 04                              sta GOSTROUT+1
 6456 T:f1c8  84 05                              sty GOSTROUT+2
 6457 T:f1ca  a9 3c                              lda #<RESTART
