 5557 T:ec23                                    ; "INT" FUNCTION
 5558 T:ec23                                    ; 
 5559 T:ec23                                    ; USES QINT TO CONVERT (FAC) TO INTEGER FORM,
 5560 T:ec23                                    ; AND THEN REFLOATS THE INTEGER.
 5561 T:ec23                                    ; <<< A FASTER APPROACH WOULD SIMPLY CLEAR >>>
 5562 T:ec23                                    ; <<< THE FRACTIONAL BITS BY ZEROING THEM  >>>
 5563 T:ec23                                    ; --------------------------------
 5564 T:ec23  a5 9d                    INT       lda FAC             ; CHECK IF EXPONENT < 32
 5565 T:ec25  c9 a0                              cmp #$a0             ; BECAUSE IF > 31 THERE IS NO FRACTION
 5566 T:ec27  b0 20                              bcs RTS_17                ; NO FRACTION, WE ARE FINISHED
 5567 T:ec29  20 f2 1b                           jsr QINT             ; USE GENERAL INTEGER CONVERSION
 5568 T:ec2c  84 ac                              sty FAC_EXTENSION                ; Y=0, CLEAR EXTENSION
 5569 T:ec2e  a5 a2                              lda FAC_SIGN                ; GET SIGN OF VALUE
 5570 T:ec30  84 a2                              sty FAC_SIGN                ; Y=0, CLEAR SIGN
 5571 T:ec32  49 80                              eor #$80             ; TOGGLE ACTUAL SIGN
 5572 T:ec34  2a                                 rol                    ; AND SAVE IN CARRY
 5573 T:ec35  a9 a0                              lda #$a0             ; SET EXPONENT TO 32
 5574 T:ec37  85 9d                              sta FAC                ; BECAUSE 4-BYTE INTEGER NOW
 5575 T:ec39  a5 a1                              lda FAC+4          ; SAVE LOW 8-BITS OF INTEGER FORM
 5576 T:ec3b  85 0d                              sta CHARAC                ; FOR EXP AND POWER
 5577 T:ec3d  4c 29 18                           jmp NORMALIZE_FAC_1             ; NORMALIZE TO FINISH CONVERSION
 5578 T:ec40                                    ; --------------------------------
 5579 T:ec40  85 9e                    QINT_3    sta FAC+1       ; FAC=0, SO CLEAR ALL 4 BYTES FOR
 5580 T:ec42  85 9f                              sta FAC+2          ; INTEGER VERSION
 5581 T:ec44  85 a0                              sta FAC+3          ; 
 5582 T:ec46  85 a1                              sta FAC+4          ; 
 5583 T:ec48  a8                                 tay                    ; Y=0 TOO
 5584 T:ec49  60                       RTS_17    rts                 ; 
 5585 T:ec4a                                    ; --------------------------------
 5586 T:ec4a                                    ; CONVERT STRING TO FP VALUE IN FAC
 5587 T:ec4a                                    ; 
 5588 T:ec4a                                    ; STRING POINTED TO BY TXTPTR
 5589 T:ec4a                                    ; FIRST CHAR ALREADY SCANNED BY CHRGET
 5590 T:ec4a                                    ; (A) = FIRST CHAR, C=0 IF DIGIT.
 5591 T:ec4a                                    ; --------------------------------
 5592 T:ec4a  a0 00                    FIN       ldy #0          ; CLEAR WORKING AREA ($99...$A3)
 5593 T:ec4c  a2 0a                              ldx #10             ; TMPEXP, EXPON, DPFLG, EXPSGN, FAC, SERLEN
 5594 T:ec4e  94 99                    L_FIN_1   sty TMPEXP,X
 5595 T:ec50  ca                                 dex 
 5596 T:ec51  10 fb                              bpl L_FIN_1
 5597 T:ec53                                    ; --------------------------------
 5598 T:ec53  90 0f                              bcc FIN_2                ; FIRST CHAR IS A DIGIT
 5599 T:ec55  c9 2d                              cmp #("-"&%01111111)     ; CHECK FOR LEADING SIGN
 5600 T:ec57  d0 04                              bne L_FIN_2                ; NOT MINUS
 5601 T:ec59  86 a3                              stx SERLEN                ; MINUS, SET SERLEN = $FF FOR FLAG
 5602 T:ec5b  f0 04                              beq FIN_1                ; ...ALWAYS
 5603 T:ec5d  c9 2b                    L_FIN_2   cmp #("+"&%01111111)  ; MIGHT BE PLUS
 5604 T:ec5f  d0 05                              bne FIN_3                ; NOT PLUS EITHER, CHECK DECIMAL POINT
 5605 T:ec61                                    ; --------------------------------
 5606 T:ec61  20 b1 00                 FIN_1     jsr CHRGET             ; GET NEXT CHAR OF STRING
 5607 T:ec64                                    ; --------------------------------
 5608 T:ec64  90 5b                    FIN_2     bcc FIN_9             ; INSERT THIS DIGIT
 5609 T:ec66                                    ; --------------------------------
 5610 T:ec66  c9 2e                    FIN_3     cmp #("."&%01111111)  ; CHECK FOR DECIMAL POINT
 5611 T:ec68  f0 2e                              beq FIN_10                ; YES
 5612 T:ec6a  c9 45                              cmp #("E"&%01111111)     ; CHECK FOR EXPONENT PART
 5613 T:ec6c  d0 30                              bne FIN_7                ; NO, END OF NUMBER
 5614 T:ec6e  20 b1 00                           jsr CHRGET                ; YES, START CONVERTING EXPONENT
 5615 T:ec71  90 17                              bcc FIN_5                ; EXPONENT DIGIT
 5616 T:ec73  c9 c9                              cmp #TOKEN_MINUS               ; NEGATIVE EXPONENT?
 5617 T:ec75  f0 0e                              beq L_FIN_3_1                ; YES
 5618 T:ec77  c9 2d                              cmp #("-"&%01111111)     ; MIGHT NOT BE TOKENIZED YET
 5619 T:ec79  f0 0a                              beq L_FIN_3_1                ; YES, IT IS NEGATIVE
 5620 T:ec7b  c9 c8                              cmp #TOKEN_PLUS               ; OPTIONAL "+"
 5621 T:ec7d  f0 08                              beq FIN_4                ; YES
 5622 T:ec7f  c9 2b                              cmp #("+"&%01111111)     ; MIGHT NOT BE TOKENIZED YET
 5623 T:ec81  f0 04                              beq FIN_4                ; YES, FOUND "+"
 5624 T:ec83  d0 07                              bne FIN_6                ; ...ALWAYS, NUMBER COMPLETED
 5625 T:ec85  66 9c                    L_FIN_3_1 ror EXPSGN             ; C=1, SET FLAG NEGATIVE
 5626 T:ec87                                    ; --------------------------------
 5627 T:ec87  20 b1 00                 FIN_4     jsr CHRGET             ; GET NEXT DIGIT OF EXPONENT
 5628 T:ec8a                                    ; --------------------------------
 5629 T:ec8a  90 5c                    FIN_5     bcc GETEXP             ; CHAR IS A DIGIT OF EXPONENT
 5630 T:ec8c                                    ; --------------------------------
 5631 T:ec8c  24 9c                    FIN_6     bit EXPSGN             ; END OF NUMBER, CHECK EXP SIGN
 5632 T:ec8e  10 0e                              bpl FIN_7                ; POSITIVE EXPONENT
 5633 T:ec90  a9 00                              lda #0             ; NEGATIVE EXPONENT
 5634 T:ec92  38                                 sec                    ; MAKE 2'S COMPLEMENT OF EXPONENT
 5635 T:ec93  e5 9a                              sbc EXPON                ; 
 5636 T:ec95  4c a0 1c                           jmp FIN_8                ; 
 5637 T:ec98                                    ; --------------------------------
 5638 T:ec98                                    ; FOUND A DECIMAL POINT
 5639 T:ec98                                    ; --------------------------------
 5640 T:ec98  66 9b                    FIN_10    ror DPFLG             ; C=1, SET DPFLG FOR DECIMAL POINT
 5641 T:ec9a  24 9b                              bit DPFLG                ; CHECK IF PREVIOUS DEC. PT.
 5642 T:ec9c  50 c3                              bvc FIN_1             ; NO PREVIOUS DECIMAL POINT
 5643 T:ec9e                                    ; A SECOND DECIMAL POINT IS TAKEN AS A TERMINATOR
 5644 T:ec9e                                    ; TO THE NUMERIC STRING.
 5645 T:ec9e                                    ; "A=11..22" WILL GIVE A SYNTAX ERROR, BECAUSE
 5646 T:ec9e                                    ; IT IS TWO NUMBERS WITH NO OPERATOR BETWEEN.
 5647 T:ec9e                                    ; "PRINT 11..22" GIVES NO ERROR, BECAUSE IT IS
 5648 T:ec9e                                    ; JUST THE CONCATENATION OF TWO NUMBERS.
 5649 T:ec9e                                    ; --------------------------------
 5650 T:ec9e                                    ; NUMBER TERMINATED, ADJUST EXPONENT NOW
 5651 T:ec9e                                    ; --------------------------------
 5652 T:ec9e  a5 9a                    FIN_7     lda EXPON             ; E-VALUE
 5653 T:eca0  38                       FIN_8     sec                 ; MODIFY WITH COUNT OF DIGITS
 5654 T:eca1  e5 99                              sbc TMPEXP                ; AFTER THE DECIMAL POINT
 5655 T:eca3  85 9a                              sta EXPON                ; COMPLETE CURRENT EXPONENT
 5656 T:eca5  f0 12                              beq L_FIN_8_15                ; NO ADJUST NEEDED IF EXP=0
 5657 T:eca7  10 09                              bpl L_FIN_8_14                ; EXP>0, MULTIPLY BY TEN
 5658 T:eca9  20 55 1a                 L_FIN_8_13 jsr DIV10          ; EXP<0, DIVIDE BY TEN
 5659 T:ecac  e6 9a                              inc EXPON                ; UNTIL EXP=0
 5660 T:ecae  d0 f9                              bne L_FIN_8_13             ; 
 5661 T:ecb0  f0 07                              beq L_FIN_8_15                ; ...ALWAYS, WE ARE FINISHED
 5662 T:ecb2  20 39 1a                 L_FIN_8_14 jsr MUL10          ; EXP>0, MULTIPLY BKY TEN
 5663 T:ecb5  c6 9a                              dec EXPON                ; UNTIL EXP=0
 5664 T:ecb7  d0 f9                              bne L_FIN_8_14             ; 
 5665 T:ecb9  a5 a3                    L_FIN_8_15 lda SERLEN             ; IS WHOLE NUMBER NEGATIVE?
 5666 T:ecbb  30 01                              bmi L_FIN_8_16                ; YES
 5667 T:ecbd  60                                 rts                    ; NO, RETURN, WHOLE JOB DONE!
 5668 T:ecbe  4c d0 1e                 L_FIN_8_16 jmp NEGOP             ; NEGATIVE NUMBER, SO NEGATE FAC
 5669 T:ecc1                                    ; --------------------------------
 5670 T:ecc1                                    ; ACCUMULATE A DIGIT INTO FAC
 5671 T:ecc1                                    ; --------------------------------
 5672 T:ecc1  48                       FIN_9     pha                 ; SAVE DIGIT
 5673 T:ecc2  24 9b                              bit DPFLG                ; SEEN A DECIMAL POINT YET?
 5674 T:ecc4  10 02                              bpl L_FIN_9_1                ; NO, STILL IN INTEGER PART
 5675 T:ecc6  e6 99                              inc TMPEXP                ; YES, COUNT THE FRACTIONAL DIGIT
 5676 T:ecc8  20 39 1a                 L_FIN_9_1 jsr MUL10          ; FAC = FAC * 10
 5677 T:eccb  68                                 pla                    ; CURRENT DIGIT
 5678 T:eccc  38                                 sec                    ; <<<SHORTER HERE TO JUST "AND #$0F">>>
 5679 T:eccd  e9 30                              sbc #("0"&%01111111)     ; <<<TO CONVERT ASCII TO BINARY FORM>>>
 5680 T:eccf  20 d5 1c                           jsr ADDACC                ; ADD THE DIGIT
 5681 T:ecd2  4c 61 1c                           jmp FIN_1             ; GO BACK FOR MORE
 5682 T:ecd5                                    ; --------------------------------
 5683 T:ecd5                                    ; ADD (A) TO FAC
 5684 T:ecd5                                    ; --------------------------------
 5685 T:ecd5  48                       ADDACC    pha                 ; SAVE ADDEND
 5686 T:ecd6  20 63 1b                           jsr COPY_FAC_TO_ARG_ROUNDED
 5687 T:ecd9  68                                 pla                    ; GET ADDEND AGAIN
 5688 T:ecda  20 93 1b                           jsr FLOAT             ; CONVERT TO FP VALUE IN FAC
 5689 T:ecdd  a5 aa                              lda ARG_SIGN                ; 
 5690 T:ecdf  45 a2                              eor FAC_SIGN                ; 
 5691 T:ece1  85 ab                              sta SGNCPR                ; 
 5692 T:ece3  a6 9d                              ldx FAC                ; TO SIGNAL IF FAC=0
 5693 T:ece5  4c c1 17                           jmp FADDT             ; PERFORM THE ADDITION
 5694 T:ece8                                    ; --------------------------------
 5695 T:ece8                                    ; ACCUMULATE DIGIT OF EXPONENT
 5696 T:ece8                                    ; --------------------------------
 5697 T:ece8  a5 9a                    GETEXP    lda EXPON             ; CHECK CURRENT VALUE
 5698 T:ecea  c9 0a                              cmp #10             ; FOR MORE THAN 2 DIGITS
 5699 T:ecec  90 09                              bcc L_GETEXP_1                ; NO, THIS IS 1ST OR 2ND DIGIT
 5700 T:ecee  a9 64                              lda #100             ; EXPONENT TOO BIG
 5701 T:ecf0  24 9c                              bit EXPSGN                ; UNLESS IT IS NEGATIVE
 5702 T:ecf2  30 11                              bmi L_GETEXP_2                ; LARGE NEGATIVE EXPONENT MAKES FAC=0
 5703 T:ecf4  4c d5 18                           jmp OVERFLOW             ; LARGE POSITIVE EXPONENT IS ERROR
 5704 T:ecf7  0a                       L_GETEXP_1 asl                 ; EXPONENT TIMES 10
 5705 T:ecf8  0a                                 asl                    ; 
 5706 T:ecf9  18                                 clc                    ; 
 5707 T:ecfa  65 9a                              adc EXPON                ; 
 5708 T:ecfc  0a                                 asl                    ; 
 5709 T:ecfd  18                                 clc                    ; <<< ASL ALREADY DID THIS! >>>
 5710 T:ecfe  a0 00                              ldy #0             ; ADD THE NEW DIGIT
 5711 T:ed00  71 b8                              adc (TXTPTR),Y                  ; BUT THIS IS IN ASCII,
 5712 T:ed02  38                                 sec                    ; SO ADJUST BACK TO BINARY
 5713 T:ed03  e9 30                              sbc #("0"&%01111111)
 5714 T:ed05  85 9a                    L_GETEXP_2 sta EXPON             ; NEW VALUE
 5715 T:ed07  4c 87 1c                           jmp FIN_4             ; BACK FOR MORE
 5716 T:ed0a                                    ; --------------------------------
 5717 T:ed0a                                    ; --------------------------------

 5719 T:ed0a  9b 3e bc 1f fd           CON_99999999P9 .byt $9b,$3e,$bc,$1f,$fd; 99,999,999.9
 5720 T:ed0f  9e 6e 6b 27 fd           CON_999999999 .byt $9e,$6e,$6b,$27,$fd; 999,999,999
 5721 T:ed14  9e 6e 6b 28 00           CON_BILLION .byt $9e,$6e,$6b,$28,$00; 1,000,000,000
 5722 T:ed19                                    ; --------------------------------
 5723 T:ed19                                    ; PRINT "IN <LINE #>"
 5724 T:ed19                                    ; --------------------------------
 5725 T:ed19  a9 58                    INPRT     lda #<QT_IN        ; PRINT " IN "
 5726 T:ed1b  a0 03                              ldy #>QT_IN
 5727 T:ed1d  20 31 1d                           jsr GO_STROUT
 5728 T:ed20  a5 76                              lda CURLIN+1
 5729 T:ed22  a6 75                              ldx CURLIN
 5730 T:ed24                                    ; --------------------------------
 5731 T:ed24                                    ; PRINT A,X AS DECIMAL INTEGER
 5732 T:ed24                                    ; --------------------------------
 5733 T:ed24  85 9e                    LINPRT    sta FAC+1       ; PRINT A,X IN DECIMAL
 5734 T:ed26  86 9f                              stx FAC+2          ; 
 5735 T:ed28  a2 90                              ldx #$90             ; EXPONENT = 2^16
 5736 T:ed2a  38                                 sec                    ; CONVERT UNSIGNED
 5737 T:ed2b  20 a0 1b                           jsr FLOAT_2             ; CONVERT LINE # TO FP
 5738 T:ed2e                                    ; --------------------------------
 5739 T:ed2e                                    ; CONVERT (FAC) TO STRING, AND PRINT IT
 5740 T:ed2e                                    ; --------------------------------
 5741 T:ed2e                           PRINT_FAC                  ; 
 5742 T:ed2e  20 34 1d                           jsr FOUT                ; CONVERT (FAC) TO STRING AT STACK
 5743 T:ed31                                    ; --------------------------------
 5744 T:ed31                                    ; PRINT STRING STARTING AT Y,A
 5745 T:ed31                                    ; --------------------------------
 5746 T:ed31                           GO_STROUT                  ; 
 5747 T:ed31  4c 3a 0b                           jmp STROUT             ; PRINT STRING AT A,Y
 5748 T:ed34                                    ; --------------------------------
 5749 T:ed34                                    ; CONVERT (FAC) TO STRING STARTING AT STACK
 5750 T:ed34                                    ; RETURN WITH (Y,A) POINTING AT STRING
 5751 T:ed34                                    ; --------------------------------
 5752 T:ed34  a0 01                    FOUT      ldy #1          ; NORMAL ENTRY PUTS STRING AT STACK...
 5753 T:ed36                                    ; --------------------------------
 5754 T:ed36                                    ; "STR$" FUNCTION ENTERS HERE, WITH (Y)=0
 5755 T:ed36                                    ; SO THAT RESULT STRING STARTS AT STACK-1
 5756 T:ed36                                    ; (THIS IS USED AS A FLAG)
 5757 T:ed36                                    ; --------------------------------
 5758 T:ed36  a9 2d                    FOUT_1    lda #("-"&%01111111)  ; IN CASE VALUE NEGATIVE
 5759 T:ed38  88                                 dey                    ; BACK UP PNTR
 5760 T:ed39  24 a2                              bit FAC_SIGN                ; 
 5761 T:ed3b  10 04                              bpl L_FOUT_1_1                ; VALUE IS +
 5762 T:ed3d  c8                                 iny                    ; VALUE IS -
 5763 T:ed3e  99 ff 00                           sta STACK-1,Y                   ; EMIT "-"
 5764 T:ed41  85 a2                    L_FOUT_1_1 sta FAC_SIGN             ; MAKE FAC.SIGN POSITIVE ($2D)
 5765 T:ed43  84 ad                              sty STRNG2                ; SAVE STRING PNTR
 5766 T:ed45  c8                                 iny                    ; 
 5767 T:ed46  a9 30                              lda #("0"&%01111111)     ; IN CASE (FAC)=0
 5768 T:ed48  a6 9d                              ldx FAC                ; NUMBER=0?
 5769 T:ed4a  d0 03                              bne L_FOUT_1_2                ; NO, (FAC) NOT ZERO
 5770 T:ed4c  4c 57 1e                           jmp FOUT_4                ; YES, FINISHED
 5771 T:ed4f                                    ; --------------------------------
 5772 T:ed4f  a9 00                    L_FOUT_1_2 lda #0          ; STARTING VALUE FOR TMPEXP
 5773 T:ed51  e0 80                              cpx #$80             ; ANY INTEGER PART?
 5774 T:ed53  f0 02                              beq L_FOUT_1_3                ; NO, BTWN L_FOUT_1_5 AND L_FOUT_1_999999999
 5775 T:ed55  b0 09                              bcs L_FOUT_1_4                ; YES
 5776 T:ed57                                    ; --------------------------------
 5777 T:ed57  a9 14                    L_FOUT_1_3 lda #<CON_BILLION        ; MULTIPLY BY 1E9
 5778 T:ed59  a0 1d                              ldy #>CON_BILLION           ; TO GIVE ADJUSTMENT A HEAD START
 5779 T:ed5b  20 7f 19                           jsr FMULT             ; 
 5780 T:ed5e  a9 f7                              lda #$0100-9       ; EXPONENT ADJUSTMENT
 5781 T:ed60  85 99                    L_FOUT_1_4 sta TMPEXP             ; 0 OR -9
 5782 T:ed62                                    ; --------------------------------
 5783 T:ed62                                    ; ADJUST UNTIL 1E8 <= (FAC) <1E9
 5784 T:ed62                                    ; --------------------------------
 5785 T:ed62  a9 0f                    L_FOUT_1_5 lda #<CON_999999999
 5786 T:ed64  a0 1d                              ldy #>CON_999999999
 5787 T:ed66  20 b2 1b                           jsr FCOMP             ; COMPARE TO 1E9-1
 5788 T:ed69  f0 1e                              beq L_FOUT_1_10                ; (FAC) = 1E9-1
 5789 T:ed6b  10 12                              bpl L_FOUT_1_8                ; TOO LARGE, DIVIDE BY TEN
 5790 T:ed6d  a9 0a                    L_FOUT_1_6 lda #<CON_99999999P9        ; COMPARE TO 1E8-L_FOUT_1_1
 5791 T:ed6f  a0 1d                              ldy #>CON_99999999P9
 5792 T:ed71  20 b2 1b                           jsr FCOMP             ; COMPARE TO 1E8-L_FOUT_1_1
 5793 T:ed74  f0 02                              beq L_FOUT_1_7                ; (FAC) = 1E8-L_FOUT_1_1
 5794 T:ed76  10 0e                              bpl L_FOUT_1_9                ; IN RANGE, ADJUSTMENT FINISHED
 5795 T:ed78  20 39 1a                 L_FOUT_1_7 jsr MUL10          ; TOO SMALL, MULTIPLY BY TEN
 5796 T:ed7b  c6 99                              dec TMPEXP                ; KEEP TRACK OF MULTIPLIES
 5797 T:ed7d  d0 ee                              bne L_FOUT_1_6             ; ...ALWAYS
 5798 T:ed7f  20 55 1a                 L_FOUT_1_8 jsr DIV10          ; TOO LARGE, DIVIDE BY TEN
 5799 T:ed82  e6 99                              inc TMPEXP                ; KEEP TRACK OF DIVISIONS
 5800 T:ed84  d0 dc                              bne L_FOUT_1_5             ; ...ALWAYS
 5801 T:ed86                                    ; --------------------------------
 5802 T:ed86  20 a0 17                 L_FOUT_1_9 jsr FADDH          ; ROUND ADJUSTED RESULT
 5803 T:ed89  20 f2 1b                 L_FOUT_1_10 jsr QINT          ; CONVERT ADJUSTED VALUE TO 32-BIT INTEGER
 5804 T:ed8c                                    ; --------------------------------
 5805 T:ed8c                                    ; FAC+1...FAC+4 IS NOW IN INTEGER FORM
 5806 T:ed8c                                    ; WITH POWER OF TEN ADJUSTMENT IN TMPEXP
 5807 T:ed8c                                    ; 
 5808 T:ed8c                                    ; IF -10 < TMPEXP > 1, PRINT IN DECIMAL FORM
 5809 T:ed8c                                    ; OTHERWISE, PRINT IN EXPONENTIAL FORM
 5810 T:ed8c                                    ; --------------------------------
 5811 T:ed8c  a2 01                    FOUT_2    ldx #1          ; ASSUME 1 DIGIT BEFORE "."
 5812 T:ed8e  a5 99                              lda TMPEXP                ; CHECK RANGE
 5813 T:ed90  18                                 clc                    ; 
 5814 T:ed91  69 0a                              adc #10             ; 
 5815 T:ed93  30 09                              bmi L_FOUT_2_1                ; < .01, USE EXPONENTIAL FORM
 5816 T:ed95  c9 0b                              cmp #11             ; 
 5817 T:ed97  b0 06                              bcs L_FOUT_2_2                ; >= 1E10, USE EXPONENTIAL FORM
 5818 T:ed99  69 ff                              adc #$ff             ; LESS 1 GIVES INDEX FOR "."
 5819 T:ed9b  aa                                 tax                    ; 
 5820 T:ed9c  a9 02                              lda #2             ; SET REMAINING EXPONENT = 0
 5821 T:ed9e  38                       L_FOUT_2_1 sec                 ; COMPUTE REMAINING EXPONENT
 5822 T:ed9f  e9 02                    L_FOUT_2_2 sbc #2          ; 
 5823 T:eda1  85 9a                              sta EXPON                ; VALUE FOR "E+XX" OR "E-XX"
 5824 T:eda3  86 99                              stx TMPEXP                ; INDEX FOR DECIMAL POINT
 5825 T:eda5  8a                                 txa                    ; SEE IF "." COMES FIRST
 5826 T:eda6  f0 02                              beq L_FOUT_2_3                ; YES
 5827 T:eda8  10 13                              bpl L_FOUT_2_5                ; NO, LATER
 5828 T:edaa  a4 ad                    L_FOUT_2_3 ldy STRNG2             ; GET INDEX INTO STRING BEING BUILT
 5829 T:edac  a9 2e                              lda #("."&%01111111)     ; STORE A DECIMAL POINT
 5830 T:edae  c8                                 iny                    ; 
 5831 T:edaf  99 ff 00                           sta STACK-1,Y                   ; 
 5832 T:edb2  8a                                 txa                    ; SEE IF NEED ".0"
 5833 T:edb3  f0 06                              beq L_FOUT_2_4                ; NO
 5834 T:edb5  a9 30                              lda #("0"&%01111111)     ; YES, STORE "0"
 5835 T:edb7  c8                                 iny                    ; 
 5836 T:edb8  99 ff 00                           sta STACK-1,Y                   ; 
 5837 T:edbb  84 ad                    L_FOUT_2_4 sty STRNG2             ; SAVE OUTPUT INDEX AGAIN
 5838 T:edbd                                    ; --------------------------------
 5839 T:edbd                                    ; NOW DIVIDE BY POWERS OF TEN TO GET SUCCESSIVE DIGITS
 5840 T:edbd                                    ; --------------------------------
 5841 T:edbd  a0 00                    L_FOUT_2_5 ldy #0          ; INDEX TO TABLE OF POWERS OF TEN
 5842 T:edbf  a2 80                              ldx #$80             ; STARTING VALUE FOR DIGIT WITH DIRECTION
 5843 T:edc1  a5 a1                    L_FOUT_2_6 lda FAC+4       ; START BY ADDING -100000000 UNTIL
 5844 T:edc3  18                                 clc                    ; OVERSHOOT.  THEN ADD +10000000,
 5845 T:edc4  79 6c 1e                           adc DECTBL+3,Y                  ; THEN ADD -1000000, THEN ADD
 5846 T:edc7  85 a1                              sta FAC+4          ; +100000, AND SO ON.
 5847 T:edc9  a5 a0                              lda FAC+3          ; THE # OF TIMES EACH POWER IS ADDED
 5848 T:edcb  79 6b 1e                           adc DECTBL+2,Y                  ; IS 1 MORE THAN CORRESPONDING DIGIT
 5849 T:edce  85 a0                              sta FAC+3
 5850 T:edd0  a5 9f                              lda FAC+2
 5851 T:edd2  79 6a 1e                           adc DECTBL+1,Y
 5852 T:edd5  85 9f                              sta FAC+2
 5853 T:edd7  a5 9e                              lda FAC+1
 5854 T:edd9  79 69 1e                           adc DECTBL,Y
 5855 T:eddc  85 9e                              sta FAC+1
 5856 T:edde  e8                                 inx                    ; COUNT THE ADD
 5857 T:eddf  b0 04                              bcs L_FOUT_2_7                ; IF C=1 AND X NEGATIVE, KEEP ADDING
 5858 T:ede1  10 de                              bpl L_FOUT_2_6             ; IF C=0 AND X POSITIVE, KEEP ADDING
 5859 T:ede3  30 02                              bmi L_FOUT_2_8                ; IF C=0 AND X NEGATIVE, WE OVERSHOT
 5860 T:ede5  30 da                    L_FOUT_2_7 bmi L_FOUT_2_6          ; IF C=1 AND X POSITIVE, WE OVERSHOT
 5861 T:ede7  8a                       L_FOUT_2_8 txa                 ; OVERSHOT, SO MAKE X INTO A DIGIT
 5862 T:ede8  90 04                              bcc L_FOUT_2_9                ; HOW DEPENDS ON DIRECTION WE WERE GOING
 5863 T:edea  49 ff                              eor #$ff             ; DIGIT = 9-X
 5864 T:edec  69 0a                              adc #10             ; 
 5865 T:edee  69 2f                    L_FOUT_2_9 adc #("0"&%01111111)-1; MAKE DIGIT INTO ASCII
 5866 T:edf0  c8                                 iny                    ; ADVANCE TO NEXT SMALLER POWER OF TEN
 5867 T:edf1  c8                                 iny                    ; 
 5868 T:edf2  c8                                 iny                    ; 
 5869 T:edf3  c8                                 iny                    ; 
 5870 T:edf4  84 83                              sty VARPNT                ; SAVE PNTR TO POWERS
 5871 T:edf6  a4 ad                              ldy STRNG2                ; GET OUTPUT PNTR
 5872 T:edf8  c8                                 iny                    ; STORE THE DIGIT
 5873 T:edf9  aa                                 tax                    ; SAVE DIGIT, HI-BIT IS DIRECTION
 5874 T:edfa  29 7f                              and #$7f             ; MAKE SURE $30...$39 FOR STRING
 5875 T:edfc  99 ff 00                           sta STACK-1,Y                   ; 
 5876 T:edff  c6 99                              dec TMPEXP                ; COUNT THE DIGIT
 5877 T:ee01  d0 06                              bne L_FOUT_2_10                ; NOT TIME FOR "." YET
 5878 T:ee03  a9 2e                              lda #("."&%01111111)     ; TIME, SO STORE THE DECIMAL POINT
 5879 T:ee05  c8                                 iny                    ; 
 5880 T:ee06  99 ff 00                           sta STACK-1,Y                   ; 
 5881 T:ee09  84 ad                    L_FOUT_2_10 sty STRNG2             ; SAVE OUTPUT PNTR AGAIN
 5882 T:ee0b  a4 83                              ldy VARPNT                ; GET PNTR TO POWERS
 5883 T:ee0d  8a                                 txa                    ; GET DIGIT WITH HI-BIT = DIRECTION
 5884 T:ee0e  49 ff                              eor #$ff             ; CHANGE DIRECTION
 5885 T:ee10  29 80                              and #$80             ; $00 IF ADDING, $80 IF SUBTRACTING
 5886 T:ee12  aa                                 tax 
 5887 T:ee13  c0 24                              cpy #DECTBL_END-DECTBL
 5888 T:ee15  d0 aa                              bne L_FOUT_2_6             ; NOT FINISHED YET
 5889 T:ee17                                    ; --------------------------------
 5890 T:ee17                                    ; NINE DIGITS HAVE BEEN STORED IN STRING.  NOW LOOK
 5891 T:ee17                                    ; BACK AND LOP OFF TRAILING ZEROES AND A TRAILING
 5892 T:ee17                                    ; DECIMAL POINT.
 5893 T:ee17                                    ; --------------------------------
 5894 T:ee17  a4 ad                    FOUT_3    ldy STRNG2             ; POINTS AT LAST STORED CHAR
 5895 T:ee19  b9 ff 00                 L_FOUT_3_1 lda STACK-1,Y                   ; SEE IF LOPPABLE
 5896 T:ee1c  88                                 dey                    ; 
 5897 T:ee1d  c9 30                              cmp #("0"&%01111111)     ; SUPPRESS TRAILING ZEROES
 5898 T:ee1f  f0 f8                              beq L_FOUT_3_1             ; YES, KEEP LOOPING
 5899 T:ee21  c9 2e                              cmp #("."&%01111111)     ; SUPPRESS TRAILING DECIMAL POINT
 5900 T:ee23  f0 01                              beq L_FOUT_3_2                ; ".", SO WRITE OVER IT
 5901 T:ee25  c8                                 iny                    ; NOT ".", SO INCLUDE IN STRING AGAIN
 5902 T:ee26  a9 2b                    L_FOUT_3_2 lda #("+"&%01111111)  ; PREPARE FOR POSITIVE EXPONENT "E+XX"
 5903 T:ee28  a6 9a                              ldx EXPON                ; SEE IF ANY E-VALUE
 5904 T:ee2a  f0 2e                              beq FOUT_5                ; NO, JUST MARK END OF STRING
 5905 T:ee2c  10 08                              bpl L_FOUT_3_3                ; YES, AND IT IS POSITIVE
 5906 T:ee2e  a9 00                              lda #0             ; YES, AND IT IS NEGATIVE
 5907 T:ee30  38                                 sec                    ; COMPLEMENT THE VALUE
 5908 T:ee31  e5 9a                              sbc EXPON                ; 
 5909 T:ee33  aa                                 tax                    ; GET MAGNITUDE IN X
 5910 T:ee34  a9 2d                              lda #("-"&%01111111)     ; E SIGN
 5911 T:ee36  99 01 01                 L_FOUT_3_3 sta STACK+1,Y                   ; STORE SIGN IN STRING
 5912 T:ee39  a9 45                              lda #("E"&%01111111)     ; STORE "E" IN STRING BEFORE SIGN
 5913 T:ee3b  99 00 01                           sta STACK,Y                     ; 
 5914 T:ee3e  8a                                 txa                    ; EXPONENT MAGNITUDE IN A-REG
 5915 T:ee3f  a2 2f                              ldx #("0"&%01111111)-1; SEED FOR EXPONENT DIGIT
 5916 T:ee41  38                                 sec                    ; CONVERT TO DECIMAL
 5917 T:ee42  e8                       L_FOUT_3_4 inx                 ; COUNT THE SUBTRACTION
 5918 T:ee43  e9 0a                              sbc #10             ; TEN'S DIGIT
 5919 T:ee45  b0 fb                              bcs L_FOUT_3_4             ; MORE TENS TO SUBTRACT
 5920 T:ee47  69 3a                              adc #("0"&%01111111)+10; CONVERT REMAINDER TO ONE'S DIGIT
 5921 T:ee49  99 03 01                           sta STACK+3,Y                   ; STORE ONE'S DIGIT
 5922 T:ee4c  8a                                 txa                    ; 
 5923 T:ee4d  99 02 01                           sta STACK+2,Y                   ; STORE TEN'S DIGIT
 5924 T:ee50  a9 00                              lda #0             ; MARK END OF STRING WITH $00
 5925 T:ee52  99 04 01                           sta STACK+4,Y                   ; 
 5926 T:ee55  f0 08                              beq FOUT_6                ; ...ALWAYS
 5927 T:ee57  99 ff 00                 FOUT_4    sta STACK-1,Y                   ; STORE "0" IN ASCII
 5928 T:ee5a  a9 00                    FOUT_5    lda #0          ; STORE $00 ON END OF STRING
 5929 T:ee5c  99 00 01                           sta STACK,Y                     ; 
 5930 T:ee5f  a9 00                    FOUT_6    lda #<STACK           ; POINT Y,A AT BEGINNING OF STRING
 5931 T:ee61  a0 01                              ldy #>STACK              ; (STR$ STARTED STRING AT STACK-1, BUT
 5932 T:ee63  60                                 rts                    ; STR$ DOESN'T USE Y,A ANYWAY.)
 5933 T:ee64                                    ; --------------------------------

 5935 T:ee64  80 00 00 00 00           CON_HALF  .byt $80,$00,$00,$00,$00; FP CONSTANT 0L_CON_HALF_5
 5936 T:ee69                                    ; --------------------------------
 5937 T:ee69                                    ; POWERS OF 10 FROM 1E8 DOWN TO 1,
 5938 T:ee69                                    ; AS 32-BIT INTEGERS, WITH ALTERNATING SIGNS
 5939 T:ee69                                    ; --------------------------------

 5941 T:ee69  fa 0a 1f 00              DECTBL    .byt $fa,$0a,$1f,$00; -100000000
 5942 T:ee6d  00 98 96 80                        .byt $00,$98,$96,$80; 10000000
 5943 T:ee71  ff f0 bd c0                        .byt $ff,$f0,$bd,$c0; -1000000
 5944 T:ee75  00 01 86 a0                        .byt $00,$01,$86,$a0; 100000
 5945 T:ee79  ff ff d8 f0                        .byt $ff,$ff,$d8,$f0; -10000
 5946 T:ee7d  00 00 03 e8                        .byt $00,$00,$03,$e8; 1000
 5947 T:ee81  ff ff ff 9c                        .byt $ff,$ff,$ff,$9c; -100
 5948 T:ee85  00 00 00 0a                        .byt $00,$00,$00,$0a; 10
 5949 T:ee89  ff ff ff ff                        .byt $ff,$ff,$ff,$ff; -1
