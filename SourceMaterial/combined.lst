 3024 T:de3a                                    ; PERFORM STACKED OPERATION
 3025 T:de3a                                    ; 
 3026 T:de3a                                    ; (A) = PRECEDENCE BYTE
 3027 T:de3a                                    ; STACK:  1 -- CPRMASK
 3028 T:de3a                                    ; 5 -- (ARG)
 3029 T:de3a                                    ; 2 -- ADDR OF PERFORMER
 3030 T:de3a                                    ; --------------------------------
 3031 T:de3a                           FRM_PERFORM_1 
 3032 T:de3a  c9 64                              cmp #P_REL               ; WAS IT RELATIONAL OPERATOR?
