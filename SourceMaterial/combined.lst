 6576 T:f24f  20 f8 16                 COLOR     jsr GETBYT          ; GET COLOR VALUE IN X-REG
 6577 T:f252  8a                                 txa                    ; 
 6578 T:f253  4c 64 f8                           jmp MON_SETCOL                ; LET MONITOR STORE COLOR
