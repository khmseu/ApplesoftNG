 3034 T:de3e  20 6a 0d                           jsr CHKNUM             ; MUST BE NUMERIC VALUE
 3035 T:de41  84 87                    L_FRM_PERFORM_1_1 sty LASTOP             ; 
 3036 T:de43                                    ; --------------------------------
 3037 T:de43                           FRM_PERFORM_2                  ; 
 3038 T:de43  68                                 pla                    ; GET 0000<=>C FROM STACK
 3039 T:de44  4a                                 lsr                    ; SHIFT TO 00000<=> FORM
 3040 T:de45  85 16                              sta CPRMASK                ; 00000<=>
 3041 T:de47  68                                 pla                    ; 
 3042 T:de48  85 a5                              sta ARG                ; GET FLOATING POINT VALUE OFF STACK,
 3043 T:de4a  68                                 pla                    ; AND PUT IT IN ARG
 3044 T:de4b  85 a6                              sta ARG+1          ; 
 3045 T:de4d  68                                 pla                    ; 
 3046 T:de4e  85 a7                              sta ARG+2          ; 
 3047 T:de50  68                                 pla                    ; 
 3048 T:de51  85 a8                              sta ARG+3          ; 
 3049 T:de53  68                                 pla                    ; 
