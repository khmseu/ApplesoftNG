 4699 T:e764                                    ; "PEEK" FUNCTION
 4700 T:e764                                    ; --------------------------------
 4701 T:e764  a5 50                    PEEK      lda LINNUM             ; SAVE (LINNUM) ON STACK DURING PEEK
 4702 T:e766  48                                 pha                    ; 
 4703 T:e767  a5 51                              lda LINNUM+1          ; 
 4704 T:e769  48                                 pha                    ; 
 4705 T:e76a  20 52 17                           jsr GETADR             ; GET ADDRESS PEEKING AT
 4706 T:e76d  a0 00                              ldy #0
 4707 T:e76f  b1 50                              lda (LINNUM),Y                  ; TAKE A QUICK LOOK
 4708 T:e771  a8                                 tay                    ; VALUE IN Y-REG
 4709 T:e772  68                                 pla                    ; RESTORE LINNUM FROM STACK
 4710 T:e773  85 51                              sta LINNUM+1          ; 
