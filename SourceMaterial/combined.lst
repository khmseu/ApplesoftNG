 4633 T:e70f  a6 b8                    L_VAL_1   ldx TXTPTR             ; SAVE CURRENT TXTPTR
 4634 T:e711  a4 b9                              ldy TXTPTR+1          ; 
 4635 T:e713  86 ad                              stx STRNG2                ; 
 4636 T:e715  84 ae                              sty STRNG2+1          ; 
