 3795 T:e26f  c8                       FAE_2     iny                 ; BUMP POINTER INTO DESCRIPTOR
 3796 T:e270  a5 ae                    FAE_3     lda STRNG2+1       ; BYPASS MULTIPLICATION IF VALUE SO
