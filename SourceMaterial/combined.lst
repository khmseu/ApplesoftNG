 6166 T:efea                                    ; --------------------------------
 6167 T:efea                                    ; "COS" FUNCTION
 6168 T:efea                                    ; --------------------------------
 6169 T:efea  a9 66                    COS       lda #<CON_PI_HALF           ; COS(X)=SIN(X + PI/2)
 6170 T:efec  a0 20                              ldy #>CON_PI_HALF
 6171 T:efee  20 be 17                           jsr FADD
 6172 T:eff1                                    ; --------------------------------
 6173 T:eff1                                    ; "SIN" FUNCTION
 6174 T:eff1                                    ; --------------------------------
 6175 T:eff1  20 63 1b                 SIN       jsr COPY_FAC_TO_ARG_ROUNDED
 6176 T:eff4  a9 6b                              lda #<CON_PI_DOUB              ; REMOVE MULTIPLES OF 2*PI
 6177 T:eff6  a0 20                              ldy #>CON_PI_DOUB              ; BY DIVIDING AND SAVING
 6178 T:eff8  a6 aa                              ldx ARG_SIGN                ; THE FRACTIONAL PART
 6179 T:effa  20 5e 1a                           jsr DIV             ; USE SIGN OF ARGUMENT
 6180 T:effd  20 63 1b                           jsr COPY_FAC_TO_ARG_ROUNDED
 6181 T:f000  20 23 1c                           jsr INT             ; TAKE INTEGER PART
 6182 T:f003  a9 00                              lda #0             ; <<< WASTED LINES, BECAUSE FSUBT >>>
 6183 T:f005  85 ab                              sta SGNCPR                ; <<< CHANGES SGNCPR AGAIN        >>>
 6184 T:f007  20 aa 17                           jsr FSUBT             ; SUBTRACT TO GET FRACTIONAL PART
 6185 T:f00a                                    ; --------------------------------
 6186 T:f00a                                    ; (FAC) = ANGLE AS A FRACTION OF A FULL CIRCLE
 6187 T:f00a                                    ; 
 6188 T:f00a                                    ; NOW FOLD THE RANGE INTO A QUARTER CIRCLE
 6189 T:f00a                                    ; 
 6190 T:f00a                                    ; <<< THERE ARE MUCH SIMPLER WAYS TO DO THIS >>>
 6191 T:f00a                                    ; --------------------------------
 6192 T:f00a  a9 70                              lda #<QUARTER              ; 1/4 - FRACTION MAKES
 6193 T:f00c  a0 20                              ldy #>QUARTER              ; -3/4 <= FRACTION < 1/4
 6194 T:f00e  20 a7 17                           jsr FSUB             ; 
 6195 T:f011  a5 a2                              lda FAC_SIGN                ; TEST SIGN OF RESULT
 6196 T:f013  48                                 pha                    ; SAVE SIGN FOR LATER UNFOLDING
 6197 T:f014  10 0d                              bpl SIN_1                ; ALREADY 0...1/4
 6198 T:f016  20 a0 17                           jsr FADDH             ; ADD 1/2 TO SHIFT TO -1/4...1/2
 6199 T:f019  a5 a2                              lda FAC_SIGN                ; TEST SIGN
 6200 T:f01b  30 09                              bmi SIN_2                ; -1/4...0
 6201 T:f01d                                    ; 0...1/2
 6202 T:f01d  a5 16                              lda SIGNFLG                ; SIGNFLG INITIALIZED = 0 IN "TAN"
 6203 T:f01f  49 ff                              eor #$ff             ; FUNCTION
 6204 T:f021  85 16                              sta SIGNFLG                ; "TAN" IS ONLY USER OF SIGNFLG TOO
 6205 T:f023                                    ; --------------------------------
 6206 T:f023                                    ; IF FALL THRU, RANGE IS 0...1/2
 6207 T:f023                                    ; IF BRANCH HERE, RANGE IS 0...1/4
 6208 T:f023                                    ; --------------------------------
 6209 T:f023  20 d0 1e                 SIN_1     jsr NEGOP
