 6867 T:f411                                    ; SET THE HIRES CURSOR POSITION
 6868 T:f411                                    ; 
 6869 T:f411                                    ; (Y,X) = HORIZONTAL COORDINATE  (0-279)
 6870 T:f411                                    ; (A)   = VERTICAL COORDINATE    (0-191)
 6871 T:f411                                    ; --------------------------------
 6872 T:f411  85 e2                    HPOSN     sta HGR_Y             ; SAVE Y- AND X-POSITIONS
 6873 T:f413  86 e0                              stx HGR_X                ; 
 6874 T:f415  84 e1                              sty HGR_X+1          ; 
 6875 T:f417  48                                 pha                    ; Y-POS ALSO ON STACK
 6876 T:f418  29 c0                              and #$c0             ; CALCULATE BASE ADDRESS FOR Y-POS
 6877 T:f41a  85 26                              sta MON_GBASL                ; FOR Y=ABCDEFGH
 6878 T:f41c  4a                                 lsr                    ; GBASL=ABAB0000
 6879 T:f41d  4a                                 lsr                    ; 
 6880 T:f41e  05 26                              ora MON_GBASL                ; 
 6881 T:f420  85 26                              sta MON_GBASL                ; 
 6882 T:f422  68                                 pla                    ; (A)      (GBASH)   (GBASL)
 6883 T:f423  85 27                              sta MON_GBASH                ; ?-ABCDEFGH  ABCDEFGH  ABAB0000
 6884 T:f425  0a                                 asl                    ; A-BCDEFGH0  ABCDEFGH  ABAB0000
 6885 T:f426  0a                                 asl                    ; B-CDEFGH00  ABCDEFGH  ABAB0000
 6886 T:f427  0a                                 asl                    ; C-DEFGH000  ABCDEFGH  ABAB0000
 6887 T:f428  26 27                              rol MON_GBASH                ; A-DEFGH000  BCDEFGHC  ABAB0000
 6888 T:f42a  0a                                 asl                    ; D-EFGH0000  BCDEFGHC  ABAB0000
 6889 T:f42b  26 27                              rol MON_GBASH                ; B-EFGH0000  CDEFGHCD  ABAB0000
 6890 T:f42d  0a                                 asl                    ; E-FGH00000  CDEFGHCD  ABAB0000
 6891 T:f42e  66 26                              ror MON_GBASL                ; 0-FGH00000  CDEFGHCD  EABAB000
 6892 T:f430  a5 27                              lda MON_GBASH                ; 0-CDEFGHCD  CDEFGHCD  EABAB000
 6893 T:f432  29 1f                              and #$1f             ; 0-000FGHCD  CDEFGHCD  EABAB000
 6894 T:f434  05 e6                              ora HGR_PAGE                ; 0-PPPFGHCD  CDEFGHCD  EABAB000
 6895 T:f436  85 27                              sta MON_GBASH                ; 0-PPPFGHCD  PPPFGHCD  EABAB000
 6896 T:f438  8a                                 txa                    ; DIVIDE X-POS BY 7 FOR INDEX FROM BASE
 6897 T:f439  c0 00                              cpy #0             ; IS X-POS < 256?
 6898 T:f43b  f0 05                              beq L_HPOSN_2                ; YES
 6899 T:f43d  a0 23                              ldy #35             ; NO: 256/7 = 36 REM 4
 6900 T:f43f                                    ; CARRY=1, SO ADC #4 IS TOO LARGE;
 6901 T:f43f                                    ; HOWEVER, ADC #4 CLEARS CARRY
 6902 T:f43f                                    ; WHICH MAKES SBC #7 ONLY -6
 6903 T:f43f                                    ; BALANCING IT OUT.
 6904 T:f43f  69 04                              adc #4             ; FOLLOWING INY MAKES Y=36
 6905 T:f441  c8                       L_HPOSN_1 iny 
 6906 T:f442  e9 07                    L_HPOSN_2 sbc #7
 6907 T:f444  b0 fb                              bcs L_HPOSN_1
 6908 T:f446  84 e5                              sty HGR_HORIZ                ; HORIZONTAL INDEX
 6909 T:f448  aa                                 tax                    ; USE REMAINDER-7 TO LOOK UP THE
 6910 T:f449  bd b9 24                           lda MSKTBL-$0100+7,X             ; BIT MASK
 6911 T:f44c  85 30                              sta MON_HMASK
 6912 T:f44e  98                                 tya                    ; QUOTIENT GIVES BYTE INDEX
 6913 T:f44f  4a                                 lsr                    ; ODD OR EVEN COLUMN?
 6914 T:f450  a5 e4                              lda HGR_COLOR                ; IF ON ODD BYTE (CARRY SET)
 6915 T:f452  85 1c                              sta HGR_BITS                ; THEN ROTATE BITS
 6916 T:f454  b0 28                              bcs COLOR_SHIFT                ; ODD COLUMN
 6917 T:f456  60                                 rts                    ; EVEN COLUMN
 6918 T:f457                                    ; --------------------------------
 6919 T:f457                                    ; PLOT A DOT
 6920 T:f457                                    ; 
 6921 T:f457                                    ; (Y,X) = HORIZONTAL POSITION
 6922 T:f457                                    ; (A)   = VERTICAL POSITION
 6923 T:f457                                    ; --------------------------------
 6924 T:f457  20 11 24                 HPLOT0    jsr HPOSN
 6925 T:f45a  a5 1c                              lda HGR_BITS                ; CALCULATE BIT POSN IN GBAS,
 6926 T:f45c  51 26                              eor (MON_GBASL),Y               ; HGR.HORIZ, AND HMASK FROM
 6927 T:f45e  25 30                              and MON_HMASK                ; Y-COOR IN A-REG,
 6928 T:f460  51 26                              eor (MON_GBASL),Y               ; X-COOR IN X,Y REGS.
 6929 T:f462  91 26                              sta (MON_GBASL),Y               ; FOR ANY 1-BITS, SUBSTITUTE
 6930 T:f464  60                                 rts                    ; CORRESPONDING BIT OF HGR.BITS
 6931 T:f465                                    ; --------------------------------
 6932 T:f465                                    ; MOVE LEFT OR RIGHT ONE PIXEL
 6933 T:f465                                    ; 
 6934 T:f465                                    ; IF STATUS IS +, MOVE RIGHT; IF -, MOVE LEFT
 6935 T:f465                                    ; IF ALREADY AT LEFT OR RIGHT EDGE, WRAP AROUND
 6936 T:f465                                    ; 
 6937 T:f465                                    ; REMEMBER BITS IN HI-RES BYTE ARE BACKWARDS ORDER:
 6938 T:f465                                    ; BYTE N   BYTE N+1
 6939 T:f465                                    ; S7654321   SEDCBA98
 6940 T:f465                                    ; --------------------------------
 6941 T:f465                           MOVE_LEFT_OR_RIGHT 
 6942 T:f465  10 23                              bpl MOVE_RIGHT                ; + MOVE RIGHT, - MOVE LEFT
 6943 T:f467  a5 30                              lda MON_HMASK                ; MOVE LEFT ONE PIXEL
 6944 T:f469  4a                                 lsr                    ; SHIFT MASK RIGHT, MOVES DOT LEFT
 6945 T:f46a  b0 05                              bcs LR_2                ; ...DOT MOVED TO NEXT BYTE
 6946 T:f46c  49 c0                              eor #$c0             ; MOVE SIGN BIT BACK WHERE IT WAS
 6947 T:f46e  85 30                    LR_1      sta MON_HMASK             ; NEW MASK VALUE
 6948 T:f470  60                                 rts                    ; 
 6949 T:f471  88                       LR_2      dey                 ; MOVED TO NEXT BYTE, SO DECR INDEX
 6950 T:f472  10 02                              bpl LR_3                ; STILL NOT PAST EDGE
 6951 T:f474  a0 27                              ldy #39             ; OFF LEFT EDGE, SO WRAP AROUND SCREEN
 6952 T:f476  a9 c0                    LR_3      lda #$c0          ; NEW HMASK, RIGHTMOST BIT ON SCREEN
 6953 T:f478  85 30                    LR_4      sta MON_HMASK             ; NEW MASK AND INDEX
 6954 T:f47a  84 e5                              sty HGR_HORIZ                ; 
 6955 T:f47c  a5 1c                              lda HGR_BITS                ; ALSO NEED TO ROTATE COLOR
 6956 T:f47e                                    ; --------------------------------
 6957 T:f47e                           COLOR_SHIFT 
 6958 T:f47e  0a                                 asl                    ; ROTATE LOW-ORDER 7 BITS
 6959 T:f47f  c9 c0                              cmp #$c0             ; OF HGR.BITS ONE BIT POSN.
 6960 T:f481  10 06                              bpl L_COLOR_SHIFT_1
 6961 T:f483  a5 1c                              lda HGR_BITS
 6962 T:f485  49 7f                              eor #$7f
 6963 T:f487  85 1c                              sta HGR_BITS
 6964 T:f489  60                       L_COLOR_SHIFT_1 rts 
 6965 T:f48a                                    ; --------------------------------
 6966 T:f48a                                    ; MOVE RIGHT ONE PIXEL
 6967 T:f48a                                    ; IF ALREADY AT RIGHT EDGE, WRAP AROUND
 6968 T:f48a                                    ; --------------------------------
 6969 T:f48a                           MOVE_RIGHT 
 6970 T:f48a  a5 30                              lda MON_HMASK
 6971 T:f48c  0a                                 asl                    ; SHIFTING BYTE LEFT MOVES PIXEL RIGHT
 6972 T:f48d  49 80                              eor #$80             ; 
 6973 T:f48f                                    ; ORIGINAL:  C0 A0 90 88 84 82 81
 6974 T:f48f                                    ; SHIFTED:   80 40 20 10 08 02 01
 6975 T:f48f                                    ; EOR #$80:  00 C0 A0 90 88 84 82
 6976 T:f48f  30 dd                              bmi LR_1             ; FINISHED
 6977 T:f491  a9 81                              lda #$81             ; NEW MASK VALUE
 6978 T:f493  c8                                 iny                    ; MOVE TO NEXT BYTE RIGHT
 6979 T:f494  c0 28                              cpy #40             ; UNLESS THAT IS TOO FAR
 6980 T:f496  90 e0                              bcc LR_4             ; NOT TOO FAR
 6981 T:f498  a0 00                              ldy #0             ; TOO FAR, SO WRAP AROUND
 6982 T:f49a  b0 dc                              bcs LR_4             ; ...ALWAYS
 6983 T:f49c                                    ; --------------------------------
 6984 T:f49c                                    ; --------------------------------
 6985 T:f49c                                    ; "XDRAW" ONE BIT
 6986 T:f49c                                    ; --------------------------------
 6987 T:f49c  18                       LRUDX1    clc                 ; C=0 MEANS NO 90 DEGREE ROTATION
 6988 T:f49d  a5 d1                    LRUDX2    lda HGR_DX+1       ; C=1 MEANS ROTATE 90 DEGREES
 6989 T:f49f  29 04                              and #4             ; IF BIT2=0 THEN DON'T PLOT
 6990 T:f4a1  f0 25                              beq LRUD4                ; YES, DO NOT PLOT
 6991 T:f4a3  a9 7f                              lda #$7f             ; NO, LOOK AT WHAT IS ALREADY THERE
 6992 T:f4a5  25 30                              and MON_HMASK
 6993 T:f4a7  31 26                              and (MON_GBASL),Y               ; SCREEN BIT = 1?
 6994 T:f4a9  d0 19                              bne LRUD3                ; YES, GO CLEAR IT
 6995 T:f4ab  e6 ea                              inc HGR_COLLISIONS                ; NO, COUNT THE COLLISION
 6996 T:f4ad  a9 7f                              lda #$7f             ; AND TURN THE BIT ON
 6997 T:f4af  25 30                              and MON_HMASK                ; 
 6998 T:f4b1  10 11                              bpl LRUD3                ; ...ALWAYS
 6999 T:f4b3                                    ; --------------------------------
 7000 T:f4b3                                    ; "DRAW" ONE BIT
 7001 T:f4b3                                    ; --------------------------------
 7002 T:f4b3  18                       LRUD1     clc                 ; C=0 MEANS NO 90 DEGREE ROTATION
 7003 T:f4b4  a5 d1                    LRUD2     lda HGR_DX+1       ; C=1 MEANS ROTATE
 7004 T:f4b6  29 04                              and #4             ; IF BIT2=0 THEN DO NOT PLOT
 7005 T:f4b8  f0 0e                              beq LRUD4                ; DO NOT PLOT
 7006 T:f4ba  b1 26                              lda (MON_GBASL),Y
 7007 T:f4bc  45 1c                              eor HGR_BITS                ; 1'S WHERE ANY BITS NOT IN COLOR
 7008 T:f4be  25 30                              and MON_HMASK                ; LOOK AT JUST THIS BIT POSITION
 7009 T:f4c0  d0 02                              bne LRUD3                ; THE BIT WAS ZERO, SO PLOT IT
 7010 T:f4c2  e6 ea                              inc HGR_COLLISIONS                ; BIT IS ALREADY 1; COUNT COLLSN
 7011 T:f4c4                                    ; --------------------------------
 7012 T:f4c4                                    ; TOGGLE BIT ON SCREEN WITH (A)
 7013 T:f4c4                                    ; --------------------------------
 7014 T:f4c4  51 26                    LRUD3     eor (MON_GBASL),Y
 7015 T:f4c6  91 26                              sta (MON_GBASL),Y
 7016 T:f4c8                                    ; --------------------------------
 7017 T:f4c8                                    ; DETERMINE WHERE NEXT POINT WILL BE, AND MOVE THERE
 7018 T:f4c8                                    ; C=0 IF NO 90 DEGREE ROTATION
 7019 T:f4c8                                    ; C=1 ROTATES 90 DEGREES
 7020 T:f4c8                                    ; --------------------------------
 7021 T:f4c8  a5 d1                    LRUD4     lda HGR_DX+1       ; CALCULATE THE DIRECTION TO MOVE
 7022 T:f4ca  65 d3                              adc HGR_QUADRANT
 7023 T:f4cc  29 03                              and #3             ; WRAP AROUND THE CIRCLE
 7024 T:f4ce                                    CON_03=*-1         ; (( A CONSTANT ))
 7025 T:f4ce                                    ; 
 7026 T:f4ce                                    ; 00 -- UP
 7027 T:f4ce                                    ; 01 -- DOWN
 7028 T:f4ce                                    ; 10 -- RIGHT
 7029 T:f4ce                                    ; 11 -- LEFT
 7030 T:f4ce                                    ; 
 7031 T:f4ce  c9 02                              cmp #2             ; C=0 IF 0 OR 1, C=1 IF 2 OR 3
 7032 T:f4d0  6a                                 ror                    ; PUT C INTO SIGN, ODD/EVEN INTO C
 7033 T:f4d1  b0 92                              bcs MOVE_LEFT_OR_RIGHT
 7034 T:f4d3                                    ; --------------------------------
 7035 T:f4d3                           MOVE_UP_OR_DOWN 
 7036 T:f4d3  30 30                              bmi MOVE_DOWN                ; SIGN FOR UP/DOWN SELECT_
 7037 T:f4d5                                    ; --------------------------------
 7038 T:f4d5                                    ; MOVE UP ONE PIXEL
 7039 T:f4d5                                    ; IF ALREADY AT TOP, GO TO BOTTOM
 7040 T:f4d5                                    ; 
 7041 T:f4d5                                    ; REMEMBER:  Y-COORD   GBASH     GBASL
 7042 T:f4d5                                    ; ABCDEFGH  PPPFGHCD  EABAB000
 7043 T:f4d5                                    ; --------------------------------
 7044 T:f4d5  18                                 clc                    ; MOVE UP
 7045 T:f4d6  a5 27                              lda MON_GBASH                ; CALC. BASE ADDRESS OF PREV. LINE
 7046 T:f4d8  2c b9 25                           bit CON_1C                ; LOOK AT BITS 000FGH00 IN GBASH
 7047 T:f4db  d0 22                              bne L_MOVE_UP_OR_DOWN_5                ; SIMPLE, JUST FGH=FGH-1
 7048 T:f4dd                                    ; GBASH=PPP000CD, GBASL=EABAB000
 7049 T:f4dd  06 26                              asl MON_GBASL                ; WHAT IS "E"?
 7050 T:f4df  b0 1a                              bcs L_MOVE_UP_OR_DOWN_3                ; E=1, THEN EFGH=EFGH-1
 7051 T:f4e1  2c cd 24                           bit CON_03             ; LOOK AT 000000CD IN GBASH
 7052 T:f4e4  f0 05                              beq L_MOVE_UP_OR_DOWN_1                ; Y-POS IS AB000000 FORM
 7053 T:f4e6  69 1f                              adc #$1f             ; CD <> 0, SO CDEFGH=CDEFGH-1
 7054 T:f4e8  38                                 sec                    ; 
 7055 T:f4e9  b0 12                              bcs L_MOVE_UP_OR_DOWN_4                ; ...ALWAYS
 7056 T:f4eb  69 23                    L_MOVE_UP_OR_DOWN_1 adc #$23          ; ENOUGH TO MAKE GBASH=PPP11111 LATER
 7057 T:f4ed  48                                 pha                    ; SAVE FOR LATER
 7058 T:f4ee  a5 26                              lda MON_GBASL                ; GBASL IS NOW ABAB0000 (AB=00,01,10)
 7059 T:f4f0  69 b0                              adc #$b0             ; 0000+1011=1011 AND CARRY CLEAR
 7060 T:f4f2                                    ; OR 0101+1011=0000 AND CARRY SET
 7061 T:f4f2                                    ; OR 1010+1011=0101 AND CARRY SET
 7062 T:f4f2  b0 02                              bcs L_MOVE_UP_OR_DOWN_2                ; NO WRAP-AROUND NEEDED
 7063 T:f4f4  69 f0                              adc #$f0             ; CHANGE 1011 TO 1010 (WRAP-AROUND)
 7064 T:f4f6  85 26                    L_MOVE_UP_OR_DOWN_2 sta MON_GBASL             ; FORM IS NOW STILL ABAB0000
 7065 T:f4f8  68                                 pla                    ; PARTIALLY MODIFIED GBASH
 7066 T:f4f9  b0 02                              bcs L_MOVE_UP_OR_DOWN_4                ; ...ALWAYS
 7067 T:f4fb  69 1f                    L_MOVE_UP_OR_DOWN_3 adc #$1f          ; 
 7068 T:f4fd  66 26                    L_MOVE_UP_OR_DOWN_4 ror MON_GBASL             ; SHIFT IN E, TO GET EABAB000 FORM
 7069 T:f4ff  69 fc                    L_MOVE_UP_OR_DOWN_5 adc #$fc          ; FINISH GBASH MODS
 7070 T:f501  85 27                    UD_1      sta MON_GBASH             ; 
 7071 T:f503  60                                 rts 
 7072 T:f504                                    ; --------------------------------
 7073 T:f504  18                                 clc                    ; <<<NEVER USED>>>
 7074 T:f505                                    ; --------------------------------
 7075 T:f505                                    ; MOVE DOWN ONE PIXEL
 7076 T:f505                                    ; IF ALREADY AT BOTTOM, GO TO TOP
 7077 T:f505                                    ; 
 7078 T:f505                                    ; REMEMBER:  Y-COORD   GBASH     GBASL
 7079 T:f505                                    ; ABCDEFGH  PPPFGHCD  EABAB000
 7080 T:f505                                    ; --------------------------------
 7081 T:f505                           MOVE_DOWN 
 7082 T:f505  a5 27                              lda MON_GBASH                ; TRY IT FIRST, BY FGH=FGH+1
 7083 T:f507  69 04                              adc #4             ; GBASH = PPPFGHCD
 7084 T:f509                                    CON_04=*-1         ; (( CONSTANT ))
 7085 T:f509  2c b9 25                           bit CON_1C                ; IS FGH FIELD NOW ZERO?
 7086 T:f50c  d0 f3                              bne UD_1             ; NO, SO WE ARE FINISHED
 7087 T:f50e                                    ; YES, RIPPLE THE CARRY AS HIGH
 7088 T:f50e                                    ; AS NECESSARY
 7089 T:f50e  06 26                              asl MON_GBASL                ; LOOK AT "E" BIT
 7090 T:f510  90 18                              bcc L_CON_04_2                ; NOW ZERO; MAKE IT 1 AND LEAVE
 7091 T:f512  69 e0                              adc #$e0             ; CARRY = 1, SO ADDS $E1
 7092 T:f514  18                                 clc                    ; IS "CD" NOT ZERO?
 7093 T:f515  2c 08 25                           bit CON_04             ; TESTS BIT 2 FOR CARRY OUT OF "CD"
 7094 T:f518  f0 12                              beq L_CON_04_3                ; NO CARRY, FINISHED
 7095 T:f51a                                    ; INCREMENT "AB" THEN
 7096 T:f51a                                    ; 0000 --> 0101
 7097 T:f51a                                    ; 0101 --> 1010
 7098 T:f51a                                    ; 1010 --> WRAP AROUND TO LINE 0
 7099 T:f51a  a5 26                              lda MON_GBASL                ; 0000  0101  1010
 7100 T:f51c  69 50                              adc #$50             ; 0101  1010  1111
 7101 T:f51e  49 f0                              eor #$f0             ; 1010  0101  0000
 7102 T:f520  f0 02                              beq L_CON_04_1                ; 
 7103 T:f522  49 f0                              eor #$f0             ; 0101  1010
 7104 T:f524  85 26                    L_CON_04_1 sta MON_GBASL             ; NEW ABAB0000
 7105 T:f526  a5 e6                              lda HGR_PAGE                ; WRAP AROUND TO LINE ZERO OF GROUP
 7106 T:f528  90 02                              bcc L_CON_04_3                ; ...ALWAYS
 7107 T:f52a  69 e0                    L_CON_04_2 adc #$e0
 7108 T:f52c  66 26                    L_CON_04_3 ror MON_GBASL
 7109 T:f52e  90 d1                              bcc UD_1             ; ...ALWAYS
 7110 T:f530                                    ; --------------------------------
 7111 T:f530                                    ; HLINRL IS NEVER CALLED BY APPLESOFT
 7112 T:f530                                    ; 
 7113 T:f530                                    ; ENTER WITH:  (A,X) = DX FROM CURRENT POINT
 7114 T:f530                                    ; (Y)   = DY FROM CURRENT POINT
 7115 T:f530                                    ; --------------------------------
 7116 T:f530  48                       HLINRL    pha                 ; SAVE (A)
 7117 T:f531  a9 00                              lda #0             ; CLEAR CURRENT POINT SO HGLIN WILL
 7118 T:f533  85 e0                              sta HGR_X                ; ACT RELATIVELY
 7119 T:f535  85 e1                              sta HGR_X+1          ; 
 7120 T:f537  85 e2                              sta HGR_Y                ; 
 7121 T:f539  68                                 pla                    ; RESTORE (A)
 7122 T:f53a                                    ; --------------------------------
 7123 T:f53a                                    ; DRAW LINE FROM LAST PLOTTED POINT TO (A,X),(Y)
 7124 T:f53a                                    ; 
 7125 T:f53a                                    ; ENTER WITH:  (A,X) = X OF TARGET POINT
 7126 T:f53a                                    ; (Y)   = Y OF TARGET POINT
 7127 T:f53a                                    ; --------------------------------
 7128 T:f53a  48                       HGLIN     pha                 ; COMPUTE DX = X- X0
 7129 T:f53b  38                                 sec 
 7130 T:f53c  e5 e0                              sbc HGR_X
 7131 T:f53e  48                                 pha 
 7132 T:f53f  8a                                 txa 
 7133 T:f540  e5 e1                              sbc HGR_X+1
 7134 T:f542  85 d3                              sta HGR_QUADRANT                ; SAVE DX SIGN (+ = RIGHT, - = LEFT)
 7135 T:f544  b0 0a                              bcs L_HGLIN_1                ; NOW FIND ABS (DX)
 7136 T:f546  68                                 pla                    ; FORMS 2'S COMPLEMENT
 7137 T:f547  49 ff                              eor #$ff
 7138 T:f549  69 01                              adc #1
 7139 T:f54b  48                                 pha 
 7140 T:f54c  a9 00                              lda #0
 7141 T:f54e  e5 d3                              sbc HGR_QUADRANT
 7142 T:f550  85 d1                    L_HGLIN_1 sta HGR_DX+1
 7143 T:f552  85 d5                              sta HGR_E+1          ; INIT HGR.E TO ABS(X-X0)
 7144 T:f554  68                                 pla 
 7145 T:f555  85 d0                              sta HGR_DX
 7146 T:f557  85 d4                              sta HGR_E
 7147 T:f559  68                                 pla 
 7148 T:f55a  85 e0                              sta HGR_X                ; TARGET X POINT
 7149 T:f55c  86 e1                              stx HGR_X+1          ; 
 7150 T:f55e  98                                 tya                    ; TARGET Y POINT
 7151 T:f55f  18                                 clc                    ; COMPUTE DY = Y-HGR.Y
 7152 T:f560  e5 e2                              sbc HGR_Y                ; AND SAVE -ABS(Y-HGR.Y)-1 IN HGR.DY
 7153 T:f562  90 04                              bcc L_HGLIN_2                ; (SO + MEANS UP, - MEANS DOWN)
 7154 T:f564  49 ff                              eor #$ff             ; 2'S COMPLEMENT OF DY
 7155 T:f566  69 fe                              adc #$fe             ; 
 7156 T:f568  85 d2                    L_HGLIN_2 sta HGR_DY             ; 
 7157 T:f56a  84 e2                              sty HGR_Y                ; TARGET Y POINT
 7158 T:f56c  66 d3                              ror HGR_QUADRANT                ; SHIFT Y-DIRECTION INTO QUADRANT
 7159 T:f56e  38                                 sec                    ; COUNT = DX -(-DY) = # OF DOTS NEEDED
 7160 T:f56f  e5 d0                              sbc HGR_DX                ; 
 7161 T:f571  aa                                 tax                    ; COUNTL IS IN X-REG
 7162 T:f572  a9 ff                              lda #$ff
 7163 T:f574  e5 d1                              sbc HGR_DX+1
 7164 T:f576  85 1d                              sta HGR_COUNT
 7165 T:f578  a4 e5                              ldy HGR_HORIZ                ; HORIZONTAL INDEX
 7166 T:f57a  b0 05                              bcs MOVEX2                ; ...ALWAYS
 7167 T:f57c                                    ; --------------------------------
 7168 T:f57c                                    ; MOVE LEFT OR RIGHT ONE PIXEL
 7169 T:f57c                                    ; (A) BIT 6 HAS DIRECTION
 7170 T:f57c                                    ; --------------------------------
 7171 T:f57c  0a                       MOVEX     asl                 ; PUT BIT 6 INTO SIGN POSITION
 7172 T:f57d  20 65 24                           jsr MOVE_LEFT_OR_RIGHT
 7173 T:f580  38                                 sec 
 7174 T:f581                                    ; --------------------------------
 7175 T:f581                                    ; DRAW LINE NOW
 7176 T:f581                                    ; --------------------------------
 7177 T:f581  a5 d4                    MOVEX2    lda HGR_E             ; CARRY IS SET
 7178 T:f583  65 d2                              adc HGR_DY                ; E = E-DELTY
 7179 T:f585  85 d4                              sta HGR_E                ; NOTE: DY IS (-DELTA Y)-1
 7180 T:f587  a5 d5                              lda HGR_E+1          ; CARRY CLR IF HGR.E GOES NEGATIVE
 7181 T:f589  e9 00                              sbc #0
 7182 T:f58b  85 d5                    L_MOVEX2_1 sta HGR_E+1
 7183 T:f58d  b1 26                              lda (MON_GBASL),Y
 7184 T:f58f  45 1c                              eor HGR_BITS                ; PLOT A DOT
 7185 T:f591  25 30                              and MON_HMASK
 7186 T:f593  51 26                              eor (MON_GBASL),Y
 7187 T:f595  91 26                              sta (MON_GBASL),Y
 7188 T:f597  e8                                 inx                    ; FINISHED ALL THE DOTS?
 7189 T:f598  d0 04                              bne L_MOVEX2_2                ; NO
 7190 T:f59a  e6 1d                              inc HGR_COUNT                ; TEST REST OF COUNT
 7191 T:f59c  f0 62                              beq RTS_22                ; YES, FINISHED.
 7192 T:f59e  a5 d3                    L_MOVEX2_2 lda HGR_QUADRANT             ; TEST DIRECTION
 7193 T:f5a0  b0 da                              bcs MOVEX             ; NEXT MOVE IS IN THE X DIRECTION
 7194 T:f5a2  20 d3 24                           jsr MOVE_UP_OR_DOWN             ; IF CLR, NEG, MOVE
 7195 T:f5a5  18                                 clc                    ; E = E+DX
 7196 T:f5a6  a5 d4                              lda HGR_E
 7197 T:f5a8  65 d0                              adc HGR_DX
 7198 T:f5aa  85 d4                              sta HGR_E
 7199 T:f5ac  a5 d5                              lda HGR_E+1
 7200 T:f5ae  65 d1                              adc HGR_DX+1
 7201 T:f5b0  50 d9                              bvc L_MOVEX2_1             ; ...ALWAYS
