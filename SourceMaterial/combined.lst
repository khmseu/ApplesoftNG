 4639 T:e71b  18                                 clc                    ; 
 4640 T:e71c  65 5e                              adc INDEX                ; ADD LENGTH
 4641 T:e71e  85 60                              sta DEST                ; POINT DEST TO END OF STRING + 1
 4642 T:e720  a6 5f                              ldx INDEX+1          ; 
 4643 T:e722  86 b9                              stx TXTPTR+1          ; 
 4644 T:e724  90 01                              bcc L_VAL_2                ; 
 4645 T:e726  e8                                 inx                    ; 
 4646 T:e727  86 61                    L_VAL_2   stx DEST+1       ; 
 4647 T:e729  a0 00                              ldy #0             ; SAVE BYTE THAT FOLLOWS STRING
 4648 T:e72b  b1 60                              lda (DEST),Y                    ; ON STACK
 4649 T:e72d  48                                 pha                    ; 
 4650 T:e72e  a9 00                              lda #0             ; AND STORE $00 IN ITS PLACE
 4651 T:e730  91 60                              sta (DEST),Y                    ; 
 4652 T:e732                                    ; <<< THAT CAUSES A BUG IF HIMEM = $BFFF, >>>
 4653 T:e732                                    ; <<< BECAUSE STORING $00 AT $C000 IS NO  >>>
 4654 T:e732                                    ; <<< USE; $C000 WILL ALWAYS BE LAST CHAR >>>
 4655 T:e732                                    ; <<< TYPED, SO FIN WON'T TERMINATE UNTIL >>>
 4656 T:e732                                    ; <<< IT SEES A ZERO AT $C010!            >>>
 4657 T:e732  20 b7 00                           jsr CHRGOT                ; PRIME THE PUMP
 4658 T:e735  20 4a 1c                           jsr FIN                ; EVALUATE STRING
 4659 T:e738  68                                 pla                    ; GET BYTE THAT SHOULD FOLLOW STRING
 4660 T:e739  a0 00                              ldy #0             ; AND PUT IT BACK
 4661 T:e73b  91 60                              sta (DEST),Y                    ; 
