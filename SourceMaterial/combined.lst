 6735 T:f331                                    ; "DEL" STATEMENT
 6736 T:f331                                    ; --------------------------------
 6737 T:f331  b0 fb                    DEL       bcs JSYN          ; ERROR IF # NOT SPECIFIED
 6738 T:f333  a6 af                              ldx PRGEND                ; 
 6739 T:f335  86 69                              stx VARTAB                ; 
 6740 T:f337  a6 b0                              ldx PRGEND+1          ; 
 6741 T:f339  86 6a                              stx VARTAB+1          ; 
 6742 T:f33b  20 0c 0a                           jsr LINGET             ; GET BEGINNING OF RANGE
 6743 T:f33e  20 1a 06                           jsr FNDLIN             ; FIND THIS LINE OR NEXT
 6744 T:f341  a5 9b                              lda LOWTR                ; UPPER PORTION OF PROGRAM WILL
 6745 T:f343  85 60                              sta DEST                ; BE MOVED DOWN TO HERE
 6746 T:f345  a5 9c                              lda LOWTR+1          ; 
 6747 T:f347  85 61                              sta DEST+1          ; 
 6748 T:f349  a9 2c                              lda #(","&%01111111)     ; MUST HAVE A COMMA NEXT
 6749 T:f34b  20 c0 0e                           jsr SYNCHR             ; 
 6750 T:f34e  20 0c 0a                           jsr LINGET             ; GET END RANGE
 6751 T:f351                                    ; (DOES NOTHING IF END RANGE
 6752 T:f351                                    ; IS NOT SPECIFIED)
 6753 T:f351  e6 50                              inc LINNUM                ; POINT ONE PAST IT
 6754 T:f353  d0 02                              bne L_DEL_1                ; 
 6755 T:f355  e6 51                              inc LINNUM+1          ; 
 6756 T:f357  20 1a 06                 L_DEL_1   jsr FNDLIN          ; FIND START LINE AFTER SPECIFIED LINE
 6757 T:f35a  a5 9b                              lda LOWTR                ; WHICH IS BEGINNING OF PORTION
 6758 T:f35c  c5 60                              cmp DEST                ; TO BE MOVED DOWN
 6759 T:f35e  a5 9c                              lda LOWTR+1          ; IT MUST BE ABOVE THE TARGET
 6760 T:f360  e5 61                              sbc DEST+1          ; 
 6761 T:f362  b0 01                              bcs L_DEL_2                ; IT IS OKAY
 6762 T:f364  60                                 rts                    ; NOTHING TO DELETE
 6763 T:f365  a0 00                    L_DEL_2   ldy #0          ; MOVE UPPER PORTION DOWN NOW
 6764 T:f367  b1 9b                    L_DEL_3   lda (LOWTR),Y                   ; SOURCE . . .
 6765 T:f369  91 60                              sta (DEST),Y                    ; ...TO DESTINATION
 6766 T:f36b  e6 9b                              inc LOWTR                ; BUMP SOURCE PNTR
 6767 T:f36d  d0 02                              bne L_DEL_4                ; 
 6768 T:f36f  e6 9c                              inc LOWTR+1          ; 
 6769 T:f371  e6 60                    L_DEL_4   inc DEST             ; BUMP DESTINATION PNTR
 6770 T:f373  d0 02                              bne L_DEL_5                ; 
 6771 T:f375  e6 61                              inc DEST+1          ; 
 6772 T:f377  a5 69                    L_DEL_5   lda VARTAB             ; REACHED END OF PROGRAM YET?
 6773 T:f379  c5 9b                              cmp LOWTR                ; 
 6774 T:f37b  a5 6a                              lda VARTAB+1          ; 
 6775 T:f37d  e5 9c                              sbc LOWTR+1          ; 
 6776 T:f37f  b0 e6                              bcs L_DEL_3             ; NO, KEEP MOVING
 6777 T:f381  a6 61                              ldx DEST+1          ; STORE NEW END OF PROGRAM
 6778 T:f383  a4 60                              ldy DEST                ; MUST SUBTRACT 1 FIRST
 6779 T:f385  d0 01                              bne L_DEL_6                ; 
 6780 T:f387  ca                                 dex                    ; 
 6781 T:f388  88                       L_DEL_6   dey                 ; 
 6782 T:f389  86 6a                              stx VARTAB+1          ; 
 6783 T:f38b  84 69                              sty VARTAB                ; 
 6784 T:f38d  4c f2 04                           jmp FIX_LINKS             ; RESET LINKS AFTER A DELETE
