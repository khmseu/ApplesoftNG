 6007 T:eedb  81 38 aa 3b 29           CON_LOG_E .byt $81,$38,$aa,$3b,$29; LOG(E) TO BASE 2
 6008 T:eee0                                    ; --------------------------------
 6009 T:eee0  07                       POLY_EXP  .byt 7           ; ( # OF TERMS IN POLYNOMIAL) - 1
 6010 T:eee1  71 34 58 3e 56                     .byt $71,$34,$58,$3e,$56; (LOG(2)^7)/8!
 6011 T:eee6  74 16 7e b3 1b                     .byt $74,$16,$7e,$b3,$1b; (LOG(2)^6)/7!
 6012 T:eeeb  77 2f ee e3 85                     .byt $77,$2f,$ee,$e3,$85; (LOG(2)^5)/6!
 6013 T:eef0  7a 1d 84 1c 2a                     .byt $7a,$1d,$84,$1c,$2a; (LOG(2)^4)/5!
 6014 T:eef5  7c 63 59 58 0a                     .byt $7c,$63,$59,$58,$0a; (LOG(2)^3)/4!
 6015 T:eefa  7e 75 fd e7 c6                     .byt $7e,$75,$fd,$e7,$c6; (LOG(2)^2)/3!
 6016 T:eeff  80 31 72 18 10                     .byt $80,$31,$72,$18,$10; LOG(2)/2!
 6017 T:ef04  81 00 00 00 00                     .byt $81,$00,$00,$00,$00; 1
 6018 T:ef09                                    ; --------------------------------
 6019 T:ef09                                    ; "EXP" FUNCTION
 6020 T:ef09                                    ; 
 6021 T:ef09                                    ; FAC = E ^ FAC
 6022 T:ef09                                    ; --------------------------------
 6023 T:ef09  a9 db                    EXP       lda #<CON_LOG_E        ; CONVERT TO POWER OF TWO PROBLEM
 6024 T:ef0b  a0 1e                              ldy #>CON_LOG_E           ; E^X = 2^(LOG2(E)*X)
 6025 T:ef0d  20 7f 19                           jsr FMULT             ; 
 6026 T:ef10  a5 ac                              lda FAC_EXTENSION                ; NON-STANDARD ROUNDING HERE
 6027 T:ef12  69 50                              adc #$50             ; ROUND UP IF EXTENSION > $AF
 6028 T:ef14  90 03                              bcc L_EXP_1                ; NO, DON'T ROUND UP
 6029 T:ef16  20 7a 1b                           jsr INCREMENT_MANTISSA
 6030 T:ef19  85 92                    L_EXP_1   sta ARG_EXTENSION             ; STRANGE VALUE
 6031 T:ef1b  20 66 1b                           jsr MAF             ; COPY FAC INTO ARG
 6032 T:ef1e  a5 9d                              lda FAC                ; MAXIMUM EXPONENT IS < 128
 6033 T:ef20  c9 88                              cmp #$88             ; WITHIN RANGE?
 6034 T:ef22  90 03                              bcc L_EXP_3                ; YES
 6035 T:ef24  20 2b 1a                 L_EXP_2   jsr OUTOFRNG          ; OVERFLOW IF +, RETURN 0.0 IF -
 6036 T:ef27  20 23 1c                 L_EXP_3   jsr INT          ; GET INT(FAC)
 6037 T:ef2a  a5 0d                              lda CHARAC                ; THIS IS THE INETGRAL PART OF THE POWER
 6038 T:ef2c  18                                 clc                    ; ADD TO EXPONENT BIAS + 1
 6039 T:ef2d  69 81                              adc #$81             ; 
 6040 T:ef2f  f0 f3                              beq L_EXP_2             ; OVERFLOW
 6041 T:ef31  38                                 sec                    ; BACK OFF TO NORMAL BIAS
 6042 T:ef32  e9 01                              sbc #1             ; 
 6043 T:ef34  48                                 pha                    ; SAVE EXPONENT
 6044 T:ef35                                    ; --------------------------------
 6045 T:ef35  a2 05                              ldx #5             ; SWAP ARG AND FAC
 6046 T:ef37  b5 a5                    L_EXP_4   lda ARG,X                       ; <<< WHY SWAP? IT IS DOING      >>>
 6047 T:ef39  b4 9d                              ldy FAC,X                       ; <<< -(A-B) WHEN (B-A) IS THE   >>>
 6048 T:ef3b  95 9d                              sta FAC,X                       ; <<< SAME THING!                >>>
 6049 T:ef3d  94 a5                              sty ARG,X
 6050 T:ef3f  ca                                 dex 
 6051 T:ef40  10 f5                              bpl L_EXP_4
 6052 T:ef42  a5 92                              lda ARG_EXTENSION
 6053 T:ef44  85 ac                              sta FAC_EXTENSION
 6054 T:ef46  20 aa 17                           jsr FSUBT             ; POWER-INT(POWER) --> FRACTIONAL PART
 6055 T:ef49  20 d0 1e                           jsr NEGOP
 6056 T:ef4c  a9 e0                              lda #<POLY_EXP
 6057 T:ef4e  a0 1e                              ldy #>POLY_EXP
 6058 T:ef50  20 72 1f                           jsr POLYNOMIAL                ; COMPUTE F(X) ON FRACTIONAL PART
 6059 T:ef53  a9 00                              lda #0
 6060 T:ef55  85 ab                              sta SGNCPR
 6061 T:ef57  68                                 pla                    ; GET EXPONENT
 6062 T:ef58  20 10 1a                           jsr ADD_EXPONENTS_1
 6063 T:ef5b  60                                 rts                    ; <<< WASTED BYTE HERE, COULD HAVE >>>
 6064 T:ef5c                                    ; <<< JUST USED "JMP ADD.EXPO..."  >>>
 6065 T:ef5c                                    ; --------------------------------
 6066 T:ef5c                                    ; ODD POLYNOMIAL SUBROUTINE
 6067 T:ef5c                                    ; 
 6068 T:ef5c                                    ; F(X) = X * P(X^2)
 6069 T:ef5c                                    ; 
 6070 T:ef5c                                    ; WHERE:  X IS VALUE IN FAC
 6071 T:ef5c                                    ; Y,A POINTS AT COEFFICIENT TABLE
 6072 T:ef5c                                    ; FIRST BYTE OF COEFF. TABLE IS N
 6073 T:ef5c                                    ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
 6074 T:ef5c                                    ; 
 6075 T:ef5c                                    ; P(X^2) COMPUTED USING NORMAL POLYNOMIAL SUBROUTINE
 6076 T:ef5c                                    ; 
 6077 T:ef5c                                    ; --------------------------------
 6078 T:ef5c                           POLYNOMIAL_ODD 
 6079 T:ef5c  85 ad                              sta SERPNT                ; SAVE ADDRESS OF COEFFICIENT TABLE
 6080 T:ef5e  84 ae                              sty SERPNT+1
 6081 T:ef60  20 21 1b                           jsr STORE_FAC_IN_TEMP1_ROUNDED
 6082 T:ef63  a9 93                              lda #TEMP1               ; Y=0 ALREADY, SO Y,A POINTS AT TEMP1
 6083 T:ef65  20 7f 19                           jsr FMULT             ; FORM X^2
 6084 T:ef68  20 76 1f                           jsr SERMAIN                ; DO SERIES IN X^2
 6085 T:ef6b  a9 93                              lda #<TEMP1              ; GET X AGAIN
 6086 T:ef6d  a0 00                              ldy #>TEMP1              ; 
 6087 T:ef6f  4c 7f 19                           jmp FMULT             ; MULTIPLY X BY P(X^2) AND EXIT
 6088 T:ef72                                    ; --------------------------------
 6089 T:ef72                                    ; NORMAL POLYNOMIAL SUBROUTINE
 6090 T:ef72                                    ; 
 6091 T:ef72                                    ; P(X) = C(0)*X^N + C(1)*X^(N-1) + ... + C(N)
 6092 T:ef72                                    ; 
 6093 T:ef72                                    ; WHERE:  X IS VALUE IN FAC
 6094 T:ef72                                    ; Y,A POINTS AT COEFFICIENT TABLE
 6095 T:ef72                                    ; FIRST BYTE OF COEFF. TABLE IS N
 6096 T:ef72                                    ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
 6097 T:ef72                                    ; 
 6098 T:ef72                                    ; --------------------------------
 6099 T:ef72                           POLYNOMIAL 
 6100 T:ef72  85 ad                              sta SERPNT                ; POINTER TO COEFFICIENT TABLE
 6101 T:ef74  84 ae                              sty SERPNT+1
 6102 T:ef76                                    ; --------------------------------
 6103 T:ef76                           SERMAIN   
 6104 T:ef76  20 1e 1b                           jsr STORE_FAC_IN_TEMP2_ROUNDED
 6105 T:ef79  b1 ad                              lda (SERPNT),Y                  ; GET N
 6106 T:ef7b  85 a3                              sta SERLEN                ; SAVE N
 6107 T:ef7d  a4 ad                              ldy SERPNT                ; BUMP PNTR TO HIGHEST COEFFICIENT
 6108 T:ef7f  c8                                 iny                    ; AND GET PNTR INTO Y,A
 6109 T:ef80  98                                 tya 
 6110 T:ef81  d0 02                              bne L_SERMAIN_1
 6111 T:ef83  e6 ae                              inc SERPNT+1
 6112 T:ef85  85 ad                    L_SERMAIN_1 sta SERPNT
 6113 T:ef87  a4 ae                              ldy SERPNT+1
 6114 T:ef89  20 7f 19                 L_SERMAIN_2 jsr FMULT          ; ACCUMULATE SERIES TERMS
 6115 T:ef8c  a5 ad                              lda SERPNT                ; BUMP PNTR TO NEXT COEFFICIENT
 6116 T:ef8e  a4 ae                              ldy SERPNT+1
 6117 T:ef90  18                                 clc 
 6118 T:ef91  69 05                              adc #5
 6119 T:ef93  90 01                              bcc L_SERMAIN_3
 6120 T:ef95  c8                                 iny 
 6121 T:ef96  85 ad                    L_SERMAIN_3 sta SERPNT
 6122 T:ef98  84 ae                              sty SERPNT+1
 6123 T:ef9a  20 be 17                           jsr FADD             ; ADD NEXT COEFFICIENT
 6124 T:ef9d  a9 98                              lda #TEMP2               ; POINT AT X AGAIN
 6125 T:ef9f  a0 00                              ldy #0             ; 
 6126 T:efa1  c6 a3                              dec SERLEN                ; IF SERIES NOT FINISHED,
 6127 T:efa3  d0 e4                              bne L_SERMAIN_2             ; THEN ADD ANOTHER TERM
 6128 T:efa5  60                       RTS_19    rts                 ; FINISHED
 6129 T:efa6                                    ; --------------------------------

 6131 T:efa6  98 35 44 7a              CON_RND_1 .byt $98,$35,$44,$7a; <<< THESE ARE MISSING ONE BYTE >>>
 6132 T:efaa  68 28 b1 46              CON_RND_2 .byt $68,$28,$b1,$46; <<< FOR FP VALUES              >>>
 6133 T:efae                                    ; --------------------------------
 6134 T:efae                                    ; "RND" FUNCTION
 6135 T:efae                                    ; --------------------------------
 6136 T:efae  20 82 1b                 RND       jsr SIGN          ; REDUCE ARGUMENT TO -1, 0, OR +1
 6137 T:efb1  aa                                 tax                    ; SAVE ARGUMENT
 6138 T:efb2  30 18                              bmi L_RND_1                ; = -1, USE CURRENT ARGUMENT FOR SEED
 6139 T:efb4  a9 c9                              lda #<RNDSEED              ; USE CURRENT SEED
 6140 T:efb6  a0 00                              ldy #>RNDSEED
 6141 T:efb8  20 f9 1a                           jsr LOAD_FAC_FROM_YA
 6142 T:efbb  8a                                 txa                    ; RECALL SIGN OF ARGUMENT
 6143 T:efbc  f0 e7                              beq RTS_19             ; =0, RETURN SEED UNCHANGED
 6144 T:efbe  a9 a6                              lda #<CON_RND_1           ; VERY POOR RND ALGORITHM
 6145 T:efc0  a0 1f                              ldy #>CON_RND_1
 6146 T:efc2  20 7f 19                           jsr FMULT
 6147 T:efc5  a9 aa                              lda #<CON_RND_2           ; ALSO, CONSTANTS ARE TRUNCATED
 6148 T:efc7  a0 1f                              ldy #>CON_RND_2           ; <<<THIS DOES NOTHING, DUE TO >>>
 6149 T:efc9                                    ; <<<SMALL EXPONENT            >>>
 6150 T:efc9  20 be 17                           jsr FADD
 6151 T:efcc  a6 a1                    L_RND_1   ldx FAC+4       ; SHUFFLE HI AND LO BYTES
 6152 T:efce  a5 9e                              lda FAC+1          ; TO SUPPOSEDLY MAKE IT MORE RANDOM
 6153 T:efd0  85 a1                              sta FAC+4          ; 
 6154 T:efd2  86 9e                              stx FAC+1          ; 
 6155 T:efd4  a9 00                              lda #0             ; MAKE IT POSITIVE
 6156 T:efd6  85 a2                              sta FAC_SIGN                ; 
 6157 T:efd8  a5 9d                              lda FAC                ; A SOMEWHAT RANDOM EXTENSION
 6158 T:efda  85 ac                              sta FAC_EXTENSION
 6159 T:efdc  a9 80                              lda #$80             ; EXPONENT TO MAKE VALUE < 1.0
 6160 T:efde  85 9d                              sta FAC
 6161 T:efe0  20 2e 18                           jsr NORMALIZE_FAC_2
 6162 T:efe3  a2 c9                              ldx #<RNDSEED              ; MOVE FAC TO RND SEED
 6163 T:efe5  a0 00                              ldy #>RNDSEED
 6164 T:efe7  4c 2b 1b                 GO_MOVMF  jmp STORE_FACDB_YX_ROUNDED
