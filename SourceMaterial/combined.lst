 6290 T:f09e                                    ; "ATN" FUNCTION
 6291 T:f09e                                    ; --------------------------------
 6292 T:f09e  a5 a2                    ATN       lda FAC_SIGN             ; FOLD THE ARGUMENT RANGE FIRST
 6293 T:f0a0  48                                 pha                    ; SAVE SIGN FOR LATER UNFOLDING
 6294 T:f0a1  10 03                              bpl L_ATN_1                ; .GE. 0
 6295 T:f0a3  20 d0 1e                           jsr NEGOP             ; .LT. 0, SO COMPLEMENT
 6296 T:f0a6  a5 9d                    L_ATN_1   lda FAC             ; IF .GE. 1, FORM RECIPROCAL
 6297 T:f0a8  48                                 pha                    ; SAVE FOR LATER UNFOLDING
 6298 T:f0a9  c9 81                              cmp #$81             ; (EXPONENT FOR .GE. 1
 6299 T:f0ab  90 07                              bcc L_ATN_2                ; X < 1
 6300 T:f0ad  a9 13                              lda #<CON_ONE           ; FORM 1/X
 6301 T:f0af  a0 19                              ldy #>CON_ONE
 6302 T:f0b1  20 66 1a                           jsr FDIV
 6303 T:f0b4                                    ; --------------------------------
 6304 T:f0b4                                    ; 0 <= X <= 1
 6305 T:f0b4                                    ; 0 <= ATN(X) <= PI/8
 6306 T:f0b4                                    ; --------------------------------
 6307 T:f0b4  a9 ce                    L_ATN_2   lda #<POLY_ATN           ; COMPUTE POLYNOMIAL APPROXIMATION
 6308 T:f0b6  a0 20                              ldy #>POLY_ATN
 6309 T:f0b8  20 5c 1f                           jsr POLYNOMIAL_ODD
 6310 T:f0bb  68                                 pla                    ; START TO UNFOLD
 6311 T:f0bc  c9 81                              cmp #$81             ; WAS IT .GE. 1?
 6312 T:f0be  90 07                              bcc L_ATN_3                ; NO
 6313 T:f0c0  a9 66                              lda #<CON_PI_HALF           ; YES, SUBTRACT FROM PI/2
 6314 T:f0c2  a0 20                              ldy #>CON_PI_HALF           ; 
 6315 T:f0c4  20 a7 17                           jsr FSUB             ; 
 6316 T:f0c7  68                       L_ATN_3   pla                 ; WAS IT NEGATIVE?
 6317 T:f0c8  10 03                              bpl RTS_20                ; NO
 6318 T:f0ca  4c d0 1e                           jmp NEGOP             ; YES, COMPLEMENT
 6319 T:f0cd  60                       RTS_20    rts 
