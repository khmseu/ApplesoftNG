 6680 T:f2d9  66 d8                              ror ERRFLG                ; 
 6681 T:f2db  a5 75                              lda CURLIN                ; SAVE LINE # OF CURRENT LINE
 6682 T:f2dd  85 f6                              sta CURLSV                ; 
 6683 T:f2df  a5 76                              lda CURLIN+1          ; 
 6684 T:f2e1  85 f7                              sta CURLSV+1          ; 
 6685 T:f2e3  20 a6 09                           jsr REMN             ; IGNORE REST OF LINE <<<WHY?>>>
 6686 T:f2e6  4c 98 09                           jmp ADDON             ; CONTINUE PROGRAM
 6687 T:f2e9                                    ; --------------------------------
 6688 T:f2e9                                    ; ROUTINE TO HANDLE ERRORS IF ONERR GOTO ACTIVE
 6689 T:f2e9                                    ; --------------------------------
 6690 T:f2e9                           HANDLERR                   ; 
 6691 T:f2e9  86 de                              stx ERRNUM                ; SAVE ERROR CODE NUMBER
 6692 T:f2eb  a6 f8                              ldx REMSTK                ; GET STACK PNTR SAVED AT NEWSTT
 6693 T:f2ed  86 df                              stx ERRSTK                ; REMEMBER IT
 6694 T:f2ef                                    ; <<<COULD ALSO HAVE DONE TXS  >>>
 6695 T:f2ef                                    ; <<<HERE; SEE ONERR CORRECTION>>>
 6696 T:f2ef                                    ; <<<IN APPLESOFT MANUAL.      >>>
 6697 T:f2ef  a5 75                              lda CURLIN                ; GET LINE # OF OFFENDING STATEMENT
 6698 T:f2f1  85 da                              sta ERRLIN                ; SO USER CAN SEE IT IF DESIRED
 6699 T:f2f3  a5 76                              lda CURLIN+1          ; 
 6700 T:f2f5  85 db                              sta ERRLIN+1          ; 
 6701 T:f2f7  a5 79                              lda OLDTEXT                ; ALSO THE POSITION IN THE LINE
 6702 T:f2f9  85 dc                              sta ERRPOS                ; IN CASE USER WANTS TO "RESUME"
 6703 T:f2fb  a5 7a                              lda OLDTEXT+1          ; 
 6704 T:f2fd  85 dd                              sta ERRPOS+1          ; 
 6705 T:f2ff  a5 f4                              lda TXTPSV                ; SET UP TXTPTR TO READ TARGET LINE #
 6706 T:f301  85 b8                              sta TXTPTR                ; IN "ON ERR GO TO XXXX"
 6707 T:f303  a5 f5                              lda TXTPSV+1          ; 
 6708 T:f305  85 b9                              sta TXTPTR+1          ; 
 6709 T:f307  a5 f6                              lda CURLSV                ; 
 6710 T:f309  85 75                              sta CURLIN                ; LINE # OF "ON ERR" STATEMENT
 6711 T:f30b  a5 f7                              lda CURLSV+1          ; 
 6712 T:f30d  85 76                              sta CURLIN+1          ; 
 6713 T:f30f  20 b7 00                           jsr CHRGOT                ; START CONVERSION
 6714 T:f312  20 3e 09                           jsr GOTO             ; GOTO SPECIFIED ONERR LINE
 6715 T:f315  4c d2 07                           jmp NEWSTT             ; 
 6716 T:f318                                    ; --------------------------------
 6717 T:f318                                    ; "RESUME" STATEMENT
 6718 T:f318                                    ; --------------------------------
 6719 T:f318  a5 da                    RESUME    lda ERRLIN             ; RESTORE LINE # AND TXTPTR
 6720 T:f31a  85 75                              sta CURLIN                ; TO RE-TRY OFFENDING LINE
 6721 T:f31c  a5 db                              lda ERRLIN+1          ; 
 6722 T:f31e  85 76                              sta CURLIN+1          ; 
 6723 T:f320  a5 dc                              lda ERRPOS                ; 
 6724 T:f322  85 b8                              sta TXTPTR                ; 
 6725 T:f324  a5 dd                              lda ERRPOS+1          ; 
 6726 T:f326  85 b9                              sta TXTPTR+1          ; 
 6727 T:f328                                    ; <<< ONERR CORRECTION IN MANUAL IS EASILY >>>
 6728 T:f328                                    ; <<< BY "CALL -3288", WHICH IS $F328 HERE >>>
 6729 T:f328  a6 df                              ldx ERRSTK                ; RETRIEVE STACK PNTR AS IT WAS
 6730 T:f32a  9a                                 txs                    ; BEFORE STATEMENT SCANNED
 6731 T:f32b  4c d2 07                           jmp NEWSTT             ; DO STATEMENT AGAIN
 6732 T:f32e                                    ; --------------------------------
 6733 T:f32e  4c c9 0e                 JSYN      jmp SYNERR          ; 
