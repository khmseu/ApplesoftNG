 7482 T:f72d                                    ; SET UP FOR DRAW AND XDRAW
 7483 T:f72d                                    ; --------------------------------
 7484 T:f72d  20 f8 16                 DRWPNT    jsr GETBYT          ; GET SHAPE NUMBER IN X-REG
 7485 T:f730  a5 e8                              lda HGR_SHAPE_PNTR                ; SEARCH FOR THAT SHAPE
 7486 T:f732  85 1a                              sta HGR_SHAPE                ; SET UP PNTR TO BEGINNING OF TABLE
 7487 T:f734  a5 e9                              lda HGR_SHAPE_PNTR+1
 7488 T:f736  85 1b                              sta HGR_SHAPE+1
 7489 T:f738  8a                                 txa 
 7490 T:f739  a2 00                              ldx #0
 7491 T:f73b  c1 1a                              cmp (HGR_SHAPE,X)               ; COMPARE TO # OF SHAPES IN TABLE
 7492 T:f73d  f0 02                              beq L_DRWPNT_1                ; LAST SHAPE IN TABLE
 7493 T:f73f  b0 a5                              bcs GGERR             ; SHAPE # TOO LARGE
 7494 T:f741  0a                       L_DRWPNT_1 asl                 ; DOUBLE SHAPE# TO MAKE AN INDEX
 7495 T:f742  90 03                              bcc L_DRWPNT_2                ; ADD 256 IF SHAPE # > 127
 7496 T:f744  e6 1b                              inc HGR_SHAPE+1
 7497 T:f746  18                                 clc 
 7498 T:f747  a8                       L_DRWPNT_2 tay                 ; USE INDEX TO LOOK UP OFFSET FOR SHAPE
 7499 T:f748  b1 1a                              lda (HGR_SHAPE),Y               ; IN OFFSET TABLE
 7500 T:f74a  65 1a                              adc HGR_SHAPE
 7501 T:f74c  aa                                 tax 
 7502 T:f74d  c8                                 iny 
 7503 T:f74e  b1 1a                              lda (HGR_SHAPE),Y
 7504 T:f750  65 e9                              adc HGR_SHAPE_PNTR+1
 7505 T:f752  85 1b                              sta HGR_SHAPE+1          ; SAVE ADDRESS OF SHAPE
 7506 T:f754  86 1a                              stx HGR_SHAPE
