 3059 T:de60                                    ; GET ELEMENT IN EXPRESSION
 3060 T:de60                                    ; 
 3061 T:de60                                    ; GET VALUE OF VARIABLE OR NUMBER AT TXTPNT, OR POINT
 3062 T:de60                                    ; TO STRING DESCRIPTOR IF A STRING, AND PUT IN FAC.
 3063 T:de60                                    ; --------------------------------
 3064 T:de60                           FRM_ELEMENT                  ; 
 3065 T:de60  a9 00                              lda #0             ; ASSUME NUMERIC
 3066 T:de62  85 11                              sta VALTYP                ; 
 3067 T:de64  20 b1 00                 L_FRM_ELEMENT_1 jsr CHRGET             ; 
 3068 T:de67  b0 03                              bcs L_FRM_ELEMENT_3                ; NOT A DIGIT
 3069 T:de69  4c 4a 1c                 L_FRM_ELEMENT_2 jmp FIN             ; NUMERIC CONSTANT
