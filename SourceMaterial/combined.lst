 2947 T:dde4                           FRM_RELATIONAL 
 2948 T:dde4  46 11                              lsr VALTYP                ; (VALTYP) = 0 (NUMERIC), = $FF (STRING)
 2949 T:dde6  8a                                 txa                    ; SET CPRTYP TO 0000<=>C
 2950 T:dde7  2a                                 rol                    ; WHERE C=0 IF #, C=1 IF STRING
 2951 T:dde8  a6 b8                              ldx TXTPTR                ; BACK UP TXTPTR
 2952 T:ddea  d0 02                              bne L_FRM_RELATIONAL_1
 2953 T:ddec  c6 b9                              dec TXTPTR+1
