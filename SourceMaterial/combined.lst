 4739 T:e7a0                                    ; ADD 0L_RTS_10_5 TO FAC
 4740 T:e7a0                                    ; --------------------------------
 4741 T:e7a0  a9 64                    FADDH     lda #<CON_HALF           ; FAC+1/2 -> FAC
 4742 T:e7a2  a0 1e                              ldy #>CON_HALF
 4743 T:e7a4  4c be 17                           jmp FADD
 4744 T:e7a7                                    ; --------------------------------
 4745 T:e7a7                                    ; FAC = (Y,A) - FAC
 4746 T:e7a7                                    ; --------------------------------
 4747 T:e7a7  20 e3 19                 FSUB      jsr LOAD_ARG_FROM_YA
 4748 T:e7aa                                    ; --------------------------------
 4749 T:e7aa                                    ; FAC = ARG - FAC
 4750 T:e7aa                                    ; --------------------------------
 4751 T:e7aa  a5 a2                    FSUBT     lda FAC_SIGN             ; COMPLEMENT FAC AND ADD
 4752 T:e7ac  49 ff                              eor #$ff             ; 
 4753 T:e7ae  85 a2                              sta FAC_SIGN                ; 
 4754 T:e7b0  45 aa                              eor ARG_SIGN                ; FIX SGNCPR TOO
 4755 T:e7b2  85 ab                              sta SGNCPR                ; 
 4756 T:e7b4  a5 9d                              lda FAC                ; MAKE STATUS SHOW FAC EXPONENT
 4757 T:e7b6  4c c1 17                           jmp FADDT                ; JOIN FADD
 4758 T:e7b9                                    ; --------------------------------
 4759 T:e7b9                                    ; SHIFT SMALLER ARGUMENT MORE THAN 7 BITS
 4760 T:e7b9                                    ; --------------------------------
 4761 T:e7b9  20 f0 18                 FADD_1    jsr SHIFT_RIGHT             ; ALIGN RADIX BY SHIFTING
 4762 T:e7bc  90 3c                              bcc FADD_3                ; ...ALWAYS
 4763 T:e7be                                    ; --------------------------------
 4764 T:e7be                                    ; FAC = (Y,A) + FAC
 4765 T:e7be                                    ; --------------------------------
 4766 T:e7be  20 e3 19                 FADD      jsr LOAD_ARG_FROM_YA
 4767 T:e7c1                                    ; --------------------------------
 4768 T:e7c1                                    ; FAC = ARG + FAC
 4769 T:e7c1                                    ; --------------------------------
 4770 T:e7c1  d0 03                    FADDT     bne L_FADDT_1             ; FAC IS NON-ZERO
 4771 T:e7c3  4c 53 1b                           jmp COPY_ARG_TO_FAC                ; FAC = 0 + ARG
 4772 T:e7c6  a6 ac                    L_FADDT_1 ldx FAC_EXTENSION
 4773 T:e7c8  86 92                              stx ARG_EXTENSION
 4774 T:e7ca  a2 a5                              ldx #ARG               ; SET UP TO SHIFT ARG
 4775 T:e7cc  a5 a5                              lda ARG                ; EXPONENT
 4776 T:e7ce                                    ; --------------------------------
 4777 T:e7ce  a8                       FADD_2    tay 
 4778 T:e7cf  f0 ce                              beq RTS_10             ; IF ARG=0, WE ARE FINISHED
 4779 T:e7d1  38                                 sec                    ; 
 4780 T:e7d2  e5 9d                              sbc FAC                ; GET DIFFNCE OF EXP
 4781 T:e7d4  f0 24                              beq FADD_3                ; GO ADD IF SAME EXP
 4782 T:e7d6  90 12                              bcc L_FADD_2_1                ; ARG HAS SMALLER EXPONENT
 4783 T:e7d8  84 9d                              sty FAC                ; EXP HAS SMALLER EXPONENT
 4784 T:e7da  a4 aa                              ldy ARG_SIGN                ; 
 4785 T:e7dc  84 a2                              sty FAC_SIGN                ; 
 4786 T:e7de  49 ff                              eor #$ff             ; COMPLEMENT SHIFT COUNT
 4787 T:e7e0  69 00                              adc #0             ; CARRY WAS SET
 4788 T:e7e2  a0 00                              ldy #0
 4789 T:e7e4  84 92                              sty ARG_EXTENSION
 4790 T:e7e6  a2 9d                              ldx #FAC               ; SET UP TO SHIFT FAC
 4791 T:e7e8  d0 04                              bne L_FADD_2_2                ; ...ALWAYS
 4792 T:e7ea  a0 00                    L_FADD_2_1 ldy #0
 4793 T:e7ec  84 ac                              sty FAC_EXTENSION
 4794 T:e7ee  c9 f9                    L_FADD_2_2 cmp #$f9          ; SHIFT MORE THAN 7 BITS?
 4795 T:e7f0  30 c7                              bmi FADD_1             ; YES
 4796 T:e7f2  a8                                 tay                    ; INDEX TO # OF SHIFTS
 4797 T:e7f3  a5 ac                              lda FAC_EXTENSION
 4798 T:e7f5  56 01                              lsr 1,X                         ; START SHIFTING...
 4799 T:e7f7  20 07 19                           jsr SHIFT_RIGHT_4                ; ...COMPLETE SHIFTING
 4800 T:e7fa  24 ab                    FADD_3    bit SGNCPR             ; DO FAC AND ARG HAVE SAME SIGNS?
 4801 T:e7fc  10 57                              bpl FADD_4                ; YES, ADD THE MANTISSAS
 4802 T:e7fe  a0 9d                              ldy #FAC               ; NO, SUBTRACT SMALLER FROM LARGER
 4803 T:e800  e0 a5                              cpx #ARG               ; WHICH WAS ADJUSTED?
 4804 T:e802  f0 02                              beq L_FADD_3_1                ; IF ARG, DO FAC-ARG
 4805 T:e804  a0 a5                              ldy #ARG               ; IF FAC, DO ARG-FAC
 4806 T:e806  38                       L_FADD_3_1 sec                 ; SUBTRACT SMALLER FROM LARGER (WE HOPE)
 4807 T:e807  49 ff                              eor #$ff             ; (IF EXPONENTS WERE EQUAL, WE MIGHT BE
 4808 T:e809  65 92                              adc ARG_EXTENSION                ; SUBTRACTING LARGER FROM SMALLER)
 4809 T:e80b  85 ac                              sta FAC_EXTENSION
 4810 T:e80d  b9 04 00                           lda 4,Y
 4811 T:e810  f5 04                              sbc 4,X
 4812 T:e812  85 a1                              sta FAC+4
 4813 T:e814  b9 03 00                           lda 3,Y
 4814 T:e817  f5 03                              sbc 3,X
 4815 T:e819  85 a0                              sta FAC+3
 4816 T:e81b  b9 02 00                           lda 2,Y
 4817 T:e81e  f5 02                              sbc 2,X
 4818 T:e820  85 9f                              sta FAC+2
 4819 T:e822  b9 01 00                           lda 1,Y
 4820 T:e825  f5 01                              sbc 1,X
 4821 T:e827  85 9e                              sta FAC+1
