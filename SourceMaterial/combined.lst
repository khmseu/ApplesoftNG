 6622 T:f279  a2 00                    N_I_      ldx #0          ; AND FLASH.BIT = $00
 6623 T:f27b  85 32                    N_I_F_    sta MON_INVFLG
 6624 T:f27d  86 f3                              stx FLASH_BIT
 6625 T:f27f  60                                 rts 
