 6857 T:f400  91 1a                              sta (HGR_SHAPE),Y               ; CLEAR HIRES TO HGR.BITS
 6858 T:f402  20 7e 24                           jsr COLOR_SHIFT                ; CORRECT FOR COLOR SHIFT
 6859 T:f405  c8                                 iny                    ; (SLOWS CLEAR BY FACTOR OF 2)
 6860 T:f406  d0 f6                              bne L_BKGND_1
 6861 T:f408  e6 1b                              inc HGR_SHAPE+1
 6862 T:f40a  a5 1b                              lda HGR_SHAPE+1
