 3054 T:de5b  85 ab                              sta SGNCPR                ; IN CASE OF MULTIPLY OR DIVIDE
 3055 T:de5d  a5 9d                    EXIT      lda FAC             ; FAC EXPONENT IN A-REG
 3056 T:de5f  60                                 rts                    ; STATUS EQU. IF (FAC)=0
