 6220 T:f033  a9 75                    L_SIN_2_1 lda #<POLY_SIN           ; DO STANDARD SIN SERIES
 6221 T:f035  a0 20                              ldy #>POLY_SIN              ; 
 6222 T:f037  4c 5c 1f                           jmp POLYNOMIAL_ODD             ; 
 6223 T:f03a                                    ; --------------------------------
 6224 T:f03a                                    ; "TAN" FUNCTION
 6225 T:f03a                                    ; 
 6226 T:f03a                                    ; COMPUTE TAN(X) = SIN(X) / COS(X)
 6227 T:f03a                                    ; --------------------------------
 6228 T:f03a  20 21 1b                 TAN       jsr STORE_FAC_IN_TEMP1_ROUNDED
 6229 T:f03d  a9 00                              lda #0             ; SIGNFLG WILL BE TOGGLED IF 2ND OR 3RD
 6230 T:f03f  85 16                              sta SIGNFLG                ; QUADRANT
 6231 T:f041  20 f1 1f                           jsr SIN             ; GET SIN(X)
 6232 T:f044  a2 8a                              ldx #<TEMP3              ; SAVE SIN(X) IN TEMP3
 6233 T:f046  a0 00                              ldy #>TEMP3              ; 
 6234 T:f048  20 e7 1f                           jsr GO_MOVMF             ; <<<FUNNY WAY TO CALL MOVMF! >>>
 6235 T:f04b  a9 93                              lda #<TEMP1              ; RETRIEVE X
 6236 T:f04d  a0 00                              ldy #>TEMP1              ; 
 6237 T:f04f  20 f9 1a                           jsr LOAD_FAC_FROM_YA
 6238 T:f052  a9 00                              lda #0             ; AND COMPUTE COS(X)
 6239 T:f054  85 a2                              sta FAC_SIGN                ; 
 6240 T:f056  a5 16                              lda SIGNFLG                ; 
 6241 T:f058  20 62 20                           jsr TAN_1                ; WEIRD & DANGEROUS WAY TO GET INTO SIN
 6242 T:f05b  a9 8a                              lda #<TEMP3              ; NOW FORM SIN/COS
 6243 T:f05d  a0 00                              ldy #>TEMP3              ; 
 6244 T:f05f  4c 66 1a                           jmp FDIV             ; 
 6245 T:f062                                    ; --------------------------------
 6246 T:f062  48                       TAN_1     pha                 ; SHAME, SHAME!
 6247 T:f063  4c 23 20                           jmp SIN_1
