 6335 T:f10b                                    ; GENERIC COPY OF CHRGET SUBROUTINE, WHICH
 6336 T:f10b                                    ; IS COPIED INTO $00B1...$00C8 DURING INITIALIZATION
 6337 T:f10b                                    ; 
 6338 T:f10b                                    ; CORNELIS BONGERS DESCRIBED SEVERAL IMPROVEMENTS
 6339 T:f10b                                    ; TO CHRGET IN MICRO MAGAZINE OR CALL A.P.P.L.E.
 6340 T:f10b                                    ; (I DON'T REMEMBER WHICH OR EXACTLY WHEN)
 6341 T:f10b                                    ; --------------------------------
 6342 T:f10b                           GENERIC_CHRGET 
 6343 T:f10b  e6 b8                              inc TXTPTR
 6344 T:f10d  d0 02                              bne L_GENERIC_CHRGET_1
 6345 T:f10f  e6 b9                              inc TXTPTR+1
 6346 T:f111  ad 60 ea                 L_GENERIC_CHRGET_1 lda $ea60           ; <<< ACTUAL ADDRESS FILLED IN LATER >>>
 6347 T:f114  c9 3a                              cmp #(":"&%01111111)     ; EOS, ALSO TOP OF NUMERIC RANGE
 6348 T:f116  b0 0a                              bcs L_GENERIC_CHRGET_2                ; NOT NUMBER, MIGHT BE EOS
 6349 T:f118  c9 20                              cmp #(" "&%01111111)     ; IGNORE BLANKS
 6350 T:f11a  f0 ef                              beq GENERIC_CHRGET
 6351 T:f11c  38                                 sec                    ; TEST FOR NUMERIC RANGE IN WAY THAT
 6352 T:f11d  e9 30                              sbc #("0"&%01111111)     ; CLEARS CARRY IF CHAR IS DIGIT
 6353 T:f11f  38                                 sec                    ; AND LEAVES CHAR IN A-REG
 6354 T:f120  e9 d0                              sbc #$d0
 6355 T:f122  60                       L_GENERIC_CHRGET_2 rts 
