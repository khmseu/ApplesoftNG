 3319 T:dfe3                                    ; PTRGET -- GENERAL VARIABLE SCAN
 3320 T:dfe3                                    ; 
 3321 T:dfe3                                    ; SCANS VARIABLE NAME AT TXTPTR, AND SEARCHES THE
 3322 T:dfe3                                    ; VARTAB AND ARYTAB FOR THE NAME.
 3323 T:dfe3                                    ; IF NOT FOUND, CREATE VARIABLE OF APPROPRIATE TYPE.
 3324 T:dfe3                                    ; RETURN WITH ADDRESS IN VARPNT AND Y,A
 3325 T:dfe3                                    ; 
 3326 T:dfe3                                    ; ACTUAL ACTIVITY CONTROLLED SOMEWHAT BY TWO FLAGS:
 3327 T:dfe3                                    ; DIMFLG -- NONZERO IF CALLED FROM "DIM"
 3328 T:dfe3                                    ; ELSE = 0
 3329 T:dfe3                                    ; 
 3330 T:dfe3                                    ; SUBFLG -- = $00
 3331 T:dfe3                                    ; = $40 IF CALLED FROM "GETARYPT"
 3332 T:dfe3                                    ; = $80 IF CALLED FROM "DEF FN"
 3333 T:dfe3                                    ; = $C1-DA IF CALLED FROM "FN"
 3334 T:dfe3                                    ; --------------------------------
 3335 T:dfe3  a2 00                    PTRGET    ldx #0          ; 
 3336 T:dfe5  20 b7 00                           jsr CHRGOT                ; GET FIRST CHAR OF VARIABLE NAME
 3337 T:dfe8                                    ; --------------------------------
 3338 T:dfe8                           PTRGET2                    ; 
 3339 T:dfe8  86 10                              stx DIMFLG                ; X IS NONZERO IF FROM DIM
 3340 T:dfea                                    ; --------------------------------
 3341 T:dfea                           PTRGET3                    ; 
 3342 T:dfea  85 81                              sta VARNAM                ; 
 3343 T:dfec  20 b7 00                           jsr CHRGOT                ; 
