 6381 T:f146  85 0a                              sta USR                ; "USR" FUNCTION VECTOR
 6382 T:f148  a9 99                              lda #<IQERR           ; POINT "USR" TO ILLEGAL QUANTITY
 6383 T:f14a  a0 11                              ldy #>IQERR           ; ERROR, UNTIL USER SETS IT UP
 6384 T:f14c  85 0b                              sta USR+1
 6385 T:f14e  84 0c                              sty USR+2
