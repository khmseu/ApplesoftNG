 3075 T:de77  f0 55                              beq MIN                ; YES
 3076 T:de79  c9 c8                              cmp #TOKEN_PLUS               ; UNARY PLUS
 3077 T:de7b  f0 e7                              beq L_FRM_ELEMENT_1             ; YES
 3078 T:de7d  c9 22                              cmp #$22             ; STRING CONSTANT?
 3079 T:de7f  d0 0f                              bne NOT_                ; NO
