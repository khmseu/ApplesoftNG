 4715 T:e77b                                    ; "POKE" STATEMENT
 4716 T:e77b                                    ; --------------------------------
 4717 T:e77b  20 46 17                 POKE      jsr GTNUM          ; GET THE ADDRESS AND VALUE
 4718 T:e77e  8a                                 txa                    ; VALUE IN A,
 4719 T:e77f  a0 00                              ldy #0             ; 
 4720 T:e781  91 50                              sta (LINNUM),Y                  ; STORE IT AWAY,
 4721 T:e783  60                                 rts                    ; AND THAT'S ALL FOR TODAY
 4722 T:e784                                    ; --------------------------------
 4723 T:e784                                    ; "WAIT" STATEMENT
 4724 T:e784                                    ; --------------------------------
 4725 T:e784  20 46 17                 WAIT      jsr GTNUM          ; GET ADDRESS IN LINNUM, MASK IN X
 4726 T:e787  86 85                              stx FORPNT                ; SAVE MASK
 4727 T:e789  a2 00                              ldx #0             ; 
 4728 T:e78b  20 b7 00                           jsr CHRGOT                ; ANOTHER PARAMETER?
 4729 T:e78e  f0 03                              beq L_WAIT_1                ; NO, USE $00 FOR EXCLUSIVE-OR
 4730 T:e790  20 4c 17                           jsr COMBYTE             ; GET XOR-MASK
 4731 T:e793  86 86                    L_WAIT_1  stx FORPNT+1       ; SAVE XOR-MASK HERE
 4732 T:e795  a0 00                              ldy #0
 4733 T:e797  b1 50                    L_WAIT_2  lda (LINNUM),Y                  ; GET BYTE AT ADDRESS
 4734 T:e799  45 86                              eor FORPNT+1          ; INVERT SPECIFIED BITS
 4735 T:e79b  25 85                              and FORPNT                ; SELECT SPECIFIED BITS
 4736 T:e79d  f0 f8                              beq L_WAIT_2             ; LOOP TILL NOT 0
 4737 T:e79f  60                       RTS_10    rts 
