 2986 T:de12                                    ; Note: XA65 assembler (Andre Fachat) requires ! here when asm with "xa -R -bt 0" for some reason:
 2987 T:de12  be b2 00                           ldx !MATHTBL,Y                   ; PRECEDENCE BYTE FROM MATHTBL
