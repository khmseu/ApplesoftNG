 6651 T:f2a6                                    ; "LOMEM:" STATEMENT
 6652 T:f2a6                                    ; --------------------------------
 6653 T:f2a6  20 67 0d                 LOMEM     jsr FRMNUM          ; GET VALUE SPECIFIED FOR LOMEM
 6654 T:f2a9  20 52 17                           jsr GETADR             ; AS 16-BIT INTEGER IN LINNUM
 6655 T:f2ac  a5 50                              lda LINNUM                ; MUST BE BELOW HIMEM
 6656 T:f2ae  c5 73                              cmp MEMSIZ                ; 
 6657 T:f2b0  a5 51                              lda LINNUM+1          ; 
 6658 T:f2b2  e5 74                              sbc MEMSIZ+1          ; 
 6659 T:f2b4  b0 e0                              bcs JMM             ; ABOVE HIMEM, MEMORY ERROR
 6660 T:f2b6  a5 50                              lda LINNUM                ; MUST BE ABOVE PROGRAM
 6661 T:f2b8  c5 69                              cmp VARTAB                ; 
 6662 T:f2ba  a5 51                              lda LINNUM+1          ; 
 6663 T:f2bc  e5 6a                              sbc VARTAB+1          ; 
 6664 T:f2be  90 d6                              bcc JMM             ; NOT ABOVE PROGRAM, ERROR
 6665 T:f2c0  a5 50                              lda LINNUM                ; STORE NEW LOMEM VALUE
 6666 T:f2c2  85 69                              sta VARTAB                ; 
 6667 T:f2c4  a5 51                              lda LINNUM+1          ; 
 6668 T:f2c6  85 6a                              sta VARTAB+1          ; 
 6669 T:f2c8  4c 6c 06                           jmp CLEARC             ; LOMEM CLEARS VARIABLES AND ARRAYS
 6670 T:f2cb                                    ; --------------------------------
 6671 T:f2cb                                    ; "ON ERR GO TO" STATEMENT
 6672 T:f2cb                                    ; --------------------------------
 6673 T:f2cb  a9 ab                    ONERR     lda #TOKEN_GOTO            ; MUST BE "GOTO" NEXT
 6674 T:f2cd  20 c0 0e                           jsr SYNCHR
 6675 T:f2d0  a5 b8                              lda TXTPTR                ; SAVE TXTPTR FOR HANDLERR
 6676 T:f2d2  85 f4                              sta TXTPSV                ; 
 6677 T:f2d4  a5 b9                              lda TXTPTR+1          ; 
 6678 T:f2d6  85 f5                              sta TXTPSV+1          ; 
