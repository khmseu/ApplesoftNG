 4140 A:e452                                    ; MAKE SPACE FOR STRING AT BOTTOM OF STRING SPACE
 4141 A:e452                                    ; (A)=# BYTES SPACE TO MAKE
 4142 A:e452                                    ; 
 4143 A:e452                                    ; RETURN WITH (A) SAME,
 4144 A:e452                                    ; AND Y,X = ADDRESS OF SPACE ALLOCATED
 4145 A:e452                                    ; --------------------------------
 4146 A:e452  46 13                    AS_GETSPA lsr AS_GARFLG             ; CLEAR SIGNBIT OF FLAG
 4147 A:e454  48                       AS_L_GETSPA_1 pha                 ; A HOLDS LENGTH
 4148 A:e455  49 ff                              eor #$ff             ; GET -LENGTH
 4149 A:e457  38                                 sec                    ; 
