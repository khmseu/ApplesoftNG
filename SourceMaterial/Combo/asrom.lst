 3708 A:e1ed  50 08                              bvc AS_L_MAKE_NEW_ARRAY_5                ; NO, USE DEFAULT VALUE
 3709 A:e1ef  68                                 pla                    ; GET SPECIFIED DIM IN A,X
 3710 A:e1f0  18                                 clc                    ; # ELEMENTS IS 1 LARGER THAN
 3711 A:e1f1  69 01                              adc #1             ; DIMENSION VALUE
 3712 A:e1f3  aa                                 tax                    ; 
