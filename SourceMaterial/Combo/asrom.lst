 3773 A:e24b  b1 9b                              lda (AS_LOWTR),Y                   ; GET # OF DIMENSIONS
 3774 A:e24d  85 0f                              sta AS_NUMDIM                ; 
 3775 A:e24f  a9 00                              lda #0             ; ZERO SUBSCRIPT ACCUMULATOR
 3776 A:e251  85 ad                              sta AS_STRNG2                ; 
 3777 A:e253  85 ae                    AS_FAE_1  sta AS_STRNG2+1       ; 
 3778 A:e255  c8                                 iny                    ; 
 3779 A:e256  68                                 pla                    ; PULL NEXT SUBSCRIPT FROM STACK
 3780 A:e257  aa                                 tax                    ; SAVE IN FAC+3,4
 3781 A:e258  85 a0                              sta AS_FAC+3          ; AND COMPARE WITH DIMENSIONED SIZE
 3782 A:e25a  68                                 pla                    ; 
 3783 A:e25b  85 a1                              sta AS_FAC+4          ; 
 3784 A:e25d  d1 9b                              cmp (AS_LOWTR),Y                   ; 
 3785 A:e25f  90 0e                              bcc AS_FAE_2                ; SUBSCRIPT NOT TOO LARGE
 3786 A:e261  d0 06                              bne AS_GSE                ; SUBSCRIPT IS TOO LARGE
 3787 A:e263  c8                                 iny                    ; CHECK LOW-BYTE OF SUBSCRIPT
 3788 A:e264  8a                                 txa                    ; 
 3789 A:e265  d1 9b                              cmp (AS_LOWTR),Y                   ; 
 3790 A:e267  90 07                              bcc AS_FAE_3                ; NOT TOO LARGE
