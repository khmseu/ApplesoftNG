 3800 A:e277  20 ad e2                           jsr AS_MULTIPLY_SUBSCRIPT                ; NOT ZERO, SO MULTIPLY
 3801 A:e27a  8a                                 txa                    ; ADD CURRENT SUBSCRIPT
 3802 A:e27b  65 a0                              adc AS_FAC+3          ; 
 3803 A:e27d  aa                                 tax                    ; 
 3804 A:e27e  98                                 tya                    ; 
 3805 A:e27f  a4 5e                              ldy AS_INDEX                ; RETRIEVE Y SAVED BY MULTIPLY.SUBSCRIPT
 3806 A:e281  65 a1                    AS_L_FAE_3_1 adc AS_FAC+4       ; FINISH ADDING CURRENT SUBSCRIPT
 3807 A:e283  86 ad                              stx AS_STRNG2                ; STORE ACCUMULATED OFFSET
 3808 A:e285  c6 0f                              dec AS_NUMDIM                ; LAST SUBSCRIPT YET?
 3809 A:e287  d0 ca                              bne AS_FAE_1                ; NO, LOOP TILL DONE
 3810 A:e289  85 ae                              sta AS_STRNG2+1          ; YES, NOW MULTIPLY BE ELEMENT SIZE
 3811 A:e28b  a2 05                              ldx #5             ; START WITH SIZE = 5
 3812 A:e28d  a5 81                              lda AS_VARNAM                ; DETERMINE VARIABLE TYPE
 3813 A:e28f  10 01                              bpl AS_L_FAE_3_2                ; NOT INTEGER
 3814 A:e291  ca                                 dex                    ; INTEGER, BACK DOWN SIZE TO 4 BYTES
 3815 A:e292  a5 82                    AS_L_FAE_3_2 lda AS_VARNAM+1       ; DISCRIMINATE BETWEEN REAL AND STR
 3816 A:e294  10 02                              bpl AS_L_FAE_3_3                ; IT IS REAL
 3817 A:e296  ca                                 dex                    ; SIZE = 3 IF STRING, =2 IF INTEGER
 3818 A:e297  ca                                 dex                    ; 
 3819 A:e298  86 64                    AS_L_FAE_3_3 stx AS_RESULT+2       ; SET UP MULTIPLIER
 3820 A:e29a  a9 00                              lda #0             ; HI-BYTE OF MULTIPLIER
 3821 A:e29c  20 b6 e2                           jsr AS_MULTIPLY_SUBS_1                ; (STRNG2) BY ELEMENT SIZE
 3822 A:e29f  8a                                 txa                    ; ADD ACCUMULATED OFFSET
