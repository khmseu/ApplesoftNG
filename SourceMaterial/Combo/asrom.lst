 4151 A:e45a  a4 70                              ldy AS_FRETOP+1          ; FOR THE STRING
 4152 A:e45c  b0 01                              bcs AS_L_GETSPA_2                ; 
 4153 A:e45e  88                                 dey                    ; 
 4154 A:e45f  c4 6e                    AS_L_GETSPA_2 cpy AS_STREND+1       ; SEE IF FITS IN REMAINING MEMORY
 4155 A:e461  90 11                              bcc AS_L_GETSPA_4                ; NO, TRY GARBAGE
 4156 A:e463  d0 04                              bne AS_L_GETSPA_3                ; YES, IT FITS
 4157 A:e465  c5 6d                              cmp AS_STREND                ; HAVE TO CHECK LOWER BYTES
 4158 A:e467  90 0b                              bcc AS_L_GETSPA_4                ; NOT ENUF ROOM YET
 4159 A:e469  85 6f                    AS_L_GETSPA_3 sta AS_FRETOP             ; THERE IS ROOM SO SAVE NEW FRETOP
 4160 A:e46b  84 70                              sty AS_FRETOP+1          ; 
 4161 A:e46d  85 71                              sta AS_FRESPC                ; 
 4162 A:e46f  84 72                              sty AS_FRESPC+1          ; 
 4163 A:e471  aa                                 tax                    ; ADDR IN Y,X
 4164 A:e472  68                                 pla                    ; LENGTH IN A
 4165 A:e473  60                                 rts 
 4166 A:e474  a2 4d                    AS_L_GETSPA_4 ldx #AS_ERR_MEMFULL
 4167 A:e476  a5 13                              lda AS_GARFLG                ; GARBAGE DONE YET?
 4168 A:e478  30 b8                              bmi AS_JERR                ; YES, MEMORY IS REALLY FULL
 4169 A:e47a  20 84 e4                           jsr AS_GARBAG                ; NO, TRY COLLECTING NOW
 4170 A:e47d  a9 80                              lda #$80             ; FLAG THAT COLLECTED GARBAGE ALREADY
 4171 A:e47f  85 13                              sta AS_GARFLG                ; 
 4172 A:e481  68                                 pla                    ; GET STRING LENGTH AGAIN
 4173 A:e482  d0 d0                              bne AS_L_GETSPA_1                ; ...ALWAYS
 4174 A:e484                                    ; --------------------------------
 4175 A:e484                                    ; SHOVE ALL REFERENCED STRINGS AS HIGH AS POSSIBLE
 4176 A:e484                                    ; IN MEMORY (AGAINST HIMEM), FREEING UP SPACE
 4177 A:e484                                    ; BELOW STRING AREA DOWN TO STREND.
 4178 A:e484                                    ; --------------------------------
 4179 A:e484  a6 73                    AS_GARBAG ldx AS_MEMSIZ             ; COLLECT FROM TOP DOWN
 4180 A:e486  a5 74                              lda AS_MEMSIZ+1          ; 
