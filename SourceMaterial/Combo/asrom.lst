 9116 A:fc3a  f0 de                              beq MON_UP                ;  D, GO UP
 9117 A:fc3c  69 fd                              adc #$fd             ;ESC-E OR F CHECK
 9118 A:fc3e  90 5c                              bcc MON_CLREOL                ;  E, CLEAR TO END OF LINE
 9119 A:fc40  d0 e9                              bne MON_RTS4                ;  NOT F, RETURN
 9120 A:fc42                                    ;  F, CLEAR TO END OF PAGE
