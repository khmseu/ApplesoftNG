 4096 A:e40e  85 ad                              sta AS_STRNG2                ; (OF 00 BYTE, OR JUST AFTER ")
 4097 A:e410  a6 ac                              ldx AS_STRNG1+1          ; 
 4098 A:e412  90 01                              bcc AS_L_STRLT2_5                ; 
 4099 A:e414  e8                                 inx                    ; 
 4100 A:e415  86 ae                    AS_L_STRLT2_5 stx AS_STRNG2+1       ; 
 4101 A:e417  a5 ac                              lda AS_STRNG1+1          ; WHERE DOES THE STRING START?
 4102 A:e419  f0 04                              beq AS_L_STRLT2_6                ; PAGE 0, MUST BE FROM STR$ FUNCTION
 4103 A:e41b  c9 02                              cmp #2             ; PAGE 2?
 4104 A:e41d  d0 0b                              bne AS_PUTNEW                ; NO, NOT PAGE 0 OR 2
 4105 A:e41f  98                       AS_L_STRLT2_6 tya                 ; LENGTH OF STRING
 4106 A:e420  20 d5 e3                           jsr AS_STRINI                ; MAKE SPACE FOR STRING
 4107 A:e423  a6 ab                              ldx AS_STRNG1                ; 
 4108 A:e425  a4 ac                              ldy AS_STRNG1+1          ; 
 4109 A:e427  20 e2 e5                           jsr AS_MOVSTR                ; MOVE IT IN
