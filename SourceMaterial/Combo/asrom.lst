 9111 A:fc30  69 fd                              adc #$fd             ;ESC-A OR B CHECK
 9112 A:fc32  90 c0                              bcc MON_ADVANCE                ;  A, ADVANCE
 9113 A:fc34  f0 da                              beq MON_BS                ;  B, BACKSPACE
 9114 A:fc36  69 fd                              adc #$fd             ;ESC-C OR D CHECK
