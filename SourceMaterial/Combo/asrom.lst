 1640 A:d607  b1 9d                              lda (AS_FAC),Y                     ; YES, AT NEXT NAME.  END OF TABLE?
 1641 A:d609  d0 9d                              bne AS_L_PARSE_7                ; NO, NOT END OF TABLE
