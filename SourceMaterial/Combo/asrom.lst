 6631 A:f284  d0 f5                              bne AS_N_I_F_                ; ...ALWAYS
 6632 A:f286                                    ; --------------------------------
 6633 A:f286                                    ; "HIMEM:" STATEMENT
 6634 A:f286                                    ; --------------------------------
 6635 A:f286  20 67 dd                 AS_HIMEM  jsr AS_FRMNUM             ; GET VALUE SPECIFIED FOR HIMEM
 6636 A:f289  20 52 e7                           jsr AS_GETADR                ; AS 16-BIT INTEGER
 6637 A:f28c  a5 50                              lda AS_LINNUM                ; MUST BE ABOVE VARIABLES AND ARRAYS
 6638 A:f28e  c5 6d                              cmp AS_STREND                ; 
 6639 A:f290  a5 51                              lda AS_LINNUM+1          ; 
 6640 A:f292  e5 6e                              sbc AS_STREND+1          ; 
 6641 A:f294  b0 03                              bcs AS_SETHI                ; IT IS ABOVE THEM
 6642 A:f296  4c 10 d4                 AS_JMM    jmp AS_MEMERR             ; NOT ENOUGH MEMORY
 6643 A:f299  a5 50                    AS_SETHI  lda AS_LINNUM             ; STORE NEW HIMEM: VALUE
 6644 A:f29b  85 73                              sta AS_MEMSIZ                ; 
 6645 A:f29d  85 6f                              sta AS_FRETOP                ; <<<NOTE THAT "HIMEM:" DOES NOT>>>
 6646 A:f29f  a5 51                              lda AS_LINNUM+1          ; <<<CLEAR STRING VARIABLES.    >>>
 6647 A:f2a1  85 74                              sta AS_MEMSIZ+1          ; <<<THIS COULD BE DISASTROUS.  >>>
 6648 A:f2a3  85 70                              sta AS_FRETOP+1          ; 
 6649 A:f2a5  60                                 rts                    ; 
 6650 A:f2a6                                    ; --------------------------------
 6651 A:f2a6                                    ; "LOMEM:" STATEMENT
 6652 A:f2a6                                    ; --------------------------------
 6653 A:f2a6  20 67 dd                 AS_LOMEM  jsr AS_FRMNUM             ; GET VALUE SPECIFIED FOR LOMEM
 6654 A:f2a9  20 52 e7                           jsr AS_GETADR                ; AS 16-BIT INTEGER IN LINNUM
 6655 A:f2ac  a5 50                              lda AS_LINNUM                ; MUST BE BELOW HIMEM
 6656 A:f2ae  c5 73                              cmp AS_MEMSIZ                ; 
 6657 A:f2b0  a5 51                              lda AS_LINNUM+1          ; 
 6658 A:f2b2  e5 74                              sbc AS_MEMSIZ+1          ; 
 6659 A:f2b4  b0 e0                              bcs AS_JMM                ; ABOVE HIMEM, MEMORY ERROR
 6660 A:f2b6  a5 50                              lda AS_LINNUM                ; MUST BE ABOVE PROGRAM
 6661 A:f2b8  c5 69                              cmp AS_VARTAB                ; 
 6662 A:f2ba  a5 51                              lda AS_LINNUM+1          ; 
 6663 A:f2bc  e5 6a                              sbc AS_VARTAB+1          ; 
 6664 A:f2be  90 d6                              bcc AS_JMM                ; NOT ABOVE PROGRAM, ERROR
 6665 A:f2c0  a5 50                              lda AS_LINNUM                ; STORE NEW LOMEM VALUE
 6666 A:f2c2  85 69                              sta AS_VARTAB                ; 
 6667 A:f2c4  a5 51                              lda AS_LINNUM+1          ; 
 6668 A:f2c6  85 6a                              sta AS_VARTAB+1          ; 
 6669 A:f2c8  4c 6c d6                           jmp AS_CLEARC                ; LOMEM CLEARS VARIABLES AND ARRAYS
 6670 A:f2cb                                    ; --------------------------------
 6671 A:f2cb                                    ; "ON ERR GO TO" STATEMENT
 6672 A:f2cb                                    ; --------------------------------
 6673 A:f2cb  a9 ab                    AS_ONERR  lda #AS_TOKEN_GOTO            ; MUST BE "GOTO" NEXT
 6674 A:f2cd  20 c0 de                           jsr AS_SYNCHR
 6675 A:f2d0  a5 b8                              lda AS_TXTPTR                ; SAVE TXTPTR FOR HANDLERR
 6676 A:f2d2  85 f4                              sta AS_TXTPSV                ; 
 6677 A:f2d4  a5 b9                              lda AS_TXTPTR+1          ; 
 6678 A:f2d6  85 f5                              sta AS_TXTPSV+1          ; 
 6679 A:f2d8  38                                 sec                    ; SET SIGN BIT OF ERRFLG
 6680 A:f2d9  66 d8                              ror AS_ERRFLG                ; 
 6681 A:f2db  a5 75                              lda AS_CURLIN                ; SAVE LINE # OF CURRENT LINE
 6682 A:f2dd  85 f6                              sta AS_CURLSV                ; 
 6683 A:f2df  a5 76                              lda AS_CURLIN+1          ; 
 6684 A:f2e1  85 f7                              sta AS_CURLSV+1          ; 
 6685 A:f2e3  20 a6 d9                           jsr AS_REMN                ; IGNORE REST OF LINE <<<WHY?>>>
 6686 A:f2e6  4c 98 d9                           jmp AS_ADDON                ; CONTINUE PROGRAM
 6687 A:f2e9                                    ; --------------------------------
 6688 A:f2e9                                    ; ROUTINE TO HANDLE ERRORS IF ONERR GOTO ACTIVE
 6689 A:f2e9                                    ; --------------------------------
 6690 A:f2e9                           AS_HANDLERR                  ; 
 6691 A:f2e9  86 de                              stx AS_ERRNUM                ; SAVE ERROR CODE NUMBER
 6692 A:f2eb  a6 f8                              ldx AS_REMSTK                ; GET STACK PNTR SAVED AT NEWSTT
 6693 A:f2ed  86 df                              stx AS_ERRSTK                ; REMEMBER IT
 6694 A:f2ef                                    ; <<<COULD ALSO HAVE DONE TXS  >>>
 6695 A:f2ef                                    ; <<<HERE; SEE ONERR CORRECTION>>>
 6696 A:f2ef                                    ; <<<IN APPLESOFT MANUAL.      >>>
 6697 A:f2ef  a5 75                              lda AS_CURLIN                ; GET LINE # OF OFFENDING STATEMENT
 6698 A:f2f1  85 da                              sta AS_ERRLIN                ; SO USER CAN SEE IT IF DESIRED
 6699 A:f2f3  a5 76                              lda AS_CURLIN+1          ; 
 6700 A:f2f5  85 db                              sta AS_ERRLIN+1          ; 
 6701 A:f2f7  a5 79                              lda AS_OLDTEXT                ; ALSO THE POSITION IN THE LINE
 6702 A:f2f9  85 dc                              sta AS_ERRPOS                ; IN CASE USER WANTS TO "RESUME"
 6703 A:f2fb  a5 7a                              lda AS_OLDTEXT+1          ; 
 6704 A:f2fd  85 dd                              sta AS_ERRPOS+1          ; 
 6705 A:f2ff  a5 f4                              lda AS_TXTPSV                ; SET UP TXTPTR TO READ TARGET LINE #
 6706 A:f301  85 b8                              sta AS_TXTPTR                ; IN "ON ERR GO TO XXXX"
 6707 A:f303  a5 f5                              lda AS_TXTPSV+1          ; 
 6708 A:f305  85 b9                              sta AS_TXTPTR+1          ; 
 6709 A:f307  a5 f6                              lda AS_CURLSV                ; 
 6710 A:f309  85 75                              sta AS_CURLIN                ; LINE # OF "ON ERR" STATEMENT
 6711 A:f30b  a5 f7                              lda AS_CURLSV+1          ; 
 6712 A:f30d  85 76                              sta AS_CURLIN+1          ; 
 6713 A:f30f  20 b7 00                           jsr AS_CHRGOT                ; START CONVERSION
 6714 A:f312  20 3e d9                           jsr AS_GOTO                ; GOTO SPECIFIED ONERR LINE
 6715 A:f315  4c d2 d7                           jmp AS_NEWSTT                ; 
 6716 A:f318                                    ; --------------------------------
 6717 A:f318                                    ; "RESUME" STATEMENT
 6718 A:f318                                    ; --------------------------------
 6719 A:f318  a5 da                    AS_RESUME lda AS_ERRLIN             ; RESTORE LINE # AND TXTPTR
 6720 A:f31a  85 75                              sta AS_CURLIN                ; TO RE-TRY OFFENDING LINE
 6721 A:f31c  a5 db                              lda AS_ERRLIN+1          ; 
 6722 A:f31e  85 76                              sta AS_CURLIN+1          ; 
 6723 A:f320  a5 dc                              lda AS_ERRPOS                ; 
 6724 A:f322  85 b8                              sta AS_TXTPTR                ; 
 6725 A:f324  a5 dd                              lda AS_ERRPOS+1          ; 
 6726 A:f326  85 b9                              sta AS_TXTPTR+1          ; 
 6727 A:f328                                    ; <<< ONERR CORRECTION IN MANUAL IS EASILY >>>
 6728 A:f328                                    ; <<< BY "CALL -3288", WHICH IS $F328 HERE >>>
 6729 A:f328  a6 df                              ldx AS_ERRSTK                ; RETRIEVE STACK PNTR AS IT WAS
 6730 A:f32a  9a                                 txs                    ; BEFORE STATEMENT SCANNED
 6731 A:f32b  4c d2 d7                           jmp AS_NEWSTT                ; DO STATEMENT AGAIN
 6732 A:f32e                                    ; --------------------------------
 6733 A:f32e  4c c9 de                 AS_JSYN   jmp AS_SYNERR             ; 
 6734 A:f331                                    ; --------------------------------
 6735 A:f331                                    ; "DEL" STATEMENT
 6736 A:f331                                    ; --------------------------------
 6737 A:f331  b0 fb                    AS_DEL    bcs AS_JSYN             ; ERROR IF # NOT SPECIFIED
 6738 A:f333  a6 af                              ldx AS_PRGEND                ; 
 6739 A:f335  86 69                              stx AS_VARTAB                ; 
 6740 A:f337  a6 b0                              ldx AS_PRGEND+1          ; 
 6741 A:f339  86 6a                              stx AS_VARTAB+1          ; 
 6742 A:f33b  20 0c da                           jsr AS_LINGET                ; GET BEGINNING OF RANGE
 6743 A:f33e  20 1a d6                           jsr AS_FNDLIN                ; FIND THIS LINE OR NEXT
 6744 A:f341  a5 9b                              lda AS_LOWTR                ; UPPER PORTION OF PROGRAM WILL
 6745 A:f343  85 60                              sta AS_DEST                ; BE MOVED DOWN TO HERE
 6746 A:f345  a5 9c                              lda AS_LOWTR+1          ; 
 6747 A:f347  85 61                              sta AS_DEST+1          ; 
 6748 A:f349  a9 2c                              lda #(","&%01111111)     ; MUST HAVE A COMMA NEXT
 6749 A:f34b  20 c0 de                           jsr AS_SYNCHR                ; 
 6750 A:f34e  20 0c da                           jsr AS_LINGET                ; GET END RANGE
 6751 A:f351                                    ; (DOES NOTHING IF END RANGE
 6752 A:f351                                    ; IS NOT SPECIFIED)
 6753 A:f351  e6 50                              inc AS_LINNUM                ; POINT ONE PAST IT
 6754 A:f353  d0 02                              bne AS_L_DEL_1                ; 
 6755 A:f355  e6 51                              inc AS_LINNUM+1          ; 
 6756 A:f357  20 1a d6                 AS_L_DEL_1 jsr AS_FNDLIN             ; FIND START LINE AFTER SPECIFIED LINE
 6757 A:f35a  a5 9b                              lda AS_LOWTR                ; WHICH IS BEGINNING OF PORTION
 6758 A:f35c  c5 60                              cmp AS_DEST                ; TO BE MOVED DOWN
 6759 A:f35e  a5 9c                              lda AS_LOWTR+1          ; IT MUST BE ABOVE THE TARGET
 6760 A:f360  e5 61                              sbc AS_DEST+1          ; 
 6761 A:f362  b0 01                              bcs AS_L_DEL_2                ; IT IS OKAY
 6762 A:f364  60                                 rts                    ; NOTHING TO DELETE
 6763 A:f365  a0 00                    AS_L_DEL_2 ldy #0          ; MOVE UPPER PORTION DOWN NOW
 6764 A:f367  b1 9b                    AS_L_DEL_3 lda (AS_LOWTR),Y                   ; SOURCE . . .
 6765 A:f369  91 60                              sta (AS_DEST),Y                    ; ...TO DESTINATION
 6766 A:f36b  e6 9b                              inc AS_LOWTR                ; BUMP SOURCE PNTR
 6767 A:f36d  d0 02                              bne AS_L_DEL_4                ; 
 6768 A:f36f  e6 9c                              inc AS_LOWTR+1          ; 
 6769 A:f371  e6 60                    AS_L_DEL_4 inc AS_DEST             ; BUMP DESTINATION PNTR
 6770 A:f373  d0 02                              bne AS_L_DEL_5                ; 
 6771 A:f375  e6 61                              inc AS_DEST+1          ; 
 6772 A:f377  a5 69                    AS_L_DEL_5 lda AS_VARTAB             ; REACHED END OF PROGRAM YET?
 6773 A:f379  c5 9b                              cmp AS_LOWTR                ; 
 6774 A:f37b  a5 6a                              lda AS_VARTAB+1          ; 
 6775 A:f37d  e5 9c                              sbc AS_LOWTR+1          ; 
 6776 A:f37f  b0 e6                              bcs AS_L_DEL_3                ; NO, KEEP MOVING
 6777 A:f381  a6 61                              ldx AS_DEST+1          ; STORE NEW END OF PROGRAM
 6778 A:f383  a4 60                              ldy AS_DEST                ; MUST SUBTRACT 1 FIRST
 6779 A:f385  d0 01                              bne AS_L_DEL_6                ; 
 6780 A:f387  ca                                 dex                    ; 
 6781 A:f388  88                       AS_L_DEL_6 dey                 ; 
 6782 A:f389  86 6a                              stx AS_VARTAB+1          ; 
 6783 A:f38b  84 69                              sty AS_VARTAB                ; 
 6784 A:f38d  4c f2 d4                           jmp AS_FIX_LINKS                ; RESET LINKS AFTER A DELETE
