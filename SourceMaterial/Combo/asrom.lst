 1535 A:d55b  ca                                 dex                    ; PREPARE FOR INX AT "PARSE"
 1536 A:d55c  a0 04                              ldy #4             ; INDEX TO PARSED OUTPUT LINE
 1537 A:d55e  84 13                              sty AS_DATAFLG                ; CLEAR SIGN-BIT OF DATAFLG
 1538 A:d560  24 d6                              bit AS_LOCK                ; IS THIS PROGRAM LOCKED?
 1539 A:d562  10 08                              bpl AS_PARSE                ; NO, GO AHEAD AND PARSE THE LINE
 1540 A:d564  68                                 pla                    ; YES, IGNORE INPUT AND "RUN"
 1541 A:d565  68                                 pla                    ; THE PROGRAM
 1542 A:d566  20 65 d6                           jsr AS_SETPTRS                ; CLEAR ALL VARIABLES
 1543 A:d569  4c d2 d7                           jmp AS_NEWSTT                ; START RUNNING
