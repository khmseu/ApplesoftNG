 4034 A:e3c5                                    ; "STR$" FUNCTION
 4035 A:e3c5                                    ; --------------------------------
 4036 A:e3c5  20 6a dd                 AS_STR    jsr AS_CHKNUM             ; EXPRESSION MUST BE NUMERIC
 4037 A:e3c8  a0 00                              ldy #0             ; START STRING AT STACK-1 ($00FF)
 4038 A:e3ca                                    ; SO STRLIT CAN DIFFRENTIATE STR$ CALLS
 4039 A:e3ca  20 36 ed                           jsr AS_FOUT_1                ; CONVERT FAC TO STRING
 4040 A:e3cd  68                                 pla                    ; POP RETURN OFF STACK
 4041 A:e3ce  68                                 pla                    ; 
 4042 A:e3cf  a9 ff                              lda #<AS_STACK-1        ; POINT TO STACK-1
 4043 A:e3d1  a0 00                              ldy #>AS_STACK-1        ; (WHICH=0)
 4044 A:e3d3  f0 12                              beq AS_STRLIT                ; ...ALWAYS, CREATE DESC & MOVE STRING
