 4289 A:e530  90 06                              bcc AS_L_CHECK_VARIABLE_1                ; NO, BELOW FRETOP
 4290 A:e532  d0 1e                              bne AS_CHECK_BUMP                ; YES, ABOVE FRETOP
 4291 A:e534  e4 6f                              cpx AS_FRETOP                ; MAYBE, CHECK LO-BYTE
 4292 A:e536  b0 1a                              bcs AS_CHECK_BUMP                ; YES, ABOVE FRETOP
 4293 A:e538  c5 9c                    AS_L_CHECK_VARIABLE_1 cmp AS_LOWTR+1       ; ABOVE HIGHEST STRING FOUND?
 4294 A:e53a  90 16                              bcc AS_CHECK_BUMP                ; NO, IGNORE FOR NOW
 4295 A:e53c  d0 04                              bne AS_L_CHECK_VARIABLE_2                ; YES, THIS IS THE NEW HIGHEST
 4296 A:e53e  e4 9b                              cpx AS_LOWTR                ; MAYBE, TRY LO-BYTE
 4297 A:e540  90 10                              bcc AS_CHECK_BUMP                ; NO, IGNORE FOR NOW
