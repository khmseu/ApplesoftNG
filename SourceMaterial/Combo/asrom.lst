 6586 A:f25d  b0 a7                              bcs AS_GOERR                ; TOO LARGE, OR WAS "VTAB 0"
 6587 A:f25f  4c 5b fb                           jmp MON_TABV                ; LET MONITOR COMPUTE BASE
