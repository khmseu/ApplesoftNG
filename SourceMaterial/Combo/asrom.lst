 4345 A:e585  a4 91                              ldy AS_LENGTH                ; FIX ITS DESCRIPTOR
 4346 A:e587  c8                                 iny                    ; POINT AT ADDRESS IN DESCRIPTOR
 4347 A:e588  a5 94                              lda AS_HIGHDS                ; STORE NEW ADDRESS
 4348 A:e58a  91 8a                              sta (AS_FNCNAM),Y
 4349 A:e58c  aa                                 tax 
