 6800 A:f39f                                    ; "STORE" STATEMENT
 6801 A:f39f                                    ; --------------------------------
 6802 A:f39f  20 d9 f7                 AS_STORE  jsr AS_GETARYPT             ; GET ADDRESS OF ARRAY TO BE SAVED
 6803 A:f3a2  a0 03                              ldy #3             ; FORWARD OFFSET - 1 IS SIZE OF
 6804 A:f3a4  b1 9b                              lda (AS_LOWTR),Y                   ; THIS ARRAY
 6805 A:f3a6  aa                                 tax 
 6806 A:f3a7  88                                 dey 
 6807 A:f3a8  b1 9b                              lda (AS_LOWTR),Y
 6808 A:f3aa  e9 01                              sbc #1
 6809 A:f3ac  b0 01                              bcs AS_L_STORE_1
 6810 A:f3ae  ca                                 dex 
 6811 A:f3af  85 50                    AS_L_STORE_1 sta AS_LINNUM
 6812 A:f3b1  86 51                              stx AS_LINNUM+1
 6813 A:f3b3  20 cd fe                           jsr MON_WRITE
 6814 A:f3b6  20 bc f7                           jsr AS_TAPEPNT
 6815 A:f3b9  4c cd fe                           jmp MON_WRITE
 6816 A:f3bc                                    ; --------------------------------
 6817 A:f3bc                                    ; "RECALL" STATEMENT
 6818 A:f3bc                                    ; --------------------------------
 6819 A:f3bc  20 d9 f7                 AS_RECALL jsr AS_GETARYPT             ; FIND ARRAY IN MEMORY
 6820 A:f3bf  20 fd fe                           jsr MON_READ                ; READ HEADER
 6821 A:f3c2  a0 02                              ldy #2             ; MAKE SURE THE NEW DATA FITS
 6822 A:f3c4  b1 9b                              lda (AS_LOWTR),Y                   ; 
 6823 A:f3c6  c5 50                              cmp AS_LINNUM                ; 
 6824 A:f3c8  c8                                 iny                    ; 
 6825 A:f3c9  b1 9b                              lda (AS_LOWTR),Y                   ; 
 6826 A:f3cb  e5 51                              sbc AS_LINNUM+1          ; 
 6827 A:f3cd  b0 03                              bcs AS_L_RECALL_1                ; IT FITS
 6828 A:f3cf  4c 10 d4                           jmp AS_MEMERR                ; DOESN'T FIT
 6829 A:f3d2  20 bc f7                 AS_L_RECALL_1 jsr AS_TAPEPNT             ; READ THE DATA
 6830 A:f3d5  4c fd fe                           jmp MON_READ                ; 
