 7526 A:f775                                    ; "SHLOAD" STATEMENT
 7527 A:f775                                    ; 
 7528 A:f775                                    ; READS A SHAPE TABLE FROM CASSETTE TAPE
 7529 A:f775                                    ; TO A POSITION JUST BELOW HIMEM.
 7530 A:f775                                    ; HIMEM IS THEN MOVED TO JUST BELOW THE TABLE
 7531 A:f775                                    ; --------------------------------
 7532 A:f775  a9 00                    AS_SHLOAD lda #>AS_LINNUM           ; SET UP TO READ TWO BYTES
 7533 A:f777  85 3d                              sta MON_A1H                ; INTO LINNUM,LINNUM+1
 7534 A:f779  85 3f                              sta MON_A2H                ; 
 7535 A:f77b  a0 50                              ldy #AS_LINNUM               ; 
 7536 A:f77d  84 3c                              sty MON_A1L                ; 
 7537 A:f77f  c8                                 iny                    ; LINNUM+1
 7538 A:f780  84 3e                              sty MON_A2L                ; 
 7539 A:f782  20 fd fe                           jsr MON_READ                ; READ TAPE
 7540 A:f785  18                                 clc                    ; SETUP TO READ (LINNUM) BYTES
 7541 A:f786  a5 73                              lda AS_MEMSIZ                ; ENDING AT HIMEM-1
 7542 A:f788  aa                                 tax                    ; 
 7543 A:f789  ca                                 dex                    ; FORMING HIMEM-1
 7544 A:f78a  86 3e                              stx MON_A2L                ; 
 7545 A:f78c  e5 50                              sbc AS_LINNUM                ; FORMING HIMEM-(LINNUM)
 7546 A:f78e  48                                 pha                    ; 
 7547 A:f78f  a5 74                              lda AS_MEMSIZ+1          ; 
 7548 A:f791  a8                                 tay                    ; 
 7549 A:f792  e8                                 inx                    ; SEE IF HIMEM LOW-BYTE WAS ZERO
 7550 A:f793  d0 01                              bne AS_L_SHLOAD_1                ; NO
 7551 A:f795  88                                 dey                    ; YES, HAVE TO DECREMENT HIGH BYTE
 7552 A:f796  84 3f                    AS_L_SHLOAD_1 sty MON_A2H             ; 
 7553 A:f798  e5 51                              sbc AS_LINNUM+1          ; 
 7554 A:f79a  c5 6e                              cmp AS_STREND+1          ; RUNNING INTO VARIABLES?
 7555 A:f79c  90 02                              bcc AS_L_SHLOAD_2                ; YES, OUT OF MEMORY
 7556 A:f79e  d0 03                              bne AS_L_SHLOAD_3                ; NO, STILL ROOM
 7557 A:f7a0  4c 10 d4                 AS_L_SHLOAD_2 jmp AS_MEMERR             ; MEM FULL ERR
 7558 A:f7a3  85 74                    AS_L_SHLOAD_3 sta AS_MEMSIZ+1       ; 
 7559 A:f7a5  85 70                              sta AS_FRETOP+1          ; CLEAR STRING SPACE
 7560 A:f7a7  85 3d                              sta MON_A1H                ; (BUT NAMES ARE STILL IN VARTBL!)
 7561 A:f7a9  85 e9                              sta AS_HGR_SHAPE_PNTR+1
 7562 A:f7ab  68                                 pla 
 7563 A:f7ac  85 e8                              sta AS_HGR_SHAPE_PNTR
 7564 A:f7ae  85 73                              sta AS_MEMSIZ
 7565 A:f7b0  85 6f                              sta AS_FRETOP
 7566 A:f7b2  85 3c                              sta MON_A1L
 7567 A:f7b4  20 fa fc                           jsr MON_RD2BIT                ; READ TO TAPE TRANSITIONS
 7568 A:f7b7  a9 03                              lda #3             ; SHORT DELAY FOR INTERMEDIATE HEADER
 7569 A:f7b9  4c 02 ff                           jmp MON_READ2                ; READ SHAPES
