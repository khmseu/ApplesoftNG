 4283 A:e527  c8                                 iny                    ; 
 4284 A:e528  b1 5e                              lda (AS_INDEX),Y                   ; GET ADDRESS OF STRING
 4285 A:e52a  aa                                 tax                    ; 
 4286 A:e52b  c8                                 iny                    ; 
