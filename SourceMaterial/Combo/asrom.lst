 3319 A:dfe3                                    ; PTRGET -- GENERAL VARIABLE SCAN
 3320 A:dfe3                                    ; 
 3321 A:dfe3                                    ; SCANS VARIABLE NAME AT TXTPTR, AND SEARCHES THE
 3322 A:dfe3                                    ; VARTAB AND ARYTAB FOR THE NAME.
 3323 A:dfe3                                    ; IF NOT FOUND, CREATE VARIABLE OF APPROPRIATE TYPE.
 3324 A:dfe3                                    ; RETURN WITH ADDRESS IN VARPNT AND Y,A
 3325 A:dfe3                                    ; 
 3326 A:dfe3                                    ; ACTUAL ACTIVITY CONTROLLED SOMEWHAT BY TWO FLAGS:
 3327 A:dfe3                                    ; DIMFLG -- NONZERO IF CALLED FROM "DIM"
 3328 A:dfe3                                    ; ELSE = 0
 3329 A:dfe3                                    ; 
 3330 A:dfe3                                    ; SUBFLG -- = $00
 3331 A:dfe3                                    ; = $40 IF CALLED FROM "GETARYPT"
 3332 A:dfe3                                    ; = $80 IF CALLED FROM "DEF FN"
 3333 A:dfe3                                    ; = $C1-DA IF CALLED FROM "FN"
 3334 A:dfe3                                    ; --------------------------------
 3335 A:dfe3  a2 00                    AS_PTRGET ldx #0          ; 
 3336 A:dfe5  20 b7 00                           jsr AS_CHRGOT                ; GET FIRST CHAR OF VARIABLE NAME
 3337 A:dfe8                                    ; --------------------------------
 3338 A:dfe8                           AS_PTRGET2                  ; 
 3339 A:dfe8  86 10                              stx AS_DIMFLG                ; X IS NONZERO IF FROM DIM
 3340 A:dfea                                    ; --------------------------------
