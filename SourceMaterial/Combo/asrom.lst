 4182 A:e488  86 6f                              stx AS_FRETOP                ; ONE PASS THROUGH ALL VARS
 4183 A:e48a  85 70                              sta AS_FRETOP+1          ; FOR EACH ACTIVE STRING!
 4184 A:e48c  a0 00                              ldy #0             ; 
 4185 A:e48e  84 8b                              sty AS_FNCNAM+1          ; FLAG IN CASE NO STRINGS TO COLLECT
 4186 A:e490  a5 6d                              lda AS_STREND                ; 
 4187 A:e492  a6 6e                              ldx AS_STREND+1          ; 
 4188 A:e494  85 9b                              sta AS_LOWTR                ; 
 4189 A:e496  86 9c                              stx AS_LOWTR+1          ; 
 4190 A:e498                                    ; --------------------------------
 4191 A:e498                                    ; START BY COLLECTING TEMPORARIES
 4192 A:e498                                    ; --------------------------------
 4193 A:e498  a9 55                              lda #<AS_TEMPST              ; 
 4194 A:e49a  a2 00                              ldx #>AS_TEMPST              ; 
 4195 A:e49c  85 5e                              sta AS_INDEX                ; 
 4196 A:e49e  86 5f                              stx AS_INDEX+1          ; 
 4197 A:e4a0  c5 52                    AS_L_FIND_HIGHEST_STRING_1 cmp AS_TEMPPT             ; FINISHED WITH TEMPS YET?
 4198 A:e4a2  f0 05                              beq AS_L_FIND_HIGHEST_STRING_2                ; YES, NOW DO SIMPLE VARIABLES
 4199 A:e4a4  20 23 e5                           jsr AS_CHECK_VARIABLE                ; DO A TEMP
 4200 A:e4a7  f0 f7                              beq AS_L_FIND_HIGHEST_STRING_1                ; ...ALWAYS
 4201 A:e4a9                                    ; --------------------------------
 4202 A:e4a9                                    ; NOW COLLECT SIMPLE VARIABLES
 4203 A:e4a9                                    ; --------------------------------
 4204 A:e4a9  a9 07                    AS_L_FIND_HIGHEST_STRING_2 lda #7          ; LENGTH OF EACH VARIABLE IS 7 BYTES
 4205 A:e4ab  85 8f                              sta AS_DSCLEN                ; 
 4206 A:e4ad  a5 69                              lda AS_VARTAB                ; START AT BEGINNING OF VARTAB
 4207 A:e4af  a6 6a                              ldx AS_VARTAB+1
 4208 A:e4b1  85 5e                              sta AS_INDEX
 4209 A:e4b3  86 5f                              stx AS_INDEX+1
 4210 A:e4b5  e4 6c                    AS_L_FIND_HIGHEST_STRING_3 cpx AS_ARYTAB+1       ; FINISHED WITH SIMPLE VARIABLES?
 4211 A:e4b7  d0 04                              bne AS_L_FIND_HIGHEST_STRING_4                ; NO
 4212 A:e4b9  c5 6b                              cmp AS_ARYTAB                ; MAYBE, CHECK LO-BYTE
 4213 A:e4bb  f0 05                              beq AS_L_FIND_HIGHEST_STRING_5                ; YES, NOW DO ARRAYS
 4214 A:e4bd  20 19 e5                 AS_L_FIND_HIGHEST_STRING_4 jsr AS_CHECK_SIMPLE_VARIABLE
 4215 A:e4c0  f0 f3                              beq AS_L_FIND_HIGHEST_STRING_3                ; ...ALWAYS
