 3714 A:e1f5  69 00                              adc #0             ; 
 3715 A:e1f7  c8                       AS_L_MAKE_NEW_ARRAY_5 iny                 ; ADD THIS DIMENSION TO ARRAY DESCRIPTOR
 3716 A:e1f8  91 9b                              sta (AS_LOWTR),Y
 3717 A:e1fa  c8                                 iny 
