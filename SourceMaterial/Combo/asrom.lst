 6365 A:f128                           AS_COLD_START 
 6366 A:f128  a2 ff                              ldx #$ff             ; SET DIRECT MODE FLAG
 6367 A:f12a  86 76                              stx AS_CURLIN+1          ; 
 6368 A:f12c  a2 fb                              ldx #$fb             ; SET STACK POINTER, LEAVING ROOM FOR
 6369 A:f12e  9a                                 txs                    ; LINE BUFFER DURING PARSING
 6370 A:f12f  a9 28                              lda #<AS_COLD_START              ; SET RESTART TO COLD.START
 6371 A:f131  a0 f1                              ldy #>AS_COLD_START              ; UNTIL COLDSTART IS COMPLETED
 6372 A:f133  85 01                              sta AS_GOWARM+1          ; 
 6373 A:f135  84 02                              sty AS_GOWARM+2          ; 
 6374 A:f137  85 04                              sta AS_GOSTROUT+1          ; ALSO SECOND USER VECTOR...
 6375 A:f139  84 05                              sty AS_GOSTROUT+2          ; ..WE SIMPLY MUST FINISH COLD.START!
 6376 A:f13b  20 73 f2                           jsr AS_NORMAL                ; SET NORMAL DISPLAY MODE
 6377 A:f13e  a9 4c                              lda #$4c             ; "JMP" OPCODE FOR 4 VECTORS
 6378 A:f140  85 00                              sta AS_GOWARM                ; WARM START
 6379 A:f142  85 03                              sta AS_GOSTROUT                ; ANYONE EVER USE THIS ONE?
 6380 A:f144  85 90                              sta AS_JMPADRS                ; USED BY FUNCTIONS (JSR JMPADRS)
 6381 A:f146  85 0a                              sta AS_USR                ; "USR" FUNCTION VECTOR
 6382 A:f148  a9 99                              lda #<AS_IQERR              ; POINT "USR" TO ILLEGAL QUANTITY
 6383 A:f14a  a0 e1                              ldy #>AS_IQERR              ; ERROR, UNTIL USER SETS IT UP
 6384 A:f14c  85 0b                              sta AS_USR+1
 6385 A:f14e  84 0c                              sty AS_USR+2
 6386 A:f150                                    ; --------------------------------
 6387 A:f150                                    ; MOVE GENERIC CHRGET AND RANDOM SEED INTO PLACE
 6388 A:f150                                    ; 
 6389 A:f150                                    ; <<< NOTE THAT LOOP VALUE IS WRONG!          >>>
 6390 A:f150                                    ; <<< THE LAST BYTE OF THE RANDOM SEED IS NOT >>>
 6391 A:f150                                    ; <<< COPIED INTO PAGE ZERO!                  >>>
 6392 A:f150                                    ; --------------------------------
 6393 A:f150  a2 1c                              ldx #AS_GENERIC_END-AS_GENERIC_CHRGET-1
 6394 A:f152  bd 0a f1                 AS_L_COLD_START_1 lda AS_GENERIC_CHRGET-1,X
 6395 A:f155  95 b0                              sta AS_CHRGET-1,X
 6396 A:f157  86 f1                              stx AS_SPEEDZ                ; ON LAST PASS STORES $01)
 6397 A:f159  ca                                 dex 
 6398 A:f15a  d0 f6                              bne AS_L_COLD_START_1
 6399 A:f15c                                    ; --------------------------------
 6400 A:f15c  86 f2                              stx AS_TRCFLG                ; X=0, TURN OFF TRACING
 6401 A:f15e  8a                                 txa                    ; A=0
 6402 A:f15f  85 a4                              sta AS_SHIFT_SIGN_EXT
 6403 A:f161  85 54                              sta AS_LASTPT+1
 6404 A:f163  48                                 pha                    ; PUT $00 ON STACK (WHAT FOR?)
 6405 A:f164  a9 03                              lda #3             ; SET LENGTH OF TEMP. STRING DESCRIPTORS
 6406 A:f166  85 8f                              sta AS_DSCLEN                ; FOR GARBAGE COLLECTION SUBROUTINE
 6407 A:f168  20 fb da                           jsr AS_CRDO                ; PRINT <RETURN>
 6408 A:f16b  a9 01                              lda #1             ; SET UP FAKE FORWARD LINK
 6409 A:f16d  8d fd 01                           sta AS_INPUT_BUFFER-3
 6410 A:f170  8d fc 01                           sta AS_INPUT_BUFFER-4
 6411 A:f173  a2 55                              ldx #AS_TEMPST               ; INIT INDEX TO TEMP STRING DESCRIPTORS
 6412 A:f175  86 52                              stx AS_TEMPPT
 6413 A:f177                                    ; --------------------------------
 6414 A:f177                                    ; FIND HIGH END OF RAM
 6415 A:f177                                    ; --------------------------------
 6416 A:f177  a9 00                              lda #<$0800            ; SET UP POINTER TO LOW END OF RAM
 6417 A:f179  a0 08                              ldy #>$0800
 6418 A:f17b  85 50                              sta AS_LINNUM
 6419 A:f17d  84 51                              sty AS_LINNUM+1
 6420 A:f17f  a0 00                              ldy #0
 6421 A:f181  e6 51                    AS_L_COLD_START_2 inc AS_LINNUM+1       ; TEST FIRST BYTE OF EACH PAGE
 6422 A:f183  b1 50                              lda (AS_LINNUM),Y                  ; BY COMPLEMENTING IT AND WATCHING
 6423 A:f185  49 ff                              eor #$ff             ; IT CHANGE THE SAME WAY
 6424 A:f187  91 50                              sta (AS_LINNUM),Y                  ; 
 6425 A:f189  d1 50                              cmp (AS_LINNUM),Y                  ; ROM OR EMPTY SOCKETS WON'T TRACK
 6426 A:f18b  d0 08                              bne AS_L_COLD_START_3                ; NOT RAM HERE
 6427 A:f18d  49 ff                              eor #$ff             ; RESTORE ORIGINAL VALUE
 6428 A:f18f  91 50                              sta (AS_LINNUM),Y                  ; 
 6429 A:f191  d1 50                              cmp (AS_LINNUM),Y                  ; DID IT TRACK AGAIN?
 6430 A:f193  f0 ec                              beq AS_L_COLD_START_2                ; YES, STILL IN RAM
 6431 A:f195  a4 50                    AS_L_COLD_START_3 ldy AS_LINNUM             ; NO, END OF RAM
 6432 A:f197  a5 51                              lda AS_LINNUM+1          ; 
 6433 A:f199  29 f0                              and #$f0             ; FORCE A MULTIPLE OF 4096 BYTES
 6434 A:f19b  84 73                              sty AS_MEMSIZ                ; (BAD RAM MAY HAVE YIELDED NON-MULTIPLE)
 6435 A:f19d  85 74                              sta AS_MEMSIZ+1          ; 
 6436 A:f19f  84 6f                              sty AS_FRETOP                ; SET HIMEM AND BOTTOM OF STRINGS
 6437 A:f1a1  85 70                              sta AS_FRETOP+1          ; 
 6438 A:f1a3  a2 00                              ldx #<$0800            ; SET PROGRAM POINTER TO $0800
 6439 A:f1a5  a0 08                              ldy #>$0800            ; 
 6440 A:f1a7  86 67                              stx AS_TXTTAB                ; 
 6441 A:f1a9  84 68                              sty AS_TXTTAB+1          ; 
 6442 A:f1ab  a0 00                              ldy #0             ; TURN OFF SEMI-SECRET LOCK FLAG
 6443 A:f1ad  84 d6                              sty AS_LOCK                ; 
 6444 A:f1af  98                                 tya                    ; A=0 TOO
 6445 A:f1b0  91 67                              sta (AS_TXTTAB),Y                  ; FIRST BYTE IN PROGRAM SPACE = 0
 6446 A:f1b2  e6 67                              inc AS_TXTTAB                ; ADVANCE PAST THE $00
 6447 A:f1b4  d0 02                              bne AS_L_COLD_START_4                ; 
 6448 A:f1b6  e6 68                              inc AS_TXTTAB+1          ; 
 6449 A:f1b8  a5 67                    AS_L_COLD_START_4 lda AS_TXTTAB             ; 
 6450 A:f1ba  a4 68                              ldy AS_TXTTAB+1          ; 
 6451 A:f1bc  20 e3 d3                           jsr AS_REASON                ; SET REST OF POINTERS UP
 6452 A:f1bf  20 4b d6                           jsr AS_SCRTCH                ; MORE POINTERS
 6453 A:f1c2  a9 3a                              lda #<AS_STROUT              ; PUT CORRECT ADDRESSES IN TWO
 6454 A:f1c4  a0 db                              ldy #>AS_STROUT              ; USER VECTORS
 6455 A:f1c6  85 04                              sta AS_GOSTROUT+1
 6456 A:f1c8  84 05                              sty AS_GOSTROUT+2
 6457 A:f1ca  a9 3c                              lda #<AS_RESTART
 6458 A:f1cc  a0 d4                              ldy #>AS_RESTART
 6459 A:f1ce  85 01                              sta AS_GOWARM+1
 6460 A:f1d0  84 02                              sty AS_GOWARM+2
 6461 A:f1d2  6c 01 00                           jmp (AS_GOWARM+1)        ; SILLY, WHY NOT JUST "JMP RESTART"
 6462 A:f1d5                                    ; --------------------------------
 6463 A:f1d5                                    ; --------------------------------
 6464 A:f1d5                                    ; "CALL" STATEMENT
 6465 A:f1d5                                    ; 
 6466 A:f1d5                                    ; EFFECTIVELY PERFORMS A "JSR" TO THE SPECIFIED
 6467 A:f1d5                                    ; ADDRESS, WITH THE FOLLOWING REGISTER CONTENTS:
 6468 A:f1d5                                    ; (A,Y) = CALL ADDRESS
 6469 A:f1d5                                    ; (X)   = $9D
 6470 A:f1d5                                    ; 
 6471 A:f1d5                                    ; THE CALLED ROUTINE CAN RETURN WITH "RTS",
 6472 A:f1d5                                    ; AND APPLESOFT WILL CONTINUE WITH THE NEXT
 6473 A:f1d5                                    ; STATEMENT.
 6474 A:f1d5                                    ; --------------------------------
 6475 A:f1d5  20 67 dd                 AS_CALL   jsr AS_FRMNUM             ; EVALUATE EXPRESSION FOR CALL ADDRESS
 6476 A:f1d8  20 52 e7                           jsr AS_GETADR                ; CONVERT EXPRESSION TO 16-BIT INTEGER
 6477 A:f1db  6c 50 00                           jmp (AS_LINNUM)              ; IN LINNUM, AND JUMP THERE.
 6478 A:f1de                                    ; --------------------------------
 6479 A:f1de                                    ; "IN#" STATEMENT
 6480 A:f1de                                    ; 
 6481 A:f1de                                    ; NOTE:  NO CHECK FOR VALID SLOT #, AS LONG
 6482 A:f1de                                    ; AS VALUE IS < 256 IT IS ACCEPTED.
 6483 A:f1de                                    ; MONITOR MASKS VALUE TO 4 BITS (0-15).
 6484 A:f1de                                    ; --------------------------------
 6485 A:f1de                           AS_IN_NUMBER 
 6486 A:f1de  20 f8 e6                           jsr AS_GETBYT                ; GET SLOT NUMBER IN X-REG
 6487 A:f1e1  8a                                 txa                    ; MONITOR WILL INSTALL IN VECTOR
 6488 A:f1e2  4c 8b fe                           jmp MON_INPORT                ; AT $38,39.
 6489 A:f1e5                                    ; --------------------------------
 6490 A:f1e5                                    ; "PR#" STATEMENT
 6491 A:f1e5                                    ; 
 6492 A:f1e5                                    ; NOTE:  NO CHECK FOR VALID SLOT #, AS LONG
 6493 A:f1e5                                    ; AS VALUE IS < 256 IT IS ACCEPTED.
 6494 A:f1e5                                    ; MONITOR MASKS VALUE TO 4 BITS (0-15).
 6495 A:f1e5                                    ; --------------------------------
 6496 A:f1e5                           AS_PR_NUMBER 
 6497 A:f1e5  20 f8 e6                           jsr AS_GETBYT                ; GET SLOT NUMBER IN X-REG
 6498 A:f1e8  8a                                 txa                    ; MONITOR WILL INSTALL IN VECTOR
 6499 A:f1e9  4c 95 fe                           jmp MON_OUTPORT                ; AT $36,37
 6500 A:f1ec                                    ; --------------------------------
 6501 A:f1ec                                    ; GET TWO VALUES < 48, WITH COMMA SEPARATOR
 6502 A:f1ec                                    ; 
 6503 A:f1ec                                    ; CALLED FOR "PLOT X,Y"
 6504 A:f1ec                                    ; AND "HLIN A,B AT Y"
 6505 A:f1ec                                    ; AND "VLIN A,B AT X"
 6506 A:f1ec                                    ; 
 6507 A:f1ec                                    ; --------------------------------
 6508 A:f1ec                           AS_PLOTFNS 
 6509 A:f1ec  20 f8 e6                           jsr AS_GETBYT                ; GET FIRST VALUE IN X-REG
 6510 A:f1ef  e0 30                              cpx #48             ; MUST BE < 48
 6511 A:f1f1  b0 13                              bcs AS_GOERR                ; TOO LARGE
 6512 A:f1f3  86 f0                              stx AS_FIRST                ; SAVE FIRST VALUE
 6513 A:f1f5  a9 2c                              lda #(","&%01111111)     ; MUST HAVE A COMMA
 6514 A:f1f7  20 c0 de                           jsr AS_SYNCHR                ; 
 6515 A:f1fa  20 f8 e6                           jsr AS_GETBYT                ; GET SECOND VALUE IN X-REG
 6516 A:f1fd  e0 30                              cpx #48             ; MUST BE < 48
 6517 A:f1ff  b0 05                              bcs AS_GOERR                ; TOO LARGE
 6518 A:f201  86 2c                              stx MON_H2                ; SAVE SECOND VALUE
 6519 A:f203  86 2d                              stx MON_V2                ; 
 6520 A:f205  60                                 rts                    ; SECOND VALUE STILL IN X-REG
 6521 A:f206                                    ; --------------------------------
 6522 A:f206  4c 99 e1                 AS_GOERR  jmp AS_IQERR             ; ILLEGAL QUANTITY ERROR
 6523 A:f209                                    ; --------------------------------
 6524 A:f209                                    ; GET "A,B AT C" VALUES FOR "HLIN" AND "VLIN"
 6525 A:f209                                    ; 
 6526 A:f209                                    ; PUT SMALLER OF (A,B) IN FIRST,
 6527 A:f209                                    ; AND LARGER  OF (A,B) IN H2 AND V2.
 6528 A:f209                                    ; RETURN WITH (X) = C-VALUE.
 6529 A:f209                                    ; --------------------------------
 6530 A:f209                           AS_LINCOOR 
 6531 A:f209  20 ec f1                           jsr AS_PLOTFNS                ; GET A,B VALUES
 6532 A:f20c  e4 f0                              cpx AS_FIRST                ; IS A < B?
 6533 A:f20e  b0 08                              bcs AS_L_LINCOOR_1                ; YES, IN RIGHT ORDER
 6534 A:f210  a5 f0                              lda AS_FIRST                ; NO, INTERCHANGE THEM
 6535 A:f212  85 2c                              sta MON_H2                ; 
 6536 A:f214  85 2d                              sta MON_V2                ; 
 6537 A:f216  86 f0                              stx AS_FIRST                ; 
 6538 A:f218  a9 c5                    AS_L_LINCOOR_1 lda #AS_TOKENDB            ; MUST HAVE "AT" NEXT
 6539 A:f21a  20 c0 de                           jsr AS_SYNCHR                ; 
 6540 A:f21d  20 f8 e6                           jsr AS_GETBYT                ; GET C-VALUE IN X-REG
 6541 A:f220  e0 30                              cpx #48             ; MUST BE < 48
 6542 A:f222  b0 e2                              bcs AS_GOERR                ; TOO LARGE
 6543 A:f224  60                                 rts                    ; C-VALUE IN X-REG
 6544 A:f225                                    ; --------------------------------
 6545 A:f225                                    ; "PLOT" STATEMENT
 6546 A:f225                                    ; --------------------------------
 6547 A:f225  20 ec f1                 AS_PLOT   jsr AS_PLOTFNS             ; GET X,Y VALUES
 6548 A:f228  8a                                 txa                    ; Y-COORD TO A-REG FOR MONITOR
 6549 A:f229  a4 f0                              ldy AS_FIRST                ; X-COORD TO Y-YEG FOR MONITOR
 6550 A:f22b  c0 28                              cpy #40             ; X-COORD MUST BE < 40
 6551 A:f22d  b0 d7                              bcs AS_GOERR                ; X-COORD IS TOO LARGE
 6552 A:f22f  4c 00 f8                           jmp MON_PLOT                ; PLOT!
 6553 A:f232                                    ; --------------------------------
 6554 A:f232                                    ; "HLIN" STATEMENT
 6555 A:f232                                    ; --------------------------------
 6556 A:f232  20 09 f2                 AS_HLIN   jsr AS_LINCOOR             ; GET "A,B AT C"
 6557 A:f235  8a                                 txa                    ; Y-COORD IN A-REG
 6558 A:f236  a4 2c                              ldy MON_H2                ; RIGHT END OF LINE
 6559 A:f238  c0 28                              cpy #40             ; MUST BE < 40
 6560 A:f23a  b0 ca                              bcs AS_GOERR                ; TOO LARGE
 6561 A:f23c  a4 f0                              ldy AS_FIRST                ; LEFT END OF LINE IN Y-REG
 6562 A:f23e  4c 19 f8                           jmp MON_HLINE                ; LET MONITOR DRAW LINE
 6563 A:f241                                    ; --------------------------------
 6564 A:f241                                    ; "VLIN" STATEMENT
 6565 A:f241                                    ; --------------------------------
 6566 A:f241  20 09 f2                 AS_VLIN   jsr AS_LINCOOR             ; GET "A,B AT C"
 6567 A:f244  8a                                 txa                    ; X-COORD IN Y-REG
 6568 A:f245  a8                                 tay                    ; 
 6569 A:f246  c0 28                              cpy #40             ; X-COORD MUST BE < 40
 6570 A:f248  b0 bc                              bcs AS_GOERR                ; TOO LARGE
 6571 A:f24a  a5 f0                              lda AS_FIRST                ; TOP END OF LINE IN A-REG
 6572 A:f24c  4c 28 f8                           jmp MON_VLINE                ; LET MONITOR DRAW LINE
 6573 A:f24f                                    ; --------------------------------
 6574 A:f24f                                    ; "COLOR=" STATEMENT
