 7447 A:f6fe                                    ; "HPLOT" STATEMENT
 7448 A:f6fe                                    ; 
 7449 A:f6fe                                    ; HPLOT X,Y
 7450 A:f6fe                                    ; HPLOT TO X,Y
 7451 A:f6fe                                    ; HPLOT X1,Y1 TO X2,Y2
 7452 A:f6fe                                    ; --------------------------------
 7453 A:f6fe  c9 c1                    AS_HPLOT  cmp #AS_TOKEN_TO            ; "PLOT TO" FORM?
 7454 A:f700  f0 0d                              beq AS_L_HPLOT_2                ; YES, START FROM CURRENT LOCATION
 7455 A:f702  20 b9 f6                           jsr AS_HFNS                ; NO, GET STARTING POINT OF LINE
 7456 A:f705  20 57 f4                           jsr AS_HPLOT0                ; PLOT THE POINT, AND SET UP FOR
 7457 A:f708                                    ; DRAWING A LINE FROM THAT POINT
 7458 A:f708  20 b7 00                 AS_L_HPLOT_1 jsr AS_CHRGOT             ; CHARACTER AT END OF EXPRESSION
 7459 A:f70b  c9 c1                              cmp #AS_TOKEN_TO               ; IS A LINE SPECIFIED?
 7460 A:f70d  d0 e6                              bne AS_RTS_23                ; NO, EXIT
 7461 A:f70f  20 c0 de                 AS_L_HPLOT_2 jsr AS_SYNCHR             ; YES. ADV. TXTPTR (WHY NOT CHRGET)
 7462 A:f712  20 b9 f6                           jsr AS_HFNS                ; GET COORDINATES OF LINE END
