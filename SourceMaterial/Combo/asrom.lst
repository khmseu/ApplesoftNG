 3874 A:e2de                                    ; --------------------------------
 3875 A:e2de  a5 11                    AS_FRE    lda AS_VALTYP             ; LOOK AT VALUE OF ARGUMENT
 3876 A:e2e0  f0 03                              beq AS_L_FRE_1                ; =0 MEANS REAL, =$FF MEANS STRING
