 1601 A:d5cb  a4 ad                    AS_L_PARSE_8 ldy AS_STRNG2             ; GET INDEX TO OUTPUT LINE IN Y-REG
 1602 A:d5cd  e8                       AS_L_PARSE_9 inx                 ; ADVANCE INPUT INDEX
 1603 A:d5ce  c8                                 iny                    ; ADVANCE OUTPUT INDEX
 1604 A:d5cf  99 fb 01                           sta AS_INPUT_BUFFER-5,Y            ; STORE CHAR OR TOKEN
