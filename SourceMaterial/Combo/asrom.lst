 5476 A:ebb2                                    ; COMPARE FAC WITH PACKED # AT (Y,A)
 5477 A:ebb2                                    ; RETURN A=1,0,-1 AS (Y,A) IS <,=,> FAC
 5478 A:ebb2                                    ; --------------------------------
 5479 A:ebb2  85 60                    AS_FCOMP  sta AS_DEST             ; USE DEST FOR PNTR
 5480 A:ebb4                                    ; --------------------------------
 5481 A:ebb4                                    ; SPECIAL ENTRY FROM "NEXT" PROCESSOR
 5482 A:ebb4                                    ; "DEST" ALREADY SET UP
 5483 A:ebb4                                    ; --------------------------------
 5484 A:ebb4  84 61                    AS_FCOMP2 sty AS_DEST+1       ; 
 5485 A:ebb6  a0 00                              ldy #0             ; GET EXPONENT OF COMPARAND
 5486 A:ebb8  b1 60                              lda (AS_DEST),Y                    ; 
 5487 A:ebba  c8                                 iny                    ; POINT AT NEXT BYTE
 5488 A:ebbb  aa                                 tax                    ; EXPONENT TO X-REG
 5489 A:ebbc  f0 c4                              beq AS_SIGN                ; IF COMPARAND=0, "SIGN" COMPARES FAC
 5490 A:ebbe  b1 60                              lda (AS_DEST),Y                    ; GET HI-BYTE OF MANTISSA
 5491 A:ebc0  45 a2                              eor AS_FAC_SIGN                ; COMPARE WITH FAC SIGN
 5492 A:ebc2  30 c2                              bmi AS_SIGN1                ; DIFFERENT SIGNS, "SIGN" GIVES ANSWER
 5493 A:ebc4  e4 9d                              cpx AS_FAC                ; SAME SIGN, SO COMPARE EXPONENTS
 5494 A:ebc6  d0 21                              bne AS_L_FCOMP2_1                ; DIFFERENT, SO SUFFICIENT TEST
 5495 A:ebc8  b1 60                              lda (AS_DEST),Y                    ; SAME EXPONENT, COMPARE MANTISSA
 5496 A:ebca  09 80                              ora #$80             ; SET INVISIBLE NORMALIZED BIT
 5497 A:ebcc  c5 9e                              cmp AS_FAC+1          ; 
 5498 A:ebce  d0 19                              bne AS_L_FCOMP2_1                ; NOT SAME, SO SUFFICIENT
 5499 A:ebd0  c8                                 iny                    ; SAME, COMPARE MORE MANTISSA
 5500 A:ebd1  b1 60                              lda (AS_DEST),Y                    ; 
 5501 A:ebd3  c5 9f                              cmp AS_FAC+2          ; 
 5502 A:ebd5  d0 12                              bne AS_L_FCOMP2_1                ; NOT SAME, SO SUFFICIENT
 5503 A:ebd7  c8                                 iny                    ; SAME, COMPARE MORE MANTISSA
 5504 A:ebd8  b1 60                              lda (AS_DEST),Y                    ; 
 5505 A:ebda  c5 a0                              cmp AS_FAC+3          ; 
 5506 A:ebdc  d0 0b                              bne AS_L_FCOMP2_1                ; NOT SAME, SO SUFFICIENT
 5507 A:ebde  c8                                 iny                    ; SAME, COMPARE REST OF MANTISSA
 5508 A:ebdf  a9 7f                              lda #$7f             ; ARTIFICIAL EXTENSION BYTE FOR COMPARAND
 5509 A:ebe1  c5 ac                              cmp AS_FAC_EXTENSION
 5510 A:ebe3  b1 60                              lda (AS_DEST),Y
 5511 A:ebe5  e5 a1                              sbc AS_FAC+4
 5512 A:ebe7  f0 28                              beq AS_RTS_16                ; NUMBERS ARE EQUAL, RETURN (A)=0
 5513 A:ebe9  a5 a2                    AS_L_FCOMP2_1 lda AS_FAC_SIGN             ; NUMBERS ARE DIFFERENT
 5514 A:ebeb  90 02                              bcc AS_L_FCOMP2_2                ; FAC IS LARGER MAGNITUDE
 5515 A:ebed  49 ff                              eor #$ff             ; FAC IS SMALLER MAGNITUDE
 5516 A:ebef                                    ; <<<  NOTE THAT ABOVE THREE LINES CAN BE SHORTENED: >>>
 5517 A:ebef                                    ; <<<  L_FCOMP2_1  ROR              PUT CARRY INTO SIGN BIT  >>>
 5518 A:ebef                                    ; <<<      EOR FAC.SIGN     TOGGLE WITH SIGN OF FAC  >>>
 5519 A:ebef  4c 88 eb                 AS_L_FCOMP2_2 jmp AS_SIGN2             ; CONVERT +1 OR -1
