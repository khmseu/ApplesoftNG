 3342 A:dfea  85 81                              sta AS_VARNAM                ; 
 3343 A:dfec  20 b7 00                           jsr AS_CHRGOT                ; 
 3344 A:dfef  20 7d e0                           jsr AS_ISLETC                ; IS IT A LETTER?
 3345 A:dff2  b0 03                              bcs AS_NAMOK                ; YES, OKAY SO FAR
 3346 A:dff4  4c c9 de                 AS_BADNAM jmp AS_SYNERR             ; NO, SYNTAX ERROR
 3347 A:dff7  a2 00                    AS_NAMOK  ldx #0          ; 
 3348 A:dff9  86 11                              stx AS_VALTYP                ; 
 3349 A:dffb  86 12                              stx AS_VALTYP+1          ; 
 3350 A:dffd  4c 07 e0                           jmp AS_PTRGET4                ; TO BRANCH ACROSS $E000 VECTORS
 3351 A:e000                                    ; --------------------------------
