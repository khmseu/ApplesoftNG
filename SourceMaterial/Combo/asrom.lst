 6264 A:f094                                    ; --------------------------------
 6265 A:f094                                    ; <<< NEXT TEN BYTES ARE NEVER REFERENCED >>>
 6266 A:f094                                    ; OBFUSCATED "MICROSOFT!" BY BILL GATES
 6267 A:f094                                    ; (REVERSED, HIGH BIT SET, XOR 7)
 6268 A:f094                                    ; --------------------------------

 6273 A:f094  a6                                 .byt ("!"|%10000000)^7
 6274 A:f095  d3                                 .byt ("T"|%10000000)^7
 6275 A:f096  c1                                 .byt ("F"|%10000000)^7
 6276 A:f097  c8                                 .byt ("O"|%10000000)^7
 6277 A:f098  d4                                 .byt ("S"|%10000000)^7
 6278 A:f099  c8                                 .byt ("O"|%10000000)^7
 6279 A:f09a  d5                                 .byt ("R"|%10000000)^7
 6280 A:f09b  c4                                 .byt ("C"|%10000000)^7
 6281 A:f09c  ce                                 .byt ("I"|%10000000)^7
 6282 A:f09d  ca                                 .byt ("M"|%10000000)^7

 6289 A:f09e                                    ; --------------------------------
 6290 A:f09e                                    ; "ATN" FUNCTION
 6291 A:f09e                                    ; --------------------------------
 6292 A:f09e  a5 a2                    AS_ATN    lda AS_FAC_SIGN             ; FOLD THE ARGUMENT RANGE FIRST
 6293 A:f0a0  48                                 pha                    ; SAVE SIGN FOR LATER UNFOLDING
 6294 A:f0a1  10 03                              bpl AS_L_ATN_1                ; .GE. 0
 6295 A:f0a3  20 d0 ee                           jsr AS_NEGOP                ; .LT. 0, SO COMPLEMENT
 6296 A:f0a6  a5 9d                    AS_L_ATN_1 lda AS_FAC             ; IF .GE. 1, FORM RECIPROCAL
 6297 A:f0a8  48                                 pha                    ; SAVE FOR LATER UNFOLDING
 6298 A:f0a9  c9 81                              cmp #$81             ; (EXPONENT FOR .GE. 1
 6299 A:f0ab  90 07                              bcc AS_L_ATN_2                ; X < 1
 6300 A:f0ad  a9 13                              lda #<AS_CON_ONE              ; FORM 1/X
 6301 A:f0af  a0 e9                              ldy #>AS_CON_ONE
 6302 A:f0b1  20 66 ea                           jsr AS_FDIV
 6303 A:f0b4                                    ; --------------------------------
 6304 A:f0b4                                    ; 0 <= X <= 1
 6305 A:f0b4                                    ; 0 <= ATN(X) <= PI/8
 6306 A:f0b4                                    ; --------------------------------
 6307 A:f0b4  a9 ce                    AS_L_ATN_2 lda #<AS_POLY_ATN           ; COMPUTE POLYNOMIAL APPROXIMATION
 6308 A:f0b6  a0 f0                              ldy #>AS_POLY_ATN
 6309 A:f0b8  20 5c ef                           jsr AS_POLYNOMIAL_ODD
 6310 A:f0bb  68                                 pla                    ; START TO UNFOLD
 6311 A:f0bc  c9 81                              cmp #$81             ; WAS IT .GE. 1?
 6312 A:f0be  90 07                              bcc AS_L_ATN_3                ; NO
 6313 A:f0c0  a9 66                              lda #<AS_CON_PI_HALF              ; YES, SUBTRACT FROM PI/2
 6314 A:f0c2  a0 f0                              ldy #>AS_CON_PI_HALF              ; 
 6315 A:f0c4  20 a7 e7                           jsr AS_FSUB                ; 
 6316 A:f0c7  68                       AS_L_ATN_3 pla                 ; WAS IT NEGATIVE?
 6317 A:f0c8  10 03                              bpl AS_RTS_20                ; NO
 6318 A:f0ca  4c d0 ee                           jmp AS_NEGOP                ; YES, COMPLEMENT
 6319 A:f0cd  60                       AS_RTS_20 rts 
 6320 A:f0ce                                    ; --------------------------------
 6321 A:f0ce  0b                       AS_POLY_ATN .byt 11           ; POWER OF POLYNOMIAL
 6322 A:f0cf  76 b3 83 bd d3                     .byt $76,$b3,$83,$bd,$d3
 6323 A:f0d4  79 1e f4 a6 f5                     .byt $79,$1e,$f4,$a6,$f5
 6324 A:f0d9  7b 83 fc b0 10                     .byt $7b,$83,$fc,$b0,$10
 6325 A:f0de  7c 0c 1f 67 ca                     .byt $7c,$0c,$1f,$67,$ca
 6326 A:f0e3  7c de 53 cb c1                     .byt $7c,$de,$53,$cb,$c1
 6327 A:f0e8  7d 14 64 70 4c                     .byt $7d,$14,$64,$70,$4c
 6328 A:f0ed  7d b7 ea 51 7a                     .byt $7d,$b7,$ea,$51,$7a
 6329 A:f0f2  7d 63 30 88 7e                     .byt $7d,$63,$30,$88,$7e
 6330 A:f0f7  7e 92 44 99 3a                     .byt $7e,$92,$44,$99,$3a
 6331 A:f0fc  7e 4c cc 91 c7                     .byt $7e,$4c,$cc,$91,$c7
 6332 A:f101  7f aa aa aa 13                     .byt $7f,$aa,$aa,$aa,$13
 6333 A:f106  81 00 00 00 00                     .byt $81,$00,$00,$00,$00
 6334 A:f10b                                    ; --------------------------------
 6335 A:f10b                                    ; GENERIC COPY OF CHRGET SUBROUTINE, WHICH
 6336 A:f10b                                    ; IS COPIED INTO $00B1...$00C8 DURING INITIALIZATION
 6337 A:f10b                                    ; 
 6338 A:f10b                                    ; CORNELIS BONGERS DESCRIBED SEVERAL IMPROVEMENTS
 6339 A:f10b                                    ; TO CHRGET IN MICRO MAGAZINE OR CALL A.P.P.L.E.
 6340 A:f10b                                    ; (I DON'T REMEMBER WHICH OR EXACTLY WHEN)
 6341 A:f10b                                    ; --------------------------------
 6342 A:f10b                           AS_GENERIC_CHRGET 
 6343 A:f10b  e6 b8                              inc AS_TXTPTR
 6344 A:f10d  d0 02                              bne AS_L_GENERIC_CHRGET_1
 6345 A:f10f  e6 b9                              inc AS_TXTPTR+1
 6346 A:f111  ad 60 ea                 AS_L_GENERIC_CHRGET_1 lda $ea60           ; <<< ACTUAL ADDRESS FILLED IN LATER >>>
 6347 A:f114  c9 3a                              cmp #(":"&%01111111)     ; EOS, ALSO TOP OF NUMERIC RANGE
 6348 A:f116  b0 0a                              bcs AS_L_GENERIC_CHRGET_2                ; NOT NUMBER, MIGHT BE EOS
 6349 A:f118  c9 20                              cmp #(" "&%01111111)     ; IGNORE BLANKS
 6350 A:f11a  f0 ef                              beq AS_GENERIC_CHRGET
 6351 A:f11c  38                                 sec                    ; TEST FOR NUMERIC RANGE IN WAY THAT
 6352 A:f11d  e9 30                              sbc #("0"&%01111111)     ; CLEARS CARRY IF CHAR IS DIGIT
 6353 A:f11f  38                                 sec                    ; AND LEAVES CHAR IN A-REG
 6354 A:f120  e9 d0                              sbc #$d0
 6355 A:f122  60                       AS_L_GENERIC_CHRGET_2 rts 
 6356 A:f123                                    ; --------------------------------
 6357 A:f123                                    ; INITIAL VALUE FOR RANDOM NUMBER, ALSO COPIED
 6358 A:f123                                    ; IN ALONG WITH CHRGET, BUT ERRONEOUSLY:
 6359 A:f123                                    ; <<< THE LAST BYTE IS NOT COPIED >>>
 6360 A:f123                                    ; --------------------------------

 6362 A:f123  80 4f c7 52 58                     .byt $80,$4f,$c7,$52,$58; APPROX. = L_GENERIC_CHRGET_811635157
 6363 A:f128                           AS_GENERIC_END 
