 9067 A:fbf0  a4 24                    MON_STOADV ldy $24           ;CURSOR H INDEX TO Y-REG
 9068 A:fbf2  91 28                              sta ($28),Y          ;STORE CHAR IN LINE
 9069 A:fbf4  e6 24                    MON_ADVANCE inc $24           ;INCREMENT CURSOR H INDEX
 9070 A:fbf6  a5 24                              lda $24              ;  (MOVE RIGHT)
 9071 A:fbf8  c5 21                              cmp $21              ;BEYOND WINDOW WIDTH?
 9072 A:fbfa  b0 66                              bcs MON_CR                ;  YES CR TO NEXT LINE
 9073 A:fbfc  60                       MON_RTS3  rts                 ;  NO,RETURN

 9075 A:fbfd  c9 a0                    MON_VIDOUT cmp #$a0          ;CONTROL CHAR?
 9076 A:fbff  b0 ef                              bcs MON_STOADV                ;  NO,OUTPUT IT.

 9078 A:fc01  a8                                 tay                    ;INVERSE VIDEO?
 9079 A:fc02  10 ec                              bpl MON_STOADV                ;  YES, OUTPUT IT.

 9081 A:fc04  c9 8d                              cmp #$8d             ;CR?
 9082 A:fc06  f0 5a                              beq MON_CR                ;  YES.
 9083 A:fc08  c9 8a                              cmp #$8a             ;LINE FEED?
 9084 A:fc0a  f0 5a                              beq MON_LF                ;  IF SO, DO IT.
 9085 A:fc0c  c9 88                              cmp #MON_ASCBS               ;BACK SPACE? (CNTRL-H)
 9086 A:fc0e  d0 c9                              bne MON_BELL1                ;  NO, CHECK FOR BELL.

 9088 A:fc10  c6 24                    MON_BS    dec $24           ;DECREMENT CURSOR H INDEX
