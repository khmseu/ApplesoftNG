 4063 A:e3e7                                    ; BUILD A DESCRIPTOR FOR STRING STARTING AT Y,A
 4064 A:e3e7                                    ; AND TERMINATED BY $00 OR QUOTATION MARK
 4065 A:e3e7                                    ; RETURN WITH DESCRIPTOR IN A TEMPORARY
 4066 A:e3e7                                    ; AND ADDRESS OF DESCRIPTOR IN FAC+3,4
 4067 A:e3e7                                    ; --------------------------------
 4068 A:e3e7  a2 22                    AS_STRLIT ldx #$22          ; SET UP LITERAL SCAN TO STOP ON
 4069 A:e3e9  86 0d                              stx AS_CHARAC                ; QUOTATION MARK OR $00
 4070 A:e3eb  86 0e                              stx AS_ENDCHR                ; 
 4071 A:e3ed                                    ; --------------------------------
 4072 A:e3ed                                    ; BUILD A DESCRIPTOR FOR STRING STARTING AT Y,A
 4073 A:e3ed                                    ; AND TERMINATED BY $00, (CHARAC), OR (ENDCHR)
 4074 A:e3ed                                    ; 
 4075 A:e3ed                                    ; RETURN WITH DESCRIPTOR IN A TEMPORARY
 4076 A:e3ed                                    ; AND ADDRESS OF DESCRIPTOR IN FAC+3,4
 4077 A:e3ed                                    ; --------------------------------
 4078 A:e3ed  85 ab                    AS_STRLT2 sta AS_STRNG1             ; SAVE ADDRESS OF STRING
 4079 A:e3ef  84 ac                              sty AS_STRNG1+1          ; 
 4080 A:e3f1  85 9e                              sta AS_FAC+1          ; ...AGAIN
 4081 A:e3f3  84 9f                              sty AS_FAC+2          ; 
 4082 A:e3f5  a0 ff                              ldy #$ff             ; 
 4083 A:e3f7  c8                       AS_L_STRLT2_1 iny                 ; FIND END OF STRING
 4084 A:e3f8  b1 ab                              lda (AS_STRNG1),Y                  ; NEXT STRING CHAR
 4085 A:e3fa  f0 0c                              beq AS_L_STRLT2_3                ; END OF STRING
 4086 A:e3fc  c5 0d                              cmp AS_CHARAC                ; ALTERNATE TERMINATOR # 1?
 4087 A:e3fe  f0 04                              beq AS_L_STRLT2_2                ; YES
 4088 A:e400  c5 0e                              cmp AS_ENDCHR                ; ALTERNATE TERMINATOR # 2?
 4089 A:e402  d0 f3                              bne AS_L_STRLT2_1                ; NO, KEEP SCANNING
 4090 A:e404  c9 22                    AS_L_STRLT2_2 cmp #$22          ; IS STRING ENDED WITH QUOTE MARK?
 4091 A:e406  f0 01                              beq AS_L_STRLT2_4                ; YES, C=1 TO INCLUDE " IN STRING
 4092 A:e408  18                       AS_L_STRLT2_3 clc                 ; 
