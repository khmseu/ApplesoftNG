 5557 A:ec23                                    ; "INT" FUNCTION
 5558 A:ec23                                    ; 
 5559 A:ec23                                    ; USES QINT TO CONVERT (FAC) TO INTEGER FORM,
 5560 A:ec23                                    ; AND THEN REFLOATS THE INTEGER.
 5561 A:ec23                                    ; <<< A FASTER APPROACH WOULD SIMPLY CLEAR >>>
 5562 A:ec23                                    ; <<< THE FRACTIONAL BITS BY ZEROING THEM  >>>
 5563 A:ec23                                    ; --------------------------------
 5564 A:ec23  a5 9d                    AS_INT    lda AS_FAC             ; CHECK IF EXPONENT < 32
 5565 A:ec25  c9 a0                              cmp #$a0             ; BECAUSE IF > 31 THERE IS NO FRACTION
 5566 A:ec27  b0 20                              bcs AS_RTS_17                ; NO FRACTION, WE ARE FINISHED
 5567 A:ec29  20 f2 eb                           jsr AS_QINT                ; USE GENERAL INTEGER CONVERSION
 5568 A:ec2c  84 ac                              sty AS_FAC_EXTENSION                ; Y=0, CLEAR EXTENSION
 5569 A:ec2e  a5 a2                              lda AS_FAC_SIGN                ; GET SIGN OF VALUE
 5570 A:ec30  84 a2                              sty AS_FAC_SIGN                ; Y=0, CLEAR SIGN
 5571 A:ec32  49 80                              eor #$80             ; TOGGLE ACTUAL SIGN
 5572 A:ec34  2a                                 rol                    ; AND SAVE IN CARRY
 5573 A:ec35  a9 a0                              lda #$a0             ; SET EXPONENT TO 32
 5574 A:ec37  85 9d                              sta AS_FAC                ; BECAUSE 4-BYTE INTEGER NOW
 5575 A:ec39  a5 a1                              lda AS_FAC+4          ; SAVE LOW 8-BITS OF INTEGER FORM
 5576 A:ec3b  85 0d                              sta AS_CHARAC                ; FOR EXP AND POWER
 5577 A:ec3d  4c 29 e8                           jmp AS_NORMALIZE_FAC_1                ; NORMALIZE TO FINISH CONVERSION
 5578 A:ec40                                    ; --------------------------------
 5579 A:ec40  85 9e                    AS_QINT_3 sta AS_FAC+1       ; FAC=0, SO CLEAR ALL 4 BYTES FOR
 5580 A:ec42  85 9f                              sta AS_FAC+2          ; INTEGER VERSION
 5581 A:ec44  85 a0                              sta AS_FAC+3          ; 
 5582 A:ec46  85 a1                              sta AS_FAC+4          ; 
 5583 A:ec48  a8                                 tay                    ; Y=0 TOO
 5584 A:ec49  60                       AS_RTS_17 rts                 ; 
 5585 A:ec4a                                    ; --------------------------------
 5586 A:ec4a                                    ; CONVERT STRING TO FP VALUE IN FAC
 5587 A:ec4a                                    ; 
 5588 A:ec4a                                    ; STRING POINTED TO BY TXTPTR
 5589 A:ec4a                                    ; FIRST CHAR ALREADY SCANNED BY CHRGET
 5590 A:ec4a                                    ; (A) = FIRST CHAR, C=0 IF DIGIT.
 5591 A:ec4a                                    ; --------------------------------
 5592 A:ec4a  a0 00                    AS_FIN    ldy #0          ; CLEAR WORKING AREA ($99...$A3)
 5593 A:ec4c  a2 0a                              ldx #10             ; TMPEXP, EXPON, DPFLG, EXPSGN, FAC, SERLEN
 5594 A:ec4e  94 99                    AS_L_FIN_1 sty AS_TMPEXP,X
 5595 A:ec50  ca                                 dex 
 5596 A:ec51  10 fb                              bpl AS_L_FIN_1
 5597 A:ec53                                    ; --------------------------------
 5598 A:ec53  90 0f                              bcc AS_FIN_2                ; FIRST CHAR IS A DIGIT
 5599 A:ec55  c9 2d                              cmp #("-"&%01111111)     ; CHECK FOR LEADING SIGN
 5600 A:ec57  d0 04                              bne AS_L_FIN_2                ; NOT MINUS
 5601 A:ec59  86 a3                              stx AS_SERLEN                ; MINUS, SET SERLEN = $FF FOR FLAG
 5602 A:ec5b  f0 04                              beq AS_FIN_1                ; ...ALWAYS
 5603 A:ec5d  c9 2b                    AS_L_FIN_2 cmp #("+"&%01111111)  ; MIGHT BE PLUS
 5604 A:ec5f  d0 05                              bne AS_FIN_3                ; NOT PLUS EITHER, CHECK DECIMAL POINT
 5605 A:ec61                                    ; --------------------------------
 5606 A:ec61  20 b1 00                 AS_FIN_1  jsr AS_CHRGET             ; GET NEXT CHAR OF STRING
 5607 A:ec64                                    ; --------------------------------
 5608 A:ec64  90 5b                    AS_FIN_2  bcc AS_FIN_9             ; INSERT THIS DIGIT
 5609 A:ec66                                    ; --------------------------------
 5610 A:ec66  c9 2e                    AS_FIN_3  cmp #("."&%01111111)  ; CHECK FOR DECIMAL POINT
 5611 A:ec68  f0 2e                              beq AS_FIN_10                ; YES
 5612 A:ec6a  c9 45                              cmp #("E"&%01111111)     ; CHECK FOR EXPONENT PART
 5613 A:ec6c  d0 30                              bne AS_FIN_7                ; NO, END OF NUMBER
 5614 A:ec6e  20 b1 00                           jsr AS_CHRGET                ; YES, START CONVERTING EXPONENT
 5615 A:ec71  90 17                              bcc AS_FIN_5                ; EXPONENT DIGIT
 5616 A:ec73  c9 c9                              cmp #AS_TOKEN_MINUS               ; NEGATIVE EXPONENT?
 5617 A:ec75  f0 0e                              beq AS_L_FIN_3_1                ; YES
 5618 A:ec77  c9 2d                              cmp #("-"&%01111111)     ; MIGHT NOT BE TOKENIZED YET
 5619 A:ec79  f0 0a                              beq AS_L_FIN_3_1                ; YES, IT IS NEGATIVE
 5620 A:ec7b  c9 c8                              cmp #AS_TOKEN_PLUS               ; OPTIONAL "+"
 5621 A:ec7d  f0 08                              beq AS_FIN_4                ; YES
 5622 A:ec7f  c9 2b                              cmp #("+"&%01111111)     ; MIGHT NOT BE TOKENIZED YET
 5623 A:ec81  f0 04                              beq AS_FIN_4                ; YES, FOUND "+"
 5624 A:ec83  d0 07                              bne AS_FIN_6                ; ...ALWAYS, NUMBER COMPLETED
 5625 A:ec85  66 9c                    AS_L_FIN_3_1 ror AS_EXPSGN             ; C=1, SET FLAG NEGATIVE
 5626 A:ec87                                    ; --------------------------------
 5627 A:ec87  20 b1 00                 AS_FIN_4  jsr AS_CHRGET             ; GET NEXT DIGIT OF EXPONENT
 5628 A:ec8a                                    ; --------------------------------
 5629 A:ec8a  90 5c                    AS_FIN_5  bcc AS_GETEXP             ; CHAR IS A DIGIT OF EXPONENT
 5630 A:ec8c                                    ; --------------------------------
 5631 A:ec8c  24 9c                    AS_FIN_6  bit AS_EXPSGN             ; END OF NUMBER, CHECK EXP SIGN
 5632 A:ec8e  10 0e                              bpl AS_FIN_7                ; POSITIVE EXPONENT
 5633 A:ec90  a9 00                              lda #0             ; NEGATIVE EXPONENT
 5634 A:ec92  38                                 sec                    ; MAKE 2'S COMPLEMENT OF EXPONENT
 5635 A:ec93  e5 9a                              sbc AS_EXPON                ; 
 5636 A:ec95  4c a0 ec                           jmp AS_FIN_8                ; 
 5637 A:ec98                                    ; --------------------------------
 5638 A:ec98                                    ; FOUND A DECIMAL POINT
 5639 A:ec98                                    ; --------------------------------
 5640 A:ec98  66 9b                    AS_FIN_10 ror AS_DPFLG             ; C=1, SET DPFLG FOR DECIMAL POINT
 5641 A:ec9a  24 9b                              bit AS_DPFLG                ; CHECK IF PREVIOUS DEC. PT.
 5642 A:ec9c  50 c3                              bvc AS_FIN_1                ; NO PREVIOUS DECIMAL POINT
 5643 A:ec9e                                    ; A SECOND DECIMAL POINT IS TAKEN AS A TERMINATOR
 5644 A:ec9e                                    ; TO THE NUMERIC STRING.
 5645 A:ec9e                                    ; "A=11..22" WILL GIVE A SYNTAX ERROR, BECAUSE
 5646 A:ec9e                                    ; IT IS TWO NUMBERS WITH NO OPERATOR BETWEEN.
 5647 A:ec9e                                    ; "PRINT 11..22" GIVES NO ERROR, BECAUSE IT IS
 5648 A:ec9e                                    ; JUST THE CONCATENATION OF TWO NUMBERS.
 5649 A:ec9e                                    ; --------------------------------
 5650 A:ec9e                                    ; NUMBER TERMINATED, ADJUST EXPONENT NOW
 5651 A:ec9e                                    ; --------------------------------
 5652 A:ec9e  a5 9a                    AS_FIN_7  lda AS_EXPON             ; E-VALUE
 5653 A:eca0  38                       AS_FIN_8  sec                 ; MODIFY WITH COUNT OF DIGITS
 5654 A:eca1  e5 99                              sbc AS_TMPEXP                ; AFTER THE DECIMAL POINT
 5655 A:eca3  85 9a                              sta AS_EXPON                ; COMPLETE CURRENT EXPONENT
 5656 A:eca5  f0 12                              beq AS_L_FIN_8_15                ; NO ADJUST NEEDED IF EXP=0
 5657 A:eca7  10 09                              bpl AS_L_FIN_8_14                ; EXP>0, MULTIPLY BY TEN
 5658 A:eca9  20 55 ea                 AS_L_FIN_8_13 jsr AS_DIV10             ; EXP<0, DIVIDE BY TEN
 5659 A:ecac  e6 9a                              inc AS_EXPON                ; UNTIL EXP=0
 5660 A:ecae  d0 f9                              bne AS_L_FIN_8_13                ; 
 5661 A:ecb0  f0 07                              beq AS_L_FIN_8_15                ; ...ALWAYS, WE ARE FINISHED
 5662 A:ecb2  20 39 ea                 AS_L_FIN_8_14 jsr AS_MUL10             ; EXP>0, MULTIPLY BKY TEN
 5663 A:ecb5  c6 9a                              dec AS_EXPON                ; UNTIL EXP=0
 5664 A:ecb7  d0 f9                              bne AS_L_FIN_8_14                ; 
 5665 A:ecb9  a5 a3                    AS_L_FIN_8_15 lda AS_SERLEN             ; IS WHOLE NUMBER NEGATIVE?
 5666 A:ecbb  30 01                              bmi AS_L_FIN_8_16                ; YES
 5667 A:ecbd  60                                 rts                    ; NO, RETURN, WHOLE JOB DONE!
 5668 A:ecbe  4c d0 ee                 AS_L_FIN_8_16 jmp AS_NEGOP             ; NEGATIVE NUMBER, SO NEGATE FAC
 5669 A:ecc1                                    ; --------------------------------
 5670 A:ecc1                                    ; ACCUMULATE A DIGIT INTO FAC
 5671 A:ecc1                                    ; --------------------------------
 5672 A:ecc1  48                       AS_FIN_9  pha                 ; SAVE DIGIT
 5673 A:ecc2  24 9b                              bit AS_DPFLG                ; SEEN A DECIMAL POINT YET?
 5674 A:ecc4  10 02                              bpl AS_L_FIN_9_1                ; NO, STILL IN INTEGER PART
 5675 A:ecc6  e6 99                              inc AS_TMPEXP                ; YES, COUNT THE FRACTIONAL DIGIT
 5676 A:ecc8  20 39 ea                 AS_L_FIN_9_1 jsr AS_MUL10             ; FAC = FAC * 10
 5677 A:eccb  68                                 pla                    ; CURRENT DIGIT
 5678 A:eccc  38                                 sec                    ; <<<SHORTER HERE TO JUST "AND #$0F">>>
 5679 A:eccd  e9 30                              sbc #("0"&%01111111)     ; <<<TO CONVERT ASCII TO BINARY FORM>>>
 5680 A:eccf  20 d5 ec                           jsr AS_ADDACC                ; ADD THE DIGIT
 5681 A:ecd2  4c 61 ec                           jmp AS_FIN_1                ; GO BACK FOR MORE
 5682 A:ecd5                                    ; --------------------------------
 5683 A:ecd5                                    ; ADD (A) TO FAC
 5684 A:ecd5                                    ; --------------------------------
 5685 A:ecd5  48                       AS_ADDACC pha                 ; SAVE ADDEND
 5686 A:ecd6  20 63 eb                           jsr AS_COPY_FAC_TO_ARG_ROUNDED
 5687 A:ecd9  68                                 pla                    ; GET ADDEND AGAIN
 5688 A:ecda  20 93 eb                           jsr AS_FLOAT                ; CONVERT TO FP VALUE IN FAC
 5689 A:ecdd  a5 aa                              lda AS_ARG_SIGN                ; 
 5690 A:ecdf  45 a2                              eor AS_FAC_SIGN                ; 
 5691 A:ece1  85 ab                              sta AS_SGNCPR                ; 
 5692 A:ece3  a6 9d                              ldx AS_FAC                ; TO SIGNAL IF FAC=0
 5693 A:ece5  4c c1 e7                           jmp AS_FADDT                ; PERFORM THE ADDITION
 5694 A:ece8                                    ; --------------------------------
 5695 A:ece8                                    ; ACCUMULATE DIGIT OF EXPONENT
 5696 A:ece8                                    ; --------------------------------
 5697 A:ece8  a5 9a                    AS_GETEXP lda AS_EXPON             ; CHECK CURRENT VALUE
 5698 A:ecea  c9 0a                              cmp #10             ; FOR MORE THAN 2 DIGITS
 5699 A:ecec  90 09                              bcc AS_L_GETEXP_1                ; NO, THIS IS 1ST OR 2ND DIGIT
 5700 A:ecee  a9 64                              lda #100             ; EXPONENT TOO BIG
 5701 A:ecf0  24 9c                              bit AS_EXPSGN                ; UNLESS IT IS NEGATIVE
 5702 A:ecf2  30 11                              bmi AS_L_GETEXP_2                ; LARGE NEGATIVE EXPONENT MAKES FAC=0
 5703 A:ecf4  4c d5 e8                           jmp AS_OVERFLOW                ; LARGE POSITIVE EXPONENT IS ERROR
 5704 A:ecf7  0a                       AS_L_GETEXP_1 asl                 ; EXPONENT TIMES 10
 5705 A:ecf8  0a                                 asl                    ; 
 5706 A:ecf9  18                                 clc                    ; 
 5707 A:ecfa  65 9a                              adc AS_EXPON                ; 
 5708 A:ecfc  0a                                 asl                    ; 
 5709 A:ecfd  18                                 clc                    ; <<< ASL ALREADY DID THIS! >>>
 5710 A:ecfe  a0 00                              ldy #0             ; ADD THE NEW DIGIT
 5711 A:ed00  71 b8                              adc (AS_TXTPTR),Y                  ; BUT THIS IS IN ASCII,
 5712 A:ed02  38                                 sec                    ; SO ADJUST BACK TO BINARY
 5713 A:ed03  e9 30                              sbc #("0"&%01111111)
 5714 A:ed05  85 9a                    AS_L_GETEXP_2 sta AS_EXPON             ; NEW VALUE
 5715 A:ed07  4c 87 ec                           jmp AS_FIN_4                ; BACK FOR MORE
 5716 A:ed0a                                    ; --------------------------------
 5717 A:ed0a                                    ; --------------------------------

 5719 A:ed0a  9b 3e bc 1f fd           AS_CON_99999999P9 .byt $9b,$3e,$bc,$1f,$fd; 99,999,999.9
 5720 A:ed0f  9e 6e 6b 27 fd           AS_CON_999999999 .byt $9e,$6e,$6b,$27,$fd; 999,999,999
 5721 A:ed14  9e 6e 6b 28 00           AS_CON_BILLION .byt $9e,$6e,$6b,$28,$00; 1,000,000,000
 5722 A:ed19                                    ; --------------------------------
 5723 A:ed19                                    ; PRINT "IN <LINE #>"
 5724 A:ed19                                    ; --------------------------------
 5725 A:ed19  a9 58                    AS_INPRT  lda #<AS_QT_IN           ; PRINT " IN "
 5726 A:ed1b  a0 d3                              ldy #>AS_QT_IN
 5727 A:ed1d  20 31 ed                           jsr AS_GO_STROUT
 5728 A:ed20  a5 76                              lda AS_CURLIN+1
 5729 A:ed22  a6 75                              ldx AS_CURLIN
 5730 A:ed24                                    ; --------------------------------
 5731 A:ed24                                    ; PRINT A,X AS DECIMAL INTEGER
 5732 A:ed24                                    ; --------------------------------
 5733 A:ed24  85 9e                    AS_LINPRT sta AS_FAC+1       ; PRINT A,X IN DECIMAL
 5734 A:ed26  86 9f                              stx AS_FAC+2          ; 
 5735 A:ed28  a2 90                              ldx #$90             ; EXPONENT = 2^16
 5736 A:ed2a  38                                 sec                    ; CONVERT UNSIGNED
 5737 A:ed2b  20 a0 eb                           jsr AS_FLOAT_2                ; CONVERT LINE # TO FP
 5738 A:ed2e                                    ; --------------------------------
 5739 A:ed2e                                    ; CONVERT (FAC) TO STRING, AND PRINT IT
 5740 A:ed2e                                    ; --------------------------------
 5741 A:ed2e                           AS_PRINT_FAC                  ; 
 5742 A:ed2e  20 34 ed                           jsr AS_FOUT                ; CONVERT (FAC) TO STRING AT STACK
 5743 A:ed31                                    ; --------------------------------
 5744 A:ed31                                    ; PRINT STRING STARTING AT Y,A
 5745 A:ed31                                    ; --------------------------------
 5746 A:ed31                           AS_GO_STROUT                  ; 
 5747 A:ed31  4c 3a db                           jmp AS_STROUT                ; PRINT STRING AT A,Y
 5748 A:ed34                                    ; --------------------------------
 5749 A:ed34                                    ; CONVERT (FAC) TO STRING STARTING AT STACK
 5750 A:ed34                                    ; RETURN WITH (Y,A) POINTING AT STRING
 5751 A:ed34                                    ; --------------------------------
 5752 A:ed34  a0 01                    AS_FOUT   ldy #1          ; NORMAL ENTRY PUTS STRING AT STACK...
 5753 A:ed36                                    ; --------------------------------
 5754 A:ed36                                    ; "STR$" FUNCTION ENTERS HERE, WITH (Y)=0
 5755 A:ed36                                    ; SO THAT RESULT STRING STARTS AT STACK-1
 5756 A:ed36                                    ; (THIS IS USED AS A FLAG)
 5757 A:ed36                                    ; --------------------------------
 5758 A:ed36  a9 2d                    AS_FOUT_1 lda #("-"&%01111111)  ; IN CASE VALUE NEGATIVE
 5759 A:ed38  88                                 dey                    ; BACK UP PNTR
 5760 A:ed39  24 a2                              bit AS_FAC_SIGN                ; 
 5761 A:ed3b  10 04                              bpl AS_L_FOUT_1_1                ; VALUE IS +
 5762 A:ed3d  c8                                 iny                    ; VALUE IS -
 5763 A:ed3e  99 ff 00                           sta AS_STACK-1,Y                   ; EMIT "-"
 5764 A:ed41  85 a2                    AS_L_FOUT_1_1 sta AS_FAC_SIGN             ; MAKE FAC.SIGN POSITIVE ($2D)
 5765 A:ed43  84 ad                              sty AS_STRNG2                ; SAVE STRING PNTR
 5766 A:ed45  c8                                 iny                    ; 
 5767 A:ed46  a9 30                              lda #("0"&%01111111)     ; IN CASE (FAC)=0
 5768 A:ed48  a6 9d                              ldx AS_FAC                ; NUMBER=0?
 5769 A:ed4a  d0 03                              bne AS_L_FOUT_1_2                ; NO, (FAC) NOT ZERO
 5770 A:ed4c  4c 57 ee                           jmp AS_FOUT_4                ; YES, FINISHED
 5771 A:ed4f                                    ; --------------------------------
 5772 A:ed4f  a9 00                    AS_L_FOUT_1_2 lda #0          ; STARTING VALUE FOR TMPEXP
 5773 A:ed51  e0 80                              cpx #$80             ; ANY INTEGER PART?
 5774 A:ed53  f0 02                              beq AS_L_FOUT_1_3                ; NO, BTWN L_FOUT_1_5 AND L_FOUT_1_999999999
 5775 A:ed55  b0 09                              bcs AS_L_FOUT_1_4                ; YES
 5776 A:ed57                                    ; --------------------------------
 5777 A:ed57  a9 14                    AS_L_FOUT_1_3 lda #<AS_CON_BILLION           ; MULTIPLY BY 1E9
 5778 A:ed59  a0 ed                              ldy #>AS_CON_BILLION              ; TO GIVE ADJUSTMENT A HEAD START
 5779 A:ed5b  20 7f e9                           jsr AS_FMULT                ; 
 5780 A:ed5e  a9 f7                              lda #$0100-9       ; EXPONENT ADJUSTMENT
 5781 A:ed60  85 99                    AS_L_FOUT_1_4 sta AS_TMPEXP             ; 0 OR -9
 5782 A:ed62                                    ; --------------------------------
 5783 A:ed62                                    ; ADJUST UNTIL 1E8 <= (FAC) <1E9
 5784 A:ed62                                    ; --------------------------------
 5785 A:ed62  a9 0f                    AS_L_FOUT_1_5 lda #<AS_CON_999999999
 5786 A:ed64  a0 ed                              ldy #>AS_CON_999999999
 5787 A:ed66  20 b2 eb                           jsr AS_FCOMP                ; COMPARE TO 1E9-1
 5788 A:ed69  f0 1e                              beq AS_L_FOUT_1_10                ; (FAC) = 1E9-1
 5789 A:ed6b  10 12                              bpl AS_L_FOUT_1_8                ; TOO LARGE, DIVIDE BY TEN
 5790 A:ed6d  a9 0a                    AS_L_FOUT_1_6 lda #<AS_CON_99999999P9           ; COMPARE TO 1E8-L_FOUT_1_1
 5791 A:ed6f  a0 ed                              ldy #>AS_CON_99999999P9
 5792 A:ed71  20 b2 eb                           jsr AS_FCOMP                ; COMPARE TO 1E8-L_FOUT_1_1
 5793 A:ed74  f0 02                              beq AS_L_FOUT_1_7                ; (FAC) = 1E8-L_FOUT_1_1
 5794 A:ed76  10 0e                              bpl AS_L_FOUT_1_9                ; IN RANGE, ADJUSTMENT FINISHED
 5795 A:ed78  20 39 ea                 AS_L_FOUT_1_7 jsr AS_MUL10             ; TOO SMALL, MULTIPLY BY TEN
 5796 A:ed7b  c6 99                              dec AS_TMPEXP                ; KEEP TRACK OF MULTIPLIES
 5797 A:ed7d  d0 ee                              bne AS_L_FOUT_1_6                ; ...ALWAYS
 5798 A:ed7f  20 55 ea                 AS_L_FOUT_1_8 jsr AS_DIV10             ; TOO LARGE, DIVIDE BY TEN
 5799 A:ed82  e6 99                              inc AS_TMPEXP                ; KEEP TRACK OF DIVISIONS
 5800 A:ed84  d0 dc                              bne AS_L_FOUT_1_5                ; ...ALWAYS
 5801 A:ed86                                    ; --------------------------------
 5802 A:ed86  20 a0 e7                 AS_L_FOUT_1_9 jsr AS_FADDH             ; ROUND ADJUSTED RESULT
 5803 A:ed89  20 f2 eb                 AS_L_FOUT_1_10 jsr AS_QINT             ; CONVERT ADJUSTED VALUE TO 32-BIT INTEGER
 5804 A:ed8c                                    ; --------------------------------
 5805 A:ed8c                                    ; FAC+1...FAC+4 IS NOW IN INTEGER FORM
 5806 A:ed8c                                    ; WITH POWER OF TEN ADJUSTMENT IN TMPEXP
 5807 A:ed8c                                    ; 
 5808 A:ed8c                                    ; IF -10 < TMPEXP > 1, PRINT IN DECIMAL FORM
 5809 A:ed8c                                    ; OTHERWISE, PRINT IN EXPONENTIAL FORM
 5810 A:ed8c                                    ; --------------------------------
 5811 A:ed8c  a2 01                    AS_FOUT_2 ldx #1          ; ASSUME 1 DIGIT BEFORE "."
 5812 A:ed8e  a5 99                              lda AS_TMPEXP                ; CHECK RANGE
 5813 A:ed90  18                                 clc                    ; 
 5814 A:ed91  69 0a                              adc #10             ; 
 5815 A:ed93  30 09                              bmi AS_L_FOUT_2_1                ; < .01, USE EXPONENTIAL FORM
 5816 A:ed95  c9 0b                              cmp #11             ; 
 5817 A:ed97  b0 06                              bcs AS_L_FOUT_2_2                ; >= 1E10, USE EXPONENTIAL FORM
 5818 A:ed99  69 ff                              adc #$ff             ; LESS 1 GIVES INDEX FOR "."
 5819 A:ed9b  aa                                 tax                    ; 
 5820 A:ed9c  a9 02                              lda #2             ; SET REMAINING EXPONENT = 0
 5821 A:ed9e  38                       AS_L_FOUT_2_1 sec                 ; COMPUTE REMAINING EXPONENT
 5822 A:ed9f  e9 02                    AS_L_FOUT_2_2 sbc #2          ; 
 5823 A:eda1  85 9a                              sta AS_EXPON                ; VALUE FOR "E+XX" OR "E-XX"
 5824 A:eda3  86 99                              stx AS_TMPEXP                ; INDEX FOR DECIMAL POINT
 5825 A:eda5  8a                                 txa                    ; SEE IF "." COMES FIRST
 5826 A:eda6  f0 02                              beq AS_L_FOUT_2_3                ; YES
 5827 A:eda8  10 13                              bpl AS_L_FOUT_2_5                ; NO, LATER
 5828 A:edaa  a4 ad                    AS_L_FOUT_2_3 ldy AS_STRNG2             ; GET INDEX INTO STRING BEING BUILT
 5829 A:edac  a9 2e                              lda #("."&%01111111)     ; STORE A DECIMAL POINT
 5830 A:edae  c8                                 iny                    ; 
 5831 A:edaf  99 ff 00                           sta AS_STACK-1,Y                   ; 
 5832 A:edb2  8a                                 txa                    ; SEE IF NEED ".0"
 5833 A:edb3  f0 06                              beq AS_L_FOUT_2_4                ; NO
 5834 A:edb5  a9 30                              lda #("0"&%01111111)     ; YES, STORE "0"
 5835 A:edb7  c8                                 iny                    ; 
 5836 A:edb8  99 ff 00                           sta AS_STACK-1,Y                   ; 
 5837 A:edbb  84 ad                    AS_L_FOUT_2_4 sty AS_STRNG2             ; SAVE OUTPUT INDEX AGAIN
 5838 A:edbd                                    ; --------------------------------
 5839 A:edbd                                    ; NOW DIVIDE BY POWERS OF TEN TO GET SUCCESSIVE DIGITS
 5840 A:edbd                                    ; --------------------------------
 5841 A:edbd  a0 00                    AS_L_FOUT_2_5 ldy #0          ; INDEX TO TABLE OF POWERS OF TEN
 5842 A:edbf  a2 80                              ldx #$80             ; STARTING VALUE FOR DIGIT WITH DIRECTION
 5843 A:edc1  a5 a1                    AS_L_FOUT_2_6 lda AS_FAC+4       ; START BY ADDING -100000000 UNTIL
 5844 A:edc3  18                                 clc                    ; OVERSHOOT.  THEN ADD +10000000,
 5845 A:edc4  79 6c ee                           adc AS_DECTBL+3,Y                  ; THEN ADD -1000000, THEN ADD
 5846 A:edc7  85 a1                              sta AS_FAC+4          ; +100000, AND SO ON.
 5847 A:edc9  a5 a0                              lda AS_FAC+3          ; THE # OF TIMES EACH POWER IS ADDED
 5848 A:edcb  79 6b ee                           adc AS_DECTBL+2,Y                  ; IS 1 MORE THAN CORRESPONDING DIGIT
 5849 A:edce  85 a0                              sta AS_FAC+3
 5850 A:edd0  a5 9f                              lda AS_FAC+2
 5851 A:edd2  79 6a ee                           adc AS_DECTBL+1,Y
 5852 A:edd5  85 9f                              sta AS_FAC+2
 5853 A:edd7  a5 9e                              lda AS_FAC+1
 5854 A:edd9  79 69 ee                           adc AS_DECTBL,Y
 5855 A:eddc  85 9e                              sta AS_FAC+1
 5856 A:edde  e8                                 inx                    ; COUNT THE ADD
 5857 A:eddf  b0 04                              bcs AS_L_FOUT_2_7                ; IF C=1 AND X NEGATIVE, KEEP ADDING
 5858 A:ede1  10 de                              bpl AS_L_FOUT_2_6                ; IF C=0 AND X POSITIVE, KEEP ADDING
 5859 A:ede3  30 02                              bmi AS_L_FOUT_2_8                ; IF C=0 AND X NEGATIVE, WE OVERSHOT
 5860 A:ede5  30 da                    AS_L_FOUT_2_7 bmi AS_L_FOUT_2_6             ; IF C=1 AND X POSITIVE, WE OVERSHOT
 5861 A:ede7  8a                       AS_L_FOUT_2_8 txa                 ; OVERSHOT, SO MAKE X INTO A DIGIT
 5862 A:ede8  90 04                              bcc AS_L_FOUT_2_9                ; HOW DEPENDS ON DIRECTION WE WERE GOING
 5863 A:edea  49 ff                              eor #$ff             ; DIGIT = 9-X
 5864 A:edec  69 0a                              adc #10             ; 
 5865 A:edee  69 2f                    AS_L_FOUT_2_9 adc #("0"&%01111111)-1; MAKE DIGIT INTO ASCII
 5866 A:edf0  c8                                 iny                    ; ADVANCE TO NEXT SMALLER POWER OF TEN
 5867 A:edf1  c8                                 iny                    ; 
 5868 A:edf2  c8                                 iny                    ; 
 5869 A:edf3  c8                                 iny                    ; 
 5870 A:edf4  84 83                              sty AS_VARPNT                ; SAVE PNTR TO POWERS
 5871 A:edf6  a4 ad                              ldy AS_STRNG2                ; GET OUTPUT PNTR
 5872 A:edf8  c8                                 iny                    ; STORE THE DIGIT
 5873 A:edf9  aa                                 tax                    ; SAVE DIGIT, HI-BIT IS DIRECTION
 5874 A:edfa  29 7f                              and #$7f             ; MAKE SURE $30...$39 FOR STRING
 5875 A:edfc  99 ff 00                           sta AS_STACK-1,Y                   ; 
 5876 A:edff  c6 99                              dec AS_TMPEXP                ; COUNT THE DIGIT
 5877 A:ee01  d0 06                              bne AS_L_FOUT_2_10                ; NOT TIME FOR "." YET
 5878 A:ee03  a9 2e                              lda #("."&%01111111)     ; TIME, SO STORE THE DECIMAL POINT
 5879 A:ee05  c8                                 iny                    ; 
 5880 A:ee06  99 ff 00                           sta AS_STACK-1,Y                   ; 
 5881 A:ee09  84 ad                    AS_L_FOUT_2_10 sty AS_STRNG2             ; SAVE OUTPUT PNTR AGAIN
 5882 A:ee0b  a4 83                              ldy AS_VARPNT                ; GET PNTR TO POWERS
 5883 A:ee0d  8a                                 txa                    ; GET DIGIT WITH HI-BIT = DIRECTION
 5884 A:ee0e  49 ff                              eor #$ff             ; CHANGE DIRECTION
 5885 A:ee10  29 80                              and #$80             ; $00 IF ADDING, $80 IF SUBTRACTING
 5886 A:ee12  aa                                 tax 
 5887 A:ee13  c0 24                              cpy #AS_DECTBL_END-AS_DECTBL
 5888 A:ee15  d0 aa                              bne AS_L_FOUT_2_6                ; NOT FINISHED YET
 5889 A:ee17                                    ; --------------------------------
 5890 A:ee17                                    ; NINE DIGITS HAVE BEEN STORED IN STRING.  NOW LOOK
 5891 A:ee17                                    ; BACK AND LOP OFF TRAILING ZEROES AND A TRAILING
 5892 A:ee17                                    ; DECIMAL POINT.
 5893 A:ee17                                    ; --------------------------------
 5894 A:ee17  a4 ad                    AS_FOUT_3 ldy AS_STRNG2             ; POINTS AT LAST STORED CHAR
 5895 A:ee19  b9 ff 00                 AS_L_FOUT_3_1 lda AS_STACK-1,Y                   ; SEE IF LOPPABLE
 5896 A:ee1c  88                                 dey                    ; 
 5897 A:ee1d  c9 30                              cmp #("0"&%01111111)     ; SUPPRESS TRAILING ZEROES
 5898 A:ee1f  f0 f8                              beq AS_L_FOUT_3_1                ; YES, KEEP LOOPING
 5899 A:ee21  c9 2e                              cmp #("."&%01111111)     ; SUPPRESS TRAILING DECIMAL POINT
 5900 A:ee23  f0 01                              beq AS_L_FOUT_3_2                ; ".", SO WRITE OVER IT
 5901 A:ee25  c8                                 iny                    ; NOT ".", SO INCLUDE IN STRING AGAIN
 5902 A:ee26  a9 2b                    AS_L_FOUT_3_2 lda #("+"&%01111111)  ; PREPARE FOR POSITIVE EXPONENT "E+XX"
 5903 A:ee28  a6 9a                              ldx AS_EXPON                ; SEE IF ANY E-VALUE
 5904 A:ee2a  f0 2e                              beq AS_FOUT_5                ; NO, JUST MARK END OF STRING
 5905 A:ee2c  10 08                              bpl AS_L_FOUT_3_3                ; YES, AND IT IS POSITIVE
 5906 A:ee2e  a9 00                              lda #0             ; YES, AND IT IS NEGATIVE
 5907 A:ee30  38                                 sec                    ; COMPLEMENT THE VALUE
 5908 A:ee31  e5 9a                              sbc AS_EXPON                ; 
 5909 A:ee33  aa                                 tax                    ; GET MAGNITUDE IN X
 5910 A:ee34  a9 2d                              lda #("-"&%01111111)     ; E SIGN
 5911 A:ee36  99 01 01                 AS_L_FOUT_3_3 sta AS_STACK+1,Y                   ; STORE SIGN IN STRING
 5912 A:ee39  a9 45                              lda #("E"&%01111111)     ; STORE "E" IN STRING BEFORE SIGN
 5913 A:ee3b  99 00 01                           sta AS_STACK,Y                     ; 
 5914 A:ee3e  8a                                 txa                    ; EXPONENT MAGNITUDE IN A-REG
 5915 A:ee3f  a2 2f                              ldx #("0"&%01111111)-1; SEED FOR EXPONENT DIGIT
 5916 A:ee41  38                                 sec                    ; CONVERT TO DECIMAL
 5917 A:ee42  e8                       AS_L_FOUT_3_4 inx                 ; COUNT THE SUBTRACTION
 5918 A:ee43  e9 0a                              sbc #10             ; TEN'S DIGIT
 5919 A:ee45  b0 fb                              bcs AS_L_FOUT_3_4                ; MORE TENS TO SUBTRACT
 5920 A:ee47  69 3a                              adc #("0"&%01111111)+10; CONVERT REMAINDER TO ONE'S DIGIT
 5921 A:ee49  99 03 01                           sta AS_STACK+3,Y                   ; STORE ONE'S DIGIT
 5922 A:ee4c  8a                                 txa                    ; 
 5923 A:ee4d  99 02 01                           sta AS_STACK+2,Y                   ; STORE TEN'S DIGIT
 5924 A:ee50  a9 00                              lda #0             ; MARK END OF STRING WITH $00
 5925 A:ee52  99 04 01                           sta AS_STACK+4,Y                   ; 
 5926 A:ee55  f0 08                              beq AS_FOUT_6                ; ...ALWAYS
 5927 A:ee57  99 ff 00                 AS_FOUT_4 sta AS_STACK-1,Y                   ; STORE "0" IN ASCII
 5928 A:ee5a  a9 00                    AS_FOUT_5 lda #0          ; STORE $00 ON END OF STRING
 5929 A:ee5c  99 00 01                           sta AS_STACK,Y                     ; 
 5930 A:ee5f  a9 00                    AS_FOUT_6 lda #<AS_STACK           ; POINT Y,A AT BEGINNING OF STRING
 5931 A:ee61  a0 01                              ldy #>AS_STACK              ; (STR$ STARTED STRING AT STACK-1, BUT
 5932 A:ee63  60                                 rts                    ; STR$ DOESN'T USE Y,A ANYWAY.)
 5933 A:ee64                                    ; --------------------------------

 5935 A:ee64  80 00 00 00 00           AS_CON_HALF .byt $80,$00,$00,$00,$00; FP CONSTANT 0L_CON_HALF_5
 5936 A:ee69                                    ; --------------------------------
 5937 A:ee69                                    ; POWERS OF 10 FROM 1E8 DOWN TO 1,
 5938 A:ee69                                    ; AS 32-BIT INTEGERS, WITH ALTERNATING SIGNS
 5939 A:ee69                                    ; --------------------------------

 5941 A:ee69  fa 0a 1f 00              AS_DECTBL .byt $fa,$0a,$1f,$00; -100000000
 5942 A:ee6d  00 98 96 80                        .byt $00,$98,$96,$80; 10000000
 5943 A:ee71  ff f0 bd c0                        .byt $ff,$f0,$bd,$c0; -1000000
