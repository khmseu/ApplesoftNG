 3422 A:e07d                                    ; RETURN CARRY = 1 IF A-Z
 3423 A:e07d                                    ; = 0 IF NOT
 3424 A:e07d                                    ; 
 3425 A:e07d                                    ; <<<NOTE FASTER AND SHORTER CODE:    >>>
 3426 A:e07d                                    ; <<<    CMP #LOCHAR(`Z')+1  COMPARE HI END
