 7482 A:f72d                                    ; SET UP FOR DRAW AND XDRAW
 7483 A:f72d                                    ; --------------------------------
 7484 A:f72d  20 f8 e6                 AS_DRWPNT jsr AS_GETBYT             ; GET SHAPE NUMBER IN X-REG
 7485 A:f730  a5 e8                              lda AS_HGR_SHAPE_PNTR                ; SEARCH FOR THAT SHAPE
 7486 A:f732  85 1a                              sta AS_HGR_SHAPE                ; SET UP PNTR TO BEGINNING OF TABLE
 7487 A:f734  a5 e9                              lda AS_HGR_SHAPE_PNTR+1
 7488 A:f736  85 1b                              sta AS_HGR_SHAPE+1
 7489 A:f738  8a                                 txa 
 7490 A:f739  a2 00                              ldx #0
 7491 A:f73b  c1 1a                              cmp (AS_HGR_SHAPE,X)               ; COMPARE TO # OF SHAPES IN TABLE
 7492 A:f73d  f0 02                              beq AS_L_DRWPNT_1                ; LAST SHAPE IN TABLE
 7493 A:f73f  b0 a5                              bcs AS_GGERR                ; SHAPE # TOO LARGE
 7494 A:f741  0a                       AS_L_DRWPNT_1 asl                 ; DOUBLE SHAPE# TO MAKE AN INDEX
 7495 A:f742  90 03                              bcc AS_L_DRWPNT_2                ; ADD 256 IF SHAPE # > 127
 7496 A:f744  e6 1b                              inc AS_HGR_SHAPE+1
 7497 A:f746  18                                 clc 
 7498 A:f747  a8                       AS_L_DRWPNT_2 tay                 ; USE INDEX TO LOOK UP OFFSET FOR SHAPE
 7499 A:f748  b1 1a                              lda (AS_HGR_SHAPE),Y               ; IN OFFSET TABLE
 7500 A:f74a  65 1a                              adc AS_HGR_SHAPE
 7501 A:f74c  aa                                 tax 
 7502 A:f74d  c8                                 iny 
