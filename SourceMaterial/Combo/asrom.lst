 3428 A:e07d                                    ; <<<    CMP #LOCHAR(`A')    COMPARE LO END
 3429 A:e07d                                    ; <<<    RTS         C=0 IF LO, C=1 IF A-Z
 3430 A:e07d                                    ; <<<L_PTRGET4_1  CLC         C=0 IF HI
 3431 A:e07d                                    ; <<<    RTS
 3432 A:e07d                                    ; --------------------------------
