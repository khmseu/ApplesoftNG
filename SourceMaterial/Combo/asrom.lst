 4230 A:e4d9  85 5e                    AS_L_FIND_HIGHEST_STRING_8 sta AS_INDEX             ; SET UP PNTR TO START OF ARRAY
 4231 A:e4db  86 5f                              stx AS_INDEX+1          ; 
 4232 A:e4dd  a0 00                              ldy #0             ; POINT AT NAME OF ARRAY
 4233 A:e4df  b1 5e                              lda (AS_INDEX),Y                   ; 
 4234 A:e4e1  aa                                 tax                    ; 1ST LETTER OF NAME IN X-REG
 4235 A:e4e2  c8                                 iny                    ; 
 4236 A:e4e3  b1 5e                              lda (AS_INDEX),Y                   ; 
 4237 A:e4e5  08                                 php                    ; STATUS FROM SECOND LETTER OF NAME
 4238 A:e4e6  c8                                 iny                    ; 
