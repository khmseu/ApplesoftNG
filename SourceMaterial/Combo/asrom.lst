 4048 A:e3d5                                    ; --------------------------------
 4049 A:e3d5  a6 a0                    AS_STRINI ldx AS_FAC+3       ; Y,X = STRING ADDRESS
 4050 A:e3d7  a4 a1                              ldy AS_FAC+4          ; 
