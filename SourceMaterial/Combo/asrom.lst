 7393 A:f6b9                                    ; GET HI-RES PLOTTING COORDINATES (0-279,0-191) FROM
 7394 A:f6b9                                    ; TXTPTR.  LEAVE REGISTERS SET UP FOR HPOSN:
 7395 A:f6b9                                    ; (Y,X)=X-COORD
 7396 A:f6b9                                    ; (A)  =Y-COORD
 7397 A:f6b9                                    ; --------------------------------
 7398 A:f6b9  20 67 dd                 AS_HFNS   jsr AS_FRMNUM             ; EVALUATE EXPRESSION, MUST BE NUMERIC
 7399 A:f6bc  20 52 e7                           jsr AS_GETADR                ; CONVERT TO 2-BYTE INTEGER IN LINNUM
 7400 A:f6bf  a4 51                              ldy AS_LINNUM+1          ; GET HORIZ COOR IN X,Y
 7401 A:f6c1  a6 50                              ldx AS_LINNUM                ; 
 7402 A:f6c3  c0 01                              cpy #>280            ; MAKE SURE IT IS < 280
 7403 A:f6c5  90 06                              bcc AS_L_HFNS_1                ; IN RANGE
 7404 A:f6c7  d0 1d                              bne AS_GGERR                ; 
 7405 A:f6c9  e0 18                              cpx #<280            ; 
 7406 A:f6cb  b0 19                              bcs AS_GGERR                ; 
 7407 A:f6cd  8a                       AS_L_HFNS_1 txa                 ; SAVE HORIZ COOR ON STACK
 7408 A:f6ce  48                                 pha                    ; 
 7409 A:f6cf  98                                 tya                    ; 
 7410 A:f6d0  48                                 pha                    ; 
 7411 A:f6d1  a9 2c                              lda #(","&%01111111)     ; REQUIRE A COMMA
 7412 A:f6d3  20 c0 de                           jsr AS_SYNCHR                ; 
 7413 A:f6d6  20 f8 e6                           jsr AS_GETBYT                ; EVAL EXP TO SINGLE BYTE IN X-REG
 7414 A:f6d9  e0 c0                              cpx #192             ; CHECK FOR RANGE
 7415 A:f6db  b0 09                              bcs AS_GGERR                ; TOO BIG
 7416 A:f6dd  86 9d                              stx AS_FAC                ; SAVE Y-COORD
 7417 A:f6df  68                                 pla                    ; RETRIEVE HORIZONTAL COORDINATE
 7418 A:f6e0  a8                                 tay                    ; 
 7419 A:f6e1  68                                 pla                    ; 
 7420 A:f6e2  aa                                 tax                    ; 
 7421 A:f6e3  a5 9d                              lda AS_FAC                ; AND VERTICAL COORDINATE
 7422 A:f6e5  60                                 rts                    ; 
 7423 A:f6e6                                    ; --------------------------------
 7424 A:f6e6  4c 06 f2                 AS_GGERR  jmp AS_GOERR             ; ILLEGAL QUANTITY ERROR
