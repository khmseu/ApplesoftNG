 6851 A:f3f6                                    ; --------------------------------
 6852 A:f3f6  a5 e6                    AS_BKGND  lda AS_HGR_PAGE             ; PUT BUFFER ADDRESS IN HGR.SHAPE
 6853 A:f3f8  85 1b                              sta AS_HGR_SHAPE+1
 6854 A:f3fa  a0 00                              ldy #0
 6855 A:f3fc  84 1a                              sty AS_HGR_SHAPE
 6856 A:f3fe  a5 1c                    AS_L_BKGND_1 lda AS_HGR_BITS             ; COLOR BYTE
 6857 A:f400  91 1a                              sta (AS_HGR_SHAPE),Y               ; CLEAR HIRES TO HGR.BITS
 6858 A:f402  20 7e f4                           jsr AS_COLOR_SHIFT                ; CORRECT FOR COLOR SHIFT
 6859 A:f405  c8                                 iny                    ; (SLOWS CLEAR BY FACTOR OF 2)
 6860 A:f406  d0 f6                              bne AS_L_BKGND_1
 6861 A:f408  e6 1b                              inc AS_HGR_SHAPE+1
 6862 A:f40a  a5 1b                              lda AS_HGR_SHAPE+1
 6863 A:f40c  29 1f                              and #$1f             ; DONE?  ($40 OR$60)
 6864 A:f40e  d0 ee                              bne AS_L_BKGND_1                ; NO
 6865 A:f410  60                                 rts                    ; YES, RETURN
 6866 A:f411                                    ; --------------------------------
 6867 A:f411                                    ; SET THE HIRES CURSOR POSITION
 6868 A:f411                                    ; 
 6869 A:f411                                    ; (Y,X) = HORIZONTAL COORDINATE  (0-279)
 6870 A:f411                                    ; (A)   = VERTICAL COORDINATE    (0-191)
 6871 A:f411                                    ; --------------------------------
 6872 A:f411  85 e2                    AS_HPOSN  sta AS_HGR_Y             ; SAVE Y- AND X-POSITIONS
 6873 A:f413  86 e0                              stx AS_HGR_X                ; 
 6874 A:f415  84 e1                              sty AS_HGR_X+1          ; 
 6875 A:f417  48                                 pha                    ; Y-POS ALSO ON STACK
 6876 A:f418  29 c0                              and #$c0             ; CALCULATE BASE ADDRESS FOR Y-POS
 6877 A:f41a  85 26                              sta MON_GBASL                ; FOR Y=ABCDEFGH
 6878 A:f41c  4a                                 lsr                    ; GBASL=ABAB0000
 6879 A:f41d  4a                                 lsr                    ; 
 6880 A:f41e  05 26                              ora MON_GBASL                ; 
 6881 A:f420  85 26                              sta MON_GBASL                ; 
 6882 A:f422  68                                 pla                    ; (A)      (GBASH)   (GBASL)
 6883 A:f423  85 27                              sta MON_GBASH                ; ?-ABCDEFGH  ABCDEFGH  ABAB0000
 6884 A:f425  0a                                 asl                    ; A-BCDEFGH0  ABCDEFGH  ABAB0000
 6885 A:f426  0a                                 asl                    ; B-CDEFGH00  ABCDEFGH  ABAB0000
 6886 A:f427  0a                                 asl                    ; C-DEFGH000  ABCDEFGH  ABAB0000
 6887 A:f428  26 27                              rol MON_GBASH                ; A-DEFGH000  BCDEFGHC  ABAB0000
 6888 A:f42a  0a                                 asl                    ; D-EFGH0000  BCDEFGHC  ABAB0000
 6889 A:f42b  26 27                              rol MON_GBASH                ; B-EFGH0000  CDEFGHCD  ABAB0000
 6890 A:f42d  0a                                 asl                    ; E-FGH00000  CDEFGHCD  ABAB0000
 6891 A:f42e  66 26                              ror MON_GBASL                ; 0-FGH00000  CDEFGHCD  EABAB000
 6892 A:f430  a5 27                              lda MON_GBASH                ; 0-CDEFGHCD  CDEFGHCD  EABAB000
 6893 A:f432  29 1f                              and #$1f             ; 0-000FGHCD  CDEFGHCD  EABAB000
 6894 A:f434  05 e6                              ora AS_HGR_PAGE                ; 0-PPPFGHCD  CDEFGHCD  EABAB000
 6895 A:f436  85 27                              sta MON_GBASH                ; 0-PPPFGHCD  PPPFGHCD  EABAB000
 6896 A:f438  8a                                 txa                    ; DIVIDE X-POS BY 7 FOR INDEX FROM BASE
 6897 A:f439  c0 00                              cpy #0             ; IS X-POS < 256?
 6898 A:f43b  f0 05                              beq AS_L_HPOSN_2                ; YES
 6899 A:f43d  a0 23                              ldy #35             ; NO: 256/7 = 36 REM 4
 6900 A:f43f                                    ; CARRY=1, SO ADC #4 IS TOO LARGE;
 6901 A:f43f                                    ; HOWEVER, ADC #4 CLEARS CARRY
 6902 A:f43f                                    ; WHICH MAKES SBC #7 ONLY -6
 6903 A:f43f                                    ; BALANCING IT OUT.
 6904 A:f43f  69 04                              adc #4             ; FOLLOWING INY MAKES Y=36
 6905 A:f441  c8                       AS_L_HPOSN_1 iny 
 6906 A:f442  e9 07                    AS_L_HPOSN_2 sbc #7
 6907 A:f444  b0 fb                              bcs AS_L_HPOSN_1
 6908 A:f446  84 e5                              sty AS_HGR_HORIZ                ; HORIZONTAL INDEX
 6909 A:f448  aa                                 tax                    ; USE REMAINDER-7 TO LOOK UP THE
 6910 A:f449  bd b9 f4                           lda AS_MSKTBL-$0100+7,X             ; BIT MASK
 6911 A:f44c  85 30                              sta MON_HMASK
 6912 A:f44e  98                                 tya                    ; QUOTIENT GIVES BYTE INDEX
 6913 A:f44f  4a                                 lsr                    ; ODD OR EVEN COLUMN?
 6914 A:f450  a5 e4                              lda AS_HGR_COLOR                ; IF ON ODD BYTE (CARRY SET)
 6915 A:f452  85 1c                              sta AS_HGR_BITS                ; THEN ROTATE BITS
 6916 A:f454  b0 28                              bcs AS_COLOR_SHIFT                ; ODD COLUMN
 6917 A:f456  60                                 rts                    ; EVEN COLUMN
 6918 A:f457                                    ; --------------------------------
 6919 A:f457                                    ; PLOT A DOT
 6920 A:f457                                    ; 
 6921 A:f457                                    ; (Y,X) = HORIZONTAL POSITION
 6922 A:f457                                    ; (A)   = VERTICAL POSITION
 6923 A:f457                                    ; --------------------------------
 6924 A:f457  20 11 f4                 AS_HPLOT0 jsr AS_HPOSN
 6925 A:f45a  a5 1c                              lda AS_HGR_BITS                ; CALCULATE BIT POSN IN GBAS,
 6926 A:f45c  51 26                              eor (MON_GBASL),Y               ; HGR.HORIZ, AND HMASK FROM
 6927 A:f45e  25 30                              and MON_HMASK                ; Y-COOR IN A-REG,
 6928 A:f460  51 26                              eor (MON_GBASL),Y               ; X-COOR IN X,Y REGS.
 6929 A:f462  91 26                              sta (MON_GBASL),Y               ; FOR ANY 1-BITS, SUBSTITUTE
 6930 A:f464  60                                 rts                    ; CORRESPONDING BIT OF HGR.BITS
 6931 A:f465                                    ; --------------------------------
 6932 A:f465                                    ; MOVE LEFT OR RIGHT ONE PIXEL
 6933 A:f465                                    ; 
 6934 A:f465                                    ; IF STATUS IS +, MOVE RIGHT; IF -, MOVE LEFT
 6935 A:f465                                    ; IF ALREADY AT LEFT OR RIGHT EDGE, WRAP AROUND
 6936 A:f465                                    ; 
 6937 A:f465                                    ; REMEMBER BITS IN HI-RES BYTE ARE BACKWARDS ORDER:
 6938 A:f465                                    ; BYTE N   BYTE N+1
 6939 A:f465                                    ; S7654321   SEDCBA98
 6940 A:f465                                    ; --------------------------------
 6941 A:f465                           AS_MOVE_LEFT_OR_RIGHT 
 6942 A:f465  10 23                              bpl AS_MOVE_RIGHT                ; + MOVE RIGHT, - MOVE LEFT
 6943 A:f467  a5 30                              lda MON_HMASK                ; MOVE LEFT ONE PIXEL
 6944 A:f469  4a                                 lsr                    ; SHIFT MASK RIGHT, MOVES DOT LEFT
 6945 A:f46a  b0 05                              bcs AS_LR_2                ; ...DOT MOVED TO NEXT BYTE
 6946 A:f46c  49 c0                              eor #$c0             ; MOVE SIGN BIT BACK WHERE IT WAS
 6947 A:f46e  85 30                    AS_LR_1   sta MON_HMASK             ; NEW MASK VALUE
 6948 A:f470  60                                 rts                    ; 
 6949 A:f471  88                       AS_LR_2   dey                 ; MOVED TO NEXT BYTE, SO DECR INDEX
 6950 A:f472  10 02                              bpl AS_LR_3                ; STILL NOT PAST EDGE
 6951 A:f474  a0 27                              ldy #39             ; OFF LEFT EDGE, SO WRAP AROUND SCREEN
 6952 A:f476  a9 c0                    AS_LR_3   lda #$c0          ; NEW HMASK, RIGHTMOST BIT ON SCREEN
 6953 A:f478  85 30                    AS_LR_4   sta MON_HMASK             ; NEW MASK AND INDEX
 6954 A:f47a  84 e5                              sty AS_HGR_HORIZ                ; 
 6955 A:f47c  a5 1c                              lda AS_HGR_BITS                ; ALSO NEED TO ROTATE COLOR
 6956 A:f47e                                    ; --------------------------------
 6957 A:f47e                           AS_COLOR_SHIFT 
 6958 A:f47e  0a                                 asl                    ; ROTATE LOW-ORDER 7 BITS
 6959 A:f47f  c9 c0                              cmp #$c0             ; OF HGR.BITS ONE BIT POSN.
 6960 A:f481  10 06                              bpl AS_L_COLOR_SHIFT_1
 6961 A:f483  a5 1c                              lda AS_HGR_BITS
 6962 A:f485  49 7f                              eor #$7f
 6963 A:f487  85 1c                              sta AS_HGR_BITS
 6964 A:f489  60                       AS_L_COLOR_SHIFT_1 rts 
 6965 A:f48a                                    ; --------------------------------
 6966 A:f48a                                    ; MOVE RIGHT ONE PIXEL
 6967 A:f48a                                    ; IF ALREADY AT RIGHT EDGE, WRAP AROUND
 6968 A:f48a                                    ; --------------------------------
 6969 A:f48a                           AS_MOVE_RIGHT 
 6970 A:f48a  a5 30                              lda MON_HMASK
 6971 A:f48c  0a                                 asl                    ; SHIFTING BYTE LEFT MOVES PIXEL RIGHT
 6972 A:f48d  49 80                              eor #$80             ; 
 6973 A:f48f                                    ; ORIGINAL:  C0 A0 90 88 84 82 81
 6974 A:f48f                                    ; SHIFTED:   80 40 20 10 08 02 01
 6975 A:f48f                                    ; EOR #$80:  00 C0 A0 90 88 84 82
 6976 A:f48f  30 dd                              bmi AS_LR_1                ; FINISHED
 6977 A:f491  a9 81                              lda #$81             ; NEW MASK VALUE
 6978 A:f493  c8                                 iny                    ; MOVE TO NEXT BYTE RIGHT
 6979 A:f494  c0 28                              cpy #40             ; UNLESS THAT IS TOO FAR
 6980 A:f496  90 e0                              bcc AS_LR_4                ; NOT TOO FAR
 6981 A:f498  a0 00                              ldy #0             ; TOO FAR, SO WRAP AROUND
 6982 A:f49a  b0 dc                              bcs AS_LR_4                ; ...ALWAYS
 6983 A:f49c                                    ; --------------------------------
 6984 A:f49c                                    ; --------------------------------
 6985 A:f49c                                    ; "XDRAW" ONE BIT
 6986 A:f49c                                    ; --------------------------------
 6987 A:f49c  18                       AS_LRUDX1 clc                 ; C=0 MEANS NO 90 DEGREE ROTATION
 6988 A:f49d  a5 d1                    AS_LRUDX2 lda AS_HGR_DX+1       ; C=1 MEANS ROTATE 90 DEGREES
 6989 A:f49f  29 04                              and #4             ; IF BIT2=0 THEN DON'T PLOT
 6990 A:f4a1  f0 25                              beq AS_LRUD4                ; YES, DO NOT PLOT
 6991 A:f4a3  a9 7f                              lda #$7f             ; NO, LOOK AT WHAT IS ALREADY THERE
 6992 A:f4a5  25 30                              and MON_HMASK
 6993 A:f4a7  31 26                              and (MON_GBASL),Y               ; SCREEN BIT = 1?
 6994 A:f4a9  d0 19                              bne AS_LRUD3                ; YES, GO CLEAR IT
 6995 A:f4ab  e6 ea                              inc AS_HGR_COLLISIONS                ; NO, COUNT THE COLLISION
 6996 A:f4ad  a9 7f                              lda #$7f             ; AND TURN THE BIT ON
 6997 A:f4af  25 30                              and MON_HMASK                ; 
 6998 A:f4b1  10 11                              bpl AS_LRUD3                ; ...ALWAYS
 6999 A:f4b3                                    ; --------------------------------
 7000 A:f4b3                                    ; "DRAW" ONE BIT
 7001 A:f4b3                                    ; --------------------------------
 7002 A:f4b3  18                       AS_LRUD1  clc                 ; C=0 MEANS NO 90 DEGREE ROTATION
 7003 A:f4b4  a5 d1                    AS_LRUD2  lda AS_HGR_DX+1       ; C=1 MEANS ROTATE
 7004 A:f4b6  29 04                              and #4             ; IF BIT2=0 THEN DO NOT PLOT
 7005 A:f4b8  f0 0e                              beq AS_LRUD4                ; DO NOT PLOT
 7006 A:f4ba  b1 26                              lda (MON_GBASL),Y
 7007 A:f4bc  45 1c                              eor AS_HGR_BITS                ; 1'S WHERE ANY BITS NOT IN COLOR
 7008 A:f4be  25 30                              and MON_HMASK                ; LOOK AT JUST THIS BIT POSITION
 7009 A:f4c0  d0 02                              bne AS_LRUD3                ; THE BIT WAS ZERO, SO PLOT IT
 7010 A:f4c2  e6 ea                              inc AS_HGR_COLLISIONS                ; BIT IS ALREADY 1; COUNT COLLSN
 7011 A:f4c4                                    ; --------------------------------
 7012 A:f4c4                                    ; TOGGLE BIT ON SCREEN WITH (A)
 7013 A:f4c4                                    ; --------------------------------
 7014 A:f4c4  51 26                    AS_LRUD3  eor (MON_GBASL),Y
 7015 A:f4c6  91 26                              sta (MON_GBASL),Y
 7016 A:f4c8                                    ; --------------------------------
 7017 A:f4c8                                    ; DETERMINE WHERE NEXT POINT WILL BE, AND MOVE THERE
 7018 A:f4c8                                    ; C=0 IF NO 90 DEGREE ROTATION
 7019 A:f4c8                                    ; C=1 ROTATES 90 DEGREES
 7020 A:f4c8                                    ; --------------------------------
 7021 A:f4c8  a5 d1                    AS_LRUD4  lda AS_HGR_DX+1       ; CALCULATE THE DIRECTION TO MOVE
 7022 A:f4ca  65 d3                              adc AS_HGR_QUADRANT
 7023 A:f4cc  29 03                              and #3             ; WRAP AROUND THE CIRCLE
 7024 A:f4ce                                    AS_CON_03=*-1         ; (( A CONSTANT ))
 7025 A:f4ce                                    ; 
 7026 A:f4ce                                    ; 00 -- UP
 7027 A:f4ce                                    ; 01 -- DOWN
 7028 A:f4ce                                    ; 10 -- RIGHT
 7029 A:f4ce                                    ; 11 -- LEFT
 7030 A:f4ce                                    ; 
 7031 A:f4ce  c9 02                              cmp #2             ; C=0 IF 0 OR 1, C=1 IF 2 OR 3
 7032 A:f4d0  6a                                 ror                    ; PUT C INTO SIGN, ODD/EVEN INTO C
 7033 A:f4d1  b0 92                              bcs AS_MOVE_LEFT_OR_RIGHT
 7034 A:f4d3                                    ; --------------------------------
 7035 A:f4d3                           AS_MOVE_UP_OR_DOWN 
 7036 A:f4d3  30 30                              bmi AS_MOVE_DOWN                ; SIGN FOR UP/DOWN SELECT_
 7037 A:f4d5                                    ; --------------------------------
 7038 A:f4d5                                    ; MOVE UP ONE PIXEL
 7039 A:f4d5                                    ; IF ALREADY AT TOP, GO TO BOTTOM
 7040 A:f4d5                                    ; 
 7041 A:f4d5                                    ; REMEMBER:  Y-COORD   GBASH     GBASL
 7042 A:f4d5                                    ; ABCDEFGH  PPPFGHCD  EABAB000
 7043 A:f4d5                                    ; --------------------------------
 7044 A:f4d5  18                                 clc                    ; MOVE UP
 7045 A:f4d6  a5 27                              lda MON_GBASH                ; CALC. BASE ADDRESS OF PREV. LINE
 7046 A:f4d8  2c b9 f5                           bit AS_CON_1C                ; LOOK AT BITS 000FGH00 IN GBASH
 7047 A:f4db  d0 22                              bne AS_L_MOVE_UP_OR_DOWN_5                ; SIMPLE, JUST FGH=FGH-1
 7048 A:f4dd                                    ; GBASH=PPP000CD, GBASL=EABAB000
 7049 A:f4dd  06 26                              asl MON_GBASL                ; WHAT IS "E"?
 7050 A:f4df  b0 1a                              bcs AS_L_MOVE_UP_OR_DOWN_3                ; E=1, THEN EFGH=EFGH-1
 7051 A:f4e1  2c cd f4                           bit AS_CON_03                ; LOOK AT 000000CD IN GBASH
 7052 A:f4e4  f0 05                              beq AS_L_MOVE_UP_OR_DOWN_1                ; Y-POS IS AB000000 FORM
 7053 A:f4e6  69 1f                              adc #$1f             ; CD <> 0, SO CDEFGH=CDEFGH-1
 7054 A:f4e8  38                                 sec                    ; 
 7055 A:f4e9  b0 12                              bcs AS_L_MOVE_UP_OR_DOWN_4                ; ...ALWAYS
 7056 A:f4eb  69 23                    AS_L_MOVE_UP_OR_DOWN_1 adc #$23          ; ENOUGH TO MAKE GBASH=PPP11111 LATER
 7057 A:f4ed  48                                 pha                    ; SAVE FOR LATER
 7058 A:f4ee  a5 26                              lda MON_GBASL                ; GBASL IS NOW ABAB0000 (AB=00,01,10)
 7059 A:f4f0  69 b0                              adc #$b0             ; 0000+1011=1011 AND CARRY CLEAR
 7060 A:f4f2                                    ; OR 0101+1011=0000 AND CARRY SET
 7061 A:f4f2                                    ; OR 1010+1011=0101 AND CARRY SET
 7062 A:f4f2  b0 02                              bcs AS_L_MOVE_UP_OR_DOWN_2                ; NO WRAP-AROUND NEEDED
 7063 A:f4f4  69 f0                              adc #$f0             ; CHANGE 1011 TO 1010 (WRAP-AROUND)
 7064 A:f4f6  85 26                    AS_L_MOVE_UP_OR_DOWN_2 sta MON_GBASL             ; FORM IS NOW STILL ABAB0000
 7065 A:f4f8  68                                 pla                    ; PARTIALLY MODIFIED GBASH
 7066 A:f4f9  b0 02                              bcs AS_L_MOVE_UP_OR_DOWN_4                ; ...ALWAYS
 7067 A:f4fb  69 1f                    AS_L_MOVE_UP_OR_DOWN_3 adc #$1f          ; 
 7068 A:f4fd  66 26                    AS_L_MOVE_UP_OR_DOWN_4 ror MON_GBASL             ; SHIFT IN E, TO GET EABAB000 FORM
 7069 A:f4ff  69 fc                    AS_L_MOVE_UP_OR_DOWN_5 adc #$fc          ; FINISH GBASH MODS
 7070 A:f501  85 27                    AS_UD_1   sta MON_GBASH             ; 
 7071 A:f503  60                                 rts 
 7072 A:f504                                    ; --------------------------------
 7073 A:f504  18                                 clc                    ; <<<NEVER USED>>>
 7074 A:f505                                    ; --------------------------------
 7075 A:f505                                    ; MOVE DOWN ONE PIXEL
 7076 A:f505                                    ; IF ALREADY AT BOTTOM, GO TO TOP
 7077 A:f505                                    ; 
 7078 A:f505                                    ; REMEMBER:  Y-COORD   GBASH     GBASL
 7079 A:f505                                    ; ABCDEFGH  PPPFGHCD  EABAB000
 7080 A:f505                                    ; --------------------------------
 7081 A:f505                           AS_MOVE_DOWN 
 7082 A:f505  a5 27                              lda MON_GBASH                ; TRY IT FIRST, BY FGH=FGH+1
 7083 A:f507  69 04                              adc #4             ; GBASH = PPPFGHCD
 7084 A:f509                                    AS_CON_04=*-1         ; (( CONSTANT ))
 7085 A:f509  2c b9 f5                           bit AS_CON_1C                ; IS FGH FIELD NOW ZERO?
 7086 A:f50c  d0 f3                              bne AS_UD_1                ; NO, SO WE ARE FINISHED
 7087 A:f50e                                    ; YES, RIPPLE THE CARRY AS HIGH
 7088 A:f50e                                    ; AS NECESSARY
 7089 A:f50e  06 26                              asl MON_GBASL                ; LOOK AT "E" BIT
 7090 A:f510  90 18                              bcc AS_L_CON_04_2                ; NOW ZERO; MAKE IT 1 AND LEAVE
 7091 A:f512  69 e0                              adc #$e0             ; CARRY = 1, SO ADDS $E1
 7092 A:f514  18                                 clc                    ; IS "CD" NOT ZERO?
 7093 A:f515  2c 08 f5                           bit AS_CON_04                ; TESTS BIT 2 FOR CARRY OUT OF "CD"
 7094 A:f518  f0 12                              beq AS_L_CON_04_3                ; NO CARRY, FINISHED
 7095 A:f51a                                    ; INCREMENT "AB" THEN
 7096 A:f51a                                    ; 0000 --> 0101
 7097 A:f51a                                    ; 0101 --> 1010
 7098 A:f51a                                    ; 1010 --> WRAP AROUND TO LINE 0
 7099 A:f51a  a5 26                              lda MON_GBASL                ; 0000  0101  1010
 7100 A:f51c  69 50                              adc #$50             ; 0101  1010  1111
 7101 A:f51e  49 f0                              eor #$f0             ; 1010  0101  0000
 7102 A:f520  f0 02                              beq AS_L_CON_04_1                ; 
 7103 A:f522  49 f0                              eor #$f0             ; 0101  1010
 7104 A:f524  85 26                    AS_L_CON_04_1 sta MON_GBASL             ; NEW ABAB0000
 7105 A:f526  a5 e6                              lda AS_HGR_PAGE                ; WRAP AROUND TO LINE ZERO OF GROUP
 7106 A:f528  90 02                              bcc AS_L_CON_04_3                ; ...ALWAYS
 7107 A:f52a  69 e0                    AS_L_CON_04_2 adc #$e0
 7108 A:f52c  66 26                    AS_L_CON_04_3 ror MON_GBASL
 7109 A:f52e  90 d1                              bcc AS_UD_1                ; ...ALWAYS
 7110 A:f530                                    ; --------------------------------
 7111 A:f530                                    ; HLINRL IS NEVER CALLED BY APPLESOFT
 7112 A:f530                                    ; 
 7113 A:f530                                    ; ENTER WITH:  (A,X) = DX FROM CURRENT POINT
 7114 A:f530                                    ; (Y)   = DY FROM CURRENT POINT
 7115 A:f530                                    ; --------------------------------
 7116 A:f530  48                       AS_HLINRL pha                 ; SAVE (A)
 7117 A:f531  a9 00                              lda #0             ; CLEAR CURRENT POINT SO HGLIN WILL
 7118 A:f533  85 e0                              sta AS_HGR_X                ; ACT RELATIVELY
 7119 A:f535  85 e1                              sta AS_HGR_X+1          ; 
 7120 A:f537  85 e2                              sta AS_HGR_Y                ; 
 7121 A:f539  68                                 pla                    ; RESTORE (A)
 7122 A:f53a                                    ; --------------------------------
 7123 A:f53a                                    ; DRAW LINE FROM LAST PLOTTED POINT TO (A,X),(Y)
 7124 A:f53a                                    ; 
 7125 A:f53a                                    ; ENTER WITH:  (A,X) = X OF TARGET POINT
 7126 A:f53a                                    ; (Y)   = Y OF TARGET POINT
 7127 A:f53a                                    ; --------------------------------
 7128 A:f53a  48                       AS_HGLIN  pha                 ; COMPUTE DX = X- X0
 7129 A:f53b  38                                 sec 
 7130 A:f53c  e5 e0                              sbc AS_HGR_X
 7131 A:f53e  48                                 pha 
 7132 A:f53f  8a                                 txa 
 7133 A:f540  e5 e1                              sbc AS_HGR_X+1
 7134 A:f542  85 d3                              sta AS_HGR_QUADRANT                ; SAVE DX SIGN (+ = RIGHT, - = LEFT)
 7135 A:f544  b0 0a                              bcs AS_L_HGLIN_1                ; NOW FIND ABS (DX)
 7136 A:f546  68                                 pla                    ; FORMS 2'S COMPLEMENT
 7137 A:f547  49 ff                              eor #$ff
 7138 A:f549  69 01                              adc #1
 7139 A:f54b  48                                 pha 
 7140 A:f54c  a9 00                              lda #0
 7141 A:f54e  e5 d3                              sbc AS_HGR_QUADRANT
 7142 A:f550  85 d1                    AS_L_HGLIN_1 sta AS_HGR_DX+1
 7143 A:f552  85 d5                              sta AS_HGR_E+1          ; INIT HGR.E TO ABS(X-X0)
 7144 A:f554  68                                 pla 
 7145 A:f555  85 d0                              sta AS_HGR_DX
 7146 A:f557  85 d4                              sta AS_HGR_E
 7147 A:f559  68                                 pla 
 7148 A:f55a  85 e0                              sta AS_HGR_X                ; TARGET X POINT
 7149 A:f55c  86 e1                              stx AS_HGR_X+1          ; 
 7150 A:f55e  98                                 tya                    ; TARGET Y POINT
 7151 A:f55f  18                                 clc                    ; COMPUTE DY = Y-HGR.Y
 7152 A:f560  e5 e2                              sbc AS_HGR_Y                ; AND SAVE -ABS(Y-HGR.Y)-1 IN HGR.DY
 7153 A:f562  90 04                              bcc AS_L_HGLIN_2                ; (SO + MEANS UP, - MEANS DOWN)
 7154 A:f564  49 ff                              eor #$ff             ; 2'S COMPLEMENT OF DY
 7155 A:f566  69 fe                              adc #$fe             ; 
 7156 A:f568  85 d2                    AS_L_HGLIN_2 sta AS_HGR_DY             ; 
 7157 A:f56a  84 e2                              sty AS_HGR_Y                ; TARGET Y POINT
 7158 A:f56c  66 d3                              ror AS_HGR_QUADRANT                ; SHIFT Y-DIRECTION INTO QUADRANT
 7159 A:f56e  38                                 sec                    ; COUNT = DX -(-DY) = # OF DOTS NEEDED
 7160 A:f56f  e5 d0                              sbc AS_HGR_DX                ; 
 7161 A:f571  aa                                 tax                    ; COUNTL IS IN X-REG
 7162 A:f572  a9 ff                              lda #$ff
 7163 A:f574  e5 d1                              sbc AS_HGR_DX+1
 7164 A:f576  85 1d                              sta AS_HGR_COUNT
 7165 A:f578  a4 e5                              ldy AS_HGR_HORIZ                ; HORIZONTAL INDEX
 7166 A:f57a  b0 05                              bcs AS_MOVEX2                ; ...ALWAYS
 7167 A:f57c                                    ; --------------------------------
 7168 A:f57c                                    ; MOVE LEFT OR RIGHT ONE PIXEL
 7169 A:f57c                                    ; (A) BIT 6 HAS DIRECTION
 7170 A:f57c                                    ; --------------------------------
 7171 A:f57c  0a                       AS_MOVEX  asl                 ; PUT BIT 6 INTO SIGN POSITION
 7172 A:f57d  20 65 f4                           jsr AS_MOVE_LEFT_OR_RIGHT
 7173 A:f580  38                                 sec 
 7174 A:f581                                    ; --------------------------------
 7175 A:f581                                    ; DRAW LINE NOW
 7176 A:f581                                    ; --------------------------------
 7177 A:f581  a5 d4                    AS_MOVEX2 lda AS_HGR_E             ; CARRY IS SET
 7178 A:f583  65 d2                              adc AS_HGR_DY                ; E = E-DELTY
 7179 A:f585  85 d4                              sta AS_HGR_E                ; NOTE: DY IS (-DELTA Y)-1
 7180 A:f587  a5 d5                              lda AS_HGR_E+1          ; CARRY CLR IF HGR.E GOES NEGATIVE
 7181 A:f589  e9 00                              sbc #0
 7182 A:f58b  85 d5                    AS_L_MOVEX2_1 sta AS_HGR_E+1
 7183 A:f58d  b1 26                              lda (MON_GBASL),Y
 7184 A:f58f  45 1c                              eor AS_HGR_BITS                ; PLOT A DOT
 7185 A:f591  25 30                              and MON_HMASK
 7186 A:f593  51 26                              eor (MON_GBASL),Y
 7187 A:f595  91 26                              sta (MON_GBASL),Y
 7188 A:f597  e8                                 inx                    ; FINISHED ALL THE DOTS?
 7189 A:f598  d0 04                              bne AS_L_MOVEX2_2                ; NO
 7190 A:f59a  e6 1d                              inc AS_HGR_COUNT                ; TEST REST OF COUNT
 7191 A:f59c  f0 62                              beq AS_RTS_22                ; YES, FINISHED.
 7192 A:f59e  a5 d3                    AS_L_MOVEX2_2 lda AS_HGR_QUADRANT             ; TEST DIRECTION
 7193 A:f5a0  b0 da                              bcs AS_MOVEX                ; NEXT MOVE IS IN THE X DIRECTION
 7194 A:f5a2  20 d3 f4                           jsr AS_MOVE_UP_OR_DOWN                ; IF CLR, NEG, MOVE
 7195 A:f5a5  18                                 clc                    ; E = E+DX
 7196 A:f5a6  a5 d4                              lda AS_HGR_E
 7197 A:f5a8  65 d0                              adc AS_HGR_DX
 7198 A:f5aa  85 d4                              sta AS_HGR_E
 7199 A:f5ac  a5 d5                              lda AS_HGR_E+1
 7200 A:f5ae  65 d1                              adc AS_HGR_DX+1
 7201 A:f5b0  50 d9                              bvc AS_L_MOVEX2_1                ; ...ALWAYS
 7202 A:f5b2                                    ; --------------------------------

