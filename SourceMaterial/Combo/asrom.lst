 3726 A:e207  c6 0f                              dec AS_NUMDIM                ; COUNT DOWN # DIMS
 3727 A:e209  d0 dc                              bne AS_L_MAKE_NEW_ARRAY_4                ; LOOP TILL DONE
 3728 A:e20b                                    ; --------------------------------
 3729 A:e20b                                    ; NOW A,X HAS TOTAL # BYTES OF ARRAY ELEMENTS
 3730 A:e20b                                    ; --------------------------------
 3731 A:e20b  65 95                              adc AS_ARYPNT+1          ; COMPUTE ADDRESS OF END OF THIS ARRAY
 3732 A:e20d  b0 5d                              bcs AS_GME                ; ...TOO LARGE, ERROR
 3733 A:e20f  85 95                              sta AS_ARYPNT+1          ; 
 3734 A:e211  a8                                 tay                    ; 
 3735 A:e212  8a                                 txa                    ; 
 3736 A:e213  65 94                              adc AS_ARYPNT                ; 
 3737 A:e215  90 03                              bcc AS_L_MAKE_NEW_ARRAY_6                ; 
 3738 A:e217  c8                                 iny                    ; 
 3739 A:e218  f0 52                              beq AS_GME                ; ...TOO LARGE, ERROR
 3740 A:e21a  20 e3 d3                 AS_L_MAKE_NEW_ARRAY_6 jsr AS_REASON             ; MAKE SURE THERE IS ROOM UP TO Y,A
 3741 A:e21d  85 6d                              sta AS_STREND                ; THERE IS ROOM SO SAVE NEW END OF TABLE
 3742 A:e21f  84 6e                              sty AS_STREND+1          ; AND ZERO THE ARRAY
 3743 A:e221  a9 00                              lda #0             ; 
 3744 A:e223  e6 ae                              inc AS_STRNG2+1          ; PREPARE FOR FAST ZEROING LOOP
 3745 A:e225  a4 ad                              ldy AS_STRNG2                ; # BYTES MOD 256
 3746 A:e227  f0 05                              beq AS_L_MAKE_NEW_ARRAY_8                ; FULL PAGE
 3747 A:e229  88                       AS_L_MAKE_NEW_ARRAY_7 dey                 ; CLEAR PAGE FULL
 3748 A:e22a  91 94                              sta (AS_ARYPNT),Y
 3749 A:e22c  d0 fb                              bne AS_L_MAKE_NEW_ARRAY_7
 3750 A:e22e  c6 95                    AS_L_MAKE_NEW_ARRAY_8 dec AS_ARYPNT+1       ; POINT TO NEXT PAGE
 3751 A:e230  c6 ae                              dec AS_STRNG2+1          ; COUNT THE PAGES
 3752 A:e232  d0 f5                              bne AS_L_MAKE_NEW_ARRAY_7                ; STILL MORE TO CLEAR
 3753 A:e234  e6 95                              inc AS_ARYPNT+1          ; RECOVER LAST DEC, POINT AT 1ST ELEMENT
 3754 A:e236  38                                 sec                    ; 
 3755 A:e237  a5 6d                              lda AS_STREND                ; COMPUTE OFFSET TO END OF ARRAYS
 3756 A:e239  e5 9b                              sbc AS_LOWTR                ; AND STORE IN ARRAY DESCRIPTOR
 3757 A:e23b  a0 02                              ldy #2             ; 
 3758 A:e23d  91 9b                              sta (AS_LOWTR),Y                   ; 
 3759 A:e23f  a5 6e                              lda AS_STREND+1          ; 
 3760 A:e241  c8                                 iny                    ; 
