 3796 A:e270  a5 ae                    AS_FAE_3  lda AS_STRNG2+1       ; BYPASS MULTIPLICATION IF VALUE SO
 3797 A:e272  05 ad                              ora AS_STRNG2                ; FAR = 0
 3798 A:e274  18                                 clc                    ; 
