 3068 A:de67  b0 03                              bcs AS_L_FRM_ELEMENT_3                ; NOT A DIGIT
 3069 A:de69  4c 4a ec                 AS_L_FRM_ELEMENT_2 jmp AS_FIN             ; NUMERIC CONSTANT
 3070 A:de6c  20 7d e0                 AS_L_FRM_ELEMENT_3 jsr AS_ISLETC             ; VARIABLE NAME?
 3071 A:de6f  b0 64                              bcs AS_FRM_VARIABLE                ; YES
 3072 A:de71  c9 2e                              cmp #("."&%01111111)     ; DECIMAL POINT
 3073 A:de73  f0 f4                              beq AS_L_FRM_ELEMENT_2                ; YES, NUMERIC CONSTANT
 3074 A:de75  c9 c9                              cmp #AS_TOKEN_MINUS               ; UNARY MINUS?
 3075 A:de77  f0 55                              beq AS_MIN                ; YES
 3076 A:de79  c9 c8                              cmp #AS_TOKEN_PLUS               ; UNARY PLUS
 3077 A:de7b  f0 e7                              beq AS_L_FRM_ELEMENT_1                ; YES
 3078 A:de7d  c9 22                              cmp #$22             ; STRING CONSTANT?
 3079 A:de7f  d0 0f                              bne AS_NOT_                ; NO
