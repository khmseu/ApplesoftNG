 1405 A:d484  18                                 clc 
 1406 A:d485  65 69                              adc AS_VARTAB
 1407 A:d487  85 69                              sta AS_VARTAB
 1408 A:d489  85 60                              sta AS_DEST
 1409 A:d48b  a5 6a                              lda AS_VARTAB+1
 1410 A:d48d  69 ff                              adc #$ff
 1411 A:d48f  85 6a                              sta AS_VARTAB+1
 1412 A:d491  e5 9c                              sbc AS_LOWTR+1
 1413 A:d493  aa                                 tax 
 1414 A:d494  38                                 sec 
 1415 A:d495  a5 9b                              lda AS_LOWTR
 1416 A:d497  e5 69                              sbc AS_VARTAB
