 3365 A:e015  90 fb                              bcc AS_L_PTRGET4_2                ; NUMERIC
 3366 A:e017  20 7d e0                           jsr AS_ISLETC                ; 
 3367 A:e01a  b0 f6                              bcs AS_L_PTRGET4_2                ; ALPHA
 3368 A:e01c  c9 24                    AS_L_PTRGET4_3 cmp #("$"&%01111111)  ; STRING?
 3369 A:e01e  d0 06                              bne AS_L_PTRGET4_4                ; NO
 3370 A:e020  a9 ff                              lda #$ff             ; 
 3371 A:e022  85 11                              sta AS_VALTYP                ; 
 3372 A:e024  d0 10                              bne AS_L_PTRGET4_5                ; ...ALWAYS
 3373 A:e026  c9 25                    AS_L_PTRGET4_4 cmp #("%"&%01111111)  ; INTEGER?
 3374 A:e028  d0 13                              bne AS_L_PTRGET4_6                ; NO
