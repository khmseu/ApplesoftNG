 4114 A:e42a                                    ; PUT ADDRESS OF TEMP DESCRIPTOR IN FAC+3,4
 4115 A:e42a                                    ; --------------------------------
 4116 A:e42a  a6 52                    AS_PUTNEW ldx AS_TEMPPT             ; POINTER TO NEXT TEMP STRING SLOT
 4117 A:e42c  e0 5e                              cpx #AS_TEMPST+9         ; MAX OF 3 TEMP STRINGS
 4118 A:e42e  d0 05                              bne AS_PUTEMP                ; ROOM FOR ANOTHER ONE
