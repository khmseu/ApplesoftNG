 1612 A:d5e0  85 13                    AS_L_PARSE_10 sta AS_DATAFLG             ; DATAFLG = 0 OR $83-$3A = $49
 1613 A:d5e2  38                       AS_L_PARSE_11 sec                 ; IS IT A "REM" TOKEN?
 1614 A:d5e3  e9 78                              sbc #AS_TOKEN_REM+128-$ba
 1615 A:d5e5  d0 86                              bne AS_L_PARSE_1                ; NO, CONTINUE PARSING LINE
