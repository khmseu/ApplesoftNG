 4415 A:e5f0  d0 f8                              bne AS_L_MOVSTR_1_1                ; YES, KEEP MOVING
 4416 A:e5f2  68                                 pla                    ; NO, FINISHED.  GET LENGTH
 4417 A:e5f3  18                       AS_L_MOVSTR_1_2 clc                 ; AND ADD TO FRESPC, SO
 4418 A:e5f4  65 71                              adc AS_FRESPC                ; FRESPC POINTS TO NEXT HIGHER
