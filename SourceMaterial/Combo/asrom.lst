 4262 A:e50e  d0 04                              bne AS_L_FIND_HIGHEST_STRING_11                ; NO, PROCESS NEXT ELEMENT
 4263 A:e510  c5 94                              cmp AS_ARYPNT                ; MAYBE, CHECK LO-BYTE
 4264 A:e512  f0 ba                              beq AS_L_FIND_HIGHEST_STRING_7                ; YES, MOVE TO NEXT ARRAY
 4265 A:e514  20 23 e5                 AS_L_FIND_HIGHEST_STRING_11 jsr AS_CHECK_VARIABLE             ; PROCESS THE ARRAY
 4266 A:e517  f0 f3                              beq AS_L_FIND_HIGHEST_STRING_10                ; ...ALWAYS
