 3376 A:e02c  30 c6                              bmi AS_BADNAM                ; NO, SYNTAX ERROR
 3377 A:e02e  a9 80                              lda #$80             ; YES
 3378 A:e030  85 12                              sta AS_VALTYP+1          ; FLAG INTEGER MODE
