 1626 A:d5f3  99 fb 01                           sta AS_INPUT_BUFFER-5,Y
 1627 A:d5f6  e8                                 inx                    ; NEXT INPUT CHAR
 1628 A:d5f7  d0 f0                              bne AS_L_PARSE_12                ; ...ALWAYS
