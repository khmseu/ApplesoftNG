 1556 A:d582  d0 04                              bne AS_L_PARSE_3                ; NO
 1557 A:d584  a9 ba                              lda #AS_TOKEN_PRINT               ; YES, REPLACE WITH "PRINT" TOKEN
 1558 A:d586  d0 45                              bne AS_L_PARSE_9                ; ...ALWAYS
