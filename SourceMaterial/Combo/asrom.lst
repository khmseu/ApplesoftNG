 4219 A:e4c2  85 94                    AS_L_FIND_HIGHEST_STRING_5 sta AS_ARYPNT
 4220 A:e4c4  86 95                              stx AS_ARYPNT+1
 4221 A:e4c6  a9 03                              lda #3             ; DESCRIPTORS IN ARRAYS ARE 3-BYTES EACH
 4222 A:e4c8  85 8f                              sta AS_DSCLEN                ; 
 4223 A:e4ca  a5 94                    AS_L_FIND_HIGHEST_STRING_6 lda AS_ARYPNT             ; COMPARE TO END OF ARRAYS
 4224 A:e4cc  a6 95                              ldx AS_ARYPNT+1          ; 
 4225 A:e4ce  e4 6e                    AS_L_FIND_HIGHEST_STRING_7 cpx AS_STREND+1       ; FINISHED WITH ARRAYS YET?
