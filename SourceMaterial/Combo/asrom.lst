 9090 A:fc14  a5 21                              lda $21              ;SET CH TO WNDWDTH-1
 9091 A:fc16  85 24                              sta $24
 9092 A:fc18  c6 24                              dec $24              ;(RIGHTMOST SCREEN POS)
 9093 A:fc1a  a5 22                    MON_UP    lda $22           ;CURSOR V INDEX
 9094 A:fc1c  c5 25                              cmp $25
 9095 A:fc1e  b0 0b                              bcs MON_RTS4                ;IF TOP LINE THEN RETURN
 9096 A:fc20  c6 25                              dec $25              ;DEC CURSOR V-INDEX

 9098 A:fc22  a5 25                    MON_VTAB  lda $25           ;GET CURSOR V-INDEX
 9099 A:fc24  20 c1 fb                 MON_VTABZ jsr MON_BASCALC             ;GENERATE BASE ADR
