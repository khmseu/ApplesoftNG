 4374 A:e5b2  a2 b0                              ldx #AS_ERR_STRLONG
 4375 A:e5b4  4c 12 d4                           jmp AS_ERROR
 4376 A:e5b7  20 d5 e3                 AS_L_CAT_1 jsr AS_STRINI             ; GET SPACE FOR CONCATENATED STRINGS
 4377 A:e5ba  20 d4 e5                           jsr AS_MOVINS                ; MOVE 1ST STRING
 4378 A:e5bd  a5 8c                              lda AS_DSCPTR                ; 
