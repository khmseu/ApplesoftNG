 4269 A:e519                                    ; --------------------------------
 4270 A:e519                           AS_CHECK_SIMPLE_VARIABLE 
 4271 A:e519  b1 5e                              lda (AS_INDEX),Y                   ; LOOK AT 1ST CHAR OF NAME
 4272 A:e51b  30 35                              bmi AS_CHECK_BUMP                ; NOT A STRING VARIABLE
 4273 A:e51d  c8                                 iny                    ; 
 4274 A:e51e  b1 5e                              lda (AS_INDEX),Y                   ; LOOK AT 2ND CHAR OF NAME
 4275 A:e520  10 30                              bpl AS_CHECK_BUMP                ; NOT A STRING VARIABLE
 4276 A:e522  c8                                 iny                    ; 
 4277 A:e523                                    ; --------------------------------
 4278 A:e523                                    ; IF STRING IS NOT EMPTY, CHECK IF IT IS HIGHEST
