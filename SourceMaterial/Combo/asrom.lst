 3832 A:e2ad                                    ; MULTIPLY (STRNG2) BY ((LOWTR),Y)
 3833 A:e2ad                                    ; LEAVING PRODUCT IN A,X.  (HI-BYTE ALSO IN Y.)
 3834 A:e2ad                                    ; USED ONLY BY ARRAY SUBSCRIPT ROUTINES
 3835 A:e2ad                                    ; --------------------------------
 3836 A:e2ad                           AS_MULTIPLY_SUBSCRIPT 
 3837 A:e2ad  84 5e                              sty AS_INDEX                ; SAVE Y-REG
 3838 A:e2af  b1 9b                              lda (AS_LOWTR),Y                   ; GET MULTIPLIER
 3839 A:e2b1  85 64                              sta AS_RESULT+2          ; SAVE IN RESULT+2,3
 3840 A:e2b3  88                                 dey                    ; 
 3841 A:e2b4  b1 9b                              lda (AS_LOWTR),Y                   ; 
 3842 A:e2b6                                    ; --------------------------------
 3843 A:e2b6                           AS_MULTIPLY_SUBS_1                  ; 
 3844 A:e2b6  85 65                              sta AS_RESULT+3          ; LOW BYTE OF MULTIPLIER
 3845 A:e2b8  a9 10                              lda #16             ; MULTIPLY 16 BITS
 3846 A:e2ba  85 99                              sta AS_INDX                ; 
 3847 A:e2bc  a2 00                              ldx #0             ; PRODUCT = 0 INITIALLY
 3848 A:e2be  a0 00                              ldy #0             ; 
 3849 A:e2c0  8a                       AS_L_MULTIPLY_SUBS_1_1 txa                 ; DOUBLE PRODUCT
 3850 A:e2c1  0a                                 asl                    ; LOW BYTE
 3851 A:e2c2  aa                                 tax                    ; 
 3852 A:e2c3  98                                 tya                    ; HIGH BYTE
 3853 A:e2c4  2a                                 rol                    ; IF TOO LARGE, SET CARRY
 3854 A:e2c5  a8                                 tay                    ; 
 3855 A:e2c6  b0 a4                              bcs AS_GME                ; TOO LARGE, "MEM FULL ERROR"
 3856 A:e2c8  06 ad                              asl AS_STRNG2                ; NEXT BIT OF MUTLPLICAND
 3857 A:e2ca  26 ae                              rol AS_STRNG2+1          ; INTO CARRY
 3858 A:e2cc  90 0b                              bcc AS_L_MULTIPLY_SUBS_1_2                ; BIT=0, DON'T NEED TO ADD
 3859 A:e2ce  18                                 clc                    ; BIT=1, ADD INTO PARTIAL PRODUCT
 3860 A:e2cf  8a                                 txa                    ; 
 3861 A:e2d0  65 64                              adc AS_RESULT+2          ; 
 3862 A:e2d2  aa                                 tax                    ; 
 3863 A:e2d3  98                                 tya                    ; 
 3864 A:e2d4  65 65                              adc AS_RESULT+3          ; 
 3865 A:e2d6  a8                                 tay                    ; 
