 4240 A:e4e9  65 94                              adc AS_ARYPNT                ; (CARRY ALWAYS CLEAR)
 4241 A:e4eb  85 94                              sta AS_ARYPNT                ; CALCULATE START OF NEXT ARRAY
 4242 A:e4ed  c8                                 iny                    ; 
 4243 A:e4ee  b1 5e                              lda (AS_INDEX),Y                   ; HI-BYTE OF OFFSET
 4244 A:e4f0  65 95                              adc AS_ARYPNT+1          ; 
 4245 A:e4f2  85 95                              sta AS_ARYPNT+1          ; 
 4246 A:e4f4  28                                 plp                    ; GET STATUS FROM 2ND CHAR OF NAME
 4247 A:e4f5  10 d3                              bpl AS_L_FIND_HIGHEST_STRING_6                ; NOT A STRING ARRAY
 4248 A:e4f7  8a                                 txa                    ; SET STATUS WITH 1ST CHAR OF NAME
 4249 A:e4f8  30 d0                              bmi AS_L_FIND_HIGHEST_STRING_6                ; NOT A STRING ARRAY
 4250 A:e4fa  c8                                 iny                    ; 
