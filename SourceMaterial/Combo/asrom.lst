 3719 A:e1fc  91 9b                              sta (AS_LOWTR),Y
 3720 A:e1fe  20 ad e2                           jsr AS_MULTIPLY_SUBSCRIPT                ; MULTIPLY THIS
 3721 A:e201                                    ; DIMENSION BY RUNNING SIZE
