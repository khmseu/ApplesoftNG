 1198 A:d365                                    ; --------------------------------
 1199 A:d365                                    ; CALLED BY "NEXT" AND "FOR" TO SCAN THROUGH
 1200 A:d365                                    ; THE STACK FOR A FRAME WITH THE SAME VARIABLE.
 1201 A:d365                                    ; 
 1202 A:d365                                    ; (FORPNT) = ADDRESS OF VARIABLE IF "FOR" OR "NEXT"
 1203 A:d365                                    ; = $XXFF IF CALLED FROM "RETURN"
 1204 A:d365                                    ; <<< BUG: SHOULD BE $FFXX >>>
 1205 A:d365                                    ; 
 1206 A:d365                                    ; RETURNS .NE. IF VARIABLE NOT FOUND,
 1207 A:d365                                    ; (X) = STACK PNTR AFTER SKIPPING ALL FRAMES
 1208 A:d365                                    ; 
 1209 A:d365                                    ; EQU. IF FOUND
 1210 A:d365                                    ; (X) = STACK PNTR OF FRAME FOUND
 1211 A:d365                                    ; --------------------------------
 1212 A:d365                           AS_GTFORPNT 
 1213 A:d365  ba                                 tsx 
 1214 A:d366  e8                                 inx 
 1215 A:d367  e8                                 inx 
 1216 A:d368  e8                                 inx 
 1217 A:d369  e8                                 inx 
 1218 A:d36a  bd 01 01                 AS_L_GTFORPNT_1 lda AS_STACK+1,X                   ; "FOR" FRAME HERE?
 1219 A:d36d  c9 81                              cmp #AS_TOKEN_FOR               ; 
 1220 A:d36f  d0 21                              bne AS_L_GTFORPNT_4                ; NO
 1221 A:d371  a5 86                              lda AS_FORPNT+1          ; YES -- "NEXT" WITH NO VARIABLE?
 1222 A:d373  d0 0a                              bne AS_L_GTFORPNT_2                ; NO, VARIABLE SPECIFIED
 1223 A:d375  bd 02 01                           lda AS_STACK+2,X                   ; YES, SO USE THIS FRAME
 1224 A:d378  85 85                              sta AS_FORPNT                ; 
 1225 A:d37a  bd 03 01                           lda AS_STACK+3,X                   ; 
 1226 A:d37d  85 86                              sta AS_FORPNT+1          ; 
 1227 A:d37f  dd 03 01                 AS_L_GTFORPNT_2 cmp AS_STACK+3,X                   ; IS VARIABLE IN THIS FRAME?
 1228 A:d382  d0 07                              bne AS_L_GTFORPNT_3                ; NO
 1229 A:d384  a5 85                              lda AS_FORPNT                ; LOOK AT 2ND BYTE TOO
 1230 A:d386  dd 02 01                           cmp AS_STACK+2,X                   ; SAME VARIABLE?
 1231 A:d389  f0 07                              beq AS_L_GTFORPNT_4                ; YES
 1232 A:d38b  8a                       AS_L_GTFORPNT_3 txa                 ; NO, SO TRY NEXT FRAME (IF ANY)
 1233 A:d38c  18                                 clc                    ; 18 BYTES PER FRAME
 1234 A:d38d  69 12                              adc #18             ; 
 1235 A:d38f  aa                                 tax 
 1236 A:d390  d0 d8                              bne AS_L_GTFORPNT_1                ; ...ALWAYS?
 1237 A:d392  60                       AS_L_GTFORPNT_4 rts 
 1238 A:d393                                    ; --------------------------------
 1239 A:d393                                    ; MOVE BLOCK OF MEMORY UP
 1240 A:d393                                    ; 
 1241 A:d393                                    ; ON ENTRY:
 1242 A:d393                                    ; (Y,A) = (HIGHDS) = DESTINATION END+1
 1243 A:d393                                    ; (LOWTR) = LOWEST ADDRESS OF SOURCE
 1244 A:d393                                    ; (HIGHTR) = HIGHEST SOURCE ADDRESS+1
 1245 A:d393                                    ; --------------------------------
 1246 A:d393  20 e3 d3                 AS_BLTU   jsr AS_REASON             ; BE SURE (Y,A) < FRETOP
 1247 A:d396  85 6d                              sta AS_STREND                ; NEW TOP OF ARRAY STORAGE
 1248 A:d398  84 6e                              sty AS_STREND+1          ; 
 1249 A:d39a  38                       AS_BLTU2  sec                 ; 
 1250 A:d39b  a5 96                              lda AS_HIGHTR                ; COMPUTE # OF BYTES TO BE MOVED
 1251 A:d39d  e5 9b                              sbc AS_LOWTR                ; (FROM LOWTR THRU HIGHTR-1)
 1252 A:d39f  85 5e                              sta AS_INDEX                ; PARTIAL PAGE AMOUNT
 1253 A:d3a1  a8                                 tay                    ; 
 1254 A:d3a2  a5 97                              lda AS_HIGHTR+1          ; 
 1255 A:d3a4  e5 9c                              sbc AS_LOWTR+1          ; 
 1256 A:d3a6  aa                                 tax                    ; # OF WHOLE PAGES IN X-REG
 1257 A:d3a7  e8                                 inx                    ; 
 1258 A:d3a8  98                                 tya                    ; # BYTES IN PARTIAL PAGE
 1259 A:d3a9  f0 23                              beq AS_L_BLTU2_4                ; NO PARTIAL PAGE
 1260 A:d3ab  a5 96                              lda AS_HIGHTR                ; BACK UP HIGHTR # BYTES IN PARTIAL PAGE
 1261 A:d3ad  38                                 sec                    ; 
 1262 A:d3ae  e5 5e                              sbc AS_INDEX                ; 
 1263 A:d3b0  85 96                              sta AS_HIGHTR                ; 
 1264 A:d3b2  b0 03                              bcs AS_L_BLTU2_1                ; 
 1265 A:d3b4  c6 97                              dec AS_HIGHTR+1          ; 
 1266 A:d3b6  38                                 sec                    ; 
 1267 A:d3b7  a5 94                    AS_L_BLTU2_1 lda AS_HIGHDS             ; BACK UP HIGHDS # BYTES IN PARTIAL PAGE
 1268 A:d3b9  e5 5e                              sbc AS_INDEX                ; 
 1269 A:d3bb  85 94                              sta AS_HIGHDS                ; 
 1270 A:d3bd  b0 08                              bcs AS_L_BLTU2_3                ; 
 1271 A:d3bf  c6 95                              dec AS_HIGHDS+1          ; 
 1272 A:d3c1  90 04                              bcc AS_L_BLTU2_3                ; ...ALWAYS
 1273 A:d3c3  b1 96                    AS_L_BLTU2_2 lda (AS_HIGHTR),Y                  ; MOVE THE BYTES
 1274 A:d3c5  91 94                              sta (AS_HIGHDS),Y
 1275 A:d3c7  88                       AS_L_BLTU2_3 dey 
 1276 A:d3c8  d0 f9                              bne AS_L_BLTU2_2                ; LOOP TO END OF THIS 256 BYTES
 1277 A:d3ca  b1 96                              lda (AS_HIGHTR),Y                  ; MOVE ONE MORE BYTE
 1278 A:d3cc  91 94                              sta (AS_HIGHDS),Y
 1279 A:d3ce  c6 97                    AS_L_BLTU2_4 dec AS_HIGHTR+1       ; DOWN TO NEXT BLOCK OF 256
 1280 A:d3d0  c6 95                              dec AS_HIGHDS+1
 1281 A:d3d2  ca                                 dex                    ; ANOTHER BLOCK OF 256 TO MOVE?
 1282 A:d3d3  d0 f2                              bne AS_L_BLTU2_3                ; YES
 1283 A:d3d5  60                                 rts                    ; NO, FINISHED
 1284 A:d3d6                                    ; --------------------------------
 1285 A:d3d6                                    ; CHECK IF ENOUGH ROOM LEFT ON STACK
 1286 A:d3d6                                    ; FOR "FOR", "GOSUB", OR EXPRESSION EVALUATION
 1287 A:d3d6                                    ; --------------------------------
 1288 A:d3d6  0a                       AS_CHKMEM asl 
 1289 A:d3d7  69 36                              adc #54
 1290 A:d3d9  b0 35                              bcs AS_MEMERR                ; ...MEM FULL ERR
 1291 A:d3db  85 5e                              sta AS_INDEX
 1292 A:d3dd  ba                                 tsx 
 1293 A:d3de  e4 5e                              cpx AS_INDEX
 1294 A:d3e0  90 2e                              bcc AS_MEMERR                ; ...MEM FULL ERR
 1295 A:d3e2  60                                 rts 
 1296 A:d3e3                                    ; --------------------------------
 1297 A:d3e3                                    ; CHECK IF ENOUGH ROOM BETWEEN ARRAYS AND STRINGS
 1298 A:d3e3                                    ; (Y,A) = ADDR ARRAYS NEED TO GROW TO
 1299 A:d3e3                                    ; --------------------------------
 1300 A:d3e3  c4 70                    AS_REASON cpy AS_FRETOP+1       ; HIGH BYTE
 1301 A:d3e5  90 28                              bcc AS_L_REASON_4                ; PLENTY OF ROOM
 1302 A:d3e7  d0 04                              bne AS_L_REASON_1                ; NOT ENOUGH, TRY GARBAGE COLLECTION
 1303 A:d3e9  c5 6f                              cmp AS_FRETOP                ; LOW BYTE
 1304 A:d3eb  90 22                              bcc AS_L_REASON_4                ; ENOUGH ROOM
 1305 A:d3ed                                    ; --------------------------------
 1306 A:d3ed  48                       AS_L_REASON_1 pha                 ; SAVE (Y,A), TEMP1, AND TEMP2
 1307 A:d3ee  a2 09                              ldx #AS_FAC-AS_TEMP1-1
 1308 A:d3f0  98                                 tya 
 1309 A:d3f1  48                       AS_L_REASON_2 pha 
 1310 A:d3f2  b5 93                              lda AS_TEMP1,X
 1311 A:d3f4  ca                                 dex 
 1312 A:d3f5  10 fa                              bpl AS_L_REASON_2
 1313 A:d3f7  20 84 e4                           jsr AS_GARBAG                ; MAKE AS MUCH ROOM AS POSSIBLE
 1314 A:d3fa  a2 f7                              ldx #AS_TEMP1+256-AS_FAC+1; RESTORE TEMP1 AND TEMP2
 1315 A:d3fc  68                       AS_L_REASON_3 pla                 ; AND (Y,A)
 1316 A:d3fd  95 9d                              sta AS_FAC,X
 1317 A:d3ff  e8                                 inx 
 1318 A:d400  30 fa                              bmi AS_L_REASON_3
 1319 A:d402  68                                 pla 
 1320 A:d403  a8                                 tay 
 1321 A:d404  68                                 pla                    ; DID WE FIND ENOUGH ROOM?
 1322 A:d405  c4 70                              cpy AS_FRETOP+1          ; HIGH BYTE
 1323 A:d407  90 06                              bcc AS_L_REASON_4                ; YES, AT LEAST A PAGE
 1324 A:d409  d0 05                              bne AS_MEMERR                ; NO, MEM FULL ERR
 1325 A:d40b  c5 6f                              cmp AS_FRETOP                ; LOW BYTE
 1326 A:d40d  b0 01                              bcs AS_MEMERR                ; NO, MEM FULL ERR
 1327 A:d40f  60                       AS_L_REASON_4 rts                 ; YES, RETURN
 1328 A:d410                                    ; --------------------------------
 1329 A:d410  a2 4d                    AS_MEMERR ldx #AS_ERR_MEMFULL
 1330 A:d412                                    ; --------------------------------
 1331 A:d412                                    ; HANDLE AN ERROR
 1332 A:d412                                    ; 
 1333 A:d412                                    ; (X)=OFFSET IN ERROR MESSAGE TABLE
 1334 A:d412                                    ; (ERRFLG) > 128 IF "ON ERR" TURNED ON
 1335 A:d412                                    ; (CURLIN+1) = $FF IF IN DIRECT MODE
 1336 A:d412                                    ; --------------------------------
 1337 A:d412  24 d8                    AS_ERROR  bit AS_ERRFLG             ; "ON ERR" TURNED ON?
 1338 A:d414  10 03                              bpl AS_L_ERROR_1                ; NO
 1339 A:d416  4c e9 f2                           jmp AS_HANDLERR                ; YES
 1340 A:d419  20 fb da                 AS_L_ERROR_1 jsr AS_CRDO             ; PRINT <RETURN>
 1341 A:d41c  20 5a db                           jsr AS_OUTQUES                ; PRINT "?"
 1342 A:d41f  bd 60 d2                 AS_L_ERROR_2 lda AS_ERROR_MESSAGES,X
 1343 A:d422  48                                 pha                    ; PRINT MESSAGE
 1344 A:d423  20 5c db                           jsr AS_OUTDO
 1345 A:d426  e8                                 inx 
 1346 A:d427  68                                 pla 
 1347 A:d428  10 f5                              bpl AS_L_ERROR_2
 1348 A:d42a  20 83 d6                           jsr AS_STKINI                ; FIX STACK, ET AL
 1349 A:d42d  a9 50                              lda #<AS_QT_ERROR              ; PRINT " ERROR" AND BELL
 1350 A:d42f  a0 d3                              ldy #>AS_QT_ERROR
 1351 A:d431                                    ; --------------------------------
 1352 A:d431                                    ; PRINT STRING AT (Y,A)
 1353 A:d431                                    ; PRINT CURRENT LINE # UNLESS IN DIRECT MODE
 1354 A:d431                                    ; FALL INTO WARM RESTART
 1355 A:d431                                    ; --------------------------------
 1356 A:d431                           AS_PRINT_ERROR_LINNUM 
 1357 A:d431  20 3a db                           jsr AS_STROUT                ; PRINT STRING AT (Y,A)
 1358 A:d434  a4 76                              ldy AS_CURLIN+1          ; RUNNING, OR DIRECT?
 1359 A:d436  c8                                 iny 
 1360 A:d437  f0 03                              beq AS_RESTART                ; WAS $FF, SO DIRECT MODE
 1361 A:d439  20 19 ed                           jsr AS_INPRT                ; RUNNING, SO PRINT LINE NUMBER
 1362 A:d43c                                    ; --------------------------------
 1363 A:d43c                                    ; WARM RESTART ENTRY
 1364 A:d43c                                    ; 
 1365 A:d43c                                    ; COME HERE FROM MONITOR BY CTL-C, 0G, 3D0G, OR E003G
 1366 A:d43c                                    ; --------------------------------
 1367 A:d43c                           AS_RESTART 
 1368 A:d43c  20 fb da                           jsr AS_CRDO                ; PRINT <RETURN>
 1369 A:d43f  a2 dd                              ldx #("]"|%10000000)     ; PROMPT CHARACTER
 1370 A:d441  20 2e d5                           jsr AS_INLIN2                ; READ A LINE
 1371 A:d444  86 b8                              stx AS_TXTPTR                ; SET UP CHRGET TO SCAN THE LINE
 1372 A:d446  84 b9                              sty AS_TXTPTR+1          ; 
 1373 A:d448  46 d8                              lsr AS_ERRFLG                ; CLEAR FLAG
 1374 A:d44a  20 b1 00                           jsr AS_CHRGET                ; 
 1375 A:d44d  aa                                 tax                    ; 
 1376 A:d44e  f0 ec                              beq AS_RESTART                ; EMPTY LINE
 1377 A:d450  a2 ff                              ldx #$ff             ; $FF IN HI-BYTE OF CURLIN MEANS
 1378 A:d452  86 76                              stx AS_CURLIN+1          ; WE ARE IN DIRECT MODE
 1379 A:d454  90 06                              bcc AS_NUMBERED_LINE                ; CHRGET SAW DIGIT, NUMBERED LINE
 1380 A:d456  20 59 d5                           jsr AS_PARSE_INPUT_LINE                ; NO NUMBER, SO PARSE IT
 1381 A:d459  4c 05 d8                           jmp AS_TRACE_                ; AND TRY EXECUTING IT
 1382 A:d45c                                    ; --------------------------------
 1383 A:d45c                                    ; HANDLE NUMBERED LINE
 1384 A:d45c                                    ; --------------------------------
 1385 A:d45c                           AS_NUMBERED_LINE 
 1386 A:d45c  a6 af                              ldx AS_PRGEND                ; SQUASH VARIABLE TABLE
 1387 A:d45e  86 69                              stx AS_VARTAB
 1388 A:d460  a6 b0                              ldx AS_PRGEND+1
 1389 A:d462  86 6a                              stx AS_VARTAB+1
 1390 A:d464  20 0c da                           jsr AS_LINGET                ; GET LINE #
 1391 A:d467  20 59 d5                           jsr AS_PARSE_INPUT_LINE                ; AND PARSE THE INPUT LINE
 1392 A:d46a  84 0f                              sty AS_EOL_PNTR                ; SAVE INDEX TO INPUT BUFFER
 1393 A:d46c  20 1a d6                           jsr AS_FNDLIN                ; IS THIS LINE # ALREADY IN PROGRAM?
 1394 A:d46f  90 44                              bcc AS_PUT_NEW_LINE                ; NO
 1395 A:d471  a0 01                              ldy #1             ; YES, SO DELETE IT
 1396 A:d473  b1 9b                              lda (AS_LOWTR),Y                   ; LOWTR POINTS AT LINE
 1397 A:d475  85 5f                              sta AS_INDEX+1          ; GET HIGH BYTE OF FORWARD PNTR
 1398 A:d477  a5 69                              lda AS_VARTAB
 1399 A:d479  85 5e                              sta AS_INDEX
 1400 A:d47b  a5 9c                              lda AS_LOWTR+1
 1401 A:d47d  85 61                              sta AS_DEST+1
 1402 A:d47f  a5 9b                              lda AS_LOWTR
 1403 A:d481  88                                 dey 
