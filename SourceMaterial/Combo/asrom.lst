 6007 A:eedb  81 38 aa 3b 29           AS_CON_LOG_E .byt $81,$38,$aa,$3b,$29; LOG(E) TO BASE 2
 6008 A:eee0                                    ; --------------------------------
 6009 A:eee0  07                       AS_POLY_EXP .byt 7           ; ( # OF TERMS IN POLYNOMIAL) - 1
 6010 A:eee1  71 34 58 3e 56                     .byt $71,$34,$58,$3e,$56; (LOG(2)^7)/8!
 6011 A:eee6  74 16 7e b3 1b                     .byt $74,$16,$7e,$b3,$1b; (LOG(2)^6)/7!
 6012 A:eeeb  77 2f ee e3 85                     .byt $77,$2f,$ee,$e3,$85; (LOG(2)^5)/6!
 6013 A:eef0  7a 1d 84 1c 2a                     .byt $7a,$1d,$84,$1c,$2a; (LOG(2)^4)/5!
 6014 A:eef5  7c 63 59 58 0a                     .byt $7c,$63,$59,$58,$0a; (LOG(2)^3)/4!
 6015 A:eefa  7e 75 fd e7 c6                     .byt $7e,$75,$fd,$e7,$c6; (LOG(2)^2)/3!
 6016 A:eeff  80 31 72 18 10                     .byt $80,$31,$72,$18,$10; LOG(2)/2!
 6017 A:ef04  81 00 00 00 00                     .byt $81,$00,$00,$00,$00; 1
 6018 A:ef09                                    ; --------------------------------
 6019 A:ef09                                    ; "EXP" FUNCTION
 6020 A:ef09                                    ; 
 6021 A:ef09                                    ; FAC = E ^ FAC
 6022 A:ef09                                    ; --------------------------------
 6023 A:ef09  a9 db                    AS_EXP    lda #<AS_CON_LOG_E           ; CONVERT TO POWER OF TWO PROBLEM
 6024 A:ef0b  a0 ee                              ldy #>AS_CON_LOG_E              ; E^X = 2^(LOG2(E)*X)
 6025 A:ef0d  20 7f e9                           jsr AS_FMULT                ; 
 6026 A:ef10  a5 ac                              lda AS_FAC_EXTENSION                ; NON-STANDARD ROUNDING HERE
 6027 A:ef12  69 50                              adc #$50             ; ROUND UP IF EXTENSION > $AF
 6028 A:ef14  90 03                              bcc AS_L_EXP_1                ; NO, DON'T ROUND UP
 6029 A:ef16  20 7a eb                           jsr AS_INCREMENT_MANTISSA
 6030 A:ef19  85 92                    AS_L_EXP_1 sta AS_ARG_EXTENSION             ; STRANGE VALUE
 6031 A:ef1b  20 66 eb                           jsr AS_MAF                ; COPY FAC INTO ARG
 6032 A:ef1e  a5 9d                              lda AS_FAC                ; MAXIMUM EXPONENT IS < 128
 6033 A:ef20  c9 88                              cmp #$88             ; WITHIN RANGE?
 6034 A:ef22  90 03                              bcc AS_L_EXP_3                ; YES
 6035 A:ef24  20 2b ea                 AS_L_EXP_2 jsr AS_OUTOFRNG             ; OVERFLOW IF +, RETURN 0.0 IF -
 6036 A:ef27  20 23 ec                 AS_L_EXP_3 jsr AS_INT             ; GET INT(FAC)
 6037 A:ef2a  a5 0d                              lda AS_CHARAC                ; THIS IS THE INETGRAL PART OF THE POWER
 6038 A:ef2c  18                                 clc                    ; ADD TO EXPONENT BIAS + 1
 6039 A:ef2d  69 81                              adc #$81             ; 
 6040 A:ef2f  f0 f3                              beq AS_L_EXP_2                ; OVERFLOW
 6041 A:ef31  38                                 sec                    ; BACK OFF TO NORMAL BIAS
 6042 A:ef32  e9 01                              sbc #1             ; 
 6043 A:ef34  48                                 pha                    ; SAVE EXPONENT
 6044 A:ef35                                    ; --------------------------------
 6045 A:ef35  a2 05                              ldx #5             ; SWAP ARG AND FAC
 6046 A:ef37  b5 a5                    AS_L_EXP_4 lda AS_ARG,X                       ; <<< WHY SWAP? IT IS DOING      >>>
 6047 A:ef39  b4 9d                              ldy AS_FAC,X                       ; <<< -(A-B) WHEN (B-A) IS THE   >>>
 6048 A:ef3b  95 9d                              sta AS_FAC,X                       ; <<< SAME THING!                >>>
 6049 A:ef3d  94 a5                              sty AS_ARG,X
 6050 A:ef3f  ca                                 dex 
 6051 A:ef40  10 f5                              bpl AS_L_EXP_4
 6052 A:ef42  a5 92                              lda AS_ARG_EXTENSION
 6053 A:ef44  85 ac                              sta AS_FAC_EXTENSION
 6054 A:ef46  20 aa e7                           jsr AS_FSUBT                ; POWER-INT(POWER) --> FRACTIONAL PART
 6055 A:ef49  20 d0 ee                           jsr AS_NEGOP
 6056 A:ef4c  a9 e0                              lda #<AS_POLY_EXP
 6057 A:ef4e  a0 ee                              ldy #>AS_POLY_EXP
 6058 A:ef50  20 72 ef                           jsr AS_POLYNOMIAL                ; COMPUTE F(X) ON FRACTIONAL PART
 6059 A:ef53  a9 00                              lda #0
 6060 A:ef55  85 ab                              sta AS_SGNCPR
 6061 A:ef57  68                                 pla                    ; GET EXPONENT
 6062 A:ef58  20 10 ea                           jsr AS_ADD_EXPONENTS_1
 6063 A:ef5b  60                                 rts                    ; <<< WASTED BYTE HERE, COULD HAVE >>>
 6064 A:ef5c                                    ; <<< JUST USED "JMP ADD.EXPO..."  >>>
 6065 A:ef5c                                    ; --------------------------------
 6066 A:ef5c                                    ; ODD POLYNOMIAL SUBROUTINE
 6067 A:ef5c                                    ; 
 6068 A:ef5c                                    ; F(X) = X * P(X^2)
 6069 A:ef5c                                    ; 
 6070 A:ef5c                                    ; WHERE:  X IS VALUE IN FAC
 6071 A:ef5c                                    ; Y,A POINTS AT COEFFICIENT TABLE
 6072 A:ef5c                                    ; FIRST BYTE OF COEFF. TABLE IS N
 6073 A:ef5c                                    ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
 6074 A:ef5c                                    ; 
 6075 A:ef5c                                    ; P(X^2) COMPUTED USING NORMAL POLYNOMIAL SUBROUTINE
 6076 A:ef5c                                    ; 
 6077 A:ef5c                                    ; --------------------------------
 6078 A:ef5c                           AS_POLYNOMIAL_ODD 
 6079 A:ef5c  85 ad                              sta AS_SERPNT                ; SAVE ADDRESS OF COEFFICIENT TABLE
 6080 A:ef5e  84 ae                              sty AS_SERPNT+1
 6081 A:ef60  20 21 eb                           jsr AS_STORE_FAC_IN_TEMP1_ROUNDED
 6082 A:ef63  a9 93                              lda #AS_TEMP1               ; Y=0 ALREADY, SO Y,A POINTS AT TEMP1
 6083 A:ef65  20 7f e9                           jsr AS_FMULT                ; FORM X^2
 6084 A:ef68  20 76 ef                           jsr AS_SERMAIN                ; DO SERIES IN X^2
 6085 A:ef6b  a9 93                              lda #<AS_TEMP1              ; GET X AGAIN
 6086 A:ef6d  a0 00                              ldy #>AS_TEMP1              ; 
 6087 A:ef6f  4c 7f e9                           jmp AS_FMULT                ; MULTIPLY X BY P(X^2) AND EXIT
 6088 A:ef72                                    ; --------------------------------
 6089 A:ef72                                    ; NORMAL POLYNOMIAL SUBROUTINE
 6090 A:ef72                                    ; 
 6091 A:ef72                                    ; P(X) = C(0)*X^N + C(1)*X^(N-1) + ... + C(N)
 6092 A:ef72                                    ; 
 6093 A:ef72                                    ; WHERE:  X IS VALUE IN FAC
 6094 A:ef72                                    ; Y,A POINTS AT COEFFICIENT TABLE
 6095 A:ef72                                    ; FIRST BYTE OF COEFF. TABLE IS N
 6096 A:ef72                                    ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
 6097 A:ef72                                    ; 
 6098 A:ef72                                    ; --------------------------------
 6099 A:ef72                           AS_POLYNOMIAL 
 6100 A:ef72  85 ad                              sta AS_SERPNT                ; POINTER TO COEFFICIENT TABLE
 6101 A:ef74  84 ae                              sty AS_SERPNT+1
 6102 A:ef76                                    ; --------------------------------
 6103 A:ef76                           AS_SERMAIN 
 6104 A:ef76  20 1e eb                           jsr AS_STORE_FAC_IN_TEMP2_ROUNDED
 6105 A:ef79  b1 ad                              lda (AS_SERPNT),Y                  ; GET N
 6106 A:ef7b  85 a3                              sta AS_SERLEN                ; SAVE N
 6107 A:ef7d  a4 ad                              ldy AS_SERPNT                ; BUMP PNTR TO HIGHEST COEFFICIENT
 6108 A:ef7f  c8                                 iny                    ; AND GET PNTR INTO Y,A
 6109 A:ef80  98                                 tya 
 6110 A:ef81  d0 02                              bne AS_L_SERMAIN_1
 6111 A:ef83  e6 ae                              inc AS_SERPNT+1
 6112 A:ef85  85 ad                    AS_L_SERMAIN_1 sta AS_SERPNT
 6113 A:ef87  a4 ae                              ldy AS_SERPNT+1
 6114 A:ef89  20 7f e9                 AS_L_SERMAIN_2 jsr AS_FMULT             ; ACCUMULATE SERIES TERMS
 6115 A:ef8c  a5 ad                              lda AS_SERPNT                ; BUMP PNTR TO NEXT COEFFICIENT
 6116 A:ef8e  a4 ae                              ldy AS_SERPNT+1
 6117 A:ef90  18                                 clc 
 6118 A:ef91  69 05                              adc #5
 6119 A:ef93  90 01                              bcc AS_L_SERMAIN_3
 6120 A:ef95  c8                                 iny 
 6121 A:ef96  85 ad                    AS_L_SERMAIN_3 sta AS_SERPNT
 6122 A:ef98  84 ae                              sty AS_SERPNT+1
 6123 A:ef9a  20 be e7                           jsr AS_FADD                ; ADD NEXT COEFFICIENT
 6124 A:ef9d  a9 98                              lda #AS_TEMP2               ; POINT AT X AGAIN
 6125 A:ef9f  a0 00                              ldy #0             ; 
 6126 A:efa1  c6 a3                              dec AS_SERLEN                ; IF SERIES NOT FINISHED,
 6127 A:efa3  d0 e4                              bne AS_L_SERMAIN_2                ; THEN ADD ANOTHER TERM
 6128 A:efa5  60                       AS_RTS_19 rts                 ; FINISHED
 6129 A:efa6                                    ; --------------------------------

 6131 A:efa6  98 35 44 7a              AS_CON_RND_1 .byt $98,$35,$44,$7a; <<< THESE ARE MISSING ONE BYTE >>>
 6132 A:efaa  68 28 b1 46              AS_CON_RND_2 .byt $68,$28,$b1,$46; <<< FOR FP VALUES              >>>
 6133 A:efae                                    ; --------------------------------
 6134 A:efae                                    ; "RND" FUNCTION
 6135 A:efae                                    ; --------------------------------
 6136 A:efae  20 82 eb                 AS_RND    jsr AS_SIGN             ; REDUCE ARGUMENT TO -1, 0, OR +1
 6137 A:efb1  aa                                 tax                    ; SAVE ARGUMENT
 6138 A:efb2  30 18                              bmi AS_L_RND_1                ; = -1, USE CURRENT ARGUMENT FOR SEED
 6139 A:efb4  a9 c9                              lda #<AS_RNDSEED              ; USE CURRENT SEED
 6140 A:efb6  a0 00                              ldy #>AS_RNDSEED
 6141 A:efb8  20 f9 ea                           jsr AS_LOAD_FAC_FROM_YA
 6142 A:efbb  8a                                 txa                    ; RECALL SIGN OF ARGUMENT
 6143 A:efbc  f0 e7                              beq AS_RTS_19                ; =0, RETURN SEED UNCHANGED
 6144 A:efbe  a9 a6                              lda #<AS_CON_RND_1              ; VERY POOR RND ALGORITHM
 6145 A:efc0  a0 ef                              ldy #>AS_CON_RND_1
 6146 A:efc2  20 7f e9                           jsr AS_FMULT
 6147 A:efc5  a9 aa                              lda #<AS_CON_RND_2              ; ALSO, CONSTANTS ARE TRUNCATED
 6148 A:efc7  a0 ef                              ldy #>AS_CON_RND_2              ; <<<THIS DOES NOTHING, DUE TO >>>
 6149 A:efc9                                    ; <<<SMALL EXPONENT            >>>
 6150 A:efc9  20 be e7                           jsr AS_FADD
 6151 A:efcc  a6 a1                    AS_L_RND_1 ldx AS_FAC+4       ; SHUFFLE HI AND LO BYTES
 6152 A:efce  a5 9e                              lda AS_FAC+1          ; TO SUPPOSEDLY MAKE IT MORE RANDOM
 6153 A:efd0  85 a1                              sta AS_FAC+4          ; 
 6154 A:efd2  86 9e                              stx AS_FAC+1          ; 
 6155 A:efd4  a9 00                              lda #0             ; MAKE IT POSITIVE
 6156 A:efd6  85 a2                              sta AS_FAC_SIGN                ; 
 6157 A:efd8  a5 9d                              lda AS_FAC                ; A SOMEWHAT RANDOM EXTENSION
 6158 A:efda  85 ac                              sta AS_FAC_EXTENSION
 6159 A:efdc  a9 80                              lda #$80             ; EXPONENT TO MAKE VALUE < 1.0
 6160 A:efde  85 9d                              sta AS_FAC
 6161 A:efe0  20 2e e8                           jsr AS_NORMALIZE_FAC_2
 6162 A:efe3  a2 c9                              ldx #<AS_RNDSEED              ; MOVE FAC TO RND SEED
 6163 A:efe5  a0 00                              ldy #>AS_RNDSEED
 6164 A:efe7  4c 2b eb                 AS_GO_MOVMF jmp AS_STORE_FACDB_YX_ROUNDED
 6165 A:efea                                    ; --------------------------------
 6166 A:efea                                    ; --------------------------------
 6167 A:efea                                    ; "COS" FUNCTION
 6168 A:efea                                    ; --------------------------------
 6169 A:efea  a9 66                    AS_COS    lda #<AS_CON_PI_HALF           ; COS(X)=SIN(X + PI/2)
 6170 A:efec  a0 f0                              ldy #>AS_CON_PI_HALF
 6171 A:efee  20 be e7                           jsr AS_FADD
 6172 A:eff1                                    ; --------------------------------
 6173 A:eff1                                    ; "SIN" FUNCTION
 6174 A:eff1                                    ; --------------------------------
 6175 A:eff1  20 63 eb                 AS_SIN    jsr AS_COPY_FAC_TO_ARG_ROUNDED
 6176 A:eff4  a9 6b                              lda #<AS_CON_PI_DOUB              ; REMOVE MULTIPLES OF 2*PI
 6177 A:eff6  a0 f0                              ldy #>AS_CON_PI_DOUB              ; BY DIVIDING AND SAVING
 6178 A:eff8  a6 aa                              ldx AS_ARG_SIGN                ; THE FRACTIONAL PART
 6179 A:effa  20 5e ea                           jsr AS_DIV                ; USE SIGN OF ARGUMENT
 6180 A:effd  20 63 eb                           jsr AS_COPY_FAC_TO_ARG_ROUNDED
 6181 A:f000  20 23 ec                           jsr AS_INT                ; TAKE INTEGER PART
 6182 A:f003  a9 00                              lda #0             ; <<< WASTED LINES, BECAUSE FSUBT >>>
 6183 A:f005  85 ab                              sta AS_SGNCPR                ; <<< CHANGES SGNCPR AGAIN        >>>
 6184 A:f007  20 aa e7                           jsr AS_FSUBT                ; SUBTRACT TO GET FRACTIONAL PART
 6185 A:f00a                                    ; --------------------------------
 6186 A:f00a                                    ; (FAC) = ANGLE AS A FRACTION OF A FULL CIRCLE
 6187 A:f00a                                    ; 
 6188 A:f00a                                    ; NOW FOLD THE RANGE INTO A QUARTER CIRCLE
 6189 A:f00a                                    ; 
 6190 A:f00a                                    ; <<< THERE ARE MUCH SIMPLER WAYS TO DO THIS >>>
 6191 A:f00a                                    ; --------------------------------
 6192 A:f00a  a9 70                              lda #<AS_QUARTER              ; 1/4 - FRACTION MAKES
 6193 A:f00c  a0 f0                              ldy #>AS_QUARTER              ; -3/4 <= FRACTION < 1/4
 6194 A:f00e  20 a7 e7                           jsr AS_FSUB                ; 
 6195 A:f011  a5 a2                              lda AS_FAC_SIGN                ; TEST SIGN OF RESULT
 6196 A:f013  48                                 pha                    ; SAVE SIGN FOR LATER UNFOLDING
 6197 A:f014  10 0d                              bpl AS_SIN_1                ; ALREADY 0...1/4
 6198 A:f016  20 a0 e7                           jsr AS_FADDH                ; ADD 1/2 TO SHIFT TO -1/4...1/2
 6199 A:f019  a5 a2                              lda AS_FAC_SIGN                ; TEST SIGN
 6200 A:f01b  30 09                              bmi AS_SIN_2                ; -1/4...0
 6201 A:f01d                                    ; 0...1/2
 6202 A:f01d  a5 16                              lda AS_SIGNFLG                ; SIGNFLG INITIALIZED = 0 IN "TAN"
 6203 A:f01f  49 ff                              eor #$ff             ; FUNCTION
 6204 A:f021  85 16                              sta AS_SIGNFLG                ; "TAN" IS ONLY USER OF SIGNFLG TOO
 6205 A:f023                                    ; --------------------------------
 6206 A:f023                                    ; IF FALL THRU, RANGE IS 0...1/2
 6207 A:f023                                    ; IF BRANCH HERE, RANGE IS 0...1/4
 6208 A:f023                                    ; --------------------------------
 6209 A:f023  20 d0 ee                 AS_SIN_1  jsr AS_NEGOP
 6210 A:f026                                    ; --------------------------------
 6211 A:f026                                    ; IF FALL THRU, RANGE IS -1/2...0
 6212 A:f026                                    ; IF BRANCH HERE, RANGE IS -1/4...0
 6213 A:f026                                    ; --------------------------------
 6214 A:f026  a9 70                    AS_SIN_2  lda #<AS_QUARTER           ; ADD 1/4 TO SHIFT RANGE
 6215 A:f028  a0 f0                              ldy #>AS_QUARTER              ; TO -1/4...1/4
 6216 A:f02a  20 be e7                           jsr AS_FADD                ; 
 6217 A:f02d  68                                 pla                    ; GET SAVED SIGN FROM ABOVE
 6218 A:f02e  10 03                              bpl AS_L_SIN_2_1                ; 
 6219 A:f030  20 d0 ee                           jsr AS_NEGOP                ; MAKE RANGE 0...1/4
 6220 A:f033  a9 75                    AS_L_SIN_2_1 lda #<AS_POLY_SIN           ; DO STANDARD SIN SERIES
 6221 A:f035  a0 f0                              ldy #>AS_POLY_SIN              ; 
 6222 A:f037  4c 5c ef                           jmp AS_POLYNOMIAL_ODD                ; 
 6223 A:f03a                                    ; --------------------------------
 6224 A:f03a                                    ; "TAN" FUNCTION
 6225 A:f03a                                    ; 
 6226 A:f03a                                    ; COMPUTE TAN(X) = SIN(X) / COS(X)
 6227 A:f03a                                    ; --------------------------------
 6228 A:f03a  20 21 eb                 AS_TAN    jsr AS_STORE_FAC_IN_TEMP1_ROUNDED
 6229 A:f03d  a9 00                              lda #0             ; SIGNFLG WILL BE TOGGLED IF 2ND OR 3RD
 6230 A:f03f  85 16                              sta AS_SIGNFLG                ; QUADRANT
 6231 A:f041  20 f1 ef                           jsr AS_SIN                ; GET SIN(X)
 6232 A:f044  a2 8a                              ldx #<AS_TEMP3              ; SAVE SIN(X) IN TEMP3
 6233 A:f046  a0 00                              ldy #>AS_TEMP3              ; 
 6234 A:f048  20 e7 ef                           jsr AS_GO_MOVMF                ; <<<FUNNY WAY TO CALL MOVMF! >>>
 6235 A:f04b  a9 93                              lda #<AS_TEMP1              ; RETRIEVE X
 6236 A:f04d  a0 00                              ldy #>AS_TEMP1              ; 
 6237 A:f04f  20 f9 ea                           jsr AS_LOAD_FAC_FROM_YA
 6238 A:f052  a9 00                              lda #0             ; AND COMPUTE COS(X)
 6239 A:f054  85 a2                              sta AS_FAC_SIGN                ; 
 6240 A:f056  a5 16                              lda AS_SIGNFLG                ; 
 6241 A:f058  20 62 f0                           jsr AS_TAN_1                ; WEIRD & DANGEROUS WAY TO GET INTO SIN
 6242 A:f05b  a9 8a                              lda #<AS_TEMP3              ; NOW FORM SIN/COS
 6243 A:f05d  a0 00                              ldy #>AS_TEMP3              ; 
 6244 A:f05f  4c 66 ea                           jmp AS_FDIV                ; 
 6245 A:f062                                    ; --------------------------------
 6246 A:f062  48                       AS_TAN_1  pha                 ; SHAME, SHAME!
 6247 A:f063  4c 23 f0                           jmp AS_SIN_1
