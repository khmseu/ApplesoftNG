 7216 A:f5ba                                    ; --------------------------------
 7217 A:f5ba                                    ; TABLE OF COS(90*X/16 DEGREES)*$100 - 1
 7218 A:f5ba                                    ; WITH ONE BYTE PRECISION, X=0 TO 16:
 7219 A:f5ba                                    ; --------------------------------
 7220 A:f5ba  ff fe fa f4 ec e1 d4 c5  AS_COSINE_TABLE .byt $ff,$fe,$fa,$f4,$ec,$e1,$d4,$c5
 7221 A:f5c2  b4 a1 8d 78 61 49 31 18            .byt $b4,$a1,$8d,$78,$61,$49,$31,$18
 7222 A:f5ca  ff                                 .byt $ff
 7223 A:f5cb                                    ; --------------------------------
 7224 A:f5cb                                    ; HFIND -- CALCULATES CURRENT POSITION OF HI-RES CURSOR
 7225 A:f5cb                                    ; (NOT CALLED BY ANY APPLESOFT ROUTINE)
 7226 A:f5cb                                    ; 
 7227 A:f5cb                                    ; CALCULATE Y-COORD FROM GBASL,H
 7228 A:f5cb                                    ; AND X-COORD FROM HORIZ AND HMASK
 7229 A:f5cb                                    ; --------------------------------
 7230 A:f5cb  a5 26                    AS_HFIND  lda MON_GBASL             ; GBASL = EABAB000
 7231 A:f5cd  0a                                 asl                    ; E INTO CARRY
 7232 A:f5ce  a5 27                              lda MON_GBASH                ; GBASH = PPPFGHCD
 7233 A:f5d0  29 03                              and #3             ; 000000CD
 7234 A:f5d2  2a                                 rol                    ; 00000CDE
 7235 A:f5d3  05 26                              ora MON_GBASL                ; EABABCDE
 7236 A:f5d5  0a                                 asl                    ; ABABCDE0
 7237 A:f5d6  0a                                 asl                    ; BABCDE00
 7238 A:f5d7  0a                                 asl                    ; ABCDE000
 7239 A:f5d8  85 e2                              sta AS_HGR_Y                ; ALL BUT FGH
 7240 A:f5da  a5 27                              lda MON_GBASH                ; PPPFGHCD
 7241 A:f5dc  4a                                 lsr                    ; 0PPPFGHC
 7242 A:f5dd  4a                                 lsr                    ; 00PPPFGH
 7243 A:f5de  29 07                              and #7             ; 00000FGH
 7244 A:f5e0  05 e2                              ora AS_HGR_Y                ; ABCDEFGH
 7245 A:f5e2  85 e2                              sta AS_HGR_Y                ; THAT TAKES CARE OF Y-COORDINATE!
 7246 A:f5e4  a5 e5                              lda AS_HGR_HORIZ                ; X = 7*HORIZ + BIT POS. IN HMASK
 7247 A:f5e6  0a                                 asl                    ; MULTIPLY BY 7
 7248 A:f5e7  65 e5                              adc AS_HGR_HORIZ                ; 3* SO FAR
 7249 A:f5e9  0a                                 asl                    ; 6*
 7250 A:f5ea  aa                                 tax                    ; SINCE 7* MIGHT NOT FIT IN 1 BYTE,
 7251 A:f5eb                                    ; WAIT TILL LATER FOR LAST ADD
 7252 A:f5eb  ca                                 dex                    ; 
 7253 A:f5ec  a5 30                              lda MON_HMASK                ; NOW FIND BIT POSITION IN HMASK
 7254 A:f5ee  29 7f                              and #$7f             ; ONLY LOOK AT LOW SEVEN
 7255 A:f5f0  e8                       AS_L_HFIND_1 inx                 ; COUNT A SHIFT
 7256 A:f5f1  4a                                 lsr                    ; 
 7257 A:f5f2  d0 fc                              bne AS_L_HFIND_1                ; STILL IN THERE
 7258 A:f5f4  85 e1                              sta AS_HGR_X+1          ; ZERO TO HI-BYTE
 7259 A:f5f6  8a                                 txa                    ; 6*HORIZ+LOG2(HMASK)
 7260 A:f5f7  18                                 clc                    ; ADD HORIZ ONE MORE TIME
 7261 A:f5f8  65 e5                              adc AS_HGR_HORIZ                ; 7*HORIZ+LOG2(HMASK)
 7262 A:f5fa  90 02                              bcc AS_L_HFIND_2                ; UPPER BYTE = 0
 7263 A:f5fc  e6 e1                              inc AS_HGR_X+1          ; UPPER BYTE = 1
 7264 A:f5fe  85 e0                    AS_L_HFIND_2 sta AS_HGR_X             ; STORE LOWER BYTE
 7265 A:f600  60                       AS_RTS_22 rts 
 7266 A:f601                                    ; --------------------------------
 7267 A:f601                                    ; DRAW A SHAPE
 7268 A:f601                                    ; 
 7269 A:f601                                    ; (Y,X) = SHAPE STARTING ADDRESS
 7270 A:f601                                    ; (A)   = ROTATION (0-3F)
 7271 A:f601                                    ; --------------------------------
 7272 A:f601                                    ; APPLESOFT DOES NOT CALL DRAW0
 7273 A:f601                                    ; --------------------------------
 7274 A:f601  86 1a                    AS_DRAW0  stx AS_HGR_SHAPE             ; SAVE SHAPE ADDRESS
 7275 A:f603  84 1b                              sty AS_HGR_SHAPE+1
 7276 A:f605                                    ; --------------------------------
 7277 A:f605                                    ; APPLESOFT ENTERS HERE
 7278 A:f605                                    ; --------------------------------
 7279 A:f605  aa                       AS_DRAW1  tax                 ; SAVE ROTATION (0-$3F)
 7280 A:f606  4a                                 lsr                    ; DIVIDE ROTATION BY 16 TO GET
 7281 A:f607  4a                                 lsr                    ; QUADRANT (0=UP, 1=RT, 2=DWN, 3=LFT)
 7282 A:f608  4a                                 lsr 
 7283 A:f609  4a                                 lsr 
 7284 A:f60a  85 d3                              sta AS_HGR_QUADRANT
 7285 A:f60c  8a                                 txa                    ; USE LOW 4 BITS OF ROTATION TO INDEX
 7286 A:f60d  29 0f                              and #$0f             ; THE TRIG TABLE
 7287 A:f60f  aa                                 tax 
 7288 A:f610  bc ba f5                           ldy AS_COSINE_TABLE,X              ; SAVE COSINE IN HGR.DX
 7289 A:f613  84 d0                              sty AS_HGR_DX                ; 
 7290 A:f615  49 0f                              eor #$0f             ; AND SINE IN DY
 7291 A:f617  aa                                 tax 
 7292 A:f618  bc bb f5                           ldy AS_COSINE_TABLE+1,X
 7293 A:f61b  c8                                 iny 
 7294 A:f61c  84 d2                              sty AS_HGR_DY
 7295 A:f61e  a4 e5                              ldy AS_HGR_HORIZ                ; INDEX FROM GBASL,H TO BYTE WE'RE IN
 7296 A:f620  a2 00                              ldx #0
 7297 A:f622  86 ea                              stx AS_HGR_COLLISIONS                ; CLEAR COLLISION COUNTER
 7298 A:f624  a1 1a                              lda (AS_HGR_SHAPE,X)               ; GET FIRST BYTE OF SHAPE DEFN
 7299 A:f626  85 d1                    AS_L_DRAW1_1 sta AS_HGR_DX+1       ; KEEP SHAPE BYTE IN HGR.DX+1
 7300 A:f628  a2 80                              ldx #$80             ; INITIAL VALUES FOR FRACTIONAL VECTORS
 7301 A:f62a  86 d4                              stx AS_HGR_E                ; L_DRAW1_5 IN COSINE COMPONENT
 7302 A:f62c  86 d5                              stx AS_HGR_E+1          ; L_DRAW1_5 IN SINE COMPONENT
 7303 A:f62e  a6 e7                              ldx AS_HGR_SCALE                ; SCALE FACTOR
 7304 A:f630  a5 d4                    AS_L_DRAW1_2 lda AS_HGR_E             ; ADD COSINE VALUE TO X-VALUE
 7305 A:f632  38                                 sec                    ; IF >= 1, THEN DRAW
 7306 A:f633  65 d0                              adc AS_HGR_DX                ; 
 7307 A:f635  85 d4                              sta AS_HGR_E                ; ONLY SAVE FRACTIONAL PART
 7308 A:f637  90 04                              bcc AS_L_DRAW1_3                ; NO INTEGRAL PART
 7309 A:f639  20 b3 f4                           jsr AS_LRUD1                ; TIME TO PLOT COSINE COMPONENT
 7310 A:f63c  18                                 clc                    ; 
 7311 A:f63d  a5 d5                    AS_L_DRAW1_3 lda AS_HGR_E+1       ; ADD SINE VALUE TO Y-VALUE
 7312 A:f63f  65 d2                              adc AS_HGR_DY                ; IF >= 1, THEN DRAW
 7313 A:f641  85 d5                              sta AS_HGR_E+1          ; ONLY SAVE FRACTIONAL PART
 7314 A:f643  90 03                              bcc AS_L_DRAW1_4                ; NO INTEGRAL PART
 7315 A:f645  20 b4 f4                           jsr AS_LRUD2                ; TIME TO PLOT SINE COMPONENT
 7316 A:f648  ca                       AS_L_DRAW1_4 dex                 ; LOOP ON SCALE FACTOR.
 7317 A:f649  d0 e5                              bne AS_L_DRAW1_2                ; STILL ON SAME SHAPE ITEM
 7318 A:f64b  a5 d1                              lda AS_HGR_DX+1          ; GET NEXT SHAPE ITEM
 7319 A:f64d  4a                                 lsr                    ; NEXT 3 BIT VECTOR
 7320 A:f64e  4a                                 lsr                    ; 
 7321 A:f64f  4a                                 lsr                    ; 
 7322 A:f650  d0 d4                              bne AS_L_DRAW1_1                ; MORE IN THIS SHAPE BYTE
 7323 A:f652  e6 1a                              inc AS_HGR_SHAPE                ; GO TO NEXT SHAPE BYTE
 7324 A:f654  d0 02                              bne AS_L_DRAW1_5
 7325 A:f656  e6 1b                              inc AS_HGR_SHAPE+1
 7326 A:f658  a1 1a                    AS_L_DRAW1_5 lda (AS_HGR_SHAPE,X)               ; NEXT BYTE OF SHAPE DEFINITION
 7327 A:f65a  d0 ca                              bne AS_L_DRAW1_1                ; PROCESS IF NOT ZERO
 7328 A:f65c  60                                 rts                    ; FINISHED
 7329 A:f65d                                    ; --------------------------------
 7330 A:f65d                                    ; XDRAW A SHAPE (SAME AS DRAW, EXCEPT TOGGLES SCREEN)
 7331 A:f65d                                    ; 
 7332 A:f65d                                    ; (Y,X) = SHAPE STARTING ADDRESS
 7333 A:f65d                                    ; (A)   = ROTATION (0-3F)
 7334 A:f65d                                    ; --------------------------------
 7335 A:f65d                                    ; APPLESOFT DOES NOT CALL XDRAW0
 7336 A:f65d                                    ; --------------------------------
 7337 A:f65d  86 1a                    AS_XDRAW0 stx AS_HGR_SHAPE             ; SAVE SHAPE ADDRESS
 7338 A:f65f  84 1b                              sty AS_HGR_SHAPE+1
 7339 A:f661                                    ; --------------------------------
 7340 A:f661                                    ; APPLESOFT ENTERS HERE
 7341 A:f661                                    ; --------------------------------
 7342 A:f661  aa                       AS_XDRAW1 tax                 ; SAVE ROTATION (0-$3F)
 7343 A:f662  4a                                 lsr                    ; DIVIDE ROTATION BY 16 TO GET
 7344 A:f663  4a                                 lsr                    ; QUADRANT (0=UP, 1=RT, 2=DWN, 3=LFT)
 7345 A:f664  4a                                 lsr 
 7346 A:f665  4a                                 lsr 
 7347 A:f666  85 d3                              sta AS_HGR_QUADRANT
 7348 A:f668  8a                                 txa                    ; USE LOW 4 BITS OF ROTATION TO INDEX
 7349 A:f669  29 0f                              and #$0f             ; THE TRIG TABLE
 7350 A:f66b  aa                                 tax 
 7351 A:f66c  bc ba f5                           ldy AS_COSINE_TABLE,X              ; SAVE COSINE IN HGR.DX
 7352 A:f66f  84 d0                              sty AS_HGR_DX                ; 
 7353 A:f671  49 0f                              eor #$0f             ; AND SINE IN DY
 7354 A:f673  aa                                 tax 
 7355 A:f674  bc bb f5                           ldy AS_COSINE_TABLE+1,X
 7356 A:f677  c8                                 iny 
 7357 A:f678  84 d2                              sty AS_HGR_DY
 7358 A:f67a  a4 e5                              ldy AS_HGR_HORIZ                ; INDEX FROM GBASL,H TO BYTE WE'RE IN
 7359 A:f67c  a2 00                              ldx #0
 7360 A:f67e  86 ea                              stx AS_HGR_COLLISIONS                ; CLEAR COLLISION COUNTER
 7361 A:f680  a1 1a                              lda (AS_HGR_SHAPE,X)               ; GET FIRST BYTE OF SHAPE DEFN
 7362 A:f682  85 d1                    AS_L_XDRAW1_1 sta AS_HGR_DX+1       ; KEEP SHAPE BYTE IN HGR.DX+1
 7363 A:f684  a2 80                              ldx #$80             ; INITIAL VALUES FOR FRACTIONAL VECTORS
 7364 A:f686  86 d4                              stx AS_HGR_E                ; L_XDRAW1_5 IN COSINE COMPONENT
 7365 A:f688  86 d5                              stx AS_HGR_E+1          ; L_XDRAW1_5 IN SINE COMPONENT
 7366 A:f68a  a6 e7                              ldx AS_HGR_SCALE                ; SCALE FACTOR
 7367 A:f68c  a5 d4                    AS_L_XDRAW1_2 lda AS_HGR_E             ; ADD COSINE VALUE TO X-VALUE
 7368 A:f68e  38                                 sec                    ; IF >= 1, THEN DRAW
 7369 A:f68f  65 d0                              adc AS_HGR_DX                ; 
 7370 A:f691  85 d4                              sta AS_HGR_E                ; ONLY SAVE FRACTIONAL PART
 7371 A:f693  90 04                              bcc AS_L_XDRAW1_3                ; NO INTEGRAL PART
 7372 A:f695  20 9c f4                           jsr AS_LRUDX1                ; TIME TO PLOT COSINE COMPONENT
 7373 A:f698  18                                 clc                    ; 
 7374 A:f699  a5 d5                    AS_L_XDRAW1_3 lda AS_HGR_E+1       ; ADD SINE VALUE TO Y-VALUE
 7375 A:f69b  65 d2                              adc AS_HGR_DY                ; IF >= 1, THEN DRAW
 7376 A:f69d  85 d5                              sta AS_HGR_E+1          ; ONLY SAVE FRACTIONAL PART
 7377 A:f69f  90 03                              bcc AS_L_XDRAW1_4                ; NO INTEGRAL PART
 7378 A:f6a1  20 9d f4                           jsr AS_LRUDX2                ; TIME TO PLOT SINE COMPONENT
 7379 A:f6a4  ca                       AS_L_XDRAW1_4 dex                 ; LOOP ON SCALE FACTOR.
 7380 A:f6a5  d0 e5                              bne AS_L_XDRAW1_2                ; STILL ON SAME SHAPE ITEM
 7381 A:f6a7  a5 d1                              lda AS_HGR_DX+1          ; GET NEXT SHAPE ITEM
 7382 A:f6a9  4a                                 lsr                    ; NEXT 3 BIT VECTOR
 7383 A:f6aa  4a                                 lsr                    ; 
 7384 A:f6ab  4a                                 lsr                    ; 
 7385 A:f6ac  d0 d4                              bne AS_L_XDRAW1_1                ; MORE IN THIS SHAPE BYTE
 7386 A:f6ae  e6 1a                              inc AS_HGR_SHAPE                ; GO TO NEXT SHAPE BYTE
 7387 A:f6b0  d0 02                              bne AS_L_XDRAW1_5
 7388 A:f6b2  e6 1b                              inc AS_HGR_SHAPE+1
 7389 A:f6b4  a1 1a                    AS_L_XDRAW1_5 lda (AS_HGR_SHAPE,X)               ; NEXT BYTE OF SHAPE DEFINITION
 7390 A:f6b6  d0 ca                              bne AS_L_XDRAW1_1                ; PROCESS IF NOT ZERO
 7391 A:f6b8  60                                 rts                    ; FINISHED
