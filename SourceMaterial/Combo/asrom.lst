 4329 A:e566  a5 91                              lda AS_LENGTH                ; GET LENGTH OF VARIABLE ELEMENT
 4330 A:e568  29 04                              and #4             ; WAS 7 OR 3, MAKE 4 OR 0
 4331 A:e56a  4a                                 lsr                    ; 2 0R 0; IN SIMPLE VARIABLES,
 4332 A:e56b  a8                                 tay                    ; NAME PRECEDES DESCRIPTOR
 4333 A:e56c  85 91                              sta AS_LENGTH                ; 2 OR 0
 4334 A:e56e  b1 8a                              lda (AS_FNCNAM),Y                  ; GET LENGTH FROM DESCRIPTOR
 4335 A:e570  65 9b                              adc AS_LOWTR                ; CARRY ALREADY CLEARED BY LSR
 4336 A:e572  85 96                              sta AS_HIGHTR                ; STRING IS BTWN (LOWTR) AND (HIGHTR)
 4337 A:e574  a5 9c                              lda AS_LOWTR+1          ; 
 4338 A:e576  69 00                              adc #0             ; 
 4339 A:e578  85 97                              sta AS_HIGHTR+1          ; 
