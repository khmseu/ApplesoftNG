 1578 A:d5a3  d0 02                              bne AS_L_PARSE_6                ; Y=Y+1 IS ENOUGH
 1579 A:d5a5  e6 9e                              inc AS_FAC+1          ; ALSO NEED TO BUMP THE PAGE
 1580 A:d5a7  e8                       AS_L_PARSE_6 inx                 ; ADVANCE POINTER TO INPUT LINE
 1581 A:d5a8  bd 00 02                 AS_L_PARSE_7 lda AS_INPUT_BUFFER,X              ; NEXT CHAR FROM INPUT LINE
 1582 A:d5ab  c9 20                              cmp #(" "&%01111111)     ; THIS CHAR A BLANK?
 1583 A:d5ad  f0 f8                              beq AS_L_PARSE_6                ; YES, IGNORE ALL BLANKS
 1584 A:d5af  38                                 sec                    ; NO, COMPARE TO CHAR IN TABLE
 1585 A:d5b0  f1 9d                              sbc (AS_FAC),Y                     ; SAME AS NEXT CHAR OF TOKEN NAME?
 1586 A:d5b2  f0 ee                              beq AS_L_PARSE_5                ; YES, CONTINUE MATCHING
 1587 A:d5b4  c9 80                              cmp #$80             ; MAYBE; WAS IT SAME EXCEPT FOR BIT 7?
 1588 A:d5b6  d0 41                              bne AS_L_PARSE_14                ; NO, SKIP TO NEXT TOKEN
 1589 A:d5b8  05 0f                              ora AS_TKN_CNTR                ; YES, END OF TOKEN; GET TOKEN #
 1590 A:d5ba  c9 c5                              cmp #AS_TOKENDB               ; DID WE MATCH "AT"?
 1591 A:d5bc  d0 0d                              bne AS_L_PARSE_8                ; NO, SO NO AMBIGUITY
 1592 A:d5be  bd 01 02                           lda AS_INPUT_BUFFER+1,X            ; "AT" COULD BE "ATN" OR "A TO"
 1593 A:d5c1  c9 4e                              cmp #("N"&%01111111)     ; "ATN" HAS PRECEDENCE OVER "AT"
 1594 A:d5c3  f0 34                              beq AS_L_PARSE_14                ; IT IS "ATN", FIND IT THE HARD WAY
 1595 A:d5c5  c9 4f                              cmp #("O"&%01111111)     ; "TO" HAS PRECEDENCE OVER "AT"
 1596 A:d5c7  f0 30                              beq AS_L_PARSE_14                ; IT IS "A TO", FIN IT THE HARD WAY
 1597 A:d5c9  a9 c5                              lda #AS_TOKENDB               ; NOT "ATN" OR "A TO", SO USE "AT"
