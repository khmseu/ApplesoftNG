 4123 A:e437  95 00                              sta 0,X
 4124 A:e439  a5 9e                              lda AS_FAC+1
 4125 A:e43b  95 01                              sta 1,X
 4126 A:e43d  a5 9f                              lda AS_FAC+2
 4127 A:e43f  95 02                              sta 2,X
 4128 A:e441  a0 00                              ldy #0
 4129 A:e443  86 a0                              stx AS_FAC+3          ; ADDRESS OF TEMP DESCRIPTOR
 4130 A:e445  84 a1                              sty AS_FAC+4          ; IN Y,X AND FAC+3,4
 4131 A:e447  88                                 dey                    ; Y=$FF
 4132 A:e448  84 11                              sty AS_VALTYP                ; FLAG (FAC ) AS STRING
 4133 A:e44a  86 53                              stx AS_LASTPT                ; INDEX OF LAST POINTER
 4134 A:e44c  e8                                 inx                    ; UPDATE FOR NEXT TEMP ENTRY
 4135 A:e44d  e8                                 inx 
 4136 A:e44e  e8                                 inx 
