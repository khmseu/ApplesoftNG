 4056 A:e3dd                                    ; --------------------------------
 4057 A:e3dd  20 52 e4                 AS_STRSPA jsr AS_GETSPA             ; A HOLDS LENGTH
 4058 A:e3e0  86 9e                              stx AS_FAC+1          ; SAVE DESCRIPTOR IN FAC
 4059 A:e3e2  84 9f                              sty AS_FAC+2          ; ---FAC--- --FAC+1-- --FAC+2--
 4060 A:e3e4  85 9d                              sta AS_FAC                ; <LENGTH>  <ADDR-LO> <ADDR-HI>
 4061 A:e3e6  60                                 rts                    ; 
