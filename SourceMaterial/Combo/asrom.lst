 6832 A:f3d8                                    ; "HGR" AND "HGR2" STATEMENTS
 6833 A:f3d8                                    ; --------------------------------
 6834 A:f3d8  2c 55 c0                 AS_HGR2   bit AS_SW_HISCR             ; SELECT PAGE 2 ($4000-5FFF)
 6835 A:f3db  2c 52 c0                           bit AS_SW_MIXCLR                ; DEFAULT TO FULL SCREEN
 6836 A:f3de  a9 40                              lda #>$4000            ; SET STARTING PAGE FOR HIRES
 6837 A:f3e0  d0 08                              bne AS_SETHPG                ; ...ALWAYS
 6838 A:f3e2  a9 20                    AS_HGR    lda #>$2000         ; SET STARTING PAGE FOR HIRES
 6839 A:f3e4  2c 54 c0                           bit AS_SW_LOWSCR                ; SELECT PAGE 1 ($2000-3FFF)
 6840 A:f3e7  2c 53 c0                           bit AS_SW_MIXSET                ; DEFAULT TO MIXED SCREEN
 6841 A:f3ea  85 e6                    AS_SETHPG sta AS_HGR_PAGE             ; BASE PAGE OF HIRES BUFFER
 6842 A:f3ec  ad 57 c0                           lda AS_SW_HIRES                ; TURN ON HIRES
 6843 A:f3ef  ad 50 c0                           lda AS_SW_TXTCLR                ; TURN ON GRAPHICS
