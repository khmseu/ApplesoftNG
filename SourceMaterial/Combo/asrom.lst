 5953 A:ee8d                                    ; "SQR" FUNCTION
 5954 A:ee8d                                    ; 
 5955 A:ee8d                                    ; <<< UNFORTUNATELY, RATHER THAN A NEWTON-RAPHSON >>>
 5956 A:ee8d                                    ; <<< ITERATION, APPLESOFT USES EXPONENTIATION    >>>
 5957 A:ee8d                                    ; <<< SQR(X) = X^L_DECTBL_END_5                               >>>
 5958 A:ee8d                                    ; --------------------------------
 5959 A:ee8d  20 63 eb                 AS_SQR    jsr AS_COPY_FAC_TO_ARG_ROUNDED
 5960 A:ee90  a9 64                              lda #<AS_CON_HALF              ; SET UP POWER OF 0L_SQR_5
 5961 A:ee92  a0 ee                              ldy #>AS_CON_HALF
 5962 A:ee94  20 f9 ea                           jsr AS_LOAD_FAC_FROM_YA
 5963 A:ee97                                    ; --------------------------------
 5964 A:ee97                                    ; EXPONENTIATION OPERATION
 5965 A:ee97                                    ; 
 5966 A:ee97                                    ; ARG ^ FAC  =  EXP( LOG(ARG) * FAC )
 5967 A:ee97                                    ; --------------------------------
 5968 A:ee97  f0 70                    AS_FPWRT  beq AS_EXP             ; IF FAC=0, ARG^FAC=EXP(0)
 5969 A:ee99  a5 a5                              lda AS_ARG                ; IF ARG=0, ARG^FAC=0
 5970 A:ee9b  d0 03                              bne AS_L_FPWRT_1                ; NEITHER IS ZERO
 5971 A:ee9d  4c 50 e8                           jmp AS_STA_IN_FAC_SIGN_AND_EXP                ; SET FAC = 0
 5972 A:eea0  a2 8a                    AS_L_FPWRT_1 ldx #AS_TEMP3            ; SAVE FAC IN TEMP3
 5973 A:eea2  a0 00                              ldy #0
 5974 A:eea4  20 2b eb                           jsr AS_STORE_FACDB_YX_ROUNDED
 5975 A:eea7  a5 aa                              lda AS_ARG_SIGN                ; NORMALLY, ARG MUST BE POSITIVE
 5976 A:eea9  10 0f                              bpl AS_L_FPWRT_2                ; IT IS POSITIVE, SO ALL IS WELL
 5977 A:eeab  20 23 ec                           jsr AS_INT                ; NEGATIVE, BUT OK IF INTEGRAL POWER
 5978 A:eeae  a9 8a                              lda #AS_TEMP3               ; SEE IF INT(FAC)=FAC
 5979 A:eeb0  a0 00                              ldy #0             ; 
 5980 A:eeb2  20 b2 eb                           jsr AS_FCOMP                ; IS IT AN INTEGER POWER?
 5981 A:eeb5  d0 03                              bne AS_L_FPWRT_2                ; NOT INTEGRAL,  WILL CAUSE ERROR LATER
 5982 A:eeb7  98                                 tya                    ; MAKE ARG SIGN + AS IT IS MOVED TO FAC
 5983 A:eeb8  a4 0d                              ldy AS_CHARAC                ; INTEGRAL, SO ALLOW NEGATIVE ARG
 5984 A:eeba  20 55 eb                 AS_L_FPWRT_2 jsr AS_MFA             ; MOVE ARGUMENT TO FAC
 5985 A:eebd  98                                 tya                    ; SAVE FLAG FOR NEGATIVE ARG (0=+)
 5986 A:eebe  48                                 pha                    ; 
 5987 A:eebf  20 41 e9                           jsr AS_LOG                ; GET LOG(ARG)
 5988 A:eec2  a9 8a                              lda #AS_TEMP3               ; MULTIPLY BY POWER
 5989 A:eec4  a0 00                              ldy #0             ; 
 5990 A:eec6  20 7f e9                           jsr AS_FMULT                ; 
 5991 A:eec9  20 09 ef                           jsr AS_EXP                ; E ^ LOG(FAC)
 5992 A:eecc  68                                 pla                    ; GET FLAG FOR NEGATIVE ARG
 5993 A:eecd  4a                                 lsr                    ; <<<LSR,BCC COULD BE MERELY BPL>>>
 5994 A:eece  90 0a                              bcc AS_RTS_18                ; NOT NEGATIVE, FINISHED
 5995 A:eed0                                    ; NEGATIVE ARG, SO NEGATE RESULT
 5996 A:eed0                                    ; --------------------------------
 5997 A:eed0                                    ; NEGATE VALUE IN FAC
 5998 A:eed0                                    ; --------------------------------
 5999 A:eed0  a5 9d                    AS_NEGOP  lda AS_FAC             ; IF FAC=0, NO NEED TO COMPLEMENT
 6000 A:eed2  f0 06                              beq AS_RTS_18                ; YES, FAC=0
 6001 A:eed4  a5 a2                              lda AS_FAC_SIGN                ; NO, SO TOGGLE SIGN
 6002 A:eed6  49 ff                              eor #$ff
 6003 A:eed8  85 a2                              sta AS_FAC_SIGN
 6004 A:eeda  60                       AS_RTS_18 rts 
