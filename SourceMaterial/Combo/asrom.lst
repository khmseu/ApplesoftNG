 1564 A:d590                                    ; SEARCH TOKEN NAME TABLE FOR MATCH STARTING
 1565 A:d590                                    ; WITH CURRENT CHAR FROM INPUT LINE
 1566 A:d590                                    ; --------------------------------
 1567 A:d590  84 ad                    AS_L_PARSE_4 sty AS_STRNG2             ; SAVE INDEX TO OUTPUT LINE
 1568 A:d592  a9 d0                              lda #<(AS_TOKEN_NAME_TABLE-$0100)
 1569 A:d594  85 9d                              sta AS_FAC                ; MAKE PNTR FOR SEARCH
 1570 A:d596  a9 cf                              lda #>(AS_TOKEN_NAME_TABLE-$0100)
 1571 A:d598  85 9e                              sta AS_FAC+1
 1572 A:d59a  a0 00                              ldy #0             ; USE Y-REG WITH (FAC) TO ADDRESS TABLE
 1573 A:d59c  84 0f                              sty AS_TKN_CNTR                ; HOLDS CURRENT TOKEN-$80
 1574 A:d59e  88                                 dey                    ; PREPARE FOR "INY" A FEW LINES DOWN
 1575 A:d59f  86 b8                              stx AS_TXTPTR                ; SAVE POSITION IN INPUT LINE
 1576 A:d5a1  ca                                 dex                    ; PREPARE FOR "INX" A FEW LINES DOWN
