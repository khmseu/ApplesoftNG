 5521 A:ebf2                                    ; QUICK INTEGER FUNCTION
 5522 A:ebf2                                    ; 
 5523 A:ebf2                                    ; CONVERTS FP VALUE IN FAC TO INTEGER VALUE
 5524 A:ebf2                                    ; IN FAC+1...FAC+4, BY SHIFTING RIGHT WITH SIGN
 5525 A:ebf2                                    ; EXTENSION UNTIL FRACTIONAL BITS ARE OUT.
 5526 A:ebf2                                    ; 
 5527 A:ebf2                                    ; THIS SUBROUTINE ASSUMES THE EXPONENT < 32.
 5528 A:ebf2                                    ; --------------------------------
 5529 A:ebf2  a5 9d                    AS_QINT   lda AS_FAC             ; LOOK AT FAC EXPONENT
 5530 A:ebf4  f0 4a                              beq AS_QINT_3                ; FAC=0, SO FINISHED
 5531 A:ebf6  38                                 sec                    ; GET -(NUMBER OF FRACTIONAL BITS)
 5532 A:ebf7  e9 a0                              sbc #$a0             ; IN A-REG FOR SHIFT COUNT
 5533 A:ebf9  24 a2                              bit AS_FAC_SIGN                ; CHECK SIGN OF FAC
 5534 A:ebfb  10 09                              bpl AS_L_QINT_1                ; POSITIVE, CONTINUE
 5535 A:ebfd  aa                                 tax                    ; NEGATIVE, SO COMPLEMENT MANTISSA
 5536 A:ebfe  a9 ff                              lda #$ff             ; AND SET SIGN EXTENSION FOR SHIFT
 5537 A:ec00  85 a4                              sta AS_SHIFT_SIGN_EXT
 5538 A:ec02  20 a4 e8                           jsr AS_COMPLEMENT_FAC_MANTISSA
 5539 A:ec05  8a                                 txa                    ; RESTORE BIT COUNT TO A-REG
 5540 A:ec06  a2 9d                    AS_L_QINT_1 ldx #AS_FAC            ; POINT SHIFT SUBROUTINE AT FAC
 5541 A:ec08  c9 f9                              cmp #$f9             ; MORE THAN 7 BITS TO SHIFT?
 5542 A:ec0a  10 06                              bpl AS_QINT_2                ; NO, SHORT SHIFT
 5543 A:ec0c  20 f0 e8                           jsr AS_SHIFT_RIGHT                ; YES, USE GENERAL ROUTINE
 5544 A:ec0f  84 a4                              sty AS_SHIFT_SIGN_EXT                ; Y=0, CLEAR SIGN EXTENSION
 5545 A:ec11  60                       AS_RTS_16 rts 
 5546 A:ec12                                    ; --------------------------------
 5547 A:ec12  a8                       AS_QINT_2 tay                 ; SAVE SHIFT COUNT
 5548 A:ec13  a5 a2                              lda AS_FAC_SIGN                ; GET SIGN BIT
 5549 A:ec15  29 80                              and #$80             ; 
 5550 A:ec17  46 9e                              lsr AS_FAC+1          ; START RIGHT SHIFT
 5551 A:ec19  05 9e                              ora AS_FAC+1          ; AND MERGE WITH SIGN
 5552 A:ec1b  85 9e                              sta AS_FAC+1
 5553 A:ec1d  20 07 e9                           jsr AS_SHIFT_RIGHT_4                ; JUMP INTO MIDDLE OF SHIFTER
 5554 A:ec20  84 a4                              sty AS_SHIFT_SIGN_EXT                ; Y=0, CLEAR SIGN EXTENSION
 5555 A:ec22  60                                 rts 
