 6832 T:23d8                                    ; "HGR" AND "HGR2" STATEMENTS
 6833 T:23d8                                    ; --------------------------------
 6834 T:23d8  2c 55 c0                 HGR2      bit SW_HISCR             ; SELECT PAGE 2 ($4000-5FFF)
 6835 T:23db  2c 52 c0                           bit SW_MIXCLR                ; DEFAULT TO FULL SCREEN
 6836 T:23de  a9 40                              lda #>$4000            ; SET STARTING PAGE FOR HIRES
 6837 T:23e0  d0 08                              bne SETHPG                ; ...ALWAYS
 6838 T:23e2  a9 20                    HGR       lda #>$2000         ; SET STARTING PAGE FOR HIRES
 6839 T:23e4  2c 54 c0                           bit SW_LOWSCR                ; SELECT PAGE 1 ($2000-3FFF)
 6840 T:23e7  2c 53 c0                           bit SW_MIXSET                ; DEFAULT TO MIXED SCREEN
 6841 T:23ea  85 e6                    SETHPG    sta HGR_PAGE             ; BASE PAGE OF HIRES BUFFER
 6842 T:23ec  ad 57 c0                           lda SW_HIRES                ; TURN ON HIRES
 6843 T:23ef  ad 50 c0                           lda SW_TXTCLR                ; TURN ON GRAPHICS
