 6803 T:23a2  a0 03                              ldy #3             ; FORWARD OFFSET - 1 IS SIZE OF
 6804 T:23a4  b1 9b                              lda (LOWTR),Y                   ; THIS ARRAY
 6805 T:23a6  aa                                 tax 
