 5953 T:1e8d                                    ; "SQR" FUNCTION
 5954 T:1e8d                                    ; 
 5955 T:1e8d                                    ; <<< UNFORTUNATELY, RATHER THAN A NEWTON-RAPHSON >>>
 5956 T:1e8d                                    ; <<< ITERATION, APPLESOFT USES EXPONENTIATION    >>>
 5957 T:1e8d                                    ; <<< SQR(X) = X^L_DECTBL_END_5                               >>>
 5958 T:1e8d                                    ; --------------------------------
 5959 T:1e8d  20 63 1b                 SQR       jsr COPY_FAC_TO_ARG_ROUNDED
 5960 T:1e90  a9 64                              lda #<CON_HALF           ; SET UP POWER OF 0L_SQR_5
 5961 T:1e92  a0 1e                              ldy #>CON_HALF
 5962 T:1e94  20 f9 1a                           jsr LOAD_FAC_FROM_YA
 5963 T:1e97                                    ; --------------------------------
 5964 T:1e97                                    ; EXPONENTIATION OPERATION
 5965 T:1e97                                    ; 
 5966 T:1e97                                    ; ARG ^ FAC  =  EXP( LOG(ARG) * FAC )
 5967 T:1e97                                    ; --------------------------------
 5968 T:1e97  f0 70                    FPWRT     beq EXP             ; IF FAC=0, ARG^FAC=EXP(0)
 5969 T:1e99  a5 a5                              lda ARG                ; IF ARG=0, ARG^FAC=0
 5970 T:1e9b  d0 03                              bne L_FPWRT_1                ; NEITHER IS ZERO
 5971 T:1e9d  4c 50 18                           jmp STA_IN_FAC_SIGN_AND_EXP             ; SET FAC = 0
 5972 T:1ea0  a2 8a                    L_FPWRT_1 ldx #TEMP3            ; SAVE FAC IN TEMP3
 5973 T:1ea2  a0 00                              ldy #0
 5974 T:1ea4  20 2b 1b                           jsr STORE_FACDB_YX_ROUNDED
 5975 T:1ea7  a5 aa                              lda ARG_SIGN                ; NORMALLY, ARG MUST BE POSITIVE
 5976 T:1ea9  10 0f                              bpl L_FPWRT_2                ; IT IS POSITIVE, SO ALL IS WELL
 5977 T:1eab  20 23 1c                           jsr INT             ; NEGATIVE, BUT OK IF INTEGRAL POWER
 5978 T:1eae  a9 8a                              lda #TEMP3               ; SEE IF INT(FAC)=FAC
 5979 T:1eb0  a0 00                              ldy #0             ; 
 5980 T:1eb2  20 b2 1b                           jsr FCOMP             ; IS IT AN INTEGER POWER?
 5981 T:1eb5  d0 03                              bne L_FPWRT_2                ; NOT INTEGRAL,  WILL CAUSE ERROR LATER
 5982 T:1eb7  98                                 tya                    ; MAKE ARG SIGN + AS IT IS MOVED TO FAC
 5983 T:1eb8  a4 0d                              ldy CHARAC                ; INTEGRAL, SO ALLOW NEGATIVE ARG
 5984 T:1eba  20 55 1b                 L_FPWRT_2 jsr MFA          ; MOVE ARGUMENT TO FAC
 5985 T:1ebd  98                                 tya                    ; SAVE FLAG FOR NEGATIVE ARG (0=+)
 5986 T:1ebe  48                                 pha                    ; 
 5987 T:1ebf  20 41 19                           jsr LOG             ; GET LOG(ARG)
 5988 T:1ec2  a9 8a                              lda #TEMP3               ; MULTIPLY BY POWER
 5989 T:1ec4  a0 00                              ldy #0             ; 
 5990 T:1ec6  20 7f 19                           jsr FMULT             ; 
 5991 T:1ec9  20 09 1f                           jsr EXP                ; E ^ LOG(FAC)
 5992 T:1ecc  68                                 pla                    ; GET FLAG FOR NEGATIVE ARG
 5993 T:1ecd  4a                                 lsr                    ; <<<LSR,BCC COULD BE MERELY BPL>>>
 5994 T:1ece  90 0a                              bcc RTS_18                ; NOT NEGATIVE, FINISHED
 5995 T:1ed0                                    ; NEGATIVE ARG, SO NEGATE RESULT
 5996 T:1ed0                                    ; --------------------------------
 5997 T:1ed0                                    ; NEGATE VALUE IN FAC
 5998 T:1ed0                                    ; --------------------------------
 5999 T:1ed0  a5 9d                    NEGOP     lda FAC             ; IF FAC=0, NO NEED TO COMPLEMENT
 6000 T:1ed2  f0 06                              beq RTS_18                ; YES, FAC=0
 6001 T:1ed4  a5 a2                              lda FAC_SIGN                ; NO, SO TOGGLE SIGN
 6002 T:1ed6  49 ff                              eor #$ff
 6003 T:1ed8  85 a2                              sta FAC_SIGN
 6004 T:1eda  60                       RTS_18    rts 
