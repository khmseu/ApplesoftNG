 7326 T:2658  a1 1a                    L_DRAW1_5 lda (HGR_SHAPE,X)               ; NEXT BYTE OF SHAPE DEFINITION
 7327 T:265a  d0 ca                              bne L_DRAW1_1             ; PROCESS IF NOT ZERO
 7328 T:265c  60                                 rts                    ; FINISHED
