 6224 T:203a                                    ; "TAN" FUNCTION
 6225 T:203a                                    ; 
 6226 T:203a                                    ; COMPUTE TAN(X) = SIN(X) / COS(X)
 6227 T:203a                                    ; --------------------------------
 6228 T:203a  20 21 1b                 TAN       jsr STORE_FAC_IN_TEMP1_ROUNDED
 6229 T:203d  a9 00                              lda #0             ; SIGNFLG WILL BE TOGGLED IF 2ND OR 3RD
 6230 T:203f  85 16                              sta SIGNFLG                ; QUADRANT
 6231 T:2041  20 f1 1f                           jsr SIN             ; GET SIN(X)
 6232 T:2044  a2 8a                              ldx #<TEMP3              ; SAVE SIN(X) IN TEMP3
 6233 T:2046  a0 00                              ldy #>TEMP3              ; 
 6234 T:2048  20 e7 1f                           jsr GO_MOVMF             ; <<<FUNNY WAY TO CALL MOVMF! >>>
 6235 T:204b  a9 93                              lda #<TEMP1              ; RETRIEVE X
 6236 T:204d  a0 00                              ldy #>TEMP1              ; 
 6237 T:204f  20 f9 1a                           jsr LOAD_FAC_FROM_YA
 6238 T:2052  a9 00                              lda #0             ; AND COMPUTE COS(X)
 6239 T:2054  85 a2                              sta FAC_SIGN                ; 
 6240 T:2056  a5 16                              lda SIGNFLG                ; 
 6241 T:2058  20 62 20                           jsr TAN_1                ; WEIRD & DANGEROUS WAY TO GET INTO SIN
 6242 T:205b  a9 8a                              lda #<TEMP3              ; NOW FORM SIN/COS
 6243 T:205d  a0 00                              ldy #>TEMP3              ; 
 6244 T:205f  4c 66 1a                           jmp FDIV             ; 
