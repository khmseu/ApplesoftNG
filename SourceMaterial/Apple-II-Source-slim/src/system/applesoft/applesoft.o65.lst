 3692 T:11d4  ca                                 dex                    ; INTEGER ARRAY, DECR. SIZE TO 4-BYTES
 3693 T:11d5  c8                       L_MAKE_NEW_ARRAY_2 iny                 ; POINT Y-REG AT NEXT CHAR OF NAME
 3694 T:11d6  a5 82                              lda VARNAM+1          ; REST OF ARRAY NAME
 3695 T:11d8  91 9b                              sta (LOWTR),Y                   ; 
 3696 T:11da  10 02                              bpl L_MAKE_NEW_ARRAY_3                ; REAL ARRAY, STICK WITH SIZE = 5 BYTES
 3697 T:11dc  ca                                 dex                    ; INTEGER OR STRING ARRAY, ADJUST SIZE
 3698 T:11dd  ca                                 dex                    ; TO INTEGER=3, STRING=2 BYTES
 3699 T:11de  86 ad                    L_MAKE_NEW_ARRAY_3 stx STRNG2             ; STORE LOW-BYTE OF ARRAY ELEMENT SIZE
 3700 T:11e0  a5 0f                              lda NUMDIM                ; STORE NUMBER OF DIMENSIONS
 3701 T:11e2  c8                                 iny                    ; IN 5TH BYTE OF ARRAY
 3702 T:11e3  c8                                 iny                    ; 
 3703 T:11e4  c8                                 iny                    ; 
 3704 T:11e5  91 9b                              sta (LOWTR),Y                   ; 
