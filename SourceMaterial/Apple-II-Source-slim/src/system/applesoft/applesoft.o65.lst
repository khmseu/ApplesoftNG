 2895 T:0d8e  20 60 0e                           jsr FRM_ELEMENT                ; GET AN ELEMENT
 2896 T:0d91  a9 00                              lda #0
 2897 T:0d93  85 89                              sta CPRTYP                ; CLEAR COMPARISON OPERATOR FLAGS
 2898 T:0d95                                    ; --------------------------------
 2899 T:0d95                           FRMEVL_2  
 2900 T:0d95  20 b7 00                           jsr CHRGOT                ; CHECK FOR RELATIONAL OPERATORS
 2901 T:0d98  38                       L_FRMEVL_2_1 sec                 ; > IS $CF, = IS $D0, < IS $D1
 2902 T:0d99  e9 cf                              sbc #TOKEN_GREATER               ; > IS 0, = IS 1, < IS 2
 2903 T:0d9b  90 17                              bcc L_FRMEVL_2_2                ; NOT RELATIONAL OPERATOR
 2904 T:0d9d  c9 03                              cmp #3             ; 
 2905 T:0d9f  b0 13                              bcs L_FRMEVL_2_2                ; NOT RELATIONAL OPERATOR
 2906 T:0da1  c9 01                              cmp #1             ; SET CARRY IF "=" OR "<"
 2907 T:0da3  2a                                 rol                    ; NOW > IS 0, = IS 3, < IS 5
 2908 T:0da4  49 01                              eor #1             ; NOW > IS 1, = IS 2, < IS 4
 2909 T:0da6  45 89                              eor CPRTYP                ; SET BITS OF CPRTYP:  00000<=>
 2910 T:0da8  c5 89                              cmp CPRTYP                ; CHECK FOR ILLEGAL COMBINATIONS
 2911 T:0daa  90 61                              bcc SNTXERR                ; IF LESS THAN, A RELOP WAS REPEATED
 2912 T:0dac  85 89                              sta CPRTYP                ; 
 2913 T:0dae  20 b1 00                           jsr CHRGET                ; ANOTHER OPERATOR?
 2914 T:0db1  4c 98 0d                           jmp L_FRMEVL_2_1             ; CHECK FOR <,=,> AGAIN
 2915 T:0db4                                    ; --------------------------------
 2916 T:0db4  a6 89                    L_FRMEVL_2_2 ldx CPRTYP             ; DID WE FIND A RELATIONAL OPERATOR?
 2917 T:0db6  d0 2c                              bne FRM_RELATIONAL                ; YES
 2918 T:0db8  b0 7b                              bcs NOTMATH                ; NO, AND NEXT TOKEN IS > $D1
 2919 T:0dba  69 07                              adc #$cf-TOKEN_PLUS         ; NO, AND NEXT TOKEN < $CF
 2920 T:0dbc  90 77                              bcc NOTMATH                ; IF NEXT TOKEN < "+"
 2921 T:0dbe  65 11                              adc VALTYP                ; + AND LAST RESULT A STRING?
 2922 T:0dc0  d0 03                              bne L_FRMEVL_2_3                ; BRANCH IF NOT
 2923 T:0dc2  4c 97 15                           jmp CAT                ; CONCATENATE IF SO.
 2924 T:0dc5                                    ; --------------------------------
 2925 T:0dc5  69 ff                    L_FRMEVL_2_3 adc #$ff          ; +-*/ IS 0123
 2926 T:0dc7  85 5e                              sta INDEX
