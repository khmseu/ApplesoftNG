 1471 T:04f2                           FIX_LINKS 
 1472 T:04f2  20 65 06                           jsr SETPTRS                ; CLEAR ALL VARIABLES
 1473 T:04f5  a5 67                              lda TXTTAB                ; POINT INDEX AT START OF PROGRAM
 1474 T:04f7  a4 68                              ldy TXTTAB+1
 1475 T:04f9  85 5e                              sta INDEX
