 3420 T:107d                                    ; CHECK IF (A) IS ASCII LETTER A-Z
 3421 T:107d                                    ; 
 3422 T:107d                                    ; RETURN CARRY = 1 IF A-Z
 3423 T:107d                                    ; = 0 IF NOT
 3424 T:107d                                    ; 
 3425 T:107d                                    ; <<<NOTE FASTER AND SHORTER CODE:    >>>
 3426 T:107d                                    ; <<<    CMP #LOCHAR(`Z')+1  COMPARE HI END
 3427 T:107d                                    ; <<<    BCS L_PTRGET4_1      ABOVE A-Z
 3428 T:107d                                    ; <<<    CMP #LOCHAR(`A')    COMPARE LO END
 3429 T:107d                                    ; <<<    RTS         C=0 IF LO, C=1 IF A-Z
 3430 T:107d                                    ; <<<L_PTRGET4_1  CLC         C=0 IF HI
 3431 T:107d                                    ; <<<    RTS
 3432 T:107d                                    ; --------------------------------
 3433 T:107d  c9 41                    ISLETC    cmp #("A"&%01111111)  ; COMPARE LO END
 3434 T:107f  90 05                              bcc L_ISLETC_1                ; C=0 IF LOW
 3435 T:1081  e9 5b                              sbc #("Z"&%01111111)+1; PREPARE HI END TEST
