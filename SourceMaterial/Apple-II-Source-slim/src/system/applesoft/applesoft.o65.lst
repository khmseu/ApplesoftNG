 6845 T:23f2                                    ; CLEAR SCREEN
 6846 T:23f2                                    ; --------------------------------
 6847 T:23f2  a9 00                    HCLR      lda #0          ; SET FOR BLACK BACKGROUND
 6848 T:23f4  85 1c                              sta HGR_BITS
