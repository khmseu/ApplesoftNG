 6688 T:22e9                                    ; ROUTINE TO HANDLE ERRORS IF ONERR GOTO ACTIVE
 6689 T:22e9                                    ; --------------------------------
 6690 T:22e9                           HANDLERR                   ; 
 6691 T:22e9  86 de                              stx ERRNUM                ; SAVE ERROR CODE NUMBER
 6692 T:22eb  a6 f8                              ldx REMSTK                ; GET STACK PNTR SAVED AT NEWSTT
 6693 T:22ed  86 df                              stx ERRSTK                ; REMEMBER IT
 6694 T:22ef                                    ; <<<COULD ALSO HAVE DONE TXS  >>>
 6695 T:22ef                                    ; <<<HERE; SEE ONERR CORRECTION>>>
 6696 T:22ef                                    ; <<<IN APPLESOFT MANUAL.      >>>
 6697 T:22ef  a5 75                              lda CURLIN                ; GET LINE # OF OFFENDING STATEMENT
 6698 T:22f1  85 da                              sta ERRLIN                ; SO USER CAN SEE IT IF DESIRED
 6699 T:22f3  a5 76                              lda CURLIN+1          ; 
 6700 T:22f5  85 db                              sta ERRLIN+1          ; 
 6701 T:22f7  a5 79                              lda OLDTEXT                ; ALSO THE POSITION IN THE LINE
 6702 T:22f9  85 dc                              sta ERRPOS                ; IN CASE USER WANTS TO "RESUME"
 6703 T:22fb  a5 7a                              lda OLDTEXT+1          ; 
 6704 T:22fd  85 dd                              sta ERRPOS+1          ; 
 6705 T:22ff  a5 f4                              lda TXTPSV                ; SET UP TXTPTR TO READ TARGET LINE #
