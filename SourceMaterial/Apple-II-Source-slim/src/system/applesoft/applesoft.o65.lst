 2943 T:0de2  d0 5f                              bne FRM_PERFORM_2                ; ...ALWAYS
 2944 T:0de4                                    ; --------------------------------
 2945 T:0de4                                    ; FOUND ONE OR MORE RELATIONAL OPERATORS <,=,>
 2946 T:0de4                                    ; --------------------------------
 2947 T:0de4                           FRM_RELATIONAL 
 2948 T:0de4  46 11                              lsr VALTYP                ; (VALTYP) = 0 (NUMERIC), = $FF (STRING)
 2949 T:0de6  8a                                 txa                    ; SET CPRTYP TO 0000<=>C
 2950 T:0de7  2a                                 rol                    ; WHERE C=0 IF #, C=1 IF STRING
 2951 T:0de8  a6 b8                              ldx TXTPTR                ; BACK UP TXTPTR
 2952 T:0dea  d0 02                              bne L_FRM_RELATIONAL_1
 2953 T:0dec  c6 b9                              dec TXTPTR+1
 2954 T:0dee  c6 b8                    L_FRM_RELATIONAL_1 dec TXTPTR
