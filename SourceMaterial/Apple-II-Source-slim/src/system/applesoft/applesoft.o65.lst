 6167 T:1fea                                    ; "COS" FUNCTION
 6168 T:1fea                                    ; --------------------------------
 6169 T:1fea  a9 66                    COS       lda #<CON_PI_HALF           ; COS(X)=SIN(X + PI/2)
 6170 T:1fec  a0 20                              ldy #>CON_PI_HALF
 6171 T:1fee  20 be 17                           jsr FADD
 6172 T:1ff1                                    ; --------------------------------
 6173 T:1ff1                                    ; "SIN" FUNCTION
 6174 T:1ff1                                    ; --------------------------------
 6175 T:1ff1  20 63 1b                 SIN       jsr COPY_FAC_TO_ARG_ROUNDED
 6176 T:1ff4  a9 6b                              lda #<CON_PI_DOUB              ; REMOVE MULTIPLES OF 2*PI
 6177 T:1ff6  a0 20                              ldy #>CON_PI_DOUB              ; BY DIVIDING AND SAVING
 6178 T:1ff8  a6 aa                              ldx ARG_SIGN                ; THE FRACTIONAL PART
 6179 T:1ffa  20 5e 1a                           jsr DIV             ; USE SIGN OF ARGUMENT
 6180 T:1ffd  20 63 1b                           jsr COPY_FAC_TO_ARG_ROUNDED
 6181 T:2000  20 23 1c                           jsr INT             ; TAKE INTEGER PART
 6182 T:2003  a9 00                              lda #0             ; <<< WASTED LINES, BECAUSE FSUBT >>>
 6183 T:2005  85 ab                              sta SGNCPR                ; <<< CHANGES SGNCPR AGAIN        >>>
 6184 T:2007  20 aa 17                           jsr FSUBT             ; SUBTRACT TO GET FRACTIONAL PART
 6185 T:200a                                    ; --------------------------------
 6186 T:200a                                    ; (FAC) = ANGLE AS A FRACTION OF A FULL CIRCLE
 6187 T:200a                                    ; 
 6188 T:200a                                    ; NOW FOLD THE RANGE INTO A QUARTER CIRCLE
 6189 T:200a                                    ; 
 6190 T:200a                                    ; <<< THERE ARE MUCH SIMPLER WAYS TO DO THIS >>>
 6191 T:200a                                    ; --------------------------------
 6192 T:200a  a9 70                              lda #<QUARTER              ; 1/4 - FRACTION MAKES
 6193 T:200c  a0 20                              ldy #>QUARTER              ; -3/4 <= FRACTION < 1/4
 6194 T:200e  20 a7 17                           jsr FSUB             ; 
 6195 T:2011  a5 a2                              lda FAC_SIGN                ; TEST SIGN OF RESULT
 6196 T:2013  48                                 pha                    ; SAVE SIGN FOR LATER UNFOLDING
 6197 T:2014  10 0d                              bpl SIN_1                ; ALREADY 0...1/4
 6198 T:2016  20 a0 17                           jsr FADDH             ; ADD 1/2 TO SHIFT TO -1/4...1/2
 6199 T:2019  a5 a2                              lda FAC_SIGN                ; TEST SIGN
 6200 T:201b  30 09                              bmi SIN_2                ; -1/4...0
 6201 T:201d                                    ; 0...1/2
 6202 T:201d  a5 16                              lda SIGNFLG                ; SIGNFLG INITIALIZED = 0 IN "TAN"
 6203 T:201f  49 ff                              eor #$ff             ; FUNCTION
 6204 T:2021  85 16                              sta SIGNFLG                ; "TAN" IS ONLY USER OF SIGNFLG TOO
 6205 T:2023                                    ; --------------------------------
 6206 T:2023                                    ; IF FALL THRU, RANGE IS 0...1/2
 6207 T:2023                                    ; IF BRANCH HERE, RANGE IS 0...1/4
 6208 T:2023                                    ; --------------------------------
 6209 T:2023  20 d0 1e                 SIN_1     jsr NEGOP
 6210 T:2026                                    ; --------------------------------
 6211 T:2026                                    ; IF FALL THRU, RANGE IS -1/2...0
 6212 T:2026                                    ; IF BRANCH HERE, RANGE IS -1/4...0
 6213 T:2026                                    ; --------------------------------
 6214 T:2026  a9 70                    SIN_2     lda #<QUARTER           ; ADD 1/4 TO SHIFT RANGE
 6215 T:2028  a0 20                              ldy #>QUARTER              ; TO -1/4...1/4
 6216 T:202a  20 be 17                           jsr FADD             ; 
 6217 T:202d  68                                 pla                    ; GET SAVED SIGN FROM ABOVE
 6218 T:202e  10 03                              bpl L_SIN_2_1                ; 
 6219 T:2030  20 d0 1e                           jsr NEGOP             ; MAKE RANGE 0...1/4
 6220 T:2033  a9 75                    L_SIN_2_1 lda #<POLY_SIN           ; DO STANDARD SIN SERIES
 6221 T:2035  a0 20                              ldy #>POLY_SIN              ; 
 6222 T:2037  4c 5c 1f                           jmp POLYNOMIAL_ODD             ; 
