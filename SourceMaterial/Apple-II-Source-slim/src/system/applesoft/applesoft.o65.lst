 7413 T:26d6  20 f8 16                           jsr GETBYT             ; EVAL EXP TO SINGLE BYTE IN X-REG
 7414 T:26d9  e0 c0                              cpx #192             ; CHECK FOR RANGE
 7415 T:26db  b0 09                              bcs GGERR                ; TOO BIG
 7416 T:26dd  86 9d                              stx FAC                ; SAVE Y-COORD
 7417 T:26df  68                                 pla                    ; RETRIEVE HORIZONTAL COORDINATE
 7418 T:26e0  a8                                 tay                    ; 
 7419 T:26e1  68                                 pla                    ; 
 7420 T:26e2  aa                                 tax                    ; 
