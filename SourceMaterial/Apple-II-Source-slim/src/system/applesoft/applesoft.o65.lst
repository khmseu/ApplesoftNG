 3762 T:1244  91 9b                              sta (LOWTR),Y                   ; 
 3763 T:1246  a5 10                              lda DIMFLG                ; WAS THIS CALLED FROM "DIM" STATEMENT?
 3764 T:1248  d0 62                              bne RTS_9                ; YES, WE ARE FINISHED
 3765 T:124a  c8                                 iny                    ; NO, NOW NEED TO FIND THE ELEMENT
 3766 T:124b                                    ; --------------------------------
 3767 T:124b                                    ; FIND SPECIFIED ARRAY ELEMENT
 3768 T:124b                                    ; 
 3769 T:124b                                    ; (LOWTR),Y POINTS AT # OF DIMS IN ARRAY DESCRIPTOR
 3770 T:124b                                    ; THE SUBSCRIPTS ARE ALL ON THE STACK AS INTEGERS
 3771 T:124b                                    ; --------------------------------
 3772 T:124b                           FIND_ARRAY_ELEMENT 
 3773 T:124b  b1 9b                              lda (LOWTR),Y                   ; GET # OF DIMENSIONS
 3774 T:124d  85 0f                              sta NUMDIM                ; 
 3775 T:124f  a9 00                              lda #0             ; ZERO SUBSCRIPT ACCUMULATOR
 3776 T:1251  85 ad                              sta STRNG2                ; 
 3777 T:1253  85 ae                    FAE_1     sta STRNG2+1       ; 
 3778 T:1255  c8                                 iny                    ; 
 3779 T:1256  68                                 pla                    ; PULL NEXT SUBSCRIPT FROM STACK
 3780 T:1257  aa                                 tax                    ; SAVE IN FAC+3,4
 3781 T:1258  85 a0                              sta FAC+3          ; AND COMPARE WITH DIMENSIONED SIZE
 3782 T:125a  68                                 pla                    ; 
 3783 T:125b  85 a1                              sta FAC+4          ; 
 3784 T:125d  d1 9b                              cmp (LOWTR),Y                   ; 
 3785 T:125f  90 0e                              bcc FAE_2                ; SUBSCRIPT NOT TOO LARGE
 3786 T:1261  d0 06                              bne GSE                ; SUBSCRIPT IS TOO LARGE
 3787 T:1263  c8                                 iny                    ; CHECK LOW-BYTE OF SUBSCRIPT
 3788 T:1264  8a                                 txa                    ; 
 3789 T:1265  d1 9b                              cmp (LOWTR),Y                   ; 
 3790 T:1267  90 07                              bcc FAE_3                ; NOT TOO LARGE
 3791 T:1269                                    ; --------------------------------
 3792 T:1269  4c 96 11                 GSE       jmp SUBERR          ; BAD SUBSCRIPTS ERROR
 3793 T:126c  4c 10 04                 GME       jmp MEMERR          ; MEM FULL ERROR
 3794 T:126f                                    ; --------------------------------
 3795 T:126f  c8                       FAE_2     iny                 ; BUMP POINTER INTO DESCRIPTOR
 3796 T:1270  a5 ae                    FAE_3     lda STRNG2+1       ; BYPASS MULTIPLICATION IF VALUE SO
 3797 T:1272  05 ad                              ora STRNG2                ; FAR = 0
 3798 T:1274  18                                 clc                    ; 
 3799 T:1275  f0 0a                              beq L_FAE_3_1                ; IT IS ZERO SO FAR
 3800 T:1277  20 ad 12                           jsr MULTIPLY_SUBSCRIPT                ; NOT ZERO, SO MULTIPLY
 3801 T:127a  8a                                 txa                    ; ADD CURRENT SUBSCRIPT
 3802 T:127b  65 a0                              adc FAC+3          ; 
 3803 T:127d  aa                                 tax                    ; 
 3804 T:127e  98                                 tya                    ; 
 3805 T:127f  a4 5e                              ldy INDEX                ; RETRIEVE Y SAVED BY MULTIPLY.SUBSCRIPT
 3806 T:1281  65 a1                    L_FAE_3_1 adc FAC+4       ; FINISH ADDING CURRENT SUBSCRIPT
 3807 T:1283  86 ad                              stx STRNG2                ; STORE ACCUMULATED OFFSET
 3808 T:1285  c6 0f                              dec NUMDIM                ; LAST SUBSCRIPT YET?
 3809 T:1287  d0 ca                              bne FAE_1             ; NO, LOOP TILL DONE
 3810 T:1289  85 ae                              sta STRNG2+1          ; YES, NOW MULTIPLY BE ELEMENT SIZE
 3811 T:128b  a2 05                              ldx #5             ; START WITH SIZE = 5
 3812 T:128d  a5 81                              lda VARNAM                ; DETERMINE VARIABLE TYPE
 3813 T:128f  10 01                              bpl L_FAE_3_2                ; NOT INTEGER
 3814 T:1291  ca                                 dex                    ; INTEGER, BACK DOWN SIZE TO 4 BYTES
 3815 T:1292  a5 82                    L_FAE_3_2 lda VARNAM+1       ; DISCRIMINATE BETWEEN REAL AND STR
 3816 T:1294  10 02                              bpl L_FAE_3_3                ; IT IS REAL
 3817 T:1296  ca                                 dex                    ; SIZE = 3 IF STRING, =2 IF INTEGER
 3818 T:1297  ca                                 dex                    ; 
 3819 T:1298  86 64                    L_FAE_3_3 stx RESULT+2       ; SET UP MULTIPLIER
 3820 T:129a  a9 00                              lda #0             ; HI-BYTE OF MULTIPLIER
 3821 T:129c  20 b6 12                           jsr MULTIPLY_SUBS_1                ; (STRNG2) BY ELEMENT SIZE
 3822 T:129f  8a                                 txa                    ; ADD ACCUMULATED OFFSET
 3823 T:12a0  65 94                              adc ARYPNT                ; TO ADDRESS OF 1ST ELEMENT
 3824 T:12a2  85 83                              sta VARPNT                ; TO GET ADDRESS OF SPECIFIED ELEMENT
 3825 T:12a4  98                                 tya                    ; 
