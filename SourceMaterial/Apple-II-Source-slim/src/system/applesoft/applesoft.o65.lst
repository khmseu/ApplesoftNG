 4289 T:1530  90 06                              bcc L_CHECK_VARIABLE_1                ; NO, BELOW FRETOP
 4290 T:1532  d0 1e                              bne CHECK_BUMP                ; YES, ABOVE FRETOP
 4291 T:1534  e4 6f                              cpx FRETOP                ; MAYBE, CHECK LO-BYTE
 4292 T:1536  b0 1a                              bcs CHECK_BUMP                ; YES, ABOVE FRETOP
 4293 T:1538  c5 9c                    L_CHECK_VARIABLE_1 cmp LOWTR+1       ; ABOVE HIGHEST STRING FOUND?
 4294 T:153a  90 16                              bcc CHECK_BUMP                ; NO, IGNORE FOR NOW
 4295 T:153c  d0 04                              bne L_CHECK_VARIABLE_2                ; YES, THIS IS THE NEW HIGHEST
 4296 T:153e  e4 9b                              cpx LOWTR                ; MAYBE, TRY LO-BYTE
 4297 T:1540  90 10                              bcc CHECK_BUMP                ; NO, IGNORE FOR NOW
 4298 T:1542  86 9b                    L_CHECK_VARIABLE_2 stx LOWTR             ; MAKE THIS THE HIGHEST STRING
 4299 T:1544  85 9c                              sta LOWTR+1
