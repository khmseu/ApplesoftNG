 3723 T:1201  86 ad                              stx STRNG2                ; STORE RUNNING SIZE IN STRNG2
 3724 T:1203  85 ae                              sta STRNG2+1          ; 
 3725 T:1205  a4 5e                              ldy INDEX                ; RETRIEVE Y SAVED BY MULTIPLY.SUBSCRIPT
 3726 T:1207  c6 0f                              dec NUMDIM                ; COUNT DOWN # DIMS
 3727 T:1209  d0 dc                              bne L_MAKE_NEW_ARRAY_4             ; LOOP TILL DONE
 3728 T:120b                                    ; --------------------------------
 3729 T:120b                                    ; NOW A,X HAS TOTAL # BYTES OF ARRAY ELEMENTS
 3730 T:120b                                    ; --------------------------------
 3731 T:120b  65 95                              adc ARYPNT+1          ; COMPUTE ADDRESS OF END OF THIS ARRAY
 3732 T:120d  b0 5d                              bcs GME                ; ...TOO LARGE, ERROR
 3733 T:120f  85 95                              sta ARYPNT+1          ; 
 3734 T:1211  a8                                 tay                    ; 
 3735 T:1212  8a                                 txa                    ; 
 3736 T:1213  65 94                              adc ARYPNT                ; 
 3737 T:1215  90 03                              bcc L_MAKE_NEW_ARRAY_6                ; 
 3738 T:1217  c8                                 iny                    ; 
 3739 T:1218  f0 52                              beq GME                ; ...TOO LARGE, ERROR
 3740 T:121a  20 e3 03                 L_MAKE_NEW_ARRAY_6 jsr REASON          ; MAKE SURE THERE IS ROOM UP TO Y,A
 3741 T:121d  85 6d                              sta STREND                ; THERE IS ROOM SO SAVE NEW END OF TABLE
 3742 T:121f  84 6e                              sty STREND+1          ; AND ZERO THE ARRAY
 3743 T:1221  a9 00                              lda #0             ; 
 3744 T:1223  e6 ae                              inc STRNG2+1          ; PREPARE FOR FAST ZEROING LOOP
 3745 T:1225  a4 ad                              ldy STRNG2                ; # BYTES MOD 256
 3746 T:1227  f0 05                              beq L_MAKE_NEW_ARRAY_8                ; FULL PAGE
 3747 T:1229  88                       L_MAKE_NEW_ARRAY_7 dey                 ; CLEAR PAGE FULL
 3748 T:122a  91 94                              sta (ARYPNT),Y
 3749 T:122c  d0 fb                              bne L_MAKE_NEW_ARRAY_7
 3750 T:122e  c6 95                    L_MAKE_NEW_ARRAY_8 dec ARYPNT+1       ; POINT TO NEXT PAGE
 3751 T:1230  c6 ae                              dec STRNG2+1          ; COUNT THE PAGES
 3752 T:1232  d0 f5                              bne L_MAKE_NEW_ARRAY_7             ; STILL MORE TO CLEAR
 3753 T:1234  e6 95                              inc ARYPNT+1          ; RECOVER LAST DEC, POINT AT 1ST ELEMENT
 3754 T:1236  38                                 sec                    ; 
 3755 T:1237  a5 6d                              lda STREND                ; COMPUTE OFFSET TO END OF ARRAYS
 3756 T:1239  e5 9b                              sbc LOWTR                ; AND STORE IN ARRAY DESCRIPTOR
 3757 T:123b  a0 02                              ldy #2             ; 
 3758 T:123d  91 9b                              sta (LOWTR),Y                   ; 
 3759 T:123f  a5 6e                              lda STREND+1          ; 
