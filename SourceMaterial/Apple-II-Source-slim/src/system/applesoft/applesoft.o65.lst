 3621 T:1173  d0 04                              bne L_ARRAY_4                ; NO, KEEP SEARCHING
 3622 T:1175  e4 6d                              cpx STREND                ; 
 3623 T:1177  f0 3f                              beq MAKE_NEW_ARRAY                ; YES, THIS IS A NEW ARRAY NAME
 3624 T:1179  a0 00                    L_ARRAY_4 ldy #0          ; POINT AT 1ST CHAR OF ARRAY NAME
 3625 T:117b  b1 9b                              lda (LOWTR),Y                   ; GET 1ST CHAR OF NAME
 3626 T:117d  c8                                 iny                    ; POINT AT 2ND CHAR
 3627 T:117e  c5 81                              cmp VARNAM                ; 1ST CHAR SAME?
 3628 T:1180  d0 06                              bne L_ARRAY_5                ; NO, MOVE TO NEXT ARRAY
 3629 T:1182  a5 82                              lda VARNAM+1          ; YES, TRY 2ND CHAR
 3630 T:1184  d1 9b                              cmp (LOWTR),Y                   ; SAME?
 3631 T:1186  f0 16                              beq USE_OLD_ARRAY                ; YES, ARRAY FOUND
 3632 T:1188  c8                       L_ARRAY_5 iny                 ; POINT AT OFFSET TO NEXT ARRAY
