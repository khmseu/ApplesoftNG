 6735 T:2331                                    ; "DEL" STATEMENT
 6736 T:2331                                    ; --------------------------------
 6737 T:2331  b0 fb                    DEL       bcs JSYN          ; ERROR IF # NOT SPECIFIED
 6738 T:2333  a6 af                              ldx PRGEND                ; 
 6739 T:2335  86 69                              stx VARTAB                ; 
 6740 T:2337  a6 b0                              ldx PRGEND+1          ; 
 6741 T:2339  86 6a                              stx VARTAB+1          ; 
 6742 T:233b  20 0c 0a                           jsr LINGET             ; GET BEGINNING OF RANGE
 6743 T:233e  20 1a 06                           jsr FNDLIN             ; FIND THIS LINE OR NEXT
 6744 T:2341  a5 9b                              lda LOWTR                ; UPPER PORTION OF PROGRAM WILL
 6745 T:2343  85 60                              sta DEST                ; BE MOVED DOWN TO HERE
 6746 T:2345  a5 9c                              lda LOWTR+1          ; 
 6747 T:2347  85 61                              sta DEST+1          ; 
 6748 T:2349  a9 2c                              lda #(","&%01111111)     ; MUST HAVE A COMMA NEXT
 6749 T:234b  20 c0 0e                           jsr SYNCHR             ; 
 6750 T:234e  20 0c 0a                           jsr LINGET             ; GET END RANGE
 6751 T:2351                                    ; (DOES NOTHING IF END RANGE
 6752 T:2351                                    ; IS NOT SPECIFIED)
 6753 T:2351  e6 50                              inc LINNUM                ; POINT ONE PAST IT
 6754 T:2353  d0 02                              bne L_DEL_1                ; 
 6755 T:2355  e6 51                              inc LINNUM+1          ; 
 6756 T:2357  20 1a 06                 L_DEL_1   jsr FNDLIN          ; FIND START LINE AFTER SPECIFIED LINE
 6757 T:235a  a5 9b                              lda LOWTR                ; WHICH IS BEGINNING OF PORTION
 6758 T:235c  c5 60                              cmp DEST                ; TO BE MOVED DOWN
 6759 T:235e  a5 9c                              lda LOWTR+1          ; IT MUST BE ABOVE THE TARGET
 6760 T:2360  e5 61                              sbc DEST+1          ; 
 6761 T:2362  b0 01                              bcs L_DEL_2                ; IT IS OKAY
 6762 T:2364  60                                 rts                    ; NOTHING TO DELETE
 6763 T:2365  a0 00                    L_DEL_2   ldy #0          ; MOVE UPPER PORTION DOWN NOW
 6764 T:2367  b1 9b                    L_DEL_3   lda (LOWTR),Y                   ; SOURCE . . .
 6765 T:2369  91 60                              sta (DEST),Y                    ; ...TO DESTINATION
 6766 T:236b  e6 9b                              inc LOWTR                ; BUMP SOURCE PNTR
 6767 T:236d  d0 02                              bne L_DEL_4                ; 
 6768 T:236f  e6 9c                              inc LOWTR+1          ; 
 6769 T:2371  e6 60                    L_DEL_4   inc DEST             ; BUMP DESTINATION PNTR
 6770 T:2373  d0 02                              bne L_DEL_5                ; 
 6771 T:2375  e6 61                              inc DEST+1          ; 
 6772 T:2377  a5 69                    L_DEL_5   lda VARTAB             ; REACHED END OF PROGRAM YET?
 6773 T:2379  c5 9b                              cmp LOWTR                ; 
 6774 T:237b  a5 6a                              lda VARTAB+1          ; 
 6775 T:237d  e5 9c                              sbc LOWTR+1          ; 
 6776 T:237f  b0 e6                              bcs L_DEL_3             ; NO, KEEP MOVING
 6777 T:2381  a6 61                              ldx DEST+1          ; STORE NEW END OF PROGRAM
 6778 T:2383  a4 60                              ldy DEST                ; MUST SUBTRACT 1 FIRST
 6779 T:2385  d0 01                              bne L_DEL_6                ; 
 6780 T:2387  ca                                 dex                    ; 
 6781 T:2388  88                       L_DEL_6   dey                 ; 
 6782 T:2389  86 6a                              stx VARTAB+1          ; 
 6783 T:238b  84 69                              sty VARTAB                ; 
 6784 T:238d  4c f2 04                           jmp FIX_LINKS             ; RESET LINKS AFTER A DELETE
