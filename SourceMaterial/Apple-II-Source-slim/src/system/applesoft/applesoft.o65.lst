 3871 T:12de                                    ; "FRE" FUNCTION
 3872 T:12de                                    ; 
 3873 T:12de                                    ; COLLECTS GARBAGE AND RETURNS # BYTES OF MEMORY LEFT
 3874 T:12de                                    ; --------------------------------
 3875 T:12de  a5 11                    FRE       lda VALTYP             ; LOOK AT VALUE OF ARGUMENT
 3876 T:12e0  f0 03                              beq L_FRE_1                ; =0 MEANS REAL, =$FF MEANS STRING
 3877 T:12e2  20 00 16                           jsr FREFAC                ; STRING, SO SET IT FREE IS TEMP
 3878 T:12e5  20 84 14                 L_FRE_1   jsr GARBAG             ; COLLECT ALL THE GARBAGE IN SIGHT
 3879 T:12e8  38                                 sec                    ; COMPUTE SPACE BETWEEN ARRAYS AND
 3880 T:12e9  a5 6f                              lda FRETOP                ; STRING TEMP AREA
 3881 T:12eb  e5 6d                              sbc STREND                ; 
 3882 T:12ed  a8                                 tay                    ; 
 3883 T:12ee  a5 70                              lda FRETOP+1          ; 
 3884 T:12f0  e5 6e                              sbc STREND+1          ; FREE SPACE IN Y,A
 3885 T:12f2                                    ; FALL INTO GIVAYF TO FLOAT THE VALUE
 3886 T:12f2                                    ; NOTE THAT VALUES OVER 32767 WILL RETURN AS NEGATIVE
 3887 T:12f2                                    ; --------------------------------
 3888 T:12f2                                    ; FLOAT THE SIGNED INTEGER IN A,Y
 3889 T:12f2                                    ; --------------------------------
 3890 T:12f2  a2 00                    GIVAYF    ldx #0          ; MARK FAC VALUE TYPE REAL
 3891 T:12f4  86 11                              stx VALTYP                ; 
 3892 T:12f6  85 9e                              sta FAC+1          ; SAVE VALUE FROM A,Y IN MANTISSA
 3893 T:12f8  84 9f                              sty FAC+2          ; 
 3894 T:12fa  a2 90                              ldx #$90             ; SET EXPONENT TO 2^16
 3895 T:12fc  4c 9b 1b                           jmp FLOAT_1                ; CONVERT TO SIGNED FP
