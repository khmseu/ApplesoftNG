 6643 T:2299  a5 50                    SETHI     lda LINNUM             ; STORE NEW HIMEM: VALUE
 6644 T:229b  85 73                              sta MEMSIZ                ; 
 6645 T:229d  85 6f                              sta FRETOP                ; <<<NOTE THAT "HIMEM:" DOES NOT>>>
 6646 T:229f  a5 51                              lda LINNUM+1          ; <<<CLEAR STRING VARIABLES.    >>>
