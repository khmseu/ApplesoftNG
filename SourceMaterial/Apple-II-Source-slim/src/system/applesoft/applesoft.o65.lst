 1198 T:0365                                    ; --------------------------------
 1199 T:0365                                    ; CALLED BY "NEXT" AND "FOR" TO SCAN THROUGH
 1200 T:0365                                    ; THE STACK FOR A FRAME WITH THE SAME VARIABLE.
 1201 T:0365                                    ; 
 1202 T:0365                                    ; (FORPNT) = ADDRESS OF VARIABLE IF "FOR" OR "NEXT"
 1203 T:0365                                    ; = $XXFF IF CALLED FROM "RETURN"
 1204 T:0365                                    ; <<< BUG: SHOULD BE $FFXX >>>
 1205 T:0365                                    ; 
 1206 T:0365                                    ; RETURNS .NE. IF VARIABLE NOT FOUND,
 1207 T:0365                                    ; (X) = STACK PNTR AFTER SKIPPING ALL FRAMES
 1208 T:0365                                    ; 
 1209 T:0365                                    ; EQU. IF FOUND
 1210 T:0365                                    ; (X) = STACK PNTR OF FRAME FOUND
 1211 T:0365                                    ; --------------------------------
 1212 T:0365                           GTFORPNT  
 1213 T:0365  ba                                 tsx 
 1214 T:0366  e8                                 inx 
 1215 T:0367  e8                                 inx 
 1216 T:0368  e8                                 inx 
 1217 T:0369  e8                                 inx 
 1218 T:036a  bd 01 01                 L_GTFORPNT_1 lda STACK+1,X                   ; "FOR" FRAME HERE?
 1219 T:036d  c9 81                              cmp #TOKEN_FOR               ; 
 1220 T:036f  d0 21                              bne L_GTFORPNT_4                ; NO
 1221 T:0371  a5 86                              lda FORPNT+1          ; YES -- "NEXT" WITH NO VARIABLE?
 1222 T:0373  d0 0a                              bne L_GTFORPNT_2                ; NO, VARIABLE SPECIFIED
 1223 T:0375  bd 02 01                           lda STACK+2,X                   ; YES, SO USE THIS FRAME
 1224 T:0378  85 85                              sta FORPNT                ; 
 1225 T:037a  bd 03 01                           lda STACK+3,X                   ; 
 1226 T:037d  85 86                              sta FORPNT+1          ; 
 1227 T:037f  dd 03 01                 L_GTFORPNT_2 cmp STACK+3,X                   ; IS VARIABLE IN THIS FRAME?
 1228 T:0382  d0 07                              bne L_GTFORPNT_3                ; NO
 1229 T:0384  a5 85                              lda FORPNT                ; LOOK AT 2ND BYTE TOO
 1230 T:0386  dd 02 01                           cmp STACK+2,X                   ; SAME VARIABLE?
 1231 T:0389  f0 07                              beq L_GTFORPNT_4                ; YES
 1232 T:038b  8a                       L_GTFORPNT_3 txa                 ; NO, SO TRY NEXT FRAME (IF ANY)
 1233 T:038c  18                                 clc                    ; 18 BYTES PER FRAME
 1234 T:038d  69 12                              adc #18             ; 
 1235 T:038f  aa                                 tax 
 1236 T:0390  d0 d8                              bne L_GTFORPNT_1             ; ...ALWAYS?
 1237 T:0392  60                       L_GTFORPNT_4 rts 
 1238 T:0393                                    ; --------------------------------
 1239 T:0393                                    ; MOVE BLOCK OF MEMORY UP
 1240 T:0393                                    ; 
 1241 T:0393                                    ; ON ENTRY:
 1242 T:0393                                    ; (Y,A) = (HIGHDS) = DESTINATION END+1
 1243 T:0393                                    ; (LOWTR) = LOWEST ADDRESS OF SOURCE
 1244 T:0393                                    ; (HIGHTR) = HIGHEST SOURCE ADDRESS+1
 1245 T:0393                                    ; --------------------------------
 1246 T:0393  20 e3 03                 BLTU      jsr REASON             ; BE SURE (Y,A) < FRETOP
 1247 T:0396  85 6d                              sta STREND                ; NEW TOP OF ARRAY STORAGE
 1248 T:0398  84 6e                              sty STREND+1          ; 
 1249 T:039a  38                       BLTU2     sec                 ; 
 1250 T:039b  a5 96                              lda HIGHTR                ; COMPUTE # OF BYTES TO BE MOVED
 1251 T:039d  e5 9b                              sbc LOWTR                ; (FROM LOWTR THRU HIGHTR-1)
 1252 T:039f  85 5e                              sta INDEX                ; PARTIAL PAGE AMOUNT
 1253 T:03a1  a8                                 tay                    ; 
 1254 T:03a2  a5 97                              lda HIGHTR+1          ; 
 1255 T:03a4  e5 9c                              sbc LOWTR+1          ; 
 1256 T:03a6  aa                                 tax                    ; # OF WHOLE PAGES IN X-REG
 1257 T:03a7  e8                                 inx                    ; 
 1258 T:03a8  98                                 tya                    ; # BYTES IN PARTIAL PAGE
 1259 T:03a9  f0 23                              beq L_BLTU2_4                ; NO PARTIAL PAGE
 1260 T:03ab  a5 96                              lda HIGHTR                ; BACK UP HIGHTR # BYTES IN PARTIAL PAGE
 1261 T:03ad  38                                 sec                    ; 
 1262 T:03ae  e5 5e                              sbc INDEX                ; 
 1263 T:03b0  85 96                              sta HIGHTR                ; 
 1264 T:03b2  b0 03                              bcs L_BLTU2_1                ; 
 1265 T:03b4  c6 97                              dec HIGHTR+1          ; 
 1266 T:03b6  38                                 sec                    ; 
 1267 T:03b7  a5 94                    L_BLTU2_1 lda HIGHDS             ; BACK UP HIGHDS # BYTES IN PARTIAL PAGE
 1268 T:03b9  e5 5e                              sbc INDEX                ; 
 1269 T:03bb  85 94                              sta HIGHDS                ; 
 1270 T:03bd  b0 08                              bcs L_BLTU2_3                ; 
 1271 T:03bf  c6 95                              dec HIGHDS+1          ; 
 1272 T:03c1  90 04                              bcc L_BLTU2_3                ; ...ALWAYS
 1273 T:03c3  b1 96                    L_BLTU2_2 lda (HIGHTR),Y                  ; MOVE THE BYTES
 1274 T:03c5  91 94                              sta (HIGHDS),Y
 1275 T:03c7  88                       L_BLTU2_3 dey 
 1276 T:03c8  d0 f9                              bne L_BLTU2_2             ; LOOP TO END OF THIS 256 BYTES
 1277 T:03ca  b1 96                              lda (HIGHTR),Y                  ; MOVE ONE MORE BYTE
 1278 T:03cc  91 94                              sta (HIGHDS),Y
 1279 T:03ce  c6 97                    L_BLTU2_4 dec HIGHTR+1       ; DOWN TO NEXT BLOCK OF 256
 1280 T:03d0  c6 95                              dec HIGHDS+1
 1281 T:03d2  ca                                 dex                    ; ANOTHER BLOCK OF 256 TO MOVE?
 1282 T:03d3  d0 f2                              bne L_BLTU2_3             ; YES
 1283 T:03d5  60                                 rts                    ; NO, FINISHED
 1284 T:03d6                                    ; --------------------------------
 1285 T:03d6                                    ; CHECK IF ENOUGH ROOM LEFT ON STACK
 1286 T:03d6                                    ; FOR "FOR", "GOSUB", OR EXPRESSION EVALUATION
 1287 T:03d6                                    ; --------------------------------
 1288 T:03d6  0a                       CHKMEM    asl 
 1289 T:03d7  69 36                              adc #54
 1290 T:03d9  b0 35                              bcs MEMERR                ; ...MEM FULL ERR
 1291 T:03db  85 5e                              sta INDEX
 1292 T:03dd  ba                                 tsx 
 1293 T:03de  e4 5e                              cpx INDEX
 1294 T:03e0  90 2e                              bcc MEMERR                ; ...MEM FULL ERR
 1295 T:03e2  60                                 rts 
 1296 T:03e3                                    ; --------------------------------
 1297 T:03e3                                    ; CHECK IF ENOUGH ROOM BETWEEN ARRAYS AND STRINGS
 1298 T:03e3                                    ; (Y,A) = ADDR ARRAYS NEED TO GROW TO
 1299 T:03e3                                    ; --------------------------------
 1300 T:03e3  c4 70                    REASON    cpy FRETOP+1       ; HIGH BYTE
 1301 T:03e5  90 28                              bcc L_REASON_4                ; PLENTY OF ROOM
 1302 T:03e7  d0 04                              bne L_REASON_1                ; NOT ENOUGH, TRY GARBAGE COLLECTION
 1303 T:03e9  c5 6f                              cmp FRETOP                ; LOW BYTE
 1304 T:03eb  90 22                              bcc L_REASON_4                ; ENOUGH ROOM
 1305 T:03ed                                    ; --------------------------------
 1306 T:03ed  48                       L_REASON_1 pha                 ; SAVE (Y,A), TEMP1, AND TEMP2
 1307 T:03ee  a2 09                              ldx #FAC-TEMP1-1
 1308 T:03f0  98                                 tya 
 1309 T:03f1  48                       L_REASON_2 pha 
 1310 T:03f2  b5 93                              lda TEMP1,X
 1311 T:03f4  ca                                 dex 
 1312 T:03f5  10 fa                              bpl L_REASON_2
 1313 T:03f7  20 84 14                           jsr GARBAG                ; MAKE AS MUCH ROOM AS POSSIBLE
 1314 T:03fa  a2 f7                              ldx #TEMP1+256-FAC+1; RESTORE TEMP1 AND TEMP2
 1315 T:03fc  68                       L_REASON_3 pla                 ; AND (Y,A)
 1316 T:03fd  95 9d                              sta FAC,X
 1317 T:03ff  e8                                 inx 
 1318 T:0400  30 fa                              bmi L_REASON_3
 1319 T:0402  68                                 pla 
 1320 T:0403  a8                                 tay 
 1321 T:0404  68                                 pla                    ; DID WE FIND ENOUGH ROOM?
 1322 T:0405  c4 70                              cpy FRETOP+1          ; HIGH BYTE
 1323 T:0407  90 06                              bcc L_REASON_4                ; YES, AT LEAST A PAGE
 1324 T:0409  d0 05                              bne MEMERR                ; NO, MEM FULL ERR
 1325 T:040b  c5 6f                              cmp FRETOP                ; LOW BYTE
 1326 T:040d  b0 01                              bcs MEMERR                ; NO, MEM FULL ERR
 1327 T:040f  60                       L_REASON_4 rts                 ; YES, RETURN
 1328 T:0410                                    ; --------------------------------
 1329 T:0410  a2 4d                    MEMERR    ldx #ERR_MEMFULL
 1330 T:0412                                    ; --------------------------------
 1331 T:0412                                    ; HANDLE AN ERROR
 1332 T:0412                                    ; 
 1333 T:0412                                    ; (X)=OFFSET IN ERROR MESSAGE TABLE
 1334 T:0412                                    ; (ERRFLG) > 128 IF "ON ERR" TURNED ON
 1335 T:0412                                    ; (CURLIN+1) = $FF IF IN DIRECT MODE
 1336 T:0412                                    ; --------------------------------
 1337 T:0412  24 d8                    ERROR     bit ERRFLG             ; "ON ERR" TURNED ON?
 1338 T:0414  10 03                              bpl L_ERROR_1                ; NO
 1339 T:0416  4c e9 22                           jmp HANDLERR                ; YES
 1340 T:0419  20 fb 0a                 L_ERROR_1 jsr CRDO             ; PRINT <RETURN>
 1341 T:041c  20 5a 0b                           jsr OUTQUES                ; PRINT "?"
 1342 T:041f  bd 60 02                 L_ERROR_2 lda ERROR_MESSAGES,X
 1343 T:0422  48                                 pha                    ; PRINT MESSAGE
 1344 T:0423  20 5c 0b                           jsr OUTDO
 1345 T:0426  e8                                 inx 
 1346 T:0427  68                                 pla 
 1347 T:0428  10 f5                              bpl L_ERROR_2
 1348 T:042a  20 83 06                           jsr STKINI                ; FIX STACK, ET AL
 1349 T:042d  a9 50                              lda #<QT_ERROR           ; PRINT " ERROR" AND BELL
 1350 T:042f  a0 03                              ldy #>QT_ERROR
 1351 T:0431                                    ; --------------------------------
 1352 T:0431                                    ; PRINT STRING AT (Y,A)
 1353 T:0431                                    ; PRINT CURRENT LINE # UNLESS IN DIRECT MODE
 1354 T:0431                                    ; FALL INTO WARM RESTART
 1355 T:0431                                    ; --------------------------------
 1356 T:0431                           PRINT_ERROR_LINNUM 
 1357 T:0431  20 3a 0b                           jsr STROUT                ; PRINT STRING AT (Y,A)
 1358 T:0434  a4 76                              ldy CURLIN+1          ; RUNNING, OR DIRECT?
 1359 T:0436  c8                                 iny 
 1360 T:0437  f0 03                              beq RESTART                ; WAS $FF, SO DIRECT MODE
 1361 T:0439  20 19 1d                           jsr INPRT                ; RUNNING, SO PRINT LINE NUMBER
 1362 T:043c                                    ; --------------------------------
 1363 T:043c                                    ; WARM RESTART ENTRY
 1364 T:043c                                    ; 
 1365 T:043c                                    ; COME HERE FROM MONITOR BY CTL-C, 0G, 3D0G, OR E003G
 1366 T:043c                                    ; --------------------------------
 1367 T:043c                           RESTART   
 1368 T:043c  20 fb 0a                           jsr CRDO                ; PRINT <RETURN>
 1369 T:043f  a2 dd                              ldx #("]"|%10000000)     ; PROMPT CHARACTER
 1370 T:0441  20 2e 05                           jsr INLIN2                ; READ A LINE
 1371 T:0444  86 b8                              stx TXTPTR                ; SET UP CHRGET TO SCAN THE LINE
 1372 T:0446  84 b9                              sty TXTPTR+1          ; 
 1373 T:0448  46 d8                              lsr ERRFLG                ; CLEAR FLAG
 1374 T:044a  20 b1 00                           jsr CHRGET                ; 
 1375 T:044d  aa                                 tax                    ; 
 1376 T:044e  f0 ec                              beq RESTART             ; EMPTY LINE
 1377 T:0450  a2 ff                              ldx #$ff             ; $FF IN HI-BYTE OF CURLIN MEANS
 1378 T:0452  86 76                              stx CURLIN+1          ; WE ARE IN DIRECT MODE
 1379 T:0454  90 06                              bcc NUMBERED_LINE                ; CHRGET SAW DIGIT, NUMBERED LINE
 1380 T:0456  20 59 05                           jsr PARSE_INPUT_LINE                ; NO NUMBER, SO PARSE IT
 1381 T:0459  4c 05 08                           jmp TRACE_                ; AND TRY EXECUTING IT
 1382 T:045c                                    ; --------------------------------
 1383 T:045c                                    ; HANDLE NUMBERED LINE
 1384 T:045c                                    ; --------------------------------
 1385 T:045c                           NUMBERED_LINE 
 1386 T:045c  a6 af                              ldx PRGEND                ; SQUASH VARIABLE TABLE
 1387 T:045e  86 69                              stx VARTAB
 1388 T:0460  a6 b0                              ldx PRGEND+1
 1389 T:0462  86 6a                              stx VARTAB+1
 1390 T:0464  20 0c 0a                           jsr LINGET                ; GET LINE #
 1391 T:0467  20 59 05                           jsr PARSE_INPUT_LINE                ; AND PARSE THE INPUT LINE
 1392 T:046a  84 0f                              sty EOL_PNTR                ; SAVE INDEX TO INPUT BUFFER
 1393 T:046c  20 1a 06                           jsr FNDLIN                ; IS THIS LINE # ALREADY IN PROGRAM?
 1394 T:046f  90 44                              bcc PUT_NEW_LINE                ; NO
 1395 T:0471  a0 01                              ldy #1             ; YES, SO DELETE IT
 1396 T:0473  b1 9b                              lda (LOWTR),Y                   ; LOWTR POINTS AT LINE
 1397 T:0475  85 5f                              sta INDEX+1          ; GET HIGH BYTE OF FORWARD PNTR
 1398 T:0477  a5 69                              lda VARTAB
 1399 T:0479  85 5e                              sta INDEX
 1400 T:047b  a5 9c                              lda LOWTR+1
 1401 T:047d  85 61                              sta DEST+1
 1402 T:047f  a5 9b                              lda LOWTR
 1403 T:0481  88                                 dey 
 1404 T:0482  f1 9b                              sbc (LOWTR),Y
 1405 T:0484  18                                 clc 
 1406 T:0485  65 69                              adc VARTAB
 1407 T:0487  85 69                              sta VARTAB
 1408 T:0489  85 60                              sta DEST
 1409 T:048b  a5 6a                              lda VARTAB+1
 1410 T:048d  69 ff                              adc #$ff
 1411 T:048f  85 6a                              sta VARTAB+1
 1412 T:0491  e5 9c                              sbc LOWTR+1
 1413 T:0493  aa                                 tax 
 1414 T:0494  38                                 sec 
 1415 T:0495  a5 9b                              lda LOWTR
 1416 T:0497  e5 69                              sbc VARTAB
 1417 T:0499  a8                                 tay 
 1418 T:049a  b0 03                              bcs L_NUMBERED_LINE_1
 1419 T:049c  e8                                 inx 
 1420 T:049d  c6 61                              dec DEST+1
 1421 T:049f  18                       L_NUMBERED_LINE_1 clc 
 1422 T:04a0  65 5e                              adc INDEX
 1423 T:04a2  90 03                              bcc L_NUMBERED_LINE_2
 1424 T:04a4  c6 5f                              dec INDEX+1
 1425 T:04a6  18                                 clc 
 1426 T:04a7                                    ; --------------------------------
 1427 T:04a7  b1 5e                    L_NUMBERED_LINE_2 lda (INDEX),Y                   ; MOVE HIGHER LINES OF PROGRAM
 1428 T:04a9  91 60                              sta (DEST),Y                    ; DOWN OVER THE DELETED LINE.
 1429 T:04ab  c8                                 iny 
 1430 T:04ac  d0 f9                              bne L_NUMBERED_LINE_2
 1431 T:04ae  e6 5f                              inc INDEX+1
 1432 T:04b0  e6 61                              inc DEST+1
 1433 T:04b2  ca                                 dex 
 1434 T:04b3  d0 f2                              bne L_NUMBERED_LINE_2
 1435 T:04b5                                    ; --------------------------------
 1436 T:04b5                           PUT_NEW_LINE 
 1437 T:04b5  ad 00 02                           lda INPUT_BUFFER                ; ANY CHARACTERS AFTER LINE #?
 1438 T:04b8  f0 38                              beq FIX_LINKS                ; NO, SO NOTHING TO INSERT.
 1439 T:04ba  a5 73                              lda MEMSIZ                ; YES, SO MAKE ROOM AND INSERT LINE
 1440 T:04bc  a4 74                              ldy MEMSIZ+1          ; WIPE STRING AREA CLEAN
 1441 T:04be  85 6f                              sta FRETOP                ; 
 1442 T:04c0  84 70                              sty FRETOP+1          ; 
 1443 T:04c2  a5 69                              lda VARTAB                ; SET UP BLTU SUBROUTINE
 1444 T:04c4  85 96                              sta HIGHTR                ; INSERT NEW LINE.
 1445 T:04c6  65 0f                              adc EOL_PNTR
 1446 T:04c8  85 94                              sta HIGHDS
 1447 T:04ca  a4 6a                              ldy VARTAB+1
 1448 T:04cc  84 97                              sty HIGHTR+1
 1449 T:04ce  90 01                              bcc L_PUT_NEW_LINE_1
 1450 T:04d0  c8                                 iny 
 1451 T:04d1  84 95                    L_PUT_NEW_LINE_1 sty HIGHDS+1
 1452 T:04d3  20 93 03                           jsr BLTU             ; MAKE ROOM FOR THE LINE
 1453 T:04d6  a5 50                              lda LINNUM                ; PUT LINE NUMBER IN LINE IMAGE
 1454 T:04d8  a4 51                              ldy LINNUM+1
 1455 T:04da  8d fe 01                           sta INPUT_BUFFER-2
 1456 T:04dd  8c ff 01                           sty INPUT_BUFFER-1
 1457 T:04e0  a5 6d                              lda STREND
 1458 T:04e2  a4 6e                              ldy STREND+1
 1459 T:04e4  85 69                              sta VARTAB
 1460 T:04e6  84 6a                              sty VARTAB+1
 1461 T:04e8  a4 0f                              ldy EOL_PNTR
