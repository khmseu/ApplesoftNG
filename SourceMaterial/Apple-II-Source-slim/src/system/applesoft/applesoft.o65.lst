 3614 T:1169                                    ; SEARCH ARRAY TABLE FOR THIS ARRAY NAME
 3615 T:1169                                    ; --------------------------------
 3616 T:1169  a6 6b                    L_ARRAY_2 ldx ARYTAB             ; (A,X) = START OF ARRAY TABLE
 3617 T:116b  a5 6c                              lda ARYTAB+1          ; 
 3618 T:116d  86 9b                    L_ARRAY_3 stx LOWTR             ; USE LOWTR FOR RUNNING POINTER
 3619 T:116f  85 9c                              sta LOWTR+1          ; 
