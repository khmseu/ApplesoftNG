 3535 T:1102                                    ; --------------------------------
 3536 T:1102                                    ; EVALUATE NUMERIC FORMULA AT TXTPTR
 3537 T:1102                                    ; CONVERTING RESULT TO INTEGER 0 <= X <= 32767
 3538 T:1102                                    ; IN FAC+3,4
 3539 T:1102                                    ; --------------------------------
 3540 T:1102  20 b1 00                 MAKINT    jsr CHRGET
 3541 T:1105  20 67 0d                           jsr FRMNUM
