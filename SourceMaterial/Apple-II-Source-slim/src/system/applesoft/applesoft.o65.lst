 6327 T:20e8  7d 14 64 70 4c                     .byt $7d,$14,$64,$70,$4c
 6328 T:20ed  7d b7 ea 51 7a                     .byt $7d,$b7,$ea,$51,$7a
 6329 T:20f2  7d 63 30 88 7e                     .byt $7d,$63,$30,$88,$7e
 6330 T:20f7  7e 92 44 99 3a                     .byt $7e,$92,$44,$99,$3a
