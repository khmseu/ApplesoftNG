 5521 T:1bf2                                    ; QUICK INTEGER FUNCTION
 5522 T:1bf2                                    ; 
 5523 T:1bf2                                    ; CONVERTS FP VALUE IN FAC TO INTEGER VALUE
 5524 T:1bf2                                    ; IN FAC+1...FAC+4, BY SHIFTING RIGHT WITH SIGN
 5525 T:1bf2                                    ; EXTENSION UNTIL FRACTIONAL BITS ARE OUT.
 5526 T:1bf2                                    ; 
 5527 T:1bf2                                    ; THIS SUBROUTINE ASSUMES THE EXPONENT < 32.
 5528 T:1bf2                                    ; --------------------------------
 5529 T:1bf2  a5 9d                    QINT      lda FAC             ; LOOK AT FAC EXPONENT
 5530 T:1bf4  f0 4a                              beq QINT_3                ; FAC=0, SO FINISHED
 5531 T:1bf6  38                                 sec                    ; GET -(NUMBER OF FRACTIONAL BITS)
 5532 T:1bf7  e9 a0                              sbc #$a0             ; IN A-REG FOR SHIFT COUNT
 5533 T:1bf9  24 a2                              bit FAC_SIGN                ; CHECK SIGN OF FAC
 5534 T:1bfb  10 09                              bpl L_QINT_1                ; POSITIVE, CONTINUE
 5535 T:1bfd  aa                                 tax                    ; NEGATIVE, SO COMPLEMENT MANTISSA
 5536 T:1bfe  a9 ff                              lda #$ff             ; AND SET SIGN EXTENSION FOR SHIFT
 5537 T:1c00  85 a4                              sta SHIFT_SIGN_EXT
 5538 T:1c02  20 a4 18                           jsr COMPLEMENT_FAC_MANTISSA
 5539 T:1c05  8a                                 txa                    ; RESTORE BIT COUNT TO A-REG
 5540 T:1c06  a2 9d                    L_QINT_1  ldx #FAC            ; POINT SHIFT SUBROUTINE AT FAC
 5541 T:1c08  c9 f9                              cmp #$f9             ; MORE THAN 7 BITS TO SHIFT?
 5542 T:1c0a  10 06                              bpl QINT_2                ; NO, SHORT SHIFT
 5543 T:1c0c  20 f0 18                           jsr SHIFT_RIGHT             ; YES, USE GENERAL ROUTINE
 5544 T:1c0f  84 a4                              sty SHIFT_SIGN_EXT                ; Y=0, CLEAR SIGN EXTENSION
 5545 T:1c11  60                       RTS_16    rts 
 5546 T:1c12                                    ; --------------------------------
 5547 T:1c12  a8                       QINT_2    tay                 ; SAVE SHIFT COUNT
 5548 T:1c13  a5 a2                              lda FAC_SIGN                ; GET SIGN BIT
 5549 T:1c15  29 80                              and #$80             ; 
 5550 T:1c17  46 9e                              lsr FAC+1          ; START RIGHT SHIFT
 5551 T:1c19  05 9e                              ora FAC+1          ; AND MERGE WITH SIGN
 5552 T:1c1b  85 9e                              sta FAC+1
 5553 T:1c1d  20 07 19                           jsr SHIFT_RIGHT_4             ; JUMP INTO MIDDLE OF SHIFTER
 5554 T:1c20  84 a4                              sty SHIFT_SIGN_EXT                ; Y=0, CLEAR SIGN EXTENSION
 5555 T:1c22  60                                 rts 
 5556 T:1c23                                    ; --------------------------------
 5557 T:1c23                                    ; "INT" FUNCTION
 5558 T:1c23                                    ; 
 5559 T:1c23                                    ; USES QINT TO CONVERT (FAC) TO INTEGER FORM,
 5560 T:1c23                                    ; AND THEN REFLOATS THE INTEGER.
 5561 T:1c23                                    ; <<< A FASTER APPROACH WOULD SIMPLY CLEAR >>>
 5562 T:1c23                                    ; <<< THE FRACTIONAL BITS BY ZEROING THEM  >>>
 5563 T:1c23                                    ; --------------------------------
 5564 T:1c23  a5 9d                    INT       lda FAC             ; CHECK IF EXPONENT < 32
 5565 T:1c25  c9 a0                              cmp #$a0             ; BECAUSE IF > 31 THERE IS NO FRACTION
 5566 T:1c27  b0 20                              bcs RTS_17                ; NO FRACTION, WE ARE FINISHED
 5567 T:1c29  20 f2 1b                           jsr QINT             ; USE GENERAL INTEGER CONVERSION
 5568 T:1c2c  84 ac                              sty FAC_EXTENSION                ; Y=0, CLEAR EXTENSION
 5569 T:1c2e  a5 a2                              lda FAC_SIGN                ; GET SIGN OF VALUE
 5570 T:1c30  84 a2                              sty FAC_SIGN                ; Y=0, CLEAR SIGN
 5571 T:1c32  49 80                              eor #$80             ; TOGGLE ACTUAL SIGN
 5572 T:1c34  2a                                 rol                    ; AND SAVE IN CARRY
 5573 T:1c35  a9 a0                              lda #$a0             ; SET EXPONENT TO 32
 5574 T:1c37  85 9d                              sta FAC                ; BECAUSE 4-BYTE INTEGER NOW
 5575 T:1c39  a5 a1                              lda FAC+4          ; SAVE LOW 8-BITS OF INTEGER FORM
 5576 T:1c3b  85 0d                              sta CHARAC                ; FOR EXP AND POWER
 5577 T:1c3d  4c 29 18                           jmp NORMALIZE_FAC_1             ; NORMALIZE TO FINISH CONVERSION
 5578 T:1c40                                    ; --------------------------------
 5579 T:1c40  85 9e                    QINT_3    sta FAC+1       ; FAC=0, SO CLEAR ALL 4 BYTES FOR
 5580 T:1c42  85 9f                              sta FAC+2          ; INTEGER VERSION
 5581 T:1c44  85 a0                              sta FAC+3          ; 
 5582 T:1c46  85 a1                              sta FAC+4          ; 
 5583 T:1c48  a8                                 tay                    ; Y=0 TOO
 5584 T:1c49  60                       RTS_17    rts                 ; 
 5585 T:1c4a                                    ; --------------------------------
 5586 T:1c4a                                    ; CONVERT STRING TO FP VALUE IN FAC
 5587 T:1c4a                                    ; 
 5588 T:1c4a                                    ; STRING POINTED TO BY TXTPTR
 5589 T:1c4a                                    ; FIRST CHAR ALREADY SCANNED BY CHRGET
 5590 T:1c4a                                    ; (A) = FIRST CHAR, C=0 IF DIGIT.
 5591 T:1c4a                                    ; --------------------------------
 5592 T:1c4a  a0 00                    FIN       ldy #0          ; CLEAR WORKING AREA ($99...$A3)
 5593 T:1c4c  a2 0a                              ldx #10             ; TMPEXP, EXPON, DPFLG, EXPSGN, FAC, SERLEN
 5594 T:1c4e  94 99                    L_FIN_1   sty TMPEXP,X
 5595 T:1c50  ca                                 dex 
 5596 T:1c51  10 fb                              bpl L_FIN_1
 5597 T:1c53                                    ; --------------------------------
 5598 T:1c53  90 0f                              bcc FIN_2                ; FIRST CHAR IS A DIGIT
 5599 T:1c55  c9 2d                              cmp #("-"&%01111111)     ; CHECK FOR LEADING SIGN
 5600 T:1c57  d0 04                              bne L_FIN_2                ; NOT MINUS
 5601 T:1c59  86 a3                              stx SERLEN                ; MINUS, SET SERLEN = $FF FOR FLAG
 5602 T:1c5b  f0 04                              beq FIN_1                ; ...ALWAYS
 5603 T:1c5d  c9 2b                    L_FIN_2   cmp #("+"&%01111111)  ; MIGHT BE PLUS
 5604 T:1c5f  d0 05                              bne FIN_3                ; NOT PLUS EITHER, CHECK DECIMAL POINT
 5605 T:1c61                                    ; --------------------------------
 5606 T:1c61  20 b1 00                 FIN_1     jsr CHRGET             ; GET NEXT CHAR OF STRING
 5607 T:1c64                                    ; --------------------------------
 5608 T:1c64  90 5b                    FIN_2     bcc FIN_9             ; INSERT THIS DIGIT
 5609 T:1c66                                    ; --------------------------------
 5610 T:1c66  c9 2e                    FIN_3     cmp #("."&%01111111)  ; CHECK FOR DECIMAL POINT
 5611 T:1c68  f0 2e                              beq FIN_10                ; YES
 5612 T:1c6a  c9 45                              cmp #("E"&%01111111)     ; CHECK FOR EXPONENT PART
 5613 T:1c6c  d0 30                              bne FIN_7                ; NO, END OF NUMBER
 5614 T:1c6e  20 b1 00                           jsr CHRGET                ; YES, START CONVERTING EXPONENT
 5615 T:1c71  90 17                              bcc FIN_5                ; EXPONENT DIGIT
 5616 T:1c73  c9 c9                              cmp #TOKEN_MINUS               ; NEGATIVE EXPONENT?
 5617 T:1c75  f0 0e                              beq L_FIN_3_1                ; YES
 5618 T:1c77  c9 2d                              cmp #("-"&%01111111)     ; MIGHT NOT BE TOKENIZED YET
 5619 T:1c79  f0 0a                              beq L_FIN_3_1                ; YES, IT IS NEGATIVE
 5620 T:1c7b  c9 c8                              cmp #TOKEN_PLUS               ; OPTIONAL "+"
 5621 T:1c7d  f0 08                              beq FIN_4                ; YES
 5622 T:1c7f  c9 2b                              cmp #("+"&%01111111)     ; MIGHT NOT BE TOKENIZED YET
 5623 T:1c81  f0 04                              beq FIN_4                ; YES, FOUND "+"
 5624 T:1c83  d0 07                              bne FIN_6                ; ...ALWAYS, NUMBER COMPLETED
 5625 T:1c85  66 9c                    L_FIN_3_1 ror EXPSGN             ; C=1, SET FLAG NEGATIVE
 5626 T:1c87                                    ; --------------------------------
 5627 T:1c87  20 b1 00                 FIN_4     jsr CHRGET             ; GET NEXT DIGIT OF EXPONENT
 5628 T:1c8a                                    ; --------------------------------
 5629 T:1c8a  90 5c                    FIN_5     bcc GETEXP             ; CHAR IS A DIGIT OF EXPONENT
 5630 T:1c8c                                    ; --------------------------------
 5631 T:1c8c  24 9c                    FIN_6     bit EXPSGN             ; END OF NUMBER, CHECK EXP SIGN
 5632 T:1c8e  10 0e                              bpl FIN_7                ; POSITIVE EXPONENT
 5633 T:1c90  a9 00                              lda #0             ; NEGATIVE EXPONENT
 5634 T:1c92  38                                 sec                    ; MAKE 2'S COMPLEMENT OF EXPONENT
 5635 T:1c93  e5 9a                              sbc EXPON                ; 
 5636 T:1c95  4c a0 1c                           jmp FIN_8                ; 
 5637 T:1c98                                    ; --------------------------------
 5638 T:1c98                                    ; FOUND A DECIMAL POINT
 5639 T:1c98                                    ; --------------------------------
 5640 T:1c98  66 9b                    FIN_10    ror DPFLG             ; C=1, SET DPFLG FOR DECIMAL POINT
 5641 T:1c9a  24 9b                              bit DPFLG                ; CHECK IF PREVIOUS DEC. PT.
 5642 T:1c9c  50 c3                              bvc FIN_1             ; NO PREVIOUS DECIMAL POINT
 5643 T:1c9e                                    ; A SECOND DECIMAL POINT IS TAKEN AS A TERMINATOR
 5644 T:1c9e                                    ; TO THE NUMERIC STRING.
 5645 T:1c9e                                    ; "A=11..22" WILL GIVE A SYNTAX ERROR, BECAUSE
 5646 T:1c9e                                    ; IT IS TWO NUMBERS WITH NO OPERATOR BETWEEN.
 5647 T:1c9e                                    ; "PRINT 11..22" GIVES NO ERROR, BECAUSE IT IS
 5648 T:1c9e                                    ; JUST THE CONCATENATION OF TWO NUMBERS.
 5649 T:1c9e                                    ; --------------------------------
 5650 T:1c9e                                    ; NUMBER TERMINATED, ADJUST EXPONENT NOW
 5651 T:1c9e                                    ; --------------------------------
 5652 T:1c9e  a5 9a                    FIN_7     lda EXPON             ; E-VALUE
 5653 T:1ca0  38                       FIN_8     sec                 ; MODIFY WITH COUNT OF DIGITS
 5654 T:1ca1  e5 99                              sbc TMPEXP                ; AFTER THE DECIMAL POINT
 5655 T:1ca3  85 9a                              sta EXPON                ; COMPLETE CURRENT EXPONENT
 5656 T:1ca5  f0 12                              beq L_FIN_8_15                ; NO ADJUST NEEDED IF EXP=0
 5657 T:1ca7  10 09                              bpl L_FIN_8_14                ; EXP>0, MULTIPLY BY TEN
 5658 T:1ca9  20 55 1a                 L_FIN_8_13 jsr DIV10          ; EXP<0, DIVIDE BY TEN
 5659 T:1cac  e6 9a                              inc EXPON                ; UNTIL EXP=0
 5660 T:1cae  d0 f9                              bne L_FIN_8_13             ; 
 5661 T:1cb0  f0 07                              beq L_FIN_8_15                ; ...ALWAYS, WE ARE FINISHED
 5662 T:1cb2  20 39 1a                 L_FIN_8_14 jsr MUL10          ; EXP>0, MULTIPLY BKY TEN
 5663 T:1cb5  c6 9a                              dec EXPON                ; UNTIL EXP=0
 5664 T:1cb7  d0 f9                              bne L_FIN_8_14             ; 
 5665 T:1cb9  a5 a3                    L_FIN_8_15 lda SERLEN             ; IS WHOLE NUMBER NEGATIVE?
 5666 T:1cbb  30 01                              bmi L_FIN_8_16                ; YES
 5667 T:1cbd  60                                 rts                    ; NO, RETURN, WHOLE JOB DONE!
 5668 T:1cbe  4c d0 1e                 L_FIN_8_16 jmp NEGOP             ; NEGATIVE NUMBER, SO NEGATE FAC
 5669 T:1cc1                                    ; --------------------------------
 5670 T:1cc1                                    ; ACCUMULATE A DIGIT INTO FAC
 5671 T:1cc1                                    ; --------------------------------
 5672 T:1cc1  48                       FIN_9     pha                 ; SAVE DIGIT
 5673 T:1cc2  24 9b                              bit DPFLG                ; SEEN A DECIMAL POINT YET?
 5674 T:1cc4  10 02                              bpl L_FIN_9_1                ; NO, STILL IN INTEGER PART
 5675 T:1cc6  e6 99                              inc TMPEXP                ; YES, COUNT THE FRACTIONAL DIGIT
 5676 T:1cc8  20 39 1a                 L_FIN_9_1 jsr MUL10          ; FAC = FAC * 10
 5677 T:1ccb  68                                 pla                    ; CURRENT DIGIT
 5678 T:1ccc  38                                 sec                    ; <<<SHORTER HERE TO JUST "AND #$0F">>>
 5679 T:1ccd  e9 30                              sbc #("0"&%01111111)     ; <<<TO CONVERT ASCII TO BINARY FORM>>>
 5680 T:1ccf  20 d5 1c                           jsr ADDACC                ; ADD THE DIGIT
 5681 T:1cd2  4c 61 1c                           jmp FIN_1             ; GO BACK FOR MORE
 5682 T:1cd5                                    ; --------------------------------
 5683 T:1cd5                                    ; ADD (A) TO FAC
 5684 T:1cd5                                    ; --------------------------------
 5685 T:1cd5  48                       ADDACC    pha                 ; SAVE ADDEND
 5686 T:1cd6  20 63 1b                           jsr COPY_FAC_TO_ARG_ROUNDED
 5687 T:1cd9  68                                 pla                    ; GET ADDEND AGAIN
 5688 T:1cda  20 93 1b                           jsr FLOAT             ; CONVERT TO FP VALUE IN FAC
 5689 T:1cdd  a5 aa                              lda ARG_SIGN                ; 
 5690 T:1cdf  45 a2                              eor FAC_SIGN                ; 
 5691 T:1ce1  85 ab                              sta SGNCPR                ; 
 5692 T:1ce3  a6 9d                              ldx FAC                ; TO SIGNAL IF FAC=0
 5693 T:1ce5  4c c1 17                           jmp FADDT             ; PERFORM THE ADDITION
 5694 T:1ce8                                    ; --------------------------------
 5695 T:1ce8                                    ; ACCUMULATE DIGIT OF EXPONENT
 5696 T:1ce8                                    ; --------------------------------
 5697 T:1ce8  a5 9a                    GETEXP    lda EXPON             ; CHECK CURRENT VALUE
 5698 T:1cea  c9 0a                              cmp #10             ; FOR MORE THAN 2 DIGITS
 5699 T:1cec  90 09                              bcc L_GETEXP_1                ; NO, THIS IS 1ST OR 2ND DIGIT
 5700 T:1cee  a9 64                              lda #100             ; EXPONENT TOO BIG
 5701 T:1cf0  24 9c                              bit EXPSGN                ; UNLESS IT IS NEGATIVE
 5702 T:1cf2  30 11                              bmi L_GETEXP_2                ; LARGE NEGATIVE EXPONENT MAKES FAC=0
 5703 T:1cf4  4c d5 18                           jmp OVERFLOW             ; LARGE POSITIVE EXPONENT IS ERROR
 5704 T:1cf7  0a                       L_GETEXP_1 asl                 ; EXPONENT TIMES 10
 5705 T:1cf8  0a                                 asl                    ; 
 5706 T:1cf9  18                                 clc                    ; 
 5707 T:1cfa  65 9a                              adc EXPON                ; 
 5708 T:1cfc  0a                                 asl                    ; 
 5709 T:1cfd  18                                 clc                    ; <<< ASL ALREADY DID THIS! >>>
 5710 T:1cfe  a0 00                              ldy #0             ; ADD THE NEW DIGIT
 5711 T:1d00  71 b8                              adc (TXTPTR),Y                  ; BUT THIS IS IN ASCII,
 5712 T:1d02  38                                 sec                    ; SO ADJUST BACK TO BINARY
 5713 T:1d03  e9 30                              sbc #("0"&%01111111)
 5714 T:1d05  85 9a                    L_GETEXP_2 sta EXPON             ; NEW VALUE
 5715 T:1d07  4c 87 1c                           jmp FIN_4             ; BACK FOR MORE
 5716 T:1d0a                                    ; --------------------------------
 5717 T:1d0a                                    ; --------------------------------

 5719 T:1d0a  9b 3e bc 1f fd           CON_99999999P9 .byt $9b,$3e,$bc,$1f,$fd; 99,999,999.9
 5720 T:1d0f  9e 6e 6b 27 fd           CON_999999999 .byt $9e,$6e,$6b,$27,$fd; 999,999,999
 5721 T:1d14  9e 6e 6b 28 00           CON_BILLION .byt $9e,$6e,$6b,$28,$00; 1,000,000,000
 5722 T:1d19                                    ; --------------------------------
 5723 T:1d19                                    ; PRINT "IN <LINE #>"
 5724 T:1d19                                    ; --------------------------------
 5725 T:1d19  a9 58                    INPRT     lda #<QT_IN        ; PRINT " IN "
 5726 T:1d1b  a0 03                              ldy #>QT_IN
 5727 T:1d1d  20 31 1d                           jsr GO_STROUT
 5728 T:1d20  a5 76                              lda CURLIN+1
 5729 T:1d22  a6 75                              ldx CURLIN
 5730 T:1d24                                    ; --------------------------------
 5731 T:1d24                                    ; PRINT A,X AS DECIMAL INTEGER
 5732 T:1d24                                    ; --------------------------------
 5733 T:1d24  85 9e                    LINPRT    sta FAC+1       ; PRINT A,X IN DECIMAL
 5734 T:1d26  86 9f                              stx FAC+2          ; 
 5735 T:1d28  a2 90                              ldx #$90             ; EXPONENT = 2^16
 5736 T:1d2a  38                                 sec                    ; CONVERT UNSIGNED
 5737 T:1d2b  20 a0 1b                           jsr FLOAT_2             ; CONVERT LINE # TO FP
 5738 T:1d2e                                    ; --------------------------------
 5739 T:1d2e                                    ; CONVERT (FAC) TO STRING, AND PRINT IT
 5740 T:1d2e                                    ; --------------------------------
 5741 T:1d2e                           PRINT_FAC                  ; 
 5742 T:1d2e  20 34 1d                           jsr FOUT                ; CONVERT (FAC) TO STRING AT STACK
 5743 T:1d31                                    ; --------------------------------
 5744 T:1d31                                    ; PRINT STRING STARTING AT Y,A
 5745 T:1d31                                    ; --------------------------------
 5746 T:1d31                           GO_STROUT                  ; 
 5747 T:1d31  4c 3a 0b                           jmp STROUT             ; PRINT STRING AT A,Y
 5748 T:1d34                                    ; --------------------------------
 5749 T:1d34                                    ; CONVERT (FAC) TO STRING STARTING AT STACK
 5750 T:1d34                                    ; RETURN WITH (Y,A) POINTING AT STRING
 5751 T:1d34                                    ; --------------------------------
 5752 T:1d34  a0 01                    FOUT      ldy #1          ; NORMAL ENTRY PUTS STRING AT STACK...
 5753 T:1d36                                    ; --------------------------------
 5754 T:1d36                                    ; "STR$" FUNCTION ENTERS HERE, WITH (Y)=0
 5755 T:1d36                                    ; SO THAT RESULT STRING STARTS AT STACK-1
 5756 T:1d36                                    ; (THIS IS USED AS A FLAG)
 5757 T:1d36                                    ; --------------------------------
 5758 T:1d36  a9 2d                    FOUT_1    lda #("-"&%01111111)  ; IN CASE VALUE NEGATIVE
 5759 T:1d38  88                                 dey                    ; BACK UP PNTR
 5760 T:1d39  24 a2                              bit FAC_SIGN                ; 
 5761 T:1d3b  10 04                              bpl L_FOUT_1_1                ; VALUE IS +
 5762 T:1d3d  c8                                 iny                    ; VALUE IS -
 5763 T:1d3e  99 ff 00                           sta STACK-1,Y                   ; EMIT "-"
 5764 T:1d41  85 a2                    L_FOUT_1_1 sta FAC_SIGN             ; MAKE FAC.SIGN POSITIVE ($2D)
 5765 T:1d43  84 ad                              sty STRNG2                ; SAVE STRING PNTR
 5766 T:1d45  c8                                 iny                    ; 
 5767 T:1d46  a9 30                              lda #("0"&%01111111)     ; IN CASE (FAC)=0
 5768 T:1d48  a6 9d                              ldx FAC                ; NUMBER=0?
 5769 T:1d4a  d0 03                              bne L_FOUT_1_2                ; NO, (FAC) NOT ZERO
 5770 T:1d4c  4c 57 1e                           jmp FOUT_4                ; YES, FINISHED
 5771 T:1d4f                                    ; --------------------------------
 5772 T:1d4f  a9 00                    L_FOUT_1_2 lda #0          ; STARTING VALUE FOR TMPEXP
 5773 T:1d51  e0 80                              cpx #$80             ; ANY INTEGER PART?
 5774 T:1d53  f0 02                              beq L_FOUT_1_3                ; NO, BTWN L_FOUT_1_5 AND L_FOUT_1_999999999
 5775 T:1d55  b0 09                              bcs L_FOUT_1_4                ; YES
 5776 T:1d57                                    ; --------------------------------
 5777 T:1d57  a9 14                    L_FOUT_1_3 lda #<CON_BILLION        ; MULTIPLY BY 1E9
 5778 T:1d59  a0 1d                              ldy #>CON_BILLION           ; TO GIVE ADJUSTMENT A HEAD START
 5779 T:1d5b  20 7f 19                           jsr FMULT             ; 
 5780 T:1d5e  a9 f7                              lda #$0100-9       ; EXPONENT ADJUSTMENT
 5781 T:1d60  85 99                    L_FOUT_1_4 sta TMPEXP             ; 0 OR -9
 5782 T:1d62                                    ; --------------------------------
 5783 T:1d62                                    ; ADJUST UNTIL 1E8 <= (FAC) <1E9
 5784 T:1d62                                    ; --------------------------------
 5785 T:1d62  a9 0f                    L_FOUT_1_5 lda #<CON_999999999
 5786 T:1d64  a0 1d                              ldy #>CON_999999999
 5787 T:1d66  20 b2 1b                           jsr FCOMP             ; COMPARE TO 1E9-1
 5788 T:1d69  f0 1e                              beq L_FOUT_1_10                ; (FAC) = 1E9-1
 5789 T:1d6b  10 12                              bpl L_FOUT_1_8                ; TOO LARGE, DIVIDE BY TEN
 5790 T:1d6d  a9 0a                    L_FOUT_1_6 lda #<CON_99999999P9        ; COMPARE TO 1E8-L_FOUT_1_1
 5791 T:1d6f  a0 1d                              ldy #>CON_99999999P9
 5792 T:1d71  20 b2 1b                           jsr FCOMP             ; COMPARE TO 1E8-L_FOUT_1_1
 5793 T:1d74  f0 02                              beq L_FOUT_1_7                ; (FAC) = 1E8-L_FOUT_1_1
 5794 T:1d76  10 0e                              bpl L_FOUT_1_9                ; IN RANGE, ADJUSTMENT FINISHED
 5795 T:1d78  20 39 1a                 L_FOUT_1_7 jsr MUL10          ; TOO SMALL, MULTIPLY BY TEN
 5796 T:1d7b  c6 99                              dec TMPEXP                ; KEEP TRACK OF MULTIPLIES
 5797 T:1d7d  d0 ee                              bne L_FOUT_1_6             ; ...ALWAYS
 5798 T:1d7f  20 55 1a                 L_FOUT_1_8 jsr DIV10          ; TOO LARGE, DIVIDE BY TEN
 5799 T:1d82  e6 99                              inc TMPEXP                ; KEEP TRACK OF DIVISIONS
 5800 T:1d84  d0 dc                              bne L_FOUT_1_5             ; ...ALWAYS
 5801 T:1d86                                    ; --------------------------------
 5802 T:1d86  20 a0 17                 L_FOUT_1_9 jsr FADDH          ; ROUND ADJUSTED RESULT
 5803 T:1d89  20 f2 1b                 L_FOUT_1_10 jsr QINT          ; CONVERT ADJUSTED VALUE TO 32-BIT INTEGER
 5804 T:1d8c                                    ; --------------------------------
 5805 T:1d8c                                    ; FAC+1...FAC+4 IS NOW IN INTEGER FORM
 5806 T:1d8c                                    ; WITH POWER OF TEN ADJUSTMENT IN TMPEXP
 5807 T:1d8c                                    ; 
 5808 T:1d8c                                    ; IF -10 < TMPEXP > 1, PRINT IN DECIMAL FORM
 5809 T:1d8c                                    ; OTHERWISE, PRINT IN EXPONENTIAL FORM
 5810 T:1d8c                                    ; --------------------------------
 5811 T:1d8c  a2 01                    FOUT_2    ldx #1          ; ASSUME 1 DIGIT BEFORE "."
 5812 T:1d8e  a5 99                              lda TMPEXP                ; CHECK RANGE
 5813 T:1d90  18                                 clc                    ; 
 5814 T:1d91  69 0a                              adc #10             ; 
 5815 T:1d93  30 09                              bmi L_FOUT_2_1                ; < .01, USE EXPONENTIAL FORM
 5816 T:1d95  c9 0b                              cmp #11             ; 
 5817 T:1d97  b0 06                              bcs L_FOUT_2_2                ; >= 1E10, USE EXPONENTIAL FORM
 5818 T:1d99  69 ff                              adc #$ff             ; LESS 1 GIVES INDEX FOR "."
 5819 T:1d9b  aa                                 tax                    ; 
 5820 T:1d9c  a9 02                              lda #2             ; SET REMAINING EXPONENT = 0
 5821 T:1d9e  38                       L_FOUT_2_1 sec                 ; COMPUTE REMAINING EXPONENT
 5822 T:1d9f  e9 02                    L_FOUT_2_2 sbc #2          ; 
 5823 T:1da1  85 9a                              sta EXPON                ; VALUE FOR "E+XX" OR "E-XX"
 5824 T:1da3  86 99                              stx TMPEXP                ; INDEX FOR DECIMAL POINT
 5825 T:1da5  8a                                 txa                    ; SEE IF "." COMES FIRST
 5826 T:1da6  f0 02                              beq L_FOUT_2_3                ; YES
 5827 T:1da8  10 13                              bpl L_FOUT_2_5                ; NO, LATER
 5828 T:1daa  a4 ad                    L_FOUT_2_3 ldy STRNG2             ; GET INDEX INTO STRING BEING BUILT
 5829 T:1dac  a9 2e                              lda #("."&%01111111)     ; STORE A DECIMAL POINT
 5830 T:1dae  c8                                 iny                    ; 
 5831 T:1daf  99 ff 00                           sta STACK-1,Y                   ; 
 5832 T:1db2  8a                                 txa                    ; SEE IF NEED ".0"
 5833 T:1db3  f0 06                              beq L_FOUT_2_4                ; NO
 5834 T:1db5  a9 30                              lda #("0"&%01111111)     ; YES, STORE "0"
 5835 T:1db7  c8                                 iny                    ; 
 5836 T:1db8  99 ff 00                           sta STACK-1,Y                   ; 
 5837 T:1dbb  84 ad                    L_FOUT_2_4 sty STRNG2             ; SAVE OUTPUT INDEX AGAIN
 5838 T:1dbd                                    ; --------------------------------
 5839 T:1dbd                                    ; NOW DIVIDE BY POWERS OF TEN TO GET SUCCESSIVE DIGITS
 5840 T:1dbd                                    ; --------------------------------
 5841 T:1dbd  a0 00                    L_FOUT_2_5 ldy #0          ; INDEX TO TABLE OF POWERS OF TEN
 5842 T:1dbf  a2 80                              ldx #$80             ; STARTING VALUE FOR DIGIT WITH DIRECTION
 5843 T:1dc1  a5 a1                    L_FOUT_2_6 lda FAC+4       ; START BY ADDING -100000000 UNTIL
 5844 T:1dc3  18                                 clc                    ; OVERSHOOT.  THEN ADD +10000000,
 5845 T:1dc4  79 6c 1e                           adc DECTBL+3,Y                  ; THEN ADD -1000000, THEN ADD
 5846 T:1dc7  85 a1                              sta FAC+4          ; +100000, AND SO ON.
 5847 T:1dc9  a5 a0                              lda FAC+3          ; THE # OF TIMES EACH POWER IS ADDED
 5848 T:1dcb  79 6b 1e                           adc DECTBL+2,Y                  ; IS 1 MORE THAN CORRESPONDING DIGIT
 5849 T:1dce  85 a0                              sta FAC+3
 5850 T:1dd0  a5 9f                              lda FAC+2
 5851 T:1dd2  79 6a 1e                           adc DECTBL+1,Y
 5852 T:1dd5  85 9f                              sta FAC+2
 5853 T:1dd7  a5 9e                              lda FAC+1
 5854 T:1dd9  79 69 1e                           adc DECTBL,Y
 5855 T:1ddc  85 9e                              sta FAC+1
 5856 T:1dde  e8                                 inx                    ; COUNT THE ADD
 5857 T:1ddf  b0 04                              bcs L_FOUT_2_7                ; IF C=1 AND X NEGATIVE, KEEP ADDING
 5858 T:1de1  10 de                              bpl L_FOUT_2_6             ; IF C=0 AND X POSITIVE, KEEP ADDING
 5859 T:1de3  30 02                              bmi L_FOUT_2_8                ; IF C=0 AND X NEGATIVE, WE OVERSHOT
 5860 T:1de5  30 da                    L_FOUT_2_7 bmi L_FOUT_2_6          ; IF C=1 AND X POSITIVE, WE OVERSHOT
 5861 T:1de7  8a                       L_FOUT_2_8 txa                 ; OVERSHOT, SO MAKE X INTO A DIGIT
 5862 T:1de8  90 04                              bcc L_FOUT_2_9                ; HOW DEPENDS ON DIRECTION WE WERE GOING
 5863 T:1dea  49 ff                              eor #$ff             ; DIGIT = 9-X
 5864 T:1dec  69 0a                              adc #10             ; 
 5865 T:1dee  69 2f                    L_FOUT_2_9 adc #("0"&%01111111)-1; MAKE DIGIT INTO ASCII
 5866 T:1df0  c8                                 iny                    ; ADVANCE TO NEXT SMALLER POWER OF TEN
 5867 T:1df1  c8                                 iny                    ; 
 5868 T:1df2  c8                                 iny                    ; 
 5869 T:1df3  c8                                 iny                    ; 
 5870 T:1df4  84 83                              sty VARPNT                ; SAVE PNTR TO POWERS
 5871 T:1df6  a4 ad                              ldy STRNG2                ; GET OUTPUT PNTR
 5872 T:1df8  c8                                 iny                    ; STORE THE DIGIT
 5873 T:1df9  aa                                 tax                    ; SAVE DIGIT, HI-BIT IS DIRECTION
 5874 T:1dfa  29 7f                              and #$7f             ; MAKE SURE $30...$39 FOR STRING
 5875 T:1dfc  99 ff 00                           sta STACK-1,Y                   ; 
 5876 T:1dff  c6 99                              dec TMPEXP                ; COUNT THE DIGIT
 5877 T:1e01  d0 06                              bne L_FOUT_2_10                ; NOT TIME FOR "." YET
 5878 T:1e03  a9 2e                              lda #("."&%01111111)     ; TIME, SO STORE THE DECIMAL POINT
 5879 T:1e05  c8                                 iny                    ; 
 5880 T:1e06  99 ff 00                           sta STACK-1,Y                   ; 
 5881 T:1e09  84 ad                    L_FOUT_2_10 sty STRNG2             ; SAVE OUTPUT PNTR AGAIN
 5882 T:1e0b  a4 83                              ldy VARPNT                ; GET PNTR TO POWERS
 5883 T:1e0d  8a                                 txa                    ; GET DIGIT WITH HI-BIT = DIRECTION
 5884 T:1e0e  49 ff                              eor #$ff             ; CHANGE DIRECTION
 5885 T:1e10  29 80                              and #$80             ; $00 IF ADDING, $80 IF SUBTRACTING
 5886 T:1e12  aa                                 tax 
 5887 T:1e13  c0 24                              cpy #DECTBL_END-DECTBL
 5888 T:1e15  d0 aa                              bne L_FOUT_2_6             ; NOT FINISHED YET
 5889 T:1e17                                    ; --------------------------------
 5890 T:1e17                                    ; NINE DIGITS HAVE BEEN STORED IN STRING.  NOW LOOK
 5891 T:1e17                                    ; BACK AND LOP OFF TRAILING ZEROES AND A TRAILING
 5892 T:1e17                                    ; DECIMAL POINT.
 5893 T:1e17                                    ; --------------------------------
 5894 T:1e17  a4 ad                    FOUT_3    ldy STRNG2             ; POINTS AT LAST STORED CHAR
 5895 T:1e19  b9 ff 00                 L_FOUT_3_1 lda STACK-1,Y                   ; SEE IF LOPPABLE
 5896 T:1e1c  88                                 dey                    ; 
 5897 T:1e1d  c9 30                              cmp #("0"&%01111111)     ; SUPPRESS TRAILING ZEROES
 5898 T:1e1f  f0 f8                              beq L_FOUT_3_1             ; YES, KEEP LOOPING
 5899 T:1e21  c9 2e                              cmp #("."&%01111111)     ; SUPPRESS TRAILING DECIMAL POINT
 5900 T:1e23  f0 01                              beq L_FOUT_3_2                ; ".", SO WRITE OVER IT
 5901 T:1e25  c8                                 iny                    ; NOT ".", SO INCLUDE IN STRING AGAIN
 5902 T:1e26  a9 2b                    L_FOUT_3_2 lda #("+"&%01111111)  ; PREPARE FOR POSITIVE EXPONENT "E+XX"
 5903 T:1e28  a6 9a                              ldx EXPON                ; SEE IF ANY E-VALUE
 5904 T:1e2a  f0 2e                              beq FOUT_5                ; NO, JUST MARK END OF STRING
 5905 T:1e2c  10 08                              bpl L_FOUT_3_3                ; YES, AND IT IS POSITIVE
 5906 T:1e2e  a9 00                              lda #0             ; YES, AND IT IS NEGATIVE
 5907 T:1e30  38                                 sec                    ; COMPLEMENT THE VALUE
 5908 T:1e31  e5 9a                              sbc EXPON                ; 
 5909 T:1e33  aa                                 tax                    ; GET MAGNITUDE IN X
 5910 T:1e34  a9 2d                              lda #("-"&%01111111)     ; E SIGN
 5911 T:1e36  99 01 01                 L_FOUT_3_3 sta STACK+1,Y                   ; STORE SIGN IN STRING
 5912 T:1e39  a9 45                              lda #("E"&%01111111)     ; STORE "E" IN STRING BEFORE SIGN
 5913 T:1e3b  99 00 01                           sta STACK,Y                     ; 
 5914 T:1e3e  8a                                 txa                    ; EXPONENT MAGNITUDE IN A-REG
 5915 T:1e3f  a2 2f                              ldx #("0"&%01111111)-1; SEED FOR EXPONENT DIGIT
 5916 T:1e41  38                                 sec                    ; CONVERT TO DECIMAL
 5917 T:1e42  e8                       L_FOUT_3_4 inx                 ; COUNT THE SUBTRACTION
 5918 T:1e43  e9 0a                              sbc #10             ; TEN'S DIGIT
 5919 T:1e45  b0 fb                              bcs L_FOUT_3_4             ; MORE TENS TO SUBTRACT
 5920 T:1e47  69 3a                              adc #("0"&%01111111)+10; CONVERT REMAINDER TO ONE'S DIGIT
 5921 T:1e49  99 03 01                           sta STACK+3,Y                   ; STORE ONE'S DIGIT
 5922 T:1e4c  8a                                 txa                    ; 
 5923 T:1e4d  99 02 01                           sta STACK+2,Y                   ; STORE TEN'S DIGIT
 5924 T:1e50  a9 00                              lda #0             ; MARK END OF STRING WITH $00
 5925 T:1e52  99 04 01                           sta STACK+4,Y                   ; 
 5926 T:1e55  f0 08                              beq FOUT_6                ; ...ALWAYS
 5927 T:1e57  99 ff 00                 FOUT_4    sta STACK-1,Y                   ; STORE "0" IN ASCII
 5928 T:1e5a  a9 00                    FOUT_5    lda #0          ; STORE $00 ON END OF STRING
 5929 T:1e5c  99 00 01                           sta STACK,Y                     ; 
 5930 T:1e5f  a9 00                    FOUT_6    lda #<STACK           ; POINT Y,A AT BEGINNING OF STRING
 5931 T:1e61  a0 01                              ldy #>STACK              ; (STR$ STARTED STRING AT STACK-1, BUT
 5932 T:1e63  60                                 rts                    ; STR$ DOESN'T USE Y,A ANYWAY.)
