 3319 T:0fe3                                    ; PTRGET -- GENERAL VARIABLE SCAN
 3320 T:0fe3                                    ; 
 3321 T:0fe3                                    ; SCANS VARIABLE NAME AT TXTPTR, AND SEARCHES THE
 3322 T:0fe3                                    ; VARTAB AND ARYTAB FOR THE NAME.
 3323 T:0fe3                                    ; IF NOT FOUND, CREATE VARIABLE OF APPROPRIATE TYPE.
 3324 T:0fe3                                    ; RETURN WITH ADDRESS IN VARPNT AND Y,A
 3325 T:0fe3                                    ; 
 3326 T:0fe3                                    ; ACTUAL ACTIVITY CONTROLLED SOMEWHAT BY TWO FLAGS:
 3327 T:0fe3                                    ; DIMFLG -- NONZERO IF CALLED FROM "DIM"
 3328 T:0fe3                                    ; ELSE = 0
 3329 T:0fe3                                    ; 
 3330 T:0fe3                                    ; SUBFLG -- = $00
 3331 T:0fe3                                    ; = $40 IF CALLED FROM "GETARYPT"
 3332 T:0fe3                                    ; = $80 IF CALLED FROM "DEF FN"
 3333 T:0fe3                                    ; = $C1-DA IF CALLED FROM "FN"
 3334 T:0fe3                                    ; --------------------------------
 3335 T:0fe3  a2 00                    PTRGET    ldx #0          ; 
 3336 T:0fe5  20 b7 00                           jsr CHRGOT                ; GET FIRST CHAR OF VARIABLE NAME
 3337 T:0fe8                                    ; --------------------------------
 3338 T:0fe8                           PTRGET2                    ; 
 3339 T:0fe8  86 10                              stx DIMFLG                ; X IS NONZERO IF FROM DIM
 3340 T:0fea                                    ; --------------------------------
