 6850 T:23f6                                    ; FILL SCREEN WITH (HGR.BITS)
 6851 T:23f6                                    ; --------------------------------
 6852 T:23f6  a5 e6                    BKGND     lda HGR_PAGE             ; PUT BUFFER ADDRESS IN HGR.SHAPE
 6853 T:23f8  85 1b                              sta HGR_SHAPE+1
 6854 T:23fa  a0 00                              ldy #0
 6855 T:23fc  84 1a                              sty HGR_SHAPE
 6856 T:23fe  a5 1c                    L_BKGND_1 lda HGR_BITS             ; COLOR BYTE
 6857 T:2400  91 1a                              sta (HGR_SHAPE),Y               ; CLEAR HIRES TO HGR.BITS
 6858 T:2402  20 7e 24                           jsr COLOR_SHIFT                ; CORRECT FOR COLOR SHIFT
 6859 T:2405  c8                                 iny                    ; (SLOWS CLEAR BY FACTOR OF 2)
 6860 T:2406  d0 f6                              bne L_BKGND_1
 6861 T:2408  e6 1b                              inc HGR_SHAPE+1
 6862 T:240a  a5 1b                              lda HGR_SHAPE+1
 6863 T:240c  29 1f                              and #$1f             ; DONE?  ($40 OR$60)
 6864 T:240e  d0 ee                              bne L_BKGND_1             ; NO
 6865 T:2410  60                                 rts                    ; YES, RETURN
 6866 T:2411                                    ; --------------------------------
 6867 T:2411                                    ; SET THE HIRES CURSOR POSITION
 6868 T:2411                                    ; 
 6869 T:2411                                    ; (Y,X) = HORIZONTAL COORDINATE  (0-279)
 6870 T:2411                                    ; (A)   = VERTICAL COORDINATE    (0-191)
 6871 T:2411                                    ; --------------------------------
 6872 T:2411  85 e2                    HPOSN     sta HGR_Y             ; SAVE Y- AND X-POSITIONS
 6873 T:2413  86 e0                              stx HGR_X                ; 
 6874 T:2415  84 e1                              sty HGR_X+1          ; 
 6875 T:2417  48                                 pha                    ; Y-POS ALSO ON STACK
 6876 T:2418  29 c0                              and #$c0             ; CALCULATE BASE ADDRESS FOR Y-POS
 6877 T:241a  85 26                              sta MON_GBASL                ; FOR Y=ABCDEFGH
 6878 T:241c  4a                                 lsr                    ; GBASL=ABAB0000
 6879 T:241d  4a                                 lsr                    ; 
 6880 T:241e  05 26                              ora MON_GBASL                ; 
 6881 T:2420  85 26                              sta MON_GBASL                ; 
 6882 T:2422  68                                 pla                    ; (A)      (GBASH)   (GBASL)
 6883 T:2423  85 27                              sta MON_GBASH                ; ?-ABCDEFGH  ABCDEFGH  ABAB0000
 6884 T:2425  0a                                 asl                    ; A-BCDEFGH0  ABCDEFGH  ABAB0000
 6885 T:2426  0a                                 asl                    ; B-CDEFGH00  ABCDEFGH  ABAB0000
 6886 T:2427  0a                                 asl                    ; C-DEFGH000  ABCDEFGH  ABAB0000
 6887 T:2428  26 27                              rol MON_GBASH                ; A-DEFGH000  BCDEFGHC  ABAB0000
 6888 T:242a  0a                                 asl                    ; D-EFGH0000  BCDEFGHC  ABAB0000
 6889 T:242b  26 27                              rol MON_GBASH                ; B-EFGH0000  CDEFGHCD  ABAB0000
 6890 T:242d  0a                                 asl                    ; E-FGH00000  CDEFGHCD  ABAB0000
 6891 T:242e  66 26                              ror MON_GBASL                ; 0-FGH00000  CDEFGHCD  EABAB000
 6892 T:2430  a5 27                              lda MON_GBASH                ; 0-CDEFGHCD  CDEFGHCD  EABAB000
 6893 T:2432  29 1f                              and #$1f             ; 0-000FGHCD  CDEFGHCD  EABAB000
 6894 T:2434  05 e6                              ora HGR_PAGE                ; 0-PPPFGHCD  CDEFGHCD  EABAB000
 6895 T:2436  85 27                              sta MON_GBASH                ; 0-PPPFGHCD  PPPFGHCD  EABAB000
 6896 T:2438  8a                                 txa                    ; DIVIDE X-POS BY 7 FOR INDEX FROM BASE
 6897 T:2439  c0 00                              cpy #0             ; IS X-POS < 256?
 6898 T:243b  f0 05                              beq L_HPOSN_2                ; YES
 6899 T:243d  a0 23                              ldy #35             ; NO: 256/7 = 36 REM 4
 6900 T:243f                                    ; CARRY=1, SO ADC #4 IS TOO LARGE;
 6901 T:243f                                    ; HOWEVER, ADC #4 CLEARS CARRY
 6902 T:243f                                    ; WHICH MAKES SBC #7 ONLY -6
 6903 T:243f                                    ; BALANCING IT OUT.
 6904 T:243f  69 04                              adc #4             ; FOLLOWING INY MAKES Y=36
 6905 T:2441  c8                       L_HPOSN_1 iny 
 6906 T:2442  e9 07                    L_HPOSN_2 sbc #7
 6907 T:2444  b0 fb                              bcs L_HPOSN_1
 6908 T:2446  84 e5                              sty HGR_HORIZ                ; HORIZONTAL INDEX
 6909 T:2448  aa                                 tax                    ; USE REMAINDER-7 TO LOOK UP THE
 6910 T:2449  bd b9 24                           lda MSKTBL-$0100+7,X             ; BIT MASK
 6911 T:244c  85 30                              sta MON_HMASK
 6912 T:244e  98                                 tya                    ; QUOTIENT GIVES BYTE INDEX
 6913 T:244f  4a                                 lsr                    ; ODD OR EVEN COLUMN?
 6914 T:2450  a5 e4                              lda HGR_COLOR                ; IF ON ODD BYTE (CARRY SET)
 6915 T:2452  85 1c                              sta HGR_BITS                ; THEN ROTATE BITS
 6916 T:2454  b0 28                              bcs COLOR_SHIFT                ; ODD COLUMN
 6917 T:2456  60                                 rts                    ; EVEN COLUMN
 6918 T:2457                                    ; --------------------------------
 6919 T:2457                                    ; PLOT A DOT
 6920 T:2457                                    ; 
 6921 T:2457                                    ; (Y,X) = HORIZONTAL POSITION
 6922 T:2457                                    ; (A)   = VERTICAL POSITION
 6923 T:2457                                    ; --------------------------------
 6924 T:2457  20 11 24                 HPLOT0    jsr HPOSN
 6925 T:245a  a5 1c                              lda HGR_BITS                ; CALCULATE BIT POSN IN GBAS,
 6926 T:245c  51 26                              eor (MON_GBASL),Y               ; HGR.HORIZ, AND HMASK FROM
 6927 T:245e  25 30                              and MON_HMASK                ; Y-COOR IN A-REG,
 6928 T:2460  51 26                              eor (MON_GBASL),Y               ; X-COOR IN X,Y REGS.
 6929 T:2462  91 26                              sta (MON_GBASL),Y               ; FOR ANY 1-BITS, SUBSTITUTE
 6930 T:2464  60                                 rts                    ; CORRESPONDING BIT OF HGR.BITS
 6931 T:2465                                    ; --------------------------------
 6932 T:2465                                    ; MOVE LEFT OR RIGHT ONE PIXEL
 6933 T:2465                                    ; 
 6934 T:2465                                    ; IF STATUS IS +, MOVE RIGHT; IF -, MOVE LEFT
 6935 T:2465                                    ; IF ALREADY AT LEFT OR RIGHT EDGE, WRAP AROUND
 6936 T:2465                                    ; 
 6937 T:2465                                    ; REMEMBER BITS IN HI-RES BYTE ARE BACKWARDS ORDER:
 6938 T:2465                                    ; BYTE N   BYTE N+1
 6939 T:2465                                    ; S7654321   SEDCBA98
 6940 T:2465                                    ; --------------------------------
 6941 T:2465                           MOVE_LEFT_OR_RIGHT 
 6942 T:2465  10 23                              bpl MOVE_RIGHT                ; + MOVE RIGHT, - MOVE LEFT
 6943 T:2467  a5 30                              lda MON_HMASK                ; MOVE LEFT ONE PIXEL
 6944 T:2469  4a                                 lsr                    ; SHIFT MASK RIGHT, MOVES DOT LEFT
 6945 T:246a  b0 05                              bcs LR_2                ; ...DOT MOVED TO NEXT BYTE
 6946 T:246c  49 c0                              eor #$c0             ; MOVE SIGN BIT BACK WHERE IT WAS
 6947 T:246e  85 30                    LR_1      sta MON_HMASK             ; NEW MASK VALUE
 6948 T:2470  60                                 rts                    ; 
 6949 T:2471  88                       LR_2      dey                 ; MOVED TO NEXT BYTE, SO DECR INDEX
 6950 T:2472  10 02                              bpl LR_3                ; STILL NOT PAST EDGE
 6951 T:2474  a0 27                              ldy #39             ; OFF LEFT EDGE, SO WRAP AROUND SCREEN
 6952 T:2476  a9 c0                    LR_3      lda #$c0          ; NEW HMASK, RIGHTMOST BIT ON SCREEN
 6953 T:2478  85 30                    LR_4      sta MON_HMASK             ; NEW MASK AND INDEX
 6954 T:247a  84 e5                              sty HGR_HORIZ                ; 
 6955 T:247c  a5 1c                              lda HGR_BITS                ; ALSO NEED TO ROTATE COLOR
 6956 T:247e                                    ; --------------------------------
 6957 T:247e                           COLOR_SHIFT 
 6958 T:247e  0a                                 asl                    ; ROTATE LOW-ORDER 7 BITS
 6959 T:247f  c9 c0                              cmp #$c0             ; OF HGR.BITS ONE BIT POSN.
 6960 T:2481  10 06                              bpl L_COLOR_SHIFT_1
 6961 T:2483  a5 1c                              lda HGR_BITS
 6962 T:2485  49 7f                              eor #$7f
 6963 T:2487  85 1c                              sta HGR_BITS
 6964 T:2489  60                       L_COLOR_SHIFT_1 rts 
 6965 T:248a                                    ; --------------------------------
 6966 T:248a                                    ; MOVE RIGHT ONE PIXEL
 6967 T:248a                                    ; IF ALREADY AT RIGHT EDGE, WRAP AROUND
 6968 T:248a                                    ; --------------------------------
 6969 T:248a                           MOVE_RIGHT 
 6970 T:248a  a5 30                              lda MON_HMASK
 6971 T:248c  0a                                 asl                    ; SHIFTING BYTE LEFT MOVES PIXEL RIGHT
 6972 T:248d  49 80                              eor #$80             ; 
 6973 T:248f                                    ; ORIGINAL:  C0 A0 90 88 84 82 81
 6974 T:248f                                    ; SHIFTED:   80 40 20 10 08 02 01
 6975 T:248f                                    ; EOR #$80:  00 C0 A0 90 88 84 82
 6976 T:248f  30 dd                              bmi LR_1             ; FINISHED
 6977 T:2491  a9 81                              lda #$81             ; NEW MASK VALUE
 6978 T:2493  c8                                 iny                    ; MOVE TO NEXT BYTE RIGHT
 6979 T:2494  c0 28                              cpy #40             ; UNLESS THAT IS TOO FAR
 6980 T:2496  90 e0                              bcc LR_4             ; NOT TOO FAR
 6981 T:2498  a0 00                              ldy #0             ; TOO FAR, SO WRAP AROUND
 6982 T:249a  b0 dc                              bcs LR_4             ; ...ALWAYS
 6983 T:249c                                    ; --------------------------------
 6984 T:249c                                    ; --------------------------------
 6985 T:249c                                    ; "XDRAW" ONE BIT
 6986 T:249c                                    ; --------------------------------
 6987 T:249c  18                       LRUDX1    clc                 ; C=0 MEANS NO 90 DEGREE ROTATION
 6988 T:249d  a5 d1                    LRUDX2    lda HGR_DX+1       ; C=1 MEANS ROTATE 90 DEGREES
 6989 T:249f  29 04                              and #4             ; IF BIT2=0 THEN DON'T PLOT
 6990 T:24a1  f0 25                              beq LRUD4                ; YES, DO NOT PLOT
 6991 T:24a3  a9 7f                              lda #$7f             ; NO, LOOK AT WHAT IS ALREADY THERE
 6992 T:24a5  25 30                              and MON_HMASK
 6993 T:24a7  31 26                              and (MON_GBASL),Y               ; SCREEN BIT = 1?
 6994 T:24a9  d0 19                              bne LRUD3                ; YES, GO CLEAR IT
 6995 T:24ab  e6 ea                              inc HGR_COLLISIONS                ; NO, COUNT THE COLLISION
 6996 T:24ad  a9 7f                              lda #$7f             ; AND TURN THE BIT ON
 6997 T:24af  25 30                              and MON_HMASK                ; 
 6998 T:24b1  10 11                              bpl LRUD3                ; ...ALWAYS
 6999 T:24b3                                    ; --------------------------------
 7000 T:24b3                                    ; "DRAW" ONE BIT
 7001 T:24b3                                    ; --------------------------------
 7002 T:24b3  18                       LRUD1     clc                 ; C=0 MEANS NO 90 DEGREE ROTATION
 7003 T:24b4  a5 d1                    LRUD2     lda HGR_DX+1       ; C=1 MEANS ROTATE
 7004 T:24b6  29 04                              and #4             ; IF BIT2=0 THEN DO NOT PLOT
 7005 T:24b8  f0 0e                              beq LRUD4                ; DO NOT PLOT
 7006 T:24ba  b1 26                              lda (MON_GBASL),Y
 7007 T:24bc  45 1c                              eor HGR_BITS                ; 1'S WHERE ANY BITS NOT IN COLOR
 7008 T:24be  25 30                              and MON_HMASK                ; LOOK AT JUST THIS BIT POSITION
 7009 T:24c0  d0 02                              bne LRUD3                ; THE BIT WAS ZERO, SO PLOT IT
 7010 T:24c2  e6 ea                              inc HGR_COLLISIONS                ; BIT IS ALREADY 1; COUNT COLLSN
 7011 T:24c4                                    ; --------------------------------
 7012 T:24c4                                    ; TOGGLE BIT ON SCREEN WITH (A)
 7013 T:24c4                                    ; --------------------------------
 7014 T:24c4  51 26                    LRUD3     eor (MON_GBASL),Y
 7015 T:24c6  91 26                              sta (MON_GBASL),Y
 7016 T:24c8                                    ; --------------------------------
 7017 T:24c8                                    ; DETERMINE WHERE NEXT POINT WILL BE, AND MOVE THERE
 7018 T:24c8                                    ; C=0 IF NO 90 DEGREE ROTATION
 7019 T:24c8                                    ; C=1 ROTATES 90 DEGREES
 7020 T:24c8                                    ; --------------------------------
 7021 T:24c8  a5 d1                    LRUD4     lda HGR_DX+1       ; CALCULATE THE DIRECTION TO MOVE
 7022 T:24ca  65 d3                              adc HGR_QUADRANT
 7023 T:24cc  29 03                              and #3             ; WRAP AROUND THE CIRCLE
 7024 T:24ce                                    CON_03=*-1         ; (( A CONSTANT ))
 7025 T:24ce                                    ; 
 7026 T:24ce                                    ; 00 -- UP
 7027 T:24ce                                    ; 01 -- DOWN
 7028 T:24ce                                    ; 10 -- RIGHT
 7029 T:24ce                                    ; 11 -- LEFT
 7030 T:24ce                                    ; 
 7031 T:24ce  c9 02                              cmp #2             ; C=0 IF 0 OR 1, C=1 IF 2 OR 3
 7032 T:24d0  6a                                 ror                    ; PUT C INTO SIGN, ODD/EVEN INTO C
 7033 T:24d1  b0 92                              bcs MOVE_LEFT_OR_RIGHT
 7034 T:24d3                                    ; --------------------------------
 7035 T:24d3                           MOVE_UP_OR_DOWN 
 7036 T:24d3  30 30                              bmi MOVE_DOWN                ; SIGN FOR UP/DOWN SELECT_
 7037 T:24d5                                    ; --------------------------------
 7038 T:24d5                                    ; MOVE UP ONE PIXEL
 7039 T:24d5                                    ; IF ALREADY AT TOP, GO TO BOTTOM
 7040 T:24d5                                    ; 
 7041 T:24d5                                    ; REMEMBER:  Y-COORD   GBASH     GBASL
 7042 T:24d5                                    ; ABCDEFGH  PPPFGHCD  EABAB000
 7043 T:24d5                                    ; --------------------------------
 7044 T:24d5  18                                 clc                    ; MOVE UP
 7045 T:24d6  a5 27                              lda MON_GBASH                ; CALC. BASE ADDRESS OF PREV. LINE
 7046 T:24d8  2c b9 25                           bit CON_1C                ; LOOK AT BITS 000FGH00 IN GBASH
 7047 T:24db  d0 22                              bne L_MOVE_UP_OR_DOWN_5                ; SIMPLE, JUST FGH=FGH-1
 7048 T:24dd                                    ; GBASH=PPP000CD, GBASL=EABAB000
 7049 T:24dd  06 26                              asl MON_GBASL                ; WHAT IS "E"?
 7050 T:24df  b0 1a                              bcs L_MOVE_UP_OR_DOWN_3                ; E=1, THEN EFGH=EFGH-1
 7051 T:24e1  2c cd 24                           bit CON_03             ; LOOK AT 000000CD IN GBASH
 7052 T:24e4  f0 05                              beq L_MOVE_UP_OR_DOWN_1                ; Y-POS IS AB000000 FORM
 7053 T:24e6  69 1f                              adc #$1f             ; CD <> 0, SO CDEFGH=CDEFGH-1
 7054 T:24e8  38                                 sec                    ; 
 7055 T:24e9  b0 12                              bcs L_MOVE_UP_OR_DOWN_4                ; ...ALWAYS
 7056 T:24eb  69 23                    L_MOVE_UP_OR_DOWN_1 adc #$23          ; ENOUGH TO MAKE GBASH=PPP11111 LATER
 7057 T:24ed  48                                 pha                    ; SAVE FOR LATER
 7058 T:24ee  a5 26                              lda MON_GBASL                ; GBASL IS NOW ABAB0000 (AB=00,01,10)
 7059 T:24f0  69 b0                              adc #$b0             ; 0000+1011=1011 AND CARRY CLEAR
 7060 T:24f2                                    ; OR 0101+1011=0000 AND CARRY SET
 7061 T:24f2                                    ; OR 1010+1011=0101 AND CARRY SET
 7062 T:24f2  b0 02                              bcs L_MOVE_UP_OR_DOWN_2                ; NO WRAP-AROUND NEEDED
 7063 T:24f4  69 f0                              adc #$f0             ; CHANGE 1011 TO 1010 (WRAP-AROUND)
 7064 T:24f6  85 26                    L_MOVE_UP_OR_DOWN_2 sta MON_GBASL             ; FORM IS NOW STILL ABAB0000
 7065 T:24f8  68                                 pla                    ; PARTIALLY MODIFIED GBASH
 7066 T:24f9  b0 02                              bcs L_MOVE_UP_OR_DOWN_4                ; ...ALWAYS
 7067 T:24fb  69 1f                    L_MOVE_UP_OR_DOWN_3 adc #$1f          ; 
 7068 T:24fd  66 26                    L_MOVE_UP_OR_DOWN_4 ror MON_GBASL             ; SHIFT IN E, TO GET EABAB000 FORM
 7069 T:24ff  69 fc                    L_MOVE_UP_OR_DOWN_5 adc #$fc          ; FINISH GBASH MODS
 7070 T:2501  85 27                    UD_1      sta MON_GBASH             ; 
 7071 T:2503  60                                 rts 
 7072 T:2504                                    ; --------------------------------
 7073 T:2504  18                                 clc                    ; <<<NEVER USED>>>
 7074 T:2505                                    ; --------------------------------
 7075 T:2505                                    ; MOVE DOWN ONE PIXEL
 7076 T:2505                                    ; IF ALREADY AT BOTTOM, GO TO TOP
 7077 T:2505                                    ; 
 7078 T:2505                                    ; REMEMBER:  Y-COORD   GBASH     GBASL
 7079 T:2505                                    ; ABCDEFGH  PPPFGHCD  EABAB000
 7080 T:2505                                    ; --------------------------------
 7081 T:2505                           MOVE_DOWN 
 7082 T:2505  a5 27                              lda MON_GBASH                ; TRY IT FIRST, BY FGH=FGH+1
 7083 T:2507  69 04                              adc #4             ; GBASH = PPPFGHCD
 7084 T:2509                                    CON_04=*-1         ; (( CONSTANT ))
 7085 T:2509  2c b9 25                           bit CON_1C                ; IS FGH FIELD NOW ZERO?
 7086 T:250c  d0 f3                              bne UD_1             ; NO, SO WE ARE FINISHED
 7087 T:250e                                    ; YES, RIPPLE THE CARRY AS HIGH
 7088 T:250e                                    ; AS NECESSARY
 7089 T:250e  06 26                              asl MON_GBASL                ; LOOK AT "E" BIT
 7090 T:2510  90 18                              bcc L_CON_04_2                ; NOW ZERO; MAKE IT 1 AND LEAVE
 7091 T:2512  69 e0                              adc #$e0             ; CARRY = 1, SO ADDS $E1
 7092 T:2514  18                                 clc                    ; IS "CD" NOT ZERO?
 7093 T:2515  2c 08 25                           bit CON_04             ; TESTS BIT 2 FOR CARRY OUT OF "CD"
 7094 T:2518  f0 12                              beq L_CON_04_3                ; NO CARRY, FINISHED
 7095 T:251a                                    ; INCREMENT "AB" THEN
 7096 T:251a                                    ; 0000 --> 0101
 7097 T:251a                                    ; 0101 --> 1010
 7098 T:251a                                    ; 1010 --> WRAP AROUND TO LINE 0
 7099 T:251a  a5 26                              lda MON_GBASL                ; 0000  0101  1010
 7100 T:251c  69 50                              adc #$50             ; 0101  1010  1111
 7101 T:251e  49 f0                              eor #$f0             ; 1010  0101  0000
 7102 T:2520  f0 02                              beq L_CON_04_1                ; 
 7103 T:2522  49 f0                              eor #$f0             ; 0101  1010
 7104 T:2524  85 26                    L_CON_04_1 sta MON_GBASL             ; NEW ABAB0000
 7105 T:2526  a5 e6                              lda HGR_PAGE                ; WRAP AROUND TO LINE ZERO OF GROUP
 7106 T:2528  90 02                              bcc L_CON_04_3                ; ...ALWAYS
 7107 T:252a  69 e0                    L_CON_04_2 adc #$e0
 7108 T:252c  66 26                    L_CON_04_3 ror MON_GBASL
 7109 T:252e  90 d1                              bcc UD_1             ; ...ALWAYS
 7110 T:2530                                    ; --------------------------------
 7111 T:2530                                    ; HLINRL IS NEVER CALLED BY APPLESOFT
 7112 T:2530                                    ; 
 7113 T:2530                                    ; ENTER WITH:  (A,X) = DX FROM CURRENT POINT
 7114 T:2530                                    ; (Y)   = DY FROM CURRENT POINT
 7115 T:2530                                    ; --------------------------------
 7116 T:2530  48                       HLINRL    pha                 ; SAVE (A)
 7117 T:2531  a9 00                              lda #0             ; CLEAR CURRENT POINT SO HGLIN WILL
 7118 T:2533  85 e0                              sta HGR_X                ; ACT RELATIVELY
 7119 T:2535  85 e1                              sta HGR_X+1          ; 
 7120 T:2537  85 e2                              sta HGR_Y                ; 
 7121 T:2539  68                                 pla                    ; RESTORE (A)
 7122 T:253a                                    ; --------------------------------
 7123 T:253a                                    ; DRAW LINE FROM LAST PLOTTED POINT TO (A,X),(Y)
 7124 T:253a                                    ; 
 7125 T:253a                                    ; ENTER WITH:  (A,X) = X OF TARGET POINT
 7126 T:253a                                    ; (Y)   = Y OF TARGET POINT
 7127 T:253a                                    ; --------------------------------
 7128 T:253a  48                       HGLIN     pha                 ; COMPUTE DX = X- X0
 7129 T:253b  38                                 sec 
 7130 T:253c  e5 e0                              sbc HGR_X
 7131 T:253e  48                                 pha 
 7132 T:253f  8a                                 txa 
 7133 T:2540  e5 e1                              sbc HGR_X+1
 7134 T:2542  85 d3                              sta HGR_QUADRANT                ; SAVE DX SIGN (+ = RIGHT, - = LEFT)
 7135 T:2544  b0 0a                              bcs L_HGLIN_1                ; NOW FIND ABS (DX)
 7136 T:2546  68                                 pla                    ; FORMS 2'S COMPLEMENT
 7137 T:2547  49 ff                              eor #$ff
 7138 T:2549  69 01                              adc #1
 7139 T:254b  48                                 pha 
 7140 T:254c  a9 00                              lda #0
 7141 T:254e  e5 d3                              sbc HGR_QUADRANT
 7142 T:2550  85 d1                    L_HGLIN_1 sta HGR_DX+1
 7143 T:2552  85 d5                              sta HGR_E+1          ; INIT HGR.E TO ABS(X-X0)
 7144 T:2554  68                                 pla 
 7145 T:2555  85 d0                              sta HGR_DX
 7146 T:2557  85 d4                              sta HGR_E
 7147 T:2559  68                                 pla 
 7148 T:255a  85 e0                              sta HGR_X                ; TARGET X POINT
 7149 T:255c  86 e1                              stx HGR_X+1          ; 
 7150 T:255e  98                                 tya                    ; TARGET Y POINT
 7151 T:255f  18                                 clc                    ; COMPUTE DY = Y-HGR.Y
 7152 T:2560  e5 e2                              sbc HGR_Y                ; AND SAVE -ABS(Y-HGR.Y)-1 IN HGR.DY
 7153 T:2562  90 04                              bcc L_HGLIN_2                ; (SO + MEANS UP, - MEANS DOWN)
 7154 T:2564  49 ff                              eor #$ff             ; 2'S COMPLEMENT OF DY
 7155 T:2566  69 fe                              adc #$fe             ; 
 7156 T:2568  85 d2                    L_HGLIN_2 sta HGR_DY             ; 
 7157 T:256a  84 e2                              sty HGR_Y                ; TARGET Y POINT
 7158 T:256c  66 d3                              ror HGR_QUADRANT                ; SHIFT Y-DIRECTION INTO QUADRANT
 7159 T:256e  38                                 sec                    ; COUNT = DX -(-DY) = # OF DOTS NEEDED
 7160 T:256f  e5 d0                              sbc HGR_DX                ; 
 7161 T:2571  aa                                 tax                    ; COUNTL IS IN X-REG
 7162 T:2572  a9 ff                              lda #$ff
 7163 T:2574  e5 d1                              sbc HGR_DX+1
 7164 T:2576  85 1d                              sta HGR_COUNT
 7165 T:2578  a4 e5                              ldy HGR_HORIZ                ; HORIZONTAL INDEX
 7166 T:257a  b0 05                              bcs MOVEX2                ; ...ALWAYS
 7167 T:257c                                    ; --------------------------------
 7168 T:257c                                    ; MOVE LEFT OR RIGHT ONE PIXEL
 7169 T:257c                                    ; (A) BIT 6 HAS DIRECTION
 7170 T:257c                                    ; --------------------------------
 7171 T:257c  0a                       MOVEX     asl                 ; PUT BIT 6 INTO SIGN POSITION
 7172 T:257d  20 65 24                           jsr MOVE_LEFT_OR_RIGHT
 7173 T:2580  38                                 sec 
 7174 T:2581                                    ; --------------------------------
 7175 T:2581                                    ; DRAW LINE NOW
 7176 T:2581                                    ; --------------------------------
 7177 T:2581  a5 d4                    MOVEX2    lda HGR_E             ; CARRY IS SET
 7178 T:2583  65 d2                              adc HGR_DY                ; E = E-DELTY
 7179 T:2585  85 d4                              sta HGR_E                ; NOTE: DY IS (-DELTA Y)-1
 7180 T:2587  a5 d5                              lda HGR_E+1          ; CARRY CLR IF HGR.E GOES NEGATIVE
 7181 T:2589  e9 00                              sbc #0
 7182 T:258b  85 d5                    L_MOVEX2_1 sta HGR_E+1
 7183 T:258d  b1 26                              lda (MON_GBASL),Y
 7184 T:258f  45 1c                              eor HGR_BITS                ; PLOT A DOT
 7185 T:2591  25 30                              and MON_HMASK
 7186 T:2593  51 26                              eor (MON_GBASL),Y
 7187 T:2595  91 26                              sta (MON_GBASL),Y
 7188 T:2597  e8                                 inx                    ; FINISHED ALL THE DOTS?
 7189 T:2598  d0 04                              bne L_MOVEX2_2                ; NO
 7190 T:259a  e6 1d                              inc HGR_COUNT                ; TEST REST OF COUNT
 7191 T:259c  f0 62                              beq RTS_22                ; YES, FINISHED.
 7192 T:259e  a5 d3                    L_MOVEX2_2 lda HGR_QUADRANT             ; TEST DIRECTION
 7193 T:25a0  b0 da                              bcs MOVEX             ; NEXT MOVE IS IN THE X DIRECTION
 7194 T:25a2  20 d3 24                           jsr MOVE_UP_OR_DOWN             ; IF CLR, NEG, MOVE
 7195 T:25a5  18                                 clc                    ; E = E+DX
 7196 T:25a6  a5 d4                              lda HGR_E
 7197 T:25a8  65 d0                              adc HGR_DX
 7198 T:25aa  85 d4                              sta HGR_E
 7199 T:25ac  a5 d5                              lda HGR_E+1
 7200 T:25ae  65 d1                              adc HGR_DX+1
 7201 T:25b0  50 d9                              bvc L_MOVEX2_1             ; ...ALWAYS
 7202 T:25b2                                    ; --------------------------------

 7205 T:25b2  81                       MSKTBL    .byt %10000001
 7206 T:25b3  82                                 .byt %10000010
 7207 T:25b4  84                                 .byt %10000100
 7208 T:25b5  88                                 .byt %10001000
 7209 T:25b6  90                                 .byt %10010000
 7210 T:25b7  a0                                 .byt %10100000
 7211 T:25b8  c0                                 .byt %11000000
