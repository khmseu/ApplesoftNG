 3077 T:0e7b  f0 e7                              beq L_FRM_ELEMENT_1             ; YES
 3078 T:0e7d  c9 22                              cmp #$22             ; STRING CONSTANT?
 3079 T:0e7f  d0 0f                              bne NOT_                ; NO
