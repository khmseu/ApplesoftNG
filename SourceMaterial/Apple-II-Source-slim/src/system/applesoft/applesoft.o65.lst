 3829 T:12aa  a5 83                              lda VARPNT                ; AND IN Y,A
 3830 T:12ac  60                       RTS_9     rts                 ; 
 3831 T:12ad                                    ; --------------------------------
 3832 T:12ad                                    ; MULTIPLY (STRNG2) BY ((LOWTR),Y)
 3833 T:12ad                                    ; LEAVING PRODUCT IN A,X.  (HI-BYTE ALSO IN Y.)
 3834 T:12ad                                    ; USED ONLY BY ARRAY SUBSCRIPT ROUTINES
 3835 T:12ad                                    ; --------------------------------
 3836 T:12ad                           MULTIPLY_SUBSCRIPT 
 3837 T:12ad  84 5e                              sty INDEX                ; SAVE Y-REG
 3838 T:12af  b1 9b                              lda (LOWTR),Y                   ; GET MULTIPLIER
 3839 T:12b1  85 64                              sta RESULT+2          ; SAVE IN RESULT+2,3
 3840 T:12b3  88                                 dey                    ; 
 3841 T:12b4  b1 9b                              lda (LOWTR),Y                   ; 
 3842 T:12b6                                    ; --------------------------------
 3843 T:12b6                           MULTIPLY_SUBS_1                  ; 
 3844 T:12b6  85 65                              sta RESULT+3          ; LOW BYTE OF MULTIPLIER
 3845 T:12b8  a9 10                              lda #16             ; MULTIPLY 16 BITS
 3846 T:12ba  85 99                              sta INDX                ; 
 3847 T:12bc  a2 00                              ldx #0             ; PRODUCT = 0 INITIALLY
 3848 T:12be  a0 00                              ldy #0             ; 
 3849 T:12c0  8a                       L_MULTIPLY_SUBS_1_1 txa                 ; DOUBLE PRODUCT
 3850 T:12c1  0a                                 asl                    ; LOW BYTE
 3851 T:12c2  aa                                 tax                    ; 
 3852 T:12c3  98                                 tya                    ; HIGH BYTE
 3853 T:12c4  2a                                 rol                    ; IF TOO LARGE, SET CARRY
 3854 T:12c5  a8                                 tay                    ; 
 3855 T:12c6  b0 a4                              bcs GME             ; TOO LARGE, "MEM FULL ERROR"
 3856 T:12c8  06 ad                              asl STRNG2                ; NEXT BIT OF MUTLPLICAND
 3857 T:12ca  26 ae                              rol STRNG2+1          ; INTO CARRY
 3858 T:12cc  90 0b                              bcc L_MULTIPLY_SUBS_1_2                ; BIT=0, DON'T NEED TO ADD
 3859 T:12ce  18                                 clc                    ; BIT=1, ADD INTO PARTIAL PRODUCT
 3860 T:12cf  8a                                 txa                    ; 
 3861 T:12d0  65 64                              adc RESULT+2          ; 
 3862 T:12d2  aa                                 tax                    ; 
 3863 T:12d3  98                                 tya                    ; 
 3864 T:12d4  65 65                              adc RESULT+3          ; 
 3865 T:12d6  a8                                 tay                    ; 
 3866 T:12d7  b0 93                              bcs GME             ; TOO LARGE, "MEM FULL ERROR"
 3867 T:12d9  c6 99                    L_MULTIPLY_SUBS_1_2 dec INDX             ; 16-BITS YET?
 3868 T:12db  d0 e3                              bne L_MULTIPLY_SUBS_1_1             ; NO, KEEP SHUFFLING
 3869 T:12dd  60                                 rts                    ; YES, PRODUCT IN Y,X AND A,X
