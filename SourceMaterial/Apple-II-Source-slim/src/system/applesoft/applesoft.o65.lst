 7299 T:2626  85 d1                    L_DRAW1_1 sta HGR_DX+1       ; KEEP SHAPE BYTE IN HGR.DX+1
 7300 T:2628  a2 80                              ldx #$80             ; INITIAL VALUES FOR FRACTIONAL VECTORS
 7301 T:262a  86 d4                              stx HGR_E                ; L_DRAW1_5 IN COSINE COMPONENT
 7302 T:262c  86 d5                              stx HGR_E+1          ; L_DRAW1_5 IN SINE COMPONENT
 7303 T:262e  a6 e7                              ldx HGR_SCALE                ; SCALE FACTOR
 7304 T:2630  a5 d4                    L_DRAW1_2 lda HGR_E             ; ADD COSINE VALUE TO X-VALUE
 7305 T:2632  38                                 sec                    ; IF >= 1, THEN DRAW
 7306 T:2633  65 d0                              adc HGR_DX                ; 
 7307 T:2635  85 d4                              sta HGR_E                ; ONLY SAVE FRACTIONAL PART
 7308 T:2637  90 04                              bcc L_DRAW1_3                ; NO INTEGRAL PART
