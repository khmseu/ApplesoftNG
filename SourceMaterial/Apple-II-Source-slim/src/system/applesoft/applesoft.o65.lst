 6334 T:210b                                    ; --------------------------------
 6335 T:210b                                    ; GENERIC COPY OF CHRGET SUBROUTINE, WHICH
 6336 T:210b                                    ; IS COPIED INTO $00B1...$00C8 DURING INITIALIZATION
 6337 T:210b                                    ; 
 6338 T:210b                                    ; CORNELIS BONGERS DESCRIBED SEVERAL IMPROVEMENTS
 6339 T:210b                                    ; TO CHRGET IN MICRO MAGAZINE OR CALL A.P.P.L.E.
 6340 T:210b                                    ; (I DON'T REMEMBER WHICH OR EXACTLY WHEN)
 6341 T:210b                                    ; --------------------------------
 6342 T:210b                           GENERIC_CHRGET 
 6343 T:210b  e6 b8                              inc TXTPTR
 6344 T:210d  d0 02                              bne L_GENERIC_CHRGET_1
 6345 T:210f  e6 b9                              inc TXTPTR+1
 6346 T:2111  ad 60 ea                 L_GENERIC_CHRGET_1 lda $ea60           ; <<< ACTUAL ADDRESS FILLED IN LATER >>>
 6347 T:2114  c9 3a                              cmp #(":"&%01111111)     ; EOS, ALSO TOP OF NUMERIC RANGE
 6348 T:2116  b0 0a                              bcs L_GENERIC_CHRGET_2                ; NOT NUMBER, MIGHT BE EOS
 6349 T:2118  c9 20                              cmp #(" "&%01111111)     ; IGNORE BLANKS
 6350 T:211a  f0 ef                              beq GENERIC_CHRGET
 6351 T:211c  38                                 sec                    ; TEST FOR NUMERIC RANGE IN WAY THAT
 6352 T:211d  e9 30                              sbc #("0"&%01111111)     ; CLEARS CARRY IF CHAR IS DIGIT
 6353 T:211f  38                                 sec                    ; AND LEAVES CHAR IN A-REG
 6354 T:2120  e9 d0                              sbc #$d0
 6355 T:2122  60                       L_GENERIC_CHRGET_2 rts 
 6356 T:2123                                    ; --------------------------------
 6357 T:2123                                    ; INITIAL VALUE FOR RANDOM NUMBER, ALSO COPIED
 6358 T:2123                                    ; IN ALONG WITH CHRGET, BUT ERRONEOUSLY:
 6359 T:2123                                    ; <<< THE LAST BYTE IS NOT COPIED >>>
 6360 T:2123                                    ; --------------------------------

 6362 T:2123  80 4f c7 52 58                     .byt $80,$4f,$c7,$52,$58; APPROX. = L_GENERIC_CHRGET_811635157
 6363 T:2128                           GENERIC_END 
