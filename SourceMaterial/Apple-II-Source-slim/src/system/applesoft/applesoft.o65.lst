 5476 T:1bb2                                    ; COMPARE FAC WITH PACKED # AT (Y,A)
 5477 T:1bb2                                    ; RETURN A=1,0,-1 AS (Y,A) IS <,=,> FAC
 5478 T:1bb2                                    ; --------------------------------
 5479 T:1bb2  85 60                    FCOMP     sta DEST             ; USE DEST FOR PNTR
 5480 T:1bb4                                    ; --------------------------------
 5481 T:1bb4                                    ; SPECIAL ENTRY FROM "NEXT" PROCESSOR
 5482 T:1bb4                                    ; "DEST" ALREADY SET UP
 5483 T:1bb4                                    ; --------------------------------
 5484 T:1bb4  84 61                    FCOMP2    sty DEST+1       ; 
 5485 T:1bb6  a0 00                              ldy #0             ; GET EXPONENT OF COMPARAND
 5486 T:1bb8  b1 60                              lda (DEST),Y                    ; 
 5487 T:1bba  c8                                 iny                    ; POINT AT NEXT BYTE
 5488 T:1bbb  aa                                 tax                    ; EXPONENT TO X-REG
 5489 T:1bbc  f0 c4                              beq SIGN             ; IF COMPARAND=0, "SIGN" COMPARES FAC
 5490 T:1bbe  b1 60                              lda (DEST),Y                    ; GET HI-BYTE OF MANTISSA
 5491 T:1bc0  45 a2                              eor FAC_SIGN                ; COMPARE WITH FAC SIGN
 5492 T:1bc2  30 c2                              bmi SIGN1             ; DIFFERENT SIGNS, "SIGN" GIVES ANSWER
 5493 T:1bc4  e4 9d                              cpx FAC                ; SAME SIGN, SO COMPARE EXPONENTS
 5494 T:1bc6  d0 21                              bne L_FCOMP2_1                ; DIFFERENT, SO SUFFICIENT TEST
 5495 T:1bc8  b1 60                              lda (DEST),Y                    ; SAME EXPONENT, COMPARE MANTISSA
 5496 T:1bca  09 80                              ora #$80             ; SET INVISIBLE NORMALIZED BIT
 5497 T:1bcc  c5 9e                              cmp FAC+1          ; 
 5498 T:1bce  d0 19                              bne L_FCOMP2_1                ; NOT SAME, SO SUFFICIENT
 5499 T:1bd0  c8                                 iny                    ; SAME, COMPARE MORE MANTISSA
 5500 T:1bd1  b1 60                              lda (DEST),Y                    ; 
 5501 T:1bd3  c5 9f                              cmp FAC+2          ; 
 5502 T:1bd5  d0 12                              bne L_FCOMP2_1                ; NOT SAME, SO SUFFICIENT
 5503 T:1bd7  c8                                 iny                    ; SAME, COMPARE MORE MANTISSA
 5504 T:1bd8  b1 60                              lda (DEST),Y                    ; 
 5505 T:1bda  c5 a0                              cmp FAC+3          ; 
 5506 T:1bdc  d0 0b                              bne L_FCOMP2_1                ; NOT SAME, SO SUFFICIENT
 5507 T:1bde  c8                                 iny                    ; SAME, COMPARE REST OF MANTISSA
 5508 T:1bdf  a9 7f                              lda #$7f             ; ARTIFICIAL EXTENSION BYTE FOR COMPARAND
 5509 T:1be1  c5 ac                              cmp FAC_EXTENSION
 5510 T:1be3  b1 60                              lda (DEST),Y
 5511 T:1be5  e5 a1                              sbc FAC+4
 5512 T:1be7  f0 28                              beq RTS_16                ; NUMBERS ARE EQUAL, RETURN (A)=0
 5513 T:1be9  a5 a2                    L_FCOMP2_1 lda FAC_SIGN             ; NUMBERS ARE DIFFERENT
 5514 T:1beb  90 02                              bcc L_FCOMP2_2                ; FAC IS LARGER MAGNITUDE
 5515 T:1bed  49 ff                              eor #$ff             ; FAC IS SMALLER MAGNITUDE
 5516 T:1bef                                    ; <<<  NOTE THAT ABOVE THREE LINES CAN BE SHORTENED: >>>
 5517 T:1bef                                    ; <<<  L_FCOMP2_1  ROR              PUT CARRY INTO SIGN BIT  >>>
 5518 T:1bef                                    ; <<<      EOR FAC.SIGN     TOGGLE WITH SIGN OF FAC  >>>
 5519 T:1bef  4c 88 1b                 L_FCOMP2_2 jmp SIGN2          ; CONVERT +1 OR -1
