 3688 T:11cc  a2 05                              ldx #5             ; ASSUME 5-BYTES PER ELEMENT
 3689 T:11ce  a5 81                              lda VARNAM                ; STUFF VARIABLE NAME IN ARRAY
 3690 T:11d0  91 9b                              sta (LOWTR),Y                   ; 
