 6819 T:23bc  20 d9 27                 RECALL    jsr GETARYPT             ; FIND ARRAY IN MEMORY
 6820 T:23bf  20 fd fe                           jsr MON_READ                ; READ HEADER
 6821 T:23c2  a0 02                              ldy #2             ; MAKE SURE THE NEW DATA FITS
 6822 T:23c4  b1 9b                              lda (LOWTR),Y                   ; 
