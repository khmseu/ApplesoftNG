 1488 T:0512  b1 5e                              lda (INDEX),Y                   ; 
 1489 T:0514  d0 fb                              bne L_FIX_LINKS_3             ; 
 1490 T:0516  c8                                 iny                    ; COMPUTE ADDRESS OF NEXT LINE
 1491 T:0517  98                                 tya                    ; 
 1492 T:0518  65 5e                              adc INDEX                ; 
 1493 T:051a  aa                                 tax                    ; 
 1494 T:051b  a0 00                              ldy #0             ; STORE FORWARD PNTR IN THIS LINE
 1495 T:051d  91 5e                              sta (INDEX),Y                   ; 
