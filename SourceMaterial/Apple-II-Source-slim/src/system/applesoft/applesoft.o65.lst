 3062 T:0e60                                    ; TO STRING DESCRIPTOR IF A STRING, AND PUT IN FAC.
 3063 T:0e60                                    ; --------------------------------
 3064 T:0e60                           FRM_ELEMENT                  ; 
 3065 T:0e60  a9 00                              lda #0             ; ASSUME NUMERIC
 3066 T:0e62  85 11                              sta VALTYP                ; 
 3067 T:0e64  20 b1 00                 L_FRM_ELEMENT_1 jsr CHRGET             ; 
 3068 T:0e67  b0 03                              bcs L_FRM_ELEMENT_3                ; NOT A DIGIT
 3069 T:0e69  4c 4a 1c                 L_FRM_ELEMENT_2 jmp FIN             ; NUMERIC CONSTANT
 3070 T:0e6c  20 7d 10                 L_FRM_ELEMENT_3 jsr ISLETC             ; VARIABLE NAME?
 3071 T:0e6f  b0 64                              bcs FRM_VARIABLE                ; YES
 3072 T:0e71  c9 2e                              cmp #("."&%01111111)     ; DECIMAL POINT
 3073 T:0e73  f0 f4                              beq L_FRM_ELEMENT_2             ; YES, NUMERIC CONSTANT
