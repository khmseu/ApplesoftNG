 3719 T:11fc  91 9b                              sta (LOWTR),Y
 3720 T:11fe  20 ad 12                           jsr MULTIPLY_SUBSCRIPT                ; MULTIPLY THIS
 3721 T:1201                                    ; DIMENSION BY RUNNING SIZE
