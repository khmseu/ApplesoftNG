 6268 T:2094                                    ; --------------------------------

 6273 T:2094  a6                                 .byt ("!"|%10000000)^7
 6274 T:2095  d3                                 .byt ("T"|%10000000)^7
 6275 T:2096  c1                                 .byt ("F"|%10000000)^7
 6276 T:2097  c8                                 .byt ("O"|%10000000)^7
 6277 T:2098  d4                                 .byt ("S"|%10000000)^7
 6278 T:2099  c8                                 .byt ("O"|%10000000)^7
 6279 T:209a  d5                                 .byt ("R"|%10000000)^7
 6280 T:209b  c4                                 .byt ("C"|%10000000)^7
 6281 T:209c  ce                                 .byt ("I"|%10000000)^7
 6282 T:209d  ca                                 .byt ("M"|%10000000)^7

