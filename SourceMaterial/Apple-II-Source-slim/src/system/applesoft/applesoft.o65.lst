 6828 T:23cf  4c 10 04                           jmp MEMERR             ; DOESN'T FIT
 6829 T:23d2  20 bc 27                 L_RECALL_1 jsr TAPEPNT             ; READ THE DATA
 6830 T:23d5  4c fd fe                           jmp MON_READ                ; 
