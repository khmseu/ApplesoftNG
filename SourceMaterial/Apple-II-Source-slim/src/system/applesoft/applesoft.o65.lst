 2959 T:0df6  d9 b2 00                 PREFNC    cmp MATHTBL,Y
 2960 T:0df9  b0 48                              bcs FRM_PERFORM_2                ; DO NOW IF HIGHER PRECEDENCE
 2961 T:0dfb  90 d9                              bcc NXOP             ; ...ALWAYS
