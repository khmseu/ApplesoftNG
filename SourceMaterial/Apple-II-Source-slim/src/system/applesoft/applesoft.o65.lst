 7526 T:2775                                    ; "SHLOAD" STATEMENT
 7527 T:2775                                    ; 
 7528 T:2775                                    ; READS A SHAPE TABLE FROM CASSETTE TAPE
 7529 T:2775                                    ; TO A POSITION JUST BELOW HIMEM.
 7530 T:2775                                    ; HIMEM IS THEN MOVED TO JUST BELOW THE TABLE
 7531 T:2775                                    ; --------------------------------
 7532 T:2775  a9 00                    SHLOAD    lda #>LINNUM           ; SET UP TO READ TWO BYTES
 7533 T:2777  85 3d                              sta MON_A1H                ; INTO LINNUM,LINNUM+1
 7534 T:2779  85 3f                              sta MON_A2H                ; 
 7535 T:277b  a0 50                              ldy #LINNUM               ; 
 7536 T:277d  84 3c                              sty MON_A1L                ; 
 7537 T:277f  c8                                 iny                    ; LINNUM+1
 7538 T:2780  84 3e                              sty MON_A2L                ; 
 7539 T:2782  20 fd fe                           jsr MON_READ                ; READ TAPE
 7540 T:2785  18                                 clc                    ; SETUP TO READ (LINNUM) BYTES
 7541 T:2786  a5 73                              lda MEMSIZ                ; ENDING AT HIMEM-1
 7542 T:2788  aa                                 tax                    ; 
 7543 T:2789  ca                                 dex                    ; FORMING HIMEM-1
 7544 T:278a  86 3e                              stx MON_A2L                ; 
 7545 T:278c  e5 50                              sbc LINNUM                ; FORMING HIMEM-(LINNUM)
 7546 T:278e  48                                 pha                    ; 
 7547 T:278f  a5 74                              lda MEMSIZ+1          ; 
 7548 T:2791  a8                                 tay                    ; 
 7549 T:2792  e8                                 inx                    ; SEE IF HIMEM LOW-BYTE WAS ZERO
 7550 T:2793  d0 01                              bne L_SHLOAD_1                ; NO
 7551 T:2795  88                                 dey                    ; YES, HAVE TO DECREMENT HIGH BYTE
 7552 T:2796  84 3f                    L_SHLOAD_1 sty MON_A2H             ; 
 7553 T:2798  e5 51                              sbc LINNUM+1          ; 
 7554 T:279a  c5 6e                              cmp STREND+1          ; RUNNING INTO VARIABLES?
 7555 T:279c  90 02                              bcc L_SHLOAD_2                ; YES, OUT OF MEMORY
 7556 T:279e  d0 03                              bne L_SHLOAD_3                ; NO, STILL ROOM
 7557 T:27a0  4c 10 04                 L_SHLOAD_2 jmp MEMERR          ; MEM FULL ERR
 7558 T:27a3  85 74                    L_SHLOAD_3 sta MEMSIZ+1       ; 
 7559 T:27a5  85 70                              sta FRETOP+1          ; CLEAR STRING SPACE
 7560 T:27a7  85 3d                              sta MON_A1H                ; (BUT NAMES ARE STILL IN VARTBL!)
 7561 T:27a9  85 e9                              sta HGR_SHAPE_PNTR+1
 7562 T:27ab  68                                 pla 
 7563 T:27ac  85 e8                              sta HGR_SHAPE_PNTR
 7564 T:27ae  85 73                              sta MEMSIZ
 7565 T:27b0  85 6f                              sta FRETOP
 7566 T:27b2  85 3c                              sta MON_A1L
 7567 T:27b4  20 fa fc                           jsr MON_RD2BIT                ; READ TO TAPE TRANSITIONS
 7568 T:27b7  a9 03                              lda #3             ; SHORT DELAY FOR INTERMEDIATE HEADER
 7569 T:27b9  4c 02 ff                           jmp MON_READ2                ; READ SHAPES
