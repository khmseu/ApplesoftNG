 3379 T:1032  05 81                              ora VARNAM                ; 
 3380 T:1034  85 81                              sta VARNAM                ; SET SIGN BIT ON VARNAME
 3381 T:1036  8a                       L_PTRGET4_5 txa                 ; SECOND CHAR OF NAME
 3382 T:1037  09 80                              ora #$80             ; SET SIGN
