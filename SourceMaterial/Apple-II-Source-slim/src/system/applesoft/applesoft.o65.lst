 6290 T:209e                                    ; "ATN" FUNCTION
 6291 T:209e                                    ; --------------------------------
 6292 T:209e  a5 a2                    ATN       lda FAC_SIGN             ; FOLD THE ARGUMENT RANGE FIRST
 6293 T:20a0  48                                 pha                    ; SAVE SIGN FOR LATER UNFOLDING
 6294 T:20a1  10 03                              bpl L_ATN_1                ; .GE. 0
 6295 T:20a3  20 d0 1e                           jsr NEGOP             ; .LT. 0, SO COMPLEMENT
 6296 T:20a6  a5 9d                    L_ATN_1   lda FAC             ; IF .GE. 1, FORM RECIPROCAL
 6297 T:20a8  48                                 pha                    ; SAVE FOR LATER UNFOLDING
 6298 T:20a9  c9 81                              cmp #$81             ; (EXPONENT FOR .GE. 1
 6299 T:20ab  90 07                              bcc L_ATN_2                ; X < 1
 6300 T:20ad  a9 13                              lda #<CON_ONE           ; FORM 1/X
 6301 T:20af  a0 19                              ldy #>CON_ONE
 6302 T:20b1  20 66 1a                           jsr FDIV
 6303 T:20b4                                    ; --------------------------------
 6304 T:20b4                                    ; 0 <= X <= 1
 6305 T:20b4                                    ; 0 <= ATN(X) <= PI/8
 6306 T:20b4                                    ; --------------------------------
 6307 T:20b4  a9 ce                    L_ATN_2   lda #<POLY_ATN           ; COMPUTE POLYNOMIAL APPROXIMATION
 6308 T:20b6  a0 20                              ldy #>POLY_ATN
 6309 T:20b8  20 5c 1f                           jsr POLYNOMIAL_ODD
 6310 T:20bb  68                                 pla                    ; START TO UNFOLD
 6311 T:20bc  c9 81                              cmp #$81             ; WAS IT .GE. 1?
 6312 T:20be  90 07                              bcc L_ATN_3                ; NO
 6313 T:20c0  a9 66                              lda #<CON_PI_HALF           ; YES, SUBTRACT FROM PI/2
 6314 T:20c2  a0 20                              ldy #>CON_PI_HALF           ; 
 6315 T:20c4  20 a7 17                           jsr FSUB             ; 
 6316 T:20c7  68                       L_ATN_3   pla                 ; WAS IT NEGATIVE?
 6317 T:20c8  10 03                              bpl RTS_20                ; NO
 6318 T:20ca  4c d0 1e                           jmp NEGOP             ; YES, COMPLEMENT
 6319 T:20cd  60                       RTS_20    rts 
 6320 T:20ce                                    ; --------------------------------
 6321 T:20ce  0b                       POLY_ATN  .byt 11           ; POWER OF POLYNOMIAL
 6322 T:20cf  76 b3 83 bd d3                     .byt $76,$b3,$83,$bd,$d3
 6323 T:20d4  79 1e f4 a6 f5                     .byt $79,$1e,$f4,$a6,$f5
 6324 T:20d9  7b 83 fc b0 10                     .byt $7b,$83,$fc,$b0,$10
 6325 T:20de  7c 0c 1f 67 ca                     .byt $7c,$0c,$1f,$67,$ca
