 3656 T:11a0  a5 10                              lda DIMFLG                ; CALLED FROM "DIM" STATEMENT?
 3657 T:11a2  d0 f7                              bne JER             ; YES, ERROR
 3658 T:11a4  a5 14                              lda SUBFLG                ; NO, CHECK IF ANY SUBSCRIPTS
 3659 T:11a6  f0 02                              beq L_USE_OLD_ARRAY_1                ; YES, NEED TO CHECK THE NUMBER
