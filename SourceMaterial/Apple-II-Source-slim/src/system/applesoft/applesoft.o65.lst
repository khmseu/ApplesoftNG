 7492 T:273d  f0 02                              beq L_DRWPNT_1                ; LAST SHAPE IN TABLE
 7493 T:273f  b0 a5                              bcs GGERR             ; SHAPE # TOO LARGE
 7494 T:2741  0a                       L_DRWPNT_1 asl                 ; DOUBLE SHAPE# TO MAKE AN INDEX
