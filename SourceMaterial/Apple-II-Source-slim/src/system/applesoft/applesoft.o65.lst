 1479 T:0500  b1 5e                              lda (INDEX),Y                   ; END OF PROGRAM YET?
 1480 T:0502  d0 0b                              bne L_FIX_LINKS_2                ; NO, KEEP GOING
 1481 T:0504  a5 69                              lda VARTAB                ; YES
