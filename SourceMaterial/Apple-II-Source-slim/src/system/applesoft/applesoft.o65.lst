 3634 T:118b  18                                 clc 
 3635 T:118c  65 9b                              adc LOWTR
 3636 T:118e  aa                                 tax 
 3637 T:118f  c8                                 iny 
 3638 T:1190  b1 9b                              lda (LOWTR),Y
 3639 T:1192  65 9c                              adc LOWTR+1
 3640 T:1194  90 d7                              bcc L_ARRAY_3             ; ...ALWAYS
 3641 T:1196                                    ; --------------------------------
