 2931 T:0dcd                           FRM_PRECEDENCE_TEST 
 2932 T:0dcd  68                                 pla                    ; GET LAST PRECEDENCE
 2933 T:0dce  d9 b2 00                           cmp MATHTBL,Y
 2934 T:0dd1  b0 67                              bcs FRM_PERFORM_1                ; DO NOW IF HIGHER PRECEDENCE
 2935 T:0dd3  20 6a 0d                           jsr CHKNUM             ; WAS LAST RESULT A #?
 2936 T:0dd6  48                       NXOP      pha                 ; YES, SAVE PRECEDENCE ON STACK
 2937 T:0dd7  20 fd 0d                 SAVOP     jsr FRM_RECURSE             ; SAVE REST, CALL FRMEVL RECURSIVELY
 2938 T:0dda  68                                 pla 
 2939 T:0ddb  a4 87                              ldy LASTOP
 2940 T:0ddd  10 17                              bpl PREFNC
 2941 T:0ddf  aa                                 tax 
