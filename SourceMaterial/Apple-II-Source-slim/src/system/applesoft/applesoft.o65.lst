 2983 T:0e10                                    ; --------------------------------
 2984 T:0e10                           FRM_STACK_1 
 2985 T:0e10  a5 a2                              lda FAC_SIGN                ; GET FAC.SIGN TO PUSH IT
 2986 T:0e12                                    ; Note: XA65 assembler (Andre Fachat) requires ! here when asm with "xa -R -bt 0" for some reason:
 2987 T:0e12  be b2 00                           ldx !MATHTBL,Y                   ; PRECEDENCE BYTE FROM MATHTBL
 2988 T:0e15                                    ; --------------------------------
