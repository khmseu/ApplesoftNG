 6134 T:1fae                                    ; "RND" FUNCTION
 6135 T:1fae                                    ; --------------------------------
 6136 T:1fae  20 82 1b                 RND       jsr SIGN          ; REDUCE ARGUMENT TO -1, 0, OR +1
 6137 T:1fb1  aa                                 tax                    ; SAVE ARGUMENT
 6138 T:1fb2  30 18                              bmi L_RND_1                ; = -1, USE CURRENT ARGUMENT FOR SEED
 6139 T:1fb4  a9 c9                              lda #<RNDSEED              ; USE CURRENT SEED
 6140 T:1fb6  a0 00                              ldy #>RNDSEED
 6141 T:1fb8  20 f9 1a                           jsr LOAD_FAC_FROM_YA
 6142 T:1fbb  8a                                 txa                    ; RECALL SIGN OF ARGUMENT
 6143 T:1fbc  f0 e7                              beq RTS_19             ; =0, RETURN SEED UNCHANGED
 6144 T:1fbe  a9 a6                              lda #<CON_RND_1           ; VERY POOR RND ALGORITHM
 6145 T:1fc0  a0 1f                              ldy #>CON_RND_1
 6146 T:1fc2  20 7f 19                           jsr FMULT
 6147 T:1fc5  a9 aa                              lda #<CON_RND_2           ; ALSO, CONSTANTS ARE TRUNCATED
 6148 T:1fc7  a0 1f                              ldy #>CON_RND_2           ; <<<THIS DOES NOTHING, DUE TO >>>
 6149 T:1fc9                                    ; <<<SMALL EXPONENT            >>>
 6150 T:1fc9  20 be 17                           jsr FADD
 6151 T:1fcc  a6 a1                    L_RND_1   ldx FAC+4       ; SHUFFLE HI AND LO BYTES
 6152 T:1fce  a5 9e                              lda FAC+1          ; TO SUPPOSEDLY MAKE IT MORE RANDOM
 6153 T:1fd0  85 a1                              sta FAC+4          ; 
 6154 T:1fd2  86 9e                              stx FAC+1          ; 
 6155 T:1fd4  a9 00                              lda #0             ; MAKE IT POSITIVE
 6156 T:1fd6  85 a2                              sta FAC_SIGN                ; 
 6157 T:1fd8  a5 9d                              lda FAC                ; A SOMEWHAT RANDOM EXTENSION
 6158 T:1fda  85 ac                              sta FAC_EXTENSION
 6159 T:1fdc  a9 80                              lda #$80             ; EXPONENT TO MAKE VALUE < 1.0
 6160 T:1fde  85 9d                              sta FAC
 6161 T:1fe0  20 2e 18                           jsr NORMALIZE_FAC_2
 6162 T:1fe3  a2 c9                              ldx #<RNDSEED              ; MOVE FAC TO RND SEED
 6163 T:1fe5  a0 00                              ldy #>RNDSEED
 6164 T:1fe7  4c 2b 1b                 GO_MOVMF  jmp STORE_FACDB_YX_ROUNDED
