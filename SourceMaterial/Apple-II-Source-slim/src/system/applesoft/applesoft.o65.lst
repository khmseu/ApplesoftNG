 7217 T:25ba                                    ; TABLE OF COS(90*X/16 DEGREES)*$100 - 1
 7218 T:25ba                                    ; WITH ONE BYTE PRECISION, X=0 TO 16:
 7219 T:25ba                                    ; --------------------------------
 7220 T:25ba  ff fe fa f4 ec e1 d4 c5  COSINE_TABLE .byt $ff,$fe,$fa,$f4,$ec,$e1,$d4,$c5
 7221 T:25c2  b4 a1 8d 78 61 49 31 18            .byt $b4,$a1,$8d,$78,$61,$49,$31,$18
 7222 T:25ca  ff                                 .byt $ff
 7223 T:25cb                                    ; --------------------------------
 7224 T:25cb                                    ; HFIND -- CALCULATES CURRENT POSITION OF HI-RES CURSOR
 7225 T:25cb                                    ; (NOT CALLED BY ANY APPLESOFT ROUTINE)
 7226 T:25cb                                    ; 
 7227 T:25cb                                    ; CALCULATE Y-COORD FROM GBASL,H
 7228 T:25cb                                    ; AND X-COORD FROM HORIZ AND HMASK
 7229 T:25cb                                    ; --------------------------------
 7230 T:25cb  a5 26                    HFIND     lda MON_GBASL             ; GBASL = EABAB000
 7231 T:25cd  0a                                 asl                    ; E INTO CARRY
 7232 T:25ce  a5 27                              lda MON_GBASH                ; GBASH = PPPFGHCD
 7233 T:25d0  29 03                              and #3             ; 000000CD
 7234 T:25d2  2a                                 rol                    ; 00000CDE
 7235 T:25d3  05 26                              ora MON_GBASL                ; EABABCDE
 7236 T:25d5  0a                                 asl                    ; ABABCDE0
 7237 T:25d6  0a                                 asl                    ; BABCDE00
 7238 T:25d7  0a                                 asl                    ; ABCDE000
 7239 T:25d8  85 e2                              sta HGR_Y                ; ALL BUT FGH
 7240 T:25da  a5 27                              lda MON_GBASH                ; PPPFGHCD
 7241 T:25dc  4a                                 lsr                    ; 0PPPFGHC
 7242 T:25dd  4a                                 lsr                    ; 00PPPFGH
 7243 T:25de  29 07                              and #7             ; 00000FGH
 7244 T:25e0  05 e2                              ora HGR_Y                ; ABCDEFGH
 7245 T:25e2  85 e2                              sta HGR_Y                ; THAT TAKES CARE OF Y-COORDINATE!
 7246 T:25e4  a5 e5                              lda HGR_HORIZ                ; X = 7*HORIZ + BIT POS. IN HMASK
 7247 T:25e6  0a                                 asl                    ; MULTIPLY BY 7
 7248 T:25e7  65 e5                              adc HGR_HORIZ                ; 3* SO FAR
 7249 T:25e9  0a                                 asl                    ; 6*
 7250 T:25ea  aa                                 tax                    ; SINCE 7* MIGHT NOT FIT IN 1 BYTE,
 7251 T:25eb                                    ; WAIT TILL LATER FOR LAST ADD
 7252 T:25eb  ca                                 dex                    ; 
 7253 T:25ec  a5 30                              lda MON_HMASK                ; NOW FIND BIT POSITION IN HMASK
 7254 T:25ee  29 7f                              and #$7f             ; ONLY LOOK AT LOW SEVEN
 7255 T:25f0  e8                       L_HFIND_1 inx                 ; COUNT A SHIFT
 7256 T:25f1  4a                                 lsr                    ; 
 7257 T:25f2  d0 fc                              bne L_HFIND_1             ; STILL IN THERE
 7258 T:25f4  85 e1                              sta HGR_X+1          ; ZERO TO HI-BYTE
 7259 T:25f6  8a                                 txa                    ; 6*HORIZ+LOG2(HMASK)
 7260 T:25f7  18                                 clc                    ; ADD HORIZ ONE MORE TIME
 7261 T:25f8  65 e5                              adc HGR_HORIZ                ; 7*HORIZ+LOG2(HMASK)
 7262 T:25fa  90 02                              bcc L_HFIND_2                ; UPPER BYTE = 0
 7263 T:25fc  e6 e1                              inc HGR_X+1          ; UPPER BYTE = 1
 7264 T:25fe  85 e0                    L_HFIND_2 sta HGR_X             ; STORE LOWER BYTE
 7265 T:2600  60                       RTS_22    rts 
 7266 T:2601                                    ; --------------------------------
 7267 T:2601                                    ; DRAW A SHAPE
 7268 T:2601                                    ; 
 7269 T:2601                                    ; (Y,X) = SHAPE STARTING ADDRESS
 7270 T:2601                                    ; (A)   = ROTATION (0-3F)
 7271 T:2601                                    ; --------------------------------
 7272 T:2601                                    ; APPLESOFT DOES NOT CALL DRAW0
 7273 T:2601                                    ; --------------------------------
 7274 T:2601  86 1a                    DRAW0     stx HGR_SHAPE             ; SAVE SHAPE ADDRESS
 7275 T:2603  84 1b                              sty HGR_SHAPE+1
 7276 T:2605                                    ; --------------------------------
 7277 T:2605                                    ; APPLESOFT ENTERS HERE
 7278 T:2605                                    ; --------------------------------
 7279 T:2605  aa                       DRAW1     tax                 ; SAVE ROTATION (0-$3F)
 7280 T:2606  4a                                 lsr                    ; DIVIDE ROTATION BY 16 TO GET
