 3544 T:1108                                    ; MUST BE POSITIVE AND LESS THAN 32768
 3545 T:1108                                    ; --------------------------------
 3546 T:1108  a5 a2                    MKINT     lda FAC_SIGN             ; ERROR IF -
 3547 T:110a  30 0d                              bmi MI1
 3548 T:110c                                    ; --------------------------------
 3549 T:110c                                    ; CONVERT FAC TO INTEGER
 3550 T:110c                                    ; MUST BE -32767 <= FAC <= 32767
 3551 T:110c                                    ; --------------------------------
 3552 T:110c  a5 9d                    AYINT     lda FAC             ; EXPONENT OF VALUE IN FAC
 3553 T:110e  c9 90                              cmp #$90             ; ABS(VALUE) < 32768?
 3554 T:1110  90 09                              bcc MI2                ; YES, OK FOR INTEGER
 3555 T:1112  a9 fe                              lda #<NEG32768           ; NO; NEXT FEW LINES ARE SUPPOSED TO
 3556 T:1114  a0 10                              ldy #>NEG32768           ; ALLOW -32768 ($8000), BUT DO NOT!
 3557 T:1116  20 b2 1b                           jsr FCOMP                ; BECAUSE COMPARED TO -32768.00049
 3558 T:1119                                    ; <<< BUG:  A=-32768.00049:A%=A IS ACCEPTED >>>
 3559 T:1119                                    ; <<<       BUT PRINT A,A% SHOWS THAT       >>>
 3560 T:1119                                    ; <<<       A=-32768.0005 (OK), A%=32767    >>>
 3561 T:1119                                    ; <<<       WRONG! WRONG! WRONG!            >>>
 3562 T:1119                                    ; --------------------------------
 3563 T:1119  d0 7e                    MI1       bne IQERR             ; ILLEGAL QUANTITY
 3564 T:111b  4c f2 1b                 MI2       jmp QINT             ; CONVERT TO INTEGER
