 1706 T:0665                           SETPTRS   
 1707 T:0665  20 97 06                           jsr STXTPT                ; SET TXTPTR TO TXTTAB - 1
 1708 T:0668  a9 00                              lda #0             ; (THIS COULD HAVE BEEN ".HS 2C")
 1709 T:066a                                    ; --------------------------------
 1710 T:066a                                    ; "CLEAR" STATEMENT
 1711 T:066a                                    ; --------------------------------
 1712 T:066a  d0 2a                    CLEAR     bne RTS_2             ; IGNORE IF NOT AT END OF STATEMENT
 1713 T:066c  a5 73                    CLEARC    lda MEMSIZ             ; CLEAR STRING AREA
 1714 T:066e  a4 74                              ldy MEMSIZ+1          ; 
 1715 T:0670  85 6f                              sta FRETOP                ; 
 1716 T:0672  84 70                              sty FRETOP+1          ; 
 1717 T:0674  a5 69                              lda VARTAB                ; CLEAR ARRAY AREA
 1718 T:0676  a4 6a                              ldy VARTAB+1          ; 
 1719 T:0678  85 6b                              sta ARYTAB                ; 
 1720 T:067a  84 6c                              sty ARYTAB+1          ; 
 1721 T:067c  85 6d                              sta STREND                ; LOW END OF FREE SPACE
 1722 T:067e  84 6e                              sty STREND+1          ; 
 1723 T:0680  20 49 08                           jsr RESTORE                ; SET "DATA" POINTER TO BEGINNING
 1724 T:0683                                    ; --------------------------------
 1725 T:0683  a2 55                    STKINI    ldx #TEMPST
 1726 T:0685  86 52                              stx TEMPPT
 1727 T:0687  68                                 pla                    ; SAVE RETURN ADDRESS
 1728 T:0688  a8                                 tay                    ; 
 1729 T:0689  68                                 pla                    ; 
 1730 T:068a  a2 f8                              ldx #$f8             ; START STACK AT $F8,
 1731 T:068c  9a                                 txs                    ; LEAVING ROOM FOR PARSING LINES
 1732 T:068d  48                                 pha                    ; RESTORE RETURN ADDRESS
 1733 T:068e  98                                 tya 
 1734 T:068f  48                                 pha 
 1735 T:0690  a9 00                              lda #0
 1736 T:0692  85 7a                              sta OLDTEXT+1
 1737 T:0694  85 14                              sta SUBFLG
 1738 T:0696  60                       RTS_2     rts 
 1739 T:0697                                    ; --------------------------------
 1740 T:0697                                    ; SET TXTPTR TO BEGINNING OF PROGRAM
 1741 T:0697                                    ; --------------------------------
 1742 T:0697  18                       STXTPT    clc                 ; TXTPTR = TXTTAB - 1
 1743 T:0698  a5 67                              lda TXTTAB
 1744 T:069a  69 ff                              adc #$ff
 1745 T:069c  85 b8                              sta TXTPTR
 1746 T:069e  a5 68                              lda TXTTAB+1
 1747 T:06a0  69 ff                              adc #$ff
 1748 T:06a2  85 b9                              sta TXTPTR+1
 1749 T:06a4  60                                 rts 
 1750 T:06a5                                    ; --------------------------------
 1751 T:06a5                                    ; "LIST" STATEMENT
 1752 T:06a5                                    ; --------------------------------
 1753 T:06a5  90 0a                    LIST      bcc L_LIST_1             ; NO  LINE # SPECIFIED
 1754 T:06a7  f0 08                              beq L_LIST_1                ; ---DITTO---
 1755 T:06a9  c9 c9                              cmp #TOKEN_MINUS               ; IF DASH OR COMMA, START AT LINE 0
 1756 T:06ab  f0 04                              beq L_LIST_1                ; IS IS A DASH
 1757 T:06ad  c9 2c                              cmp #(","&%01111111)     ; COMMA?
 1758 T:06af  d0 e5                              bne RTS_2             ; NO, ERROR
 1759 T:06b1  20 0c 0a                 L_LIST_1  jsr LINGET             ; CONVERT LINE NUMBER IF ANY
 1760 T:06b4  20 1a 06                           jsr FNDLIN             ; POINT LOWTR TO 1ST LINE
 1761 T:06b7  20 b7 00                           jsr CHRGOT                ; RANGE SPECIFIED?
 1762 T:06ba  f0 10                              beq L_LIST_3                ; NO
 1763 T:06bc  c9 c9                              cmp #TOKEN_MINUS
 1764 T:06be  f0 04                              beq L_LIST_2
 1765 T:06c0  c9 2c                              cmp #(","&%01111111)
 1766 T:06c2  d0 84                              bne RTS_1
 1767 T:06c4  20 b1 00                 L_LIST_2  jsr CHRGET             ; GET NEXT CHAR
 1768 T:06c7  20 0c 0a                           jsr LINGET                ; CONVERT SECOND LINE #
 1769 T:06ca  d0 ca                              bne RTS_2             ; BRANCH IF SYNTAX ERR
 1770 T:06cc  68                       L_LIST_3  pla                 ; POP RETURN ADRESS
 1771 T:06cd  68                                 pla                    ; (GET BACK BY "JMP NEWSTT")
 1772 T:06ce  a5 50                              lda LINNUM                ; IF NO SECOND NUMBER, USE $FFFF
 1773 T:06d0  05 51                              ora LINNUM+1          ; 
 1774 T:06d2  d0 06                              bne LIST_0                ; THERE WAS A SECOND NUMBER
 1775 T:06d4  a9 ff                              lda #$ff             ; MAX END RANGE
 1776 T:06d6  85 50                              sta LINNUM                ; 
 1777 T:06d8  85 51                              sta LINNUM+1          ; 
 1778 T:06da  a0 01                    LIST_0    ldy #1          ; 
 1779 T:06dc  b1 9b                              lda (LOWTR),Y                   ; HIGH BYTE OF LINK
 1780 T:06de  f0 44                              beq LIST_3                ; END OF PROGRAM
 1781 T:06e0  20 58 08                           jsr ISCNTC                ; CHECK IF CONTROL-C HAS BEEN TYPED
 1782 T:06e3  20 fb 0a                           jsr CRDO                ; NO, PRINT <RETURN>
 1783 T:06e6  c8                                 iny                    ; 
 1784 T:06e7  b1 9b                              lda (LOWTR),Y                   ; GET LINE #, COMPARE WITH END RANGE
 1785 T:06e9  aa                                 tax                    ; 
 1786 T:06ea  c8                                 iny                    ; 
 1787 T:06eb  b1 9b                              lda (LOWTR),Y                   ; 
 1788 T:06ed  c5 51                              cmp LINNUM+1          ; 
 1789 T:06ef  d0 04                              bne L_LIST_0_5                ; 
 1790 T:06f1  e4 50                              cpx LINNUM                ; 
 1791 T:06f3  f0 02                              beq L_LIST_0_6                ; ON LAST LINE OF RANGE
 1792 T:06f5  b0 2d                    L_LIST_0_5 bcs LIST_3             ; FINISHED THE RANGE
 1793 T:06f7                                    ; ---LIST ONE LINE----------------
 1794 T:06f7  84 85                    L_LIST_0_6 sty FORPNT             ; 
 1795 T:06f9  20 24 1d                           jsr LINPRT                ; PRINT LINE # FROM X,A
 1796 T:06fc  a9 20                              lda #(" "&%01111111)     ; PRINT SPACE AFTER LINE #
 1797 T:06fe  a4 85                    LIST_1    ldy FORPNT             ; 
 1798 T:0700  29 7f                              and #$7f             ; 
 1799 T:0702  20 5c 0b                 LIST_2    jsr OUTDO             ; 
 1800 T:0705  a5 24                              lda MON_CH                ; IF PAST COLUMN 33, START A NEW LINE
 1801 T:0707  c9 21                              cmp #33             ; 
 1802 T:0709  90 07                              bcc L_LIST_2_1                ; < 33
 1803 T:070b  20 fb 0a                           jsr CRDO                ; PRINT <RETURN>
 1804 T:070e  a9 05                              lda #5             ; AND TAB OVER 5
 1805 T:0710  85 24                              sta MON_CH                ; 
 1806 T:0712  c8                       L_LIST_2_1 iny                 ; 
 1807 T:0713  b1 9b                              lda (LOWTR),Y                   ; 
 1808 T:0715  d0 1d                              bne LIST_4                ; NOT END OF LINE YET
 1809 T:0717  a8                                 tay                    ; END OF LINE
 1810 T:0718  b1 9b                              lda (LOWTR),Y                   ; GET LINK TO NEXT LINE
 1811 T:071a  aa                                 tax                    ; 
 1812 T:071b  c8                                 iny                    ; 
 1813 T:071c  b1 9b                              lda (LOWTR),Y                   ; 
 1814 T:071e  86 9b                              stx LOWTR                ; POINT TO NEXT LINE
 1815 T:0720  85 9c                              sta LOWTR+1          ; 
 1816 T:0722  d0 b6                              bne LIST_0             ; BRANCH IF NOT END OF PROGRAM
 1817 T:0724  a9 0d                    LIST_3    lda #$0d          ; PRINT <RETURN>
 1818 T:0726  20 5c 0b                           jsr OUTDO                ; 
 1819 T:0729  4c d2 07                           jmp NEWSTT                ; TO NEXT STATEMENT
 1820 T:072c                                    ; --------------------------------
 1821 T:072c  c8                       GETCHR    iny                 ; PICK UP CHAR FROM TABLE
 1822 T:072d  d0 02                              bne L_GETCHR_1                ; 
