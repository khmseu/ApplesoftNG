 2992 T:0e15  a8                                 tay                    ; FAC.SIGN OR SGN(STEP VALUE)
 2993 T:0e16  68                                 pla                    ; PULL RETURN ADDRESS AND ADD 1
 2994 T:0e17  85 5e                              sta INDEX                ; <<< ASSUMES NOT ON PAGE BOUNDARY! >>>
 2995 T:0e19  e6 5e                              inc INDEX                ; PLACE BUMPED RETURN ADDRESS IN
 2996 T:0e1b  68                                 pla                    ; INDEX,INDEX+1
 2997 T:0e1c  85 5f                              sta INDEX+1          ; 
