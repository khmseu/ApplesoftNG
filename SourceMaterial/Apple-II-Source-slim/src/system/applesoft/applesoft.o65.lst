 3598 T:114a  9d 02 01                           sta STACK+2,X                   ; STACK WHERE VALTYP & DIMFLG WERE
 3599 T:114d  a5 a1                              lda FAC+4          ; 
 3600 T:114f  9d 01 01                           sta STACK+1,X                   ; 
