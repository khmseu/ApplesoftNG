 6010 T:1ee1  71 34 58 3e 56                     .byt $71,$34,$58,$3e,$56; (LOG(2)^7)/8!
 6011 T:1ee6  74 16 7e b3 1b                     .byt $74,$16,$7e,$b3,$1b; (LOG(2)^6)/7!
 6012 T:1eeb  77 2f ee e3 85                     .byt $77,$2f,$ee,$e3,$85; (LOG(2)^5)/6!
 6013 T:1ef0  7a 1d 84 1c 2a                     .byt $7a,$1d,$84,$1c,$2a; (LOG(2)^4)/5!
 6014 T:1ef5  7c 63 59 58 0a                     .byt $7c,$63,$59,$58,$0a; (LOG(2)^3)/4!
