 3024 T:0e3a                                    ; PERFORM STACKED OPERATION
 3025 T:0e3a                                    ; 
 3026 T:0e3a                                    ; (A) = PRECEDENCE BYTE
 3027 T:0e3a                                    ; STACK:  1 -- CPRMASK
 3028 T:0e3a                                    ; 5 -- (ARG)
 3029 T:0e3a                                    ; 2 -- ADDR OF PERFORMER
 3030 T:0e3a                                    ; --------------------------------
 3031 T:0e3a                           FRM_PERFORM_1 
 3032 T:0e3a  c9 64                              cmp #P_REL               ; WAS IT RELATIONAL OPERATOR?
 3033 T:0e3c  f0 03                              beq L_FRM_PERFORM_1_1                ; YES, ALLOW STRING COMPARE
 3034 T:0e3e  20 6a 0d                           jsr CHKNUM             ; MUST BE NUMERIC VALUE
 3035 T:0e41  84 87                    L_FRM_PERFORM_1_1 sty LASTOP             ; 
