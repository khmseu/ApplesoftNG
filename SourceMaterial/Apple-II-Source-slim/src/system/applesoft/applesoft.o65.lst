 6066 T:1f5c                                    ; ODD POLYNOMIAL SUBROUTINE
 6067 T:1f5c                                    ; 
 6068 T:1f5c                                    ; F(X) = X * P(X^2)
 6069 T:1f5c                                    ; 
 6070 T:1f5c                                    ; WHERE:  X IS VALUE IN FAC
 6071 T:1f5c                                    ; Y,A POINTS AT COEFFICIENT TABLE
 6072 T:1f5c                                    ; FIRST BYTE OF COEFF. TABLE IS N
 6073 T:1f5c                                    ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
 6074 T:1f5c                                    ; 
 6075 T:1f5c                                    ; P(X^2) COMPUTED USING NORMAL POLYNOMIAL SUBROUTINE
 6076 T:1f5c                                    ; 
 6077 T:1f5c                                    ; --------------------------------
 6078 T:1f5c                           POLYNOMIAL_ODD 
 6079 T:1f5c  85 ad                              sta SERPNT                ; SAVE ADDRESS OF COEFFICIENT TABLE
 6080 T:1f5e  84 ae                              sty SERPNT+1
 6081 T:1f60  20 21 1b                           jsr STORE_FAC_IN_TEMP1_ROUNDED
 6082 T:1f63  a9 93                              lda #TEMP1               ; Y=0 ALREADY, SO Y,A POINTS AT TEMP1
 6083 T:1f65  20 7f 19                           jsr FMULT             ; FORM X^2
 6084 T:1f68  20 76 1f                           jsr SERMAIN                ; DO SERIES IN X^2
 6085 T:1f6b  a9 93                              lda #<TEMP1              ; GET X AGAIN
 6086 T:1f6d  a0 00                              ldy #>TEMP1              ; 
 6087 T:1f6f  4c 7f 19                           jmp FMULT             ; MULTIPLY X BY P(X^2) AND EXIT
 6088 T:1f72                                    ; --------------------------------
 6089 T:1f72                                    ; NORMAL POLYNOMIAL SUBROUTINE
 6090 T:1f72                                    ; 
 6091 T:1f72                                    ; P(X) = C(0)*X^N + C(1)*X^(N-1) + ... + C(N)
 6092 T:1f72                                    ; 
 6093 T:1f72                                    ; WHERE:  X IS VALUE IN FAC
 6094 T:1f72                                    ; Y,A POINTS AT COEFFICIENT TABLE
 6095 T:1f72                                    ; FIRST BYTE OF COEFF. TABLE IS N
 6096 T:1f72                                    ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
 6097 T:1f72                                    ; 
 6098 T:1f72                                    ; --------------------------------
 6099 T:1f72                           POLYNOMIAL 
 6100 T:1f72  85 ad                              sta SERPNT                ; POINTER TO COEFFICIENT TABLE
 6101 T:1f74  84 ae                              sty SERPNT+1
 6102 T:1f76                                    ; --------------------------------
 6103 T:1f76                           SERMAIN   
 6104 T:1f76  20 1e 1b                           jsr STORE_FAC_IN_TEMP2_ROUNDED
 6105 T:1f79  b1 ad                              lda (SERPNT),Y                  ; GET N
 6106 T:1f7b  85 a3                              sta SERLEN                ; SAVE N
 6107 T:1f7d  a4 ad                              ldy SERPNT                ; BUMP PNTR TO HIGHEST COEFFICIENT
 6108 T:1f7f  c8                                 iny                    ; AND GET PNTR INTO Y,A
 6109 T:1f80  98                                 tya 
 6110 T:1f81  d0 02                              bne L_SERMAIN_1
 6111 T:1f83  e6 ae                              inc SERPNT+1
 6112 T:1f85  85 ad                    L_SERMAIN_1 sta SERPNT
 6113 T:1f87  a4 ae                              ldy SERPNT+1
 6114 T:1f89  20 7f 19                 L_SERMAIN_2 jsr FMULT          ; ACCUMULATE SERIES TERMS
 6115 T:1f8c  a5 ad                              lda SERPNT                ; BUMP PNTR TO NEXT COEFFICIENT
 6116 T:1f8e  a4 ae                              ldy SERPNT+1
 6117 T:1f90  18                                 clc 
 6118 T:1f91  69 05                              adc #5
 6119 T:1f93  90 01                              bcc L_SERMAIN_3
 6120 T:1f95  c8                                 iny 
 6121 T:1f96  85 ad                    L_SERMAIN_3 sta SERPNT
 6122 T:1f98  84 ae                              sty SERPNT+1
 6123 T:1f9a  20 be 17                           jsr FADD             ; ADD NEXT COEFFICIENT
 6124 T:1f9d  a9 98                              lda #TEMP2               ; POINT AT X AGAIN
 6125 T:1f9f  a0 00                              ldy #0             ; 
 6126 T:1fa1  c6 a3                              dec SERLEN                ; IF SERIES NOT FINISHED,
 6127 T:1fa3  d0 e4                              bne L_SERMAIN_2             ; THEN ADD ANOTHER TERM
 6128 T:1fa5  60                       RTS_19    rts                 ; FINISHED
 6129 T:1fa6                                    ; --------------------------------

 6131 T:1fa6  98 35 44 7a              CON_RND_1 .byt $98,$35,$44,$7a; <<< THESE ARE MISSING ONE BYTE >>>
 6132 T:1faa  68 28 b1 46              CON_RND_2 .byt $68,$28,$b1,$46; <<< FOR FP VALUES              >>>
