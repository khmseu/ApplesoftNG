 6019 T:1f09                                    ; "EXP" FUNCTION
 6020 T:1f09                                    ; 
 6021 T:1f09                                    ; FAC = E ^ FAC
 6022 T:1f09                                    ; --------------------------------
 6023 T:1f09  a9 db                    EXP       lda #<CON_LOG_E        ; CONVERT TO POWER OF TWO PROBLEM
 6024 T:1f0b  a0 1e                              ldy #>CON_LOG_E           ; E^X = 2^(LOG2(E)*X)
 6025 T:1f0d  20 7f 19                           jsr FMULT             ; 
 6026 T:1f10  a5 ac                              lda FAC_EXTENSION                ; NON-STANDARD ROUNDING HERE
 6027 T:1f12  69 50                              adc #$50             ; ROUND UP IF EXTENSION > $AF
 6028 T:1f14  90 03                              bcc L_EXP_1                ; NO, DON'T ROUND UP
 6029 T:1f16  20 7a 1b                           jsr INCREMENT_MANTISSA
 6030 T:1f19  85 92                    L_EXP_1   sta ARG_EXTENSION             ; STRANGE VALUE
 6031 T:1f1b  20 66 1b                           jsr MAF             ; COPY FAC INTO ARG
 6032 T:1f1e  a5 9d                              lda FAC                ; MAXIMUM EXPONENT IS < 128
 6033 T:1f20  c9 88                              cmp #$88             ; WITHIN RANGE?
 6034 T:1f22  90 03                              bcc L_EXP_3                ; YES
 6035 T:1f24  20 2b 1a                 L_EXP_2   jsr OUTOFRNG          ; OVERFLOW IF +, RETURN 0.0 IF -
 6036 T:1f27  20 23 1c                 L_EXP_3   jsr INT          ; GET INT(FAC)
 6037 T:1f2a  a5 0d                              lda CHARAC                ; THIS IS THE INETGRAL PART OF THE POWER
 6038 T:1f2c  18                                 clc                    ; ADD TO EXPONENT BIAS + 1
 6039 T:1f2d  69 81                              adc #$81             ; 
 6040 T:1f2f  f0 f3                              beq L_EXP_2             ; OVERFLOW
 6041 T:1f31  38                                 sec                    ; BACK OFF TO NORMAL BIAS
 6042 T:1f32  e9 01                              sbc #1             ; 
 6043 T:1f34  48                                 pha                    ; SAVE EXPONENT
 6044 T:1f35                                    ; --------------------------------
 6045 T:1f35  a2 05                              ldx #5             ; SWAP ARG AND FAC
 6046 T:1f37  b5 a5                    L_EXP_4   lda ARG,X                       ; <<< WHY SWAP? IT IS DOING      >>>
 6047 T:1f39  b4 9d                              ldy FAC,X                       ; <<< -(A-B) WHEN (B-A) IS THE   >>>
 6048 T:1f3b  95 9d                              sta FAC,X                       ; <<< SAME THING!                >>>
 6049 T:1f3d  94 a5                              sty ARG,X
 6050 T:1f3f  ca                                 dex 
 6051 T:1f40  10 f5                              bpl L_EXP_4
 6052 T:1f42  a5 92                              lda ARG_EXTENSION
 6053 T:1f44  85 ac                              sta FAC_EXTENSION
 6054 T:1f46  20 aa 17                           jsr FSUBT             ; POWER-INT(POWER) --> FRACTIONAL PART
 6055 T:1f49  20 d0 1e                           jsr NEGOP
 6056 T:1f4c  a9 e0                              lda #<POLY_EXP
 6057 T:1f4e  a0 1e                              ldy #>POLY_EXP
 6058 T:1f50  20 72 1f                           jsr POLYNOMIAL                ; COMPUTE F(X) ON FRACTIONAL PART
 6059 T:1f53  a9 00                              lda #0
 6060 T:1f55  85 ab                              sta SGNCPR
 6061 T:1f57  68                                 pla                    ; GET EXPONENT
 6062 T:1f58  20 10 1a                           jsr ADD_EXPONENTS_1
 6063 T:1f5b  60                                 rts                    ; <<< WASTED BYTE HERE, COULD HAVE >>>
 6064 T:1f5c                                    ; <<< JUST USED "JMP ADD.EXPO..."  >>>
