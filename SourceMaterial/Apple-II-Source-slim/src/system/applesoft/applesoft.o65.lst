 3706 T:11e9  a9 00                              lda #0             ; FOR HI-BYTE OF DIMENSION IF DEFAULT
 3707 T:11eb  24 10                              bit DIMFLG                ; DIMENSIONED ARRAY?
 3708 T:11ed  50 08                              bvc L_MAKE_NEW_ARRAY_5                ; NO, USE DEFAULT VALUE
 3709 T:11ef  68                                 pla                    ; GET SPECIFIED DIM IN A,X
 3710 T:11f0  18                                 clc                    ; # ELEMENTS IS 1 LARGER THAN
 3711 T:11f1  69 01                              adc #1             ; DIMENSION VALUE
 3712 T:11f3  aa                                 tax                    ; 
