 4273 T:151d  c8                                 iny                    ; 
 4274 T:151e  b1 5e                              lda (INDEX),Y                   ; LOOK AT 2ND CHAR OF NAME
 4275 T:1520  10 30                              bpl CHECK_BUMP                ; NOT A STRING VARIABLE
 4276 T:1522  c8                                 iny                    ; 
