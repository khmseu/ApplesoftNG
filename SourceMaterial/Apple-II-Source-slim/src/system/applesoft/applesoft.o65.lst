 7312 T:263f  65 d2                              adc HGR_DY                ; IF >= 1, THEN DRAW
 7313 T:2641  85 d5                              sta HGR_E+1          ; ONLY SAVE FRACTIONAL PART
 7314 T:2643  90 03                              bcc L_DRAW1_4                ; NO INTEGRAL PART
 7315 T:2645  20 b4 24                           jsr LRUD2             ; TIME TO PLOT SINE COMPONENT
 7316 T:2648  ca                       L_DRAW1_4 dex                 ; LOOP ON SCALE FACTOR.
