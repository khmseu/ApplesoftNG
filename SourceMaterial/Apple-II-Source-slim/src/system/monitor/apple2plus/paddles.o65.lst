  124 T:0000  ad 70 c0                 PREAD     lda PTRIG             ;TRIGGER PADDLES
  125 T:0003  a0 00                              ldy #$00             ;INIT COUNT
  126 T:0005  ea                                 nop                    ;COMPENSATE FOR 1ST COUNT
