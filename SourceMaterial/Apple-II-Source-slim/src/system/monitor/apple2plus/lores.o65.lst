
lores.s65


  109 T:0000                                    LORESHEIGHT=24*2

  111 T:0000                                    ;-----------------------------------------------------------------------
  112 T:0000                                    ;
  113 T:0000                                    ; LO-RES GRAPHICS
  114 T:0000                                    ;
  115 T:0000                                    ; Some low-resolution-graphics routines.
  116 T:0000                                    ;
  117 T:0000                                    ;-----------------------------------------------------------------------

  123 T:0000  4a                       PLOT      lsr                 ;Y-COORD/2
  124 T:0001  08                                 php                    ;SAVE LSB IN CARRY
  125 T:0002  20 47 00                           jsr GBASCALC                ;CALC BASE ADR IN GBASL,H
  126 T:0005  28                                 plp                    ;RESTORE LSB FROM CARRY
  127 T:0006  a9 0f                              lda #%00001111             ;MASK $0F IF EVEN
  128 T:0008  90 02                              bcc RTMASK
  129 T:000a  69 e0                              adc #%11100000             ;MASK $F0 IF ODD
  130 T:000c  85 2e                    RTMASK    sta $2e
  131 T:000e  b1 26                    PLOT1     lda ($26),Y       ;DATA
  132 T:0010  45 30                              eor $30              ; EOR COLOR
  133 T:0012  25 2e                              and $2e              ;  AND MASK
  134 T:0014  51 26                              eor ($26),Y          ;   EOR DATA
  135 T:0016  91 26                              sta ($26),Y          ;    TO DATA
  136 T:0018  60                                 rts 

  138 T:0019  20 00 00                 HLINE     jsr PLOT          ;PLOT SQUARE
  139 T:001c  c4 2c                    HLINE1    cpy $2c           ;DONE?
  140 T:001e  b0 11                              bcs RTS1                ; YES, RETURN
  141 T:0020  c8                                 iny                    ; NO, INC INDEX (X-COORD)
  142 T:0021  20 0e 00                           jsr PLOT1             ;PLOT NEXT SQUARE
  143 T:0024  90 f6                              bcc HLINE1             ;ALWAYS TAKEN
  144 T:0026  69 01                    VLINEZ    adc #1          ;NEXT Y-COORD
  145 T:0028  48                       VLINE     pha                 ; SAVE ON STACK
  146 T:0029  20 00 00                           jsr PLOT             ; PLOT SQUARE
  147 T:002c  68                                 pla 
  148 T:002d  c5 2d                              cmp $2d              ;DONE?
  149 T:002f  90 f5                              bcc VLINEZ             ; NO, LOOP
  150 T:0031  60                       RTS1      rts 

  154 T:0032  a0 2f                    CLRSCR    ldy #LORESHEIGHT-1      ;MAX Y, FULL SCRN CLR
  155 T:0034  d0 02                              bne CLRSC2                ;ALWAYS TAKEN
  156 T:0036  a0 27                    CLRTOP    ldy #40-1    ;MAX Y, TOP SCREEN CLR
  157 T:0038  84 2d                    CLRSC2    sty $2d           ;STORE AS BOTTOM COORD
  158 T:003a                                    ; FOR VLINE CALLS
  159 T:003a  a0 27                              ldy #40-1       ;RIGHTMOST X-COORD (COLUMN)
  160 T:003c  a9 00                    CLRSC3    lda #0          ;TOP COORD FOR VLINE CALLS
  161 T:003e  85 30                              sta $30              ;CLEAR COLOR (BLACK)
  162 T:0040  20 28 00                           jsr VLINE             ;DRAW VLINE
  163 T:0043  88                                 dey                    ;NEXT LEFTMOST X-COORD
  164 T:0044  10 f6                              bpl CLRSC3             ;LOOP UNTIL DONE
  165 T:0046  60                                 rts 

  169 T:0047  48                       GBASCALC  pha                 ;FOR INPUT 000DEFGH
  170 T:0048  4a                                 lsr 
  171 T:0049  29 03                              and #%00000011
  172 T:004b  09 04                              ora #%00000100             ;  GENERATE GBASH=000001FG
  173 T:004d  85 27                              sta $27
  174 T:004f  68                                 pla                    ;  AND GBASL=HDEDE000
  175 T:0050  29 18                              and #%00011000
  176 T:0052  90 02                              bcc GBCALC
  177 T:0054  69 7f                              adc #$80-1
  178 T:0056  85 26                    GBCALC    sta $26
  179 T:0058  0a                                 asl 
  180 T:0059  0a                                 asl 
  181 T:005a  05 26                              ora $26
  182 T:005c  85 26                              sta $26
  183 T:005e  60                                 rts 

  187 T:005f  a5 30                    NXTCOL    lda $30           ;INCREMENT COLOR BY 3
  188 T:0061  18                                 clc 
  189 T:0062  69 03                              adc #3
  190 T:0064  29 0f                    SETCOL    and #%00001111          ;SETS COLOR=17*A MOD 16
  191 T:0066  85 30                              sta $30
  192 T:0068  0a                                 asl                    ;BOTH HALF BYTES OF COLOR EQUAL
  193 T:0069  0a                                 asl 
  194 T:006a  0a                                 asl 
  195 T:006b  0a                                 asl 
  196 T:006c  05 30                              ora $30
  197 T:006e  85 30                              sta $30
  198 T:0070  60                                 rts 

  202 T:0071  4a                       SCRN      lsr                 ;READ SCREEN Y-COORD/2
  203 T:0072  08                                 php                    ;SAVE LSB (CARRY)
  204 T:0073  20 47 00                           jsr GBASCALC             ;CALC BASE ADDRESS
  205 T:0076  b1 26                              lda ($26),Y          ;GET BYTE
  206 T:0078  28                                 plp                    ;RESTORE LSB FROM CARRY

  208 T:0079  90 04                    SCRN2     bcc RTMSKZ             ;IF EVEN, USE LO H
  209 T:007b  4a                                 lsr 
  210 T:007c  4a                                 lsr 
  211 T:007d  4a                                 lsr                    ;SHIFT HIGH HALF BYTE DOWN
  212 T:007e  4a                                 lsr 
  213 T:007f  29 0f                    RTMSKZ    and #%00001111          ;MASK 4-BITS
  214 T:0081  60                                 rts 
