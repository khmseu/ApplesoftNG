  150 T:0038  e0 8a                              cpx #$8a
  151 T:003a  f0 0b                              beq MNNDX3
  152 T:003c  4a                       MNNDX1    lsr 
  153 T:003d  90 08                              bcc MNNDX3                ;FORM INDEX INTO MNEMONIC TABLE
  154 T:003f  4a                                 lsr 
