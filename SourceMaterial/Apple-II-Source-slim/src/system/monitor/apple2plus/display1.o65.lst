
display1.s65


  109 T:0000                                    ;-----------------------------------------------------------------------
  110 T:0000                                    ;
  111 T:0000                                    ; INITIALIZE DISPLAY
  112 T:0000                                    ;
  113 T:0000                                    ; Handles initializing the display.
  114 T:0000                                    ;
  115 T:0000                                    ;-----------------------------------------------------------------------

  121 T:0000                                    TXTCLR=$c050
  122 T:0000                                    TXTSET=$c051
  123 T:0000                                    MIXSET=$c053
  124 T:0000                                    LOWSCR=$c054
  125 T:0000                                    LORES=$c056

  128 T:0000                                    TEXTBOTTOMLINES=4

  131 T:0000  a9 00                    INIT      lda #0          ;CLR STATUS FOR DEBUG
  132 T:0002  85 48                              sta $48              ;  SOFTWARE
  133 T:0004  ad 56 c0                           lda LORES
  134 T:0007  ad 54 c0                           lda LOWSCR                ;INIT VIDEO MODE

  138 T:000a  ad 51 c0                 SETTXT    lda TXTSET             ;SET FOR TEXT MODE
  139 T:000d  a9 00                              lda #0             ;  FULL SCREEN WINDOW
  140 T:000f  f0 0b                              beq SETWND

  142 T:0011  ad 50 c0                 SETGR     lda TXTCLR             ;SET FOR GRAPHICS MODE
  143 T:0014  ad 53 c0                           lda MIXSET                ;  LOWER 4 LINES AS
  144 T:0017  20 00 00                           jsr CLRTOP                ;  TEXT WINDOW
  145 T:001a  a9 14                              lda #24-TEXTBOTTOMLINES

  149 T:001c  85 22                    SETWND    sta $22           ;SET FOR 40 COL WINDOW
  150 T:001e  a9 00                              lda #0             ;  TOP IN A-REG,
  151 T:0020  85 20                              sta $20              ;  BTTM AT LINE 24
  152 T:0022  a9 28                              lda #40
  153 T:0024  85 21                              sta $21
  154 T:0026  a9 18                              lda #24
  155 T:0028  85 23                              sta $23              ;  VTAB TO ROW 23
  156 T:002a  a9 17                              lda #24-1
  157 T:002c  85 25                    TABV      sta $25           ;VTABS TO ROW IN A-REG
  158 T:002e  4c 00 00                           jmp VTAB
